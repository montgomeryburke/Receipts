-- =================================================================== TYPES ==
--[[
	The shapes above, written down so the editor can catch a typo in a weapon
	name before the game ever runs. Optional fields end in `?` — a pistol has
	no BlastRadius and that is fine.
]]

export type WeaponSpec = {
	Slot: number,
	Category: string,
	DisplayName: string,
	Kind: string,
	Damage: number,
	Cooldown: number,
	Recoil: number?, -- camera kick in degrees, per shot
	Range: number,
	MagSize: number,
	ReloadTime: number,
	Spread: number,
	Color: Color3,

	Speed: number?,
	Pellets: number?,
	Automatic: boolean?,
	Pierces: number?,
	BlastRadius: number?,
	BlastDamage: number?,
	CanMegaDetonate: boolean?,
	AutoAim: boolean?,
	ZoomFov: number?,
	ZoomLevels: { number }?,
	SemiAutoWhenScoped: boolean?,
	Points: number?,
	Cluster: number?,
	ClusterRadius: number?,
	ClusterDamage: number?,
	FuseTime: number?,
	Sticky: boolean?,
	MountedOnly: boolean?,
	Splat: boolean?,
	AmmoFromPickupsOnly: boolean?,
	HomingTurnRate: number?,
	HomingLifetime: number?,
	VehicleDamageMultiplier: number?,
	MoveSpeedFactor: number?,
}

export type CarTier = {
	Name: string,
	KeysRequired: number,
	MaxSpeed: number,
	Torque: number,
	TurnSpeed: number,
	Color: Color3,
}

export type VehicleSpec = {
	DisplayName: string,
	Seats: number,
	Health: number,
	Color: Color3,
	RespawnDelay: number,

	MaxSpeed: number?,
	Torque: number?,
	TurnSpeed: number?,
	MountedWeapon: string?,
	DamageResistance: number?,
	FlySpeed: number?,
	MinFlySpeed: number?,
	PitchRate: number?,
	RollRate: number?,
	YawRate: number?,
	Speed: number?,
	TurnRate: number?,
	BlastRadius: number?,
	BlastDamage: number?,
	Lifetime: number?,
}

export type MapSpec = {
	Id: string,
	Name: string,
	Size: number,
	MudFraction: number,
	Buildings: number,
	Jumps: number,
	Ramps: number,
	Theme: Color3,
}

export type ConfigType = {
	FreeMode: boolean,
	InfiniteAmmo: boolean,

	GamePasses: { [string]: number },
	Products: { [string]: number },
	ProductGrants: { MegaDetonations: number, InstantTopCarTier: number },

	Modes: { { Id: string, Name: string, Blurb: string, ScoreLimit: number } },
	CTF: {
		CapturePoints: number, FlagTakenPoints: number, FlagReturnPoints: number,
		DroppedReturnDelay: number, RequireOwnFlagHome: boolean,
		CarrierSpeedFactor: number,
	},
	Match: {
		MaxPlayers: number,
		VoteDuration: number,
		RoundDuration: number,
		IntermissionDuration: number,
		MapChoices: number,
		MinPlayers: number,
		ScoreLimit: number,
		PointsPerKill: number,
	},

	Combat: {
		MaxHealth: number,
		ShieldRegenDelay: number,
		ShieldRegenPerSecond: number,
		SpawnProtection: number,
		AutoAimConeDegrees: number,
		AutoAimRange: number,
		AutoAimServerToleranceDegrees: number,
	},

	Weapons: { [string]: WeaponSpec },
	StartingLoadout: { string },

	Mega: { Multiplier: number, FreeChargesPerLife: number, CraterDepth: number },
	Melee: {
		Damage: number, Range: number, Cooldown: number,
		BackstabMultiplier: number, BackstabArc: number,
	},
	Driving: {
		Acceleration: number, BrakeDeceleration: number,
		Coast: number, SteerGripSpeed: number,
		MotorTorque: number, BrakeTorque: number,
		SuspensionHeight: number, SuspensionTravel: number,
		SpringStiffness: number, SpringDamping: number,
		MaxSteerAngle: number, MinSteerAngle: number,
		SteerSpeed: number, SteerTorque: number,
		WheelFriction: number, WheelFrictionWeight: number,
	},
	Wildlife: {
		ElephantCount: number, ElephantSpeed: number,
		PoopInterval: number, PoopLifetime: number, PoopPerPile: number,
		MaxPoopPiles: number, SplatDuration: number,
	},
	GrenadeKeyWeapon: string,
	WeaponsAlwaysAvailable: boolean,
	Movement: { JumpPower: number, HeadshotMultiplier: number, ScopedSpeedFactor: number },
	Carnival: {
		BalloonPoints: number, BalloonClearBonus: number,
		BottlePoints: number, BottleStackBonus: number,
		MolePoints: number, MoleDownSeconds: number, MoleUpSeconds: number,
		CratePoints: number, CrateStackBonus: number, CannonCooldown: number,
		ResetSeconds: number,
	},
	Arcade: { OfferRadius: number, ReofferSeconds: number },
	Bots: {
		Health: number,
		WalkSpeed: number,
		Points: number,
		RespawnDelay: number,
		ThinkInterval: number,
	},
	Hockey: {
		GoalPoints: number,
		FightSeconds: number,
		FightWinPoints: number,
		KnockdownSeconds: number,
		StickBreakChance: number,
		StickWeapon: string,
		PickupRange: number, CarryDistance: number, ShotSpeed: number,
		FightHealth: number, PunchCooldown: number,
		PunchDamageMin: number, PunchDamageMax: number,
		BlockedDamage: number, PenaltySeconds: number,
		BrokenStickWeapon: string,
	},
	Radar: {
		Range: number,
		VerticalRange: number,
	},
	Boost: { Speed: number, Lift: number },
	Population: {
		Zombies: number, Civilians: number, Targets: number,
		ZombieHealth: number, ZombieSpeed: number, ZombiePoints: number,
		ZombieReach: number, ZombieDamage: number,
		CivilianHealth: number, CivilianSpeed: number, CivilianPoints: number,
		TargetHealth: number, TargetPoints: number,
		RespawnDelay: number,
	},
	CivilianLines: { string },
	Sounds: {
		[string]: {
			Asset: string, Volume: number,
			Pitch: { number }, Looped: boolean?,
		}
	},

	CarTiers: { CarTier },
	Turbo: { Multiplier: number, WalkSpeed: number, SprintWalkSpeed: number },
	CarBodies: {
		{
			Name: string,
			Size: Vector3,
			RideHeight: number,
			SpeedBias: number,
			Color: Color3,
			OffRoad: boolean?,
			ClimbAssist: number?,
		}
	},
	Vehicles: { [string]: VehicleSpec },
	MudSpeedFactor: number,

	Pickups: {
		RespawnDelay: number,
		Burger: { DisplayName: string, Duration: number, Color: Color3 },
		Fries: { DisplayName: string, Duration: number, Barrels: number, SpreadDegrees: number, Color: Color3 },
		Shield: { DisplayName: string, Amount: number, Color: Color3 },
		Ammo: { DisplayName: string, Color: Color3 },
		Health: { DisplayName: string, Color: Color3 },
		Invincibility: { DisplayName: string, Duration: number, Color: Color3 },
		PoopAmmo: { DisplayName: string, Color: Color3 },
		DroneAmmo: { DisplayName: string, Color: Color3 },
		Multiplier: { DisplayName: string, Duration: number, Amount: number, Color: Color3 },
	},

	Effects: {
		GagChance: number,
		DeathScreenDuration: number,
		WienerDuration: number,
		Gags: { string },
	},

	Maps: { MapSpec },
	Teams: { { Name: string, Color: BrickColor } },
	DataStoreName: string,
}

return (Config :: any) :: ConfigType
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Remotes — the phone lines between the player's computer and the server.

	The server creates them, the client waits for them. Nothing else in the
	game has to think about it: just `Remotes.Get("FireWeapon")`.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

--[[ Client asks the server to do something. ]]
local EVENT_NAMES = {
	-- Client -> Server
	"FireWeapon",
	"MegaDetonate",
	"EquipWeapon",
	"Reload",
	"RequestVehicle",
	"CastVote",
	"SetAimDirection",
	"SetTurbo",
	"Melee",
	"SetPedal",
	"Eject",

	-- Server -> Client
	"HudUpdate",
	"PlayEffect",
	"MatchState",
	"VoteOptions",
	"DeathScreen",
	"Notify",
	"Hitmarker",
	"Medal",
	"KillFeed",
	"PlaySound",
	"MountedWeaponState",
	-- The scoreboard is pulled, not pushed: streaming everyone's score to
	-- everyone continuously costs bandwidth all match for a panel that is on
	-- screen a few seconds at a time.
	-- Cosmetic only: the shooter already drew their own shot locally, this
	-- tells everybody nearby what it looked like. Cheaper than replicating
	-- the parts, and far less laggy than drawing them server-side.
	-- The hockey fight scene: the server starts one, the client mashes, the
	-- server says who won.
	-- Hockey: possession, shooting, and the fight.
	"HockeyShoot",
	"HockeyChallenge",
	"HockeyPunch",
	"HockeyBlock",
	"HockeyScore",
	"FightUpdate",
	"FightStarted",
	"FightSwing",
	"FightResult",
	-- The sub-games: the menu, the walk-in offer, and joining or leaving one.
	-- The client tells the server it has scoped, so the server can slow the
	-- player down. Movement speed is the server's to set.
	"SetScoped",
	"RequestArcadeMenu",
	"ArcadeMenu",
	"ArcadeOffer",
	"ArcadeJoined",
	"ArcadeLeft",
	"JoinArcade",
	"LeaveArcade",
	"ShotFired",
	"ThrowGrenade",
	"RequestScoreboard",
	"Scoreboard",
}

local FUNCTION_NAMES = {
	"GetArsenal",
	"GetPlayerState",
}

local Remotes = {}

local folder: Folder

if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing and existing:IsA("Folder") then
		folder = existing
	else
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end

	for _, name in EVENT_NAMES do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end

	for _, name in FUNCTION_NAMES do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

--[[ Grab a RemoteEvent by name. Yields on the client until it exists. ]]
function Remotes.Event(name: string): RemoteEvent
	-- No timeout on the client: waiting a moment longer for a remote to
	-- replicate is always better than throwing, because a throw here takes
	-- out whatever was setting up the controls.
	local remote = if RunService:IsServer()
		then folder:FindFirstChild(name)
		else folder:WaitForChild(name)
	assert(remote and remote:IsA("RemoteEvent"), `Remotes: no RemoteEvent named "{name}"`)
	return remote
end

--[[ Grab a RemoteFunction by name. ]]
function Remotes.Function(name: string): RemoteFunction
	local remote = if RunService:IsServer()
		then folder:FindFirstChild(name)
		else folder:WaitForChild(name)
	assert(remote and remote:IsA("RemoteFunction"), `Remotes: no RemoteFunction named "{name}"`)
	return remote
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Shot</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Nuclear Mud Arena — what a shot looks like.

	Draws crisp, fading ballistic tracers, animated muzzle flashes, and
	gravity-affected impact sparks oriented along the true surface normal.
]]

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Shot = {}

local function effectsFolder(): Instance
	local existing = workspace:FindFirstChild("ShotEffects")
	if existing then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = "ShotEffects"
	folder.Parent = workspace
	return folder
end

local function safeLookAt(position: Vector3, target: Vector3): CFrame
	local dir = target - position
	if dir.Magnitude < 1e-4 then
		return CFrame.new(position)
	end
	local unit = dir.Unit
	local up = if math.abs(unit.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
	return CFrame.lookAt(position, target, up)
end

--[[ The bright ballistic streak the bullet leaves, fading out smoothly. ]]
function Shot.Tracer(from: Vector3, to: Vector3, color: Color3)
	local delta = to - from
	local length = delta.Magnitude
	if length < 0.5 or length ~= length then
		return
	end

	local tracer = Instance.new("Part")
	tracer.Name = "Tracer"
	tracer.Size = Vector3.new(0.18, 0.18, length)
	tracer.CFrame = safeLookAt(from + delta * 0.5, to)
	tracer.Color = color
	tracer.Material = Enum.Material.Neon
	tracer.Anchored = true
	tracer.CanCollide = false
	tracer.CanQuery = false
	tracer.CanTouch = false
	tracer.CastShadow = false
	tracer.Transparency = 0.08
	tracer.Parent = effectsFolder()

	TweenService:Create(tracer, TweenInfo.new(0.11, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Transparency = 1,
		Size = Vector3.new(0.04, 0.04, length),
	}):Play()

	Debris:AddItem(tracer, 0.13)
end

--[[ The flash at the muzzle, shrinking and dimming rapidly. ]]
function Shot.MuzzleFlash(position: Vector3, color: Color3)
	local flash = Instance.new("Part")
	flash.Name = "MuzzleFlash"
	flash.Size = Vector3.new(1.3, 1.3, 1.3)
	flash.CFrame = CFrame.new(position)
	flash.Shape = Enum.PartType.Ball
	flash.Color = Color3.fromRGB(255, 236, 176)
	flash.Material = Enum.Material.Neon
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanQuery = false
	flash.CanTouch = false
	flash.CastShadow = false
	flash.Transparency = 0.15
	flash.Parent = effectsFolder()

	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = 5.5
	light.Range = 22
	light.Shadows = false
	light.Parent = flash

	TweenService:Create(flash, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.25, 0.25, 0.25),
		Transparency = 1,
	}):Play()
	TweenService:Create(light, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Brightness = 0,
	}):Play()

	Debris:AddItem(flash, 0.08)
end

--[[ Sparks bursting outward along the surface normal with realistic gravity arc. ]]
function Shot.Impact(position: Vector3, normal: Vector3, color: Color3)
	local n = if normal.Magnitude > 1e-4 then normal.Unit else Vector3.yAxis
	local anchor = Instance.new("Part")
	anchor.Name = "Impact"
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = safeLookAt(position, position + n)
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CastShadow = false
	anchor.Parent = effectsFolder()

	local sparks = Instance.new("ParticleEmitter")
	sparks.EmissionDirection = Enum.NormalId.Front
	sparks.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 248, 220)),
		ColorSequenceKeypoint.new(0.4, color),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 110, 30)),
	})
	sparks.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 0),
	})
	sparks.Lifetime = NumberRange.new(0.1, 0.26)
	sparks.Speed = NumberRange.new(14, 34)
	sparks.SpreadAngle = Vector2.new(42, 42)
	sparks.Acceleration = Vector3.new(0, -45, 0)
	sparks.Drag = 4
	sparks.Rate = 0
	sparks.LightEmission = 1
	sparks.Parent = anchor
	sparks:Emit(10)

	local flash = Instance.new("PointLight")
	flash.Color = color
	flash.Brightness = 3.5
	flash.Range = 12
	flash.Shadows = false
	flash.Parent = anchor
	TweenService:Create(flash, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Brightness = 0,
	}):Play()

	Debris:AddItem(anchor, 0.4)
end

--[[ All three at once, which is what a shot normally wants. ]]
function Shot.Full(origin: Vector3, endPoint: Vector3, color: Color3, normal: Vector3?)
	Shot.MuzzleFlash(origin, color)
	Shot.Tracer(origin, endPoint, color)
	if normal then
		Shot.Impact(endPoint, normal, color)
	end
end

return Shot
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Signal — a tiny "tell me when this happens" helper.

	Roblox has BindableEvents for this, but they copy every argument they pass
	and lose the difference between nil and nothing. Inside one script that is
	pure downside, so server code uses this instead.
]]

export type Callback = (...any) -> ()

export type Signal = {
	--[[ Listen. Returns a function you call to stop listening. ]]
	Connect: (callback: Callback) -> () -> (),
	--[[ Announce, telling every listener in its own thread. ]]
	Fire: (...any) -> (),
	DisconnectAll: () -> (),
}

local Signal = {}

function Signal.new(): Signal
	local callbacks: { Callback } = {}

	local function Connect(callback: Callback): () -> ()
		table.insert(callbacks, callback)
		return function()
			local index = table.find(callbacks, callback)
			if index then
				table.remove(callbacks, index)
			end
		end
	end

	-- Cloned before iterating so a listener that disconnects itself mid-fire
	-- cannot shuffle the list out from under us. Each listener gets its own
	-- thread, so one erroring listener does not stop the rest being told.
	local function Fire(...: any)
		for _, callback in table.clone(callbacks) do
			task.spawn(callback, ...)
		end
	end

	local function DisconnectAll()
		table.clear(callbacks)
	end

	return {
		Connect = Connect,
		Fire = Fire,
		DisconnectAll = DisconnectAll,
	}
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Sound</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Sound — one place that plays everything.

	Two ways to use it:
	  Sound.At(name, position)   a noise somewhere in the world, heard louder
	                             the closer you are to it
	  Sound.Flat(name)           a noise in your ears, for the player it
	                             happened to — hitmarkers, medals, pickups

	Every asset is an rbxasset:// file built into the Roblox client, so none of
	them can fail to load the way a numeric asset ID can. The variety comes
	from pitching the same handful of files differently.
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Sound = {}

local rng = Random.new()

-- Beyond this, you cannot hear it at all.
local WORLD_RANGE = 420

--[[ Build a Sound from a config entry, without playing it. ]]
local function build(name: string): Instance?
	local spec = Config.Sounds[name]
	if not spec then
		-- A typo in a sound name should not take down whatever was happening.
		warn(`Sound: no such sound "{name}"`)
		return nil
	end

	local sound = Instance.new("Sound")
	sound.Name = `Sound_{name}`
	sound.SoundId = spec.Asset
	sound.Volume = spec.Volume
	sound.PlaybackSpeed = rng:NextNumber(spec.Pitch[1], spec.Pitch[2] or spec.Pitch[1])
	sound.Looped = spec.Looped == true
	sound.RollOffMaxDistance = WORLD_RANGE
	sound.RollOffMinDistance = 12
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	return sound
end

--[[
	A noise at a place in the world.

	The Sound hangs on a tiny invisible anchor part, because a Sound only
	plays positionally when it has a part to play from, and the anchor is
	cleaned up a few seconds later.
]]
function Sound.At(name: string, position: Vector3, volumeScale: number?)
	local sound = build(name)
	if not sound then
		return
	end
	local real = sound :: Sound

	if volumeScale then
		real.Volume *= volumeScale
	end

	local anchor = Instance.new("Part")
	anchor.Name = "SoundAnchor"
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(position)
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Parent = workspace

	real.Parent = anchor
	real:Play()

	Debris:AddItem(anchor, 6)
end

--[[
	A noise in one player's ears, with no position at all.

	Client only — on the server there is nobody to hear it.
]]
function Sound.Flat(name: string, volumeScale: number?)
	if not RunService:IsClient() then
		return
	end
	local sound = build(name)
	if not sound then
		return
	end
	local real = sound :: Sound

	if volumeScale then
		real.Volume *= volumeScale
	end
	real.RollOffMaxDistance = 1
	real.Parent = SoundService
	real:Play()

	Debris:AddItem(real, 6)
end

--[[
	A looping sound attached to something that moves — an engine, mostly.

	Returns the Sound so the caller can change its pitch as the thing speeds
	up, or stop it when the thing is switched off.
]]
function Sound.Attach(name: string, to: BasePart): Sound?
	local sound = build(name)
	if not sound then
		return nil
	end
	local real = sound :: Sound
	real.Parent = to
	return real
end

--[[ Which gunshot a weapon should make, from its category. ]]
function Sound.ForWeapon(spec: Config.WeaponSpec): string
	if spec.CanMegaDetonate then
		return "ShotDiamond"
	end
	local category = spec.Category
	if category == "Sniper" then
		return "ShotSniper"
	elseif category == "Shotgun" then
		return "ShotShotgun"
	elseif category == "Explosive" then
		return "ShotLaunch"
	elseif category == "Sidearm" then
		return "ShotLight"
	elseif category == "Utility" then
		return "ShotLaunch"
	end
	return "ShotHeavy"
end

return Sound
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Util — small helpers used all over the place. Nothing clever, just the
	boring code written once instead of forty times.
]]

local Util = {}

--[[
	Make a part in one call instead of eight lines.
	Anchored and collidable by default, because that is what map pieces want.
]]
function Util.Part(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "Parent" then
			(part :: any)[key] = value
		end
	end
	-- Parent last so the part is fully built before it hits the world.
	if props.Parent then
		part.Parent = props.Parent
	end
	return part
end

--[[ Glue two parts together so they move as one lump. ]]
function Util.Weld(a: BasePart, b: BasePart): WeldConstraint
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = a
	weld.Part1 = b
	weld.Parent = a
	return weld
end

--[[ An attachment at a spot on a part, in that part's own local space. ]]
function Util.Attachment(parent: BasePart, offset: Vector3, name: string?): Attachment
	local attachment = Instance.new("Attachment")
	attachment.Name = name or "Attachment"
	attachment.Position = offset
	attachment.Parent = parent
	return attachment
end

--[[ Raycast settings that ignore a list of things (usually you and your car). ]]
function Util.RayParams(ignore: { Instance }): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = true
	return params
end

--[[ Safe CFrame.lookAt that avoids collinearity NaN when aiming straight up or down. ]]
function Util.LookAt(position: Vector3, target: Vector3): CFrame
	local delta = target - position
	if delta.Magnitude < 1e-4 then
		return CFrame.new(position)
	end
	local unit = delta.Unit
	local up = if math.abs(unit.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
	return CFrame.lookAt(position, target, up)
end

--[[ Nudge a direction off-course by up to `degrees` in a circular cone. ]]
function Util.ApplySpread(direction: Vector3, degrees: number, rng: Random): Vector3
	if direction.Magnitude < 1e-4 then
		return Vector3.new(0, 0, -1)
	end
	local unit = direction.Unit
	if degrees <= 0 then
		return unit
	end
	local maxRad = math.rad(degrees)
	local angle = rng:NextNumber(0, math.pi * 2)
	local radius = math.sqrt(rng:NextNumber()) * maxRad
	local pitch = math.sin(angle) * radius
	local yaw = math.cos(angle) * radius
	return (Util.LookAt(Vector3.zero, unit) * CFrame.Angles(pitch, yaw, 0)).LookVector
end

--[[ The angle between two directions, in degrees. Used by auto-aim. ]]
--[[
	Is this a Vector3 a server can safely do arithmetic with?

	Every remote handler that takes a direction used to guard with
	`typeof(v) ~= "Vector3"` and `v.Magnitude < 0.001`. Neither one rejects
	NaN, because **every comparison involving NaN is false** -- so
	`Vector3.new(0/0, 0/0, 0/0)` passed both tests, and `.Unit` stayed NaN,
	and the NaN went on into CFrame.lookAt, workspace:Raycast and projectile
	positions. A hostile client could send one from a console.

	A finite check has to be written as its own test, not as a comparison:
	`value ~= value` is the only thing that catches NaN, and infinity has to
	be excluded separately.
]]
local function finite(value: number): boolean
	return value == value and value > -math.huge and value < math.huge
end

function Util.IsSaneVector(value: any): boolean
	if typeof(value) ~= "Vector3" then
		return false
	end
	local vector = value :: Vector3
	if not (finite(vector.X) and finite(vector.Y) and finite(vector.Z)) then
		return false
	end
	-- Nothing legitimate is this far out, and a huge-but-finite vector is
	-- just as good a way to break downstream maths as an infinite one.
	return vector.Magnitude < 1e6
end

--[[
	A direction a server can trust: sane, and long enough to normalise.

	Returns the unit vector, or nil. Returning the normalised value rather
	than a boolean means a caller cannot forget to normalise it afterwards.
]]
function Util.SaneDirection(value: any): Vector3?
	if not Util.IsSaneVector(value) then
		return nil
	end
	local vector = value :: Vector3
	if vector.Magnitude < 0.001 then
		return nil
	end
	return vector.Unit
end

function Util.AngleBetween(a: Vector3, b: Vector3): number
	if not Util.IsSaneVector(a) or not Util.IsSaneVector(b) then
		return 180
	end
	local aMag, bMag = a.Magnitude, b.Magnitude
	if not (aMag > 0 and bMag > 0) then
		return 180
	end
	local dot = math.clamp(a.Unit:Dot(b.Unit), -1, 1)
	return math.deg(math.acos(dot))
end

--[[ The Humanoid and root part of whatever a raycast hit, if it was a player. ]]
function Util.HumanoidFromHit(hit: BasePart?): (Humanoid?, Model?)
	if not hit then
		return nil, nil
	end
	local model = hit:FindFirstAncestorOfClass("Model")
	while model do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			return humanoid, model
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil, nil
end

--[[ Clean something up after a delay without leaking a thread if it dies first. ]]
function Util.DestroyAfter(instance: Instance, seconds: number)
	task.delay(seconds, function()
		if instance and instance.Parent then
			instance:Destroy()
		end
	end)
end

--[[ A flat random point inside a square centred on the origin. ]]
function Util.RandomFlatPoint(halfSize: number, rng: Random): Vector3
	return Vector3.new(rng:NextNumber(-halfSize, halfSize), 0, rng:NextNumber(-halfSize, halfSize))
end

--[[ Seconds as M:SS, for the round clock. ]]
function Util.FormatClock(seconds: number): string
	local whole = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", whole // 60, whole % 60)
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="10">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="11">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	Nuclear Mud Arena — server start-up.

	This is the only Script on the server. Everything else is a module it turns
	on.

	IT IS WRITTEN DEFENSIVELY ON PURPOSE.

	The first version of this file required every module at the top and started
	them in a row. One of those modules asked Roblox for a DataStore while it
	was loading, and Roblox Studio refuses DataStore access in a place that has
	never been published. That refusal killed this script before it reached the
	line that builds the arena — so the game opened to an empty sky and players
	fell forever with no clue why.

	So now: ground exists before anything that can fail is even touched, and
	every subsystem starts inside its own pcall. A broken subsystem costs you
	that subsystem and prints a clear reason. It can never again cost you the
	whole world.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ======================================================= 1. GROUND, ALWAYS ==
--[[
	Built with nothing but Instance.new, before a single require runs, so there
	is no possible failure between opening the place and having a floor.

	It is thrown away the moment the real arena is standing.
]]
local function buildFallbackGround(): Model
	local holder = Instance.new("Model")
	holder.Name = "FallbackGround"

	local floor = Instance.new("Part")
	floor.Name = "Baseplate"
	floor.Size = Vector3.new(2048, 20, 2048)
	floor.CFrame = CFrame.new(0, -10, 0)
	floor.Anchored = true
	floor.Color = Color3.fromRGB(70, 78, 70)
	floor.Material = Enum.Material.Grass
	floor.TopSurface = Enum.SurfaceType.Smooth
	floor.Parent = holder

	local pad = Instance.new("SpawnLocation")
	pad.Name = "FallbackSpawn"
	pad.Size = Vector3.new(24, 1, 24)
	pad.CFrame = CFrame.new(0, 1, 0)
	pad.Anchored = true
	pad.Neutral = true
	pad.Duration = 0
	pad.BrickColor = BrickColor.new("Bright yellow")
	pad.Material = Enum.Material.Neon
	pad.Parent = holder

	holder.Parent = workspace
	return holder
end

local fallbackGround = buildFallbackGround()
print("[Nuclear Mud Arena] Fallback ground placed. You will never fall into the void.")

-- ==================================================== 2. START SUBSYSTEMS ==

local modules = script:WaitForChild("modules")
local Shared = ReplicatedStorage:WaitForChild("Shared")

--[[ Load a module without letting a bad one take the server with it. ]]
local function tryRequire(container: Instance, name: string): any
	local child = container:FindFirstChild(name)
	if not child then
		warn(`[Nuclear Mud Arena] Missing module: {name}`)
		return nil
	end
	local ok, result = pcall(require, child)
	if not ok then
		warn(`[Nuclear Mud Arena] Module "{name}" failed to load: {result}`)
		return nil
	end
	return result
end

--[[ Start one subsystem, reporting rather than exploding. ]]
local function tryStart(name: string, service: any)
	if not service or typeof(service.Start) ~= "function" then
		return
	end
	local ok, err = pcall(service.Start)
	if not ok then
		warn(`[Nuclear Mud Arena] "{name}" failed to start: {err}`)
	end
end

local Config = tryRequire(Shared, "Config")
-- Creating the remotes early matters: the client is already waiting on them.
tryRequire(Shared, "Remotes")

local PlayerState = tryRequire(modules, "PlayerState")
local TeamService = tryRequire(modules, "TeamService")
local WeaponService = tryRequire(modules, "WeaponService")
local MonetizationService = tryRequire(modules, "MonetizationService")
local MatchService = tryRequire(modules, "MatchService")
local GraphicsService = tryRequire(modules, "GraphicsService")
local ScoreboardService = tryRequire(modules, "ScoreboardService")
local HockeyService = tryRequire(modules, "HockeyService")
local BotService = tryRequire(modules, "BotService")
local ArcadeService = tryRequire(modules, "ArcadeService")

tryStart("GraphicsService", GraphicsService)
tryStart("TeamService", TeamService)
tryStart("WeaponService", WeaponService)
tryStart("MonetizationService", MonetizationService)
tryStart("ScoreboardService", ScoreboardService)
tryStart("HockeyService", HockeyService)
tryStart("BotService", BotService)
tryStart("ArcadeService", ArcadeService)
tryStart("MatchService", MatchService)

-- ========================================================= 3. THE HUD FEED ==

local Remotes = tryRequire(Shared, "Remotes")

if Remotes and Config and PlayerState then
	--[[
		Everything one player's screen needs to draw itself, built in one place
		so the pushed update and the asked-for update cannot disagree.
	]]
	local function describe(player: Player)
		local state = PlayerState.Get(player)

		-- The gun in their hands might be a mounted one they are sitting behind.
		local equipped = state.equipped
		if state.vehicle and state.vehicle.Parent then
			local mounted = state.vehicle:GetAttribute("MountedWeapon")
			local isGunner = state.seatRole == "Gunner"
			local isPilot = state.seatRole == "Driver"
				and state.vehicle:GetAttribute("VehicleKind") == "Plane"
			if typeof(mounted) == "string" and (isGunner or isPilot) then
				equipped = mounted
			end
		end

		local spec = Config.Weapons[equipped]
		local slot = state.weapons[equipped]

		return {
			shield = state.shield,
			maxShield = state.maxShield,
			keys = state.keys,
			carTier = state.carTier,
			carTierName = Config.CarTiers[math.clamp(state.carTier, 1, #Config.CarTiers)].Name,
			megaCharges = state.megaCharges,
			kills = state.kills,
			deaths = state.deaths,

			equipped = equipped,
			weaponName = if spec then spec.DisplayName else equipped,
			ammo = if slot then slot.ammo else 0,
			magSize = if spec then spec.MagSize else 0,
			reloading = if slot then slot.reloadingUntil > os.clock() else false,
		}
	end

	-- Push a fresh HUD when something actually changes, rather than having
	-- every client ask twenty times a second.
	PlayerState.Changed.Connect(function(player: Player)
		if player and player.Parent then
			Remotes.Event("HudUpdate"):FireClient(player, describe(player))
		end
	end)

	-- Still answer a direct ask, for a client that has just loaded in.
	Remotes.Function("GetPlayerState").OnServerInvoke = function(player)
		return describe(player)
	end
end

-- ================================================= 4. CLEAR THE SCAFFOLDING ==

--[[
	Once the real arena is up, the fallback is just a giant plate in the way.
	If the arena never appears, the fallback stays and the warnings above tell
	you why — which is a bad game, but a visible one.
]]
task.spawn(function()
	for _ = 1, 60 do
		if workspace:FindFirstChild("Arena") then
			fallbackGround:Destroy()
			print("[Nuclear Mud Arena] Arena is up. Fallback ground removed.")

			-- Anyone who spawned on the fallback needs moving onto the map.
			for _, player in Players:GetPlayers() do
				if player.Character then
					player:LoadCharacterAsync()
				end
			end
			return
		end
		task.wait(0.5)
	end
	warn("[Nuclear Mud Arena] No arena appeared after 30s. Keeping fallback ground.")
	warn("[Nuclear Mud Arena] Look for a red error above this line — that is the cause.")
end)

if Config and Config.FreeMode then
	print("[Nuclear Mud Arena] FREE MODE — every weapon and vehicle is unlocked.")
end
print("[Nuclear Mud Arena] Server ready.")
]]></string>
      </Properties>
      <Item class="Folder" referent="12">
        <Properties>
          <string name="Name">modules</string>
        </Properties>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">ArcadeService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Nuclear Mud Arena — the sub-games.

	The game is a shooter with sports scattered through it, and the problem
	with scattering sports through a 2000-stud map is that nobody finds them.
	This is the fix, and it works two ways on purpose:

	  1. Press the menu key anywhere and pick a game. You are taken straight
	     there. Nobody should have to walk across a map to find out what is
	     in the corner of it.
	  2. Walk into a venue and it asks whether you want to play. If you say
	     yes you are put on a side and the game starts.

	Either way the roster is filled out with bots up to full teams, so a game
	is never short. Real players take the empty slots first and bots only
	make up the difference -- which is what "computer players play when there
	aren't other online people" has to mean in practice.

	And you keep your guns the whole time. That is the rule.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Signal = require(Shared:WaitForChild("Signal"))
local Sound = require(Shared:WaitForChild("Sound"))

local BotService = require(script.Parent:WaitForChild("BotService"))
local TeamService = require(script.Parent:WaitForChild("TeamService"))

local ArcadeService = {}

--[[ Fired as (player, gameId) when somebody joins a sub-game. ]]
ArcadeService.Joined = Signal.new()

export type VenueInfo = {
	id: string,
	name: string,
	-- One line, shown on screen when you join. This is the whole of the
	-- game's instructions and it has to fit on one line.
	objective: string,
	-- Where the game is played, set when the map is built.
	centre: Vector3,
	-- Where a joining player is put down.
	spawns: { Vector3 },
	-- How many on each side for a full game.
	perTeam: number,
	-- Does it have sides at all? Bowling does not.
	teamed: boolean,
}

local venues: { [string]: VenueInfo } = {}
local order: { string } = {}

-- Who is in which game, and which side they are on.
local membership: { [Player]: { venue: string, team: number } } = {}

-- Which venues have been filled out with bots.
local staffed: { [string]: boolean } = {}

--[[
	Declare a venue.

	Called by whichever service builds the place, so the geometry and the
	game rules stay together and this module never has to know what a rink
	looks like.
]]
function ArcadeService.Register(info: VenueInfo)
	if not venues[info.id] then
		table.insert(order, info.id)
	end
	venues[info.id] = info
end

function ArcadeService.Clear()
	table.clear(venues)
	table.clear(order)
	table.clear(membership)
	table.clear(staffed)
	BotService.Clear(nil)
end

--[[ The list a player sees in the menu. ]]
function ArcadeService.Menu(): { { id: string, name: string, objective: string, players: number } }
	local out = {}
	for _, id in order do
		local info = venues[id]
		if not info then
			continue
		end
		local count = 0
		for _, where in membership do
			if where.venue == id then
				count += 1
			end
		end
		table.insert(out, {
			id = id,
			name = info.name,
			objective = info.objective,
			players = count,
		})
	end
	return out
end

--[[
	How many real players are on each side of a venue right now.
]]
local function humanCount(venueId: string): { [number]: number }
	local counts = { [1] = 0, [2] = 0 }
	for player, where in membership do
		if where.venue == venueId and player.Parent then
			counts[where.team] = (counts[where.team] or 0) + 1
		end
	end
	return counts
end

--[[
	Fill a venue out to full teams with bots.

	Real players first: bots only ever make up the difference, and they are
	topped up again whenever somebody joins or leaves, so a game is always
	full and never over-full.
]]
function ArcadeService.Staff(venueId: string)
	local info = venues[venueId]
	if not info then
		return
	end

	local humans = humanCount(venueId)
	BotService.Clear(venueId)

	if not info.teamed then
		-- A solo game: a couple of others milling about, for company and for
		-- something to shoot at.
		for index = 1, math.max(0, info.perTeam - (humans[1] + humans[2])) do
			local spot = info.spawns[((index - 1) % #info.spawns) + 1]
			BotService.Spawn(venueId, 1, "bystander", spot)
		end
		staffed[venueId] = true
		return
	end

	for team = 1, 2 do
		local wanted = info.perTeam - (humans[team] or 0)
		for index = 1, math.max(0, wanted) do
			-- Spread them along the venue's spawn points rather than
			-- stacking them all on one.
			local base = info.spawns[((index + team) % #info.spawns) + 1]
			local spot = base + Vector3.new(
				(index - 1) * 8 - 12,
				0,
				if team == 1 then -14 else 14
			)
			BotService.Spawn(venueId, team, "player", spot)
		end
	end
	staffed[venueId] = true
end

--[[ Put a player into a game. ]]
function ArcadeService.Join(player: Player, venueId: string): boolean
	local info = venues[venueId]
	if not info then
		return false
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return false
	end

	-- The smaller side, so joining never makes a game more lopsided. On an
	-- empty venue this puts you opposite the bots rather than among them.
	local humans = humanCount(venueId)
	local side = if (humans[1] or 0) <= (humans[2] or 0) then 1 else 2
	if not info.teamed then
		side = TeamService.IndexOf(player)
	end

	membership[player] = { venue = venueId, team = side }

	-- Stood on the venue's own spawn rather than wherever you pressed the
	-- key, because the point of the menu is not having to walk.
	local spot = info.spawns[math.random(1, math.max(1, #info.spawns))]
	root.CFrame = CFrame.new(spot + Vector3.new(0, 6, 0))

	ArcadeService.Staff(venueId)

	Remotes.Event("ArcadeJoined"):FireClient(player, {
		id = info.id,
		name = info.name,
		objective = info.objective,
		team = side,
	})
	Remotes.Event("PlaySound"):FireClient(player, "Medal")

	ArcadeService.Joined.Fire(player, venueId)
	return true
end

--[[ Take a player out of whatever game they were in. ]]
function ArcadeService.Leave(player: Player)
	local where = membership[player]
	if not where then
		return
	end
	membership[player] = nil
	-- Re-staff, so the side they left does not play a man down.
	ArcadeService.Staff(where.venue)
	Remotes.Event("ArcadeLeft"):FireClient(player, { id = where.venue })
end

--[[ Which game a player is in, if any. ]]
function ArcadeService.VenueOf(player: Player): string?
	local where = membership[player]
	return if where then where.venue else nil
end

--[[ Which side a player is on inside their sub-game. ]]
function ArcadeService.SideOf(player: Player): number?
	local where = membership[player]
	return if where then where.team else nil
end

--[[
	Offer a game to anybody who wanders into a venue.

	Checked a few times a second rather than with a Touched event on a huge
	invisible part, because a trigger volume the size of a rink fires
	constantly for every bullet, every car and every bot that crosses it.
]]
local lastSweep = 0
local offered: { [Player]: { [string]: number } } = {}

local function sweep()
	local now = os.clock()
	if now - lastSweep < 0.4 then
		return
	end
	lastSweep = now

	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
			continue
		end

		local here = root.Position
		local inside: string? = nil
		for _, id in order do
			local info = venues[id]
			if info and (Vector3.new(here.X, 0, here.Z) - Vector3.new(info.centre.X, 0, info.centre.Z)).Magnitude
				< Config.Arcade.OfferRadius
			then
				inside = id
				break
			end
		end

		-- Walked out of everything: drop out of whatever they were in.
		if not inside then
			if membership[player] then
				ArcadeService.Leave(player)
			end
			continue
		end

		-- Already playing this one, nothing to ask.
		if membership[player] and membership[player].venue == inside then
			continue
		end

		-- Ask, but not over and over.
		local seen = offered[player]
		if not seen then
			seen = {}
			offered[player] = seen
		end
		if now - (seen[inside] or 0) < Config.Arcade.ReofferSeconds then
			continue
		end
		seen[inside] = now

		local info = venues[inside]
		if info then
			Remotes.Event("ArcadeOffer"):FireClient(player, {
				id = info.id,
				name = info.name,
				objective = info.objective,
			})
		end
	end
end

function ArcadeService.Start()
	Remotes.Event("RequestArcadeMenu").OnServerEvent:Connect(function(player: Player)
		Remotes.Event("ArcadeMenu"):FireClient(player, { games = ArcadeService.Menu() })
	end)

	Remotes.Event("JoinArcade").OnServerEvent:Connect(function(player: Player, venueId: any)
		if typeof(venueId) ~= "string" then
			return
		end
		ArcadeService.Join(player, venueId)
	end)

	Remotes.Event("LeaveArcade").OnServerEvent:Connect(function(player: Player)
		ArcadeService.Leave(player)
	end)

	RunService.Heartbeat:Connect(sweep)

	Players.PlayerRemoving:Connect(function(player)
		local where = membership[player]
		membership[player] = nil
		offered[player] = nil
		if where then
			ArcadeService.Staff(where.venue)
		end
	end)

	local _ = Sound
end

--[[ Run one offer sweep, for tests. ]]
function ArcadeService.SweepForTests()
	lastSweep = 0
	sweep()
end

return ArcadeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">BotService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Nuclear Mud Arena — the bots.

	Computer players, so that walking into the rink or up to the ski lift is
	never a disappointment. A venue with nobody in it is worse than no venue
	at all, and on a quiet server that is every venue.

	They are not real Players -- Roblox has no way to fake one -- so they are
	models with a Humanoid, a team number in an attribute, and a brain the
	venue drives. That means every piece of code that asks
	`Players:GetPlayerFromCharacter` gets nil for a bot, which is why hits on
	them are routed through BotService.RegisterHit the same way the zombies
	and the carnival props are.

	They are also shootable, killable, and worth points, because the rule
	here is that you can shoot anybody at any time -- including the goalie.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Signal = require(Shared:WaitForChild("Signal"))
local Sound = require(Shared:WaitForChild("Sound"))
local Util = require(Shared:WaitForChild("Util"))

local PlayerState = require(script.Parent:WaitForChild("PlayerState"))

local BotService = {}

--[[ Fired as (bot, killer) when a bot is killed. ]]
BotService.Killed = Signal.new()

export type Bot = {
	model: Model,
	humanoid: Humanoid,
	root: BasePart,
	name: string,
	team: number,
	-- Which venue owns it, so a venue can clean up only its own.
	venue: string,
	role: string,
	health: number,
	maxHealth: number,
	dead: boolean,
	-- Where the brain currently wants to be.
	goal: Vector3?,
	-- Simple combat: bots shoot back.
	nextShotAt: number,
	homeAt: Vector3,
}

local bots: { Bot } = {}

local FIRST_NAMES = {
	"Dale", "Cletus", "Darla", "Roscoe", "Bobbi", "Earl", "Junior", "Maybelle",
	"Tucker", "Shelby", "Gator", "Peaches", "Buford", "Luanne", "Hoyt", "Dixie",
}

local nextBotNumber = 0

local function botName(): string
	nextBotNumber += 1
	local first = FIRST_NAMES[((nextBotNumber - 1) % #FIRST_NAMES) + 1]
	return `{first} (CPU)`
end

--[[
	A body with a Humanoid, so Roblox's own walking does the hard part.

	Using a real Humanoid rather than moving a part by hand means they walk
	round obstacles, climb the stairs, fall off things and ragdoll when they
	die, all for free.
]]
local function buildBody(name: string, team: number, position: Vector3): (Model, Humanoid, BasePart)
	-- Config.Teams stores a BrickColor, which carries the Color3 in .Color.
	local brick = Config.Teams[team] and Config.Teams[team].Color
	local colour = if brick then brick.Color else Color3.fromRGB(180, 180, 190)

	local model = Instance.new("Model")
	model.Name = name

	local root = Util.Part({
		Name = "HumanoidRootPart",
		Size = Vector3.new(2, 2, 1),
		CFrame = CFrame.new(position + Vector3.new(0, 3, 0)),
		Transparency = 1,
		Anchored = false,
		Parent = model,
	})
	model.PrimaryPart = root

	local torso = Util.Part({
		Name = "Torso",
		Size = Vector3.new(2.6, 3.4, 1.5),
		CFrame = root.CFrame,
		Color = colour,
		Material = Enum.Material.Fabric,
		Anchored = false,
		Parent = model,
	})
	Util.Weld(root, torso)

	local head = Util.Part({
		Name = "Head",
		Size = Vector3.new(1.7, 1.7, 1.7),
		CFrame = torso.CFrame * CFrame.new(0, 2.6, 0),
		Color = Color3.fromRGB(226, 192, 150),
		Material = Enum.Material.SmoothPlastic,
		Anchored = false,
		Parent = model,
	})
	Util.Weld(torso, head)

	for _, side in { -1, 1 } do
		local arm = Util.Part({
			Name = "Arm",
			Size = Vector3.new(0.9, 3.2, 0.9),
			CFrame = torso.CFrame * CFrame.new(side * 1.75, 0, 0),
			Color = Color3.fromRGB(226, 192, 150),
			Material = Enum.Material.SmoothPlastic,
			Anchored = false,
			Parent = model,
		})
		Util.Weld(torso, arm)

		local leg = Util.Part({
			Name = "Leg",
			Size = Vector3.new(1, 3, 1),
			CFrame = torso.CFrame * CFrame.new(side * 0.7, -3.2, 0),
			Color = Color3.fromRGB(60, 72, 110),
			Material = Enum.Material.Fabric,
			Anchored = false,
			Parent = model,
		})
		Util.Weld(torso, leg)
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.WalkSpeed = Config.Bots.WalkSpeed
	humanoid.MaxHealth = Config.Bots.Health
	humanoid.Health = Config.Bots.Health
	humanoid.Parent = model

	-- A name tag, in team colour, so you can tell friend from foe at a
	-- glance and tell a bot from a player at all.
	local tag = Instance.new("BillboardGui")
	tag.Name = "BotTag"
	tag.Size = UDim2.fromOffset(190, 22)
	tag.StudsOffset = Vector3.new(0, 3.4, 0)
	tag.MaxDistance = 220
	tag.Adornee = head
	tag.Parent = head

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = name
	label.TextColor3 = colour
	label.TextStrokeTransparency = 0.4
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = tag

	model.Parent = workspace
	return model, humanoid, root
end

--[[ Put a bot on the field. ]]
function BotService.Spawn(venue: string, team: number, role: string, position: Vector3): Bot
	local name = botName()
	local model, humanoid, root = buildBody(name, team, position)

	model:SetAttribute("Bot", true)
	model:SetAttribute("BotTeam", team)

	local bot: Bot = {
		model = model,
		humanoid = humanoid,
		root = root,
		name = name,
		team = team,
		venue = venue,
		role = role,
		health = Config.Bots.Health,
		maxHealth = Config.Bots.Health,
		dead = false,
		goal = nil,
		nextShotAt = 0,
		homeAt = position,
	}
	table.insert(bots, bot)
	return bot
end

--[[ Every bot still standing in a given venue. ]]
function BotService.InVenue(venue: string): { Bot }
	local out: { Bot } = {}
	for _, bot in bots do
		if bot.venue == venue and not bot.dead then
			table.insert(out, bot)
		end
	end
	return out
end

function BotService.Count(): number
	local total = 0
	for _, bot in bots do
		if not bot.dead then
			total += 1
		end
	end
	return total
end

--[[ Clear out a venue's bots, or all of them. ]]
function BotService.Clear(venue: string?)
	for index = #bots, 1, -1 do
		local bot = bots[index]
		if venue == nil or bot.venue == venue then
			if bot.model.Parent then
				bot.model:Destroy()
			end
			table.remove(bots, index)
		end
	end
end

--[[ The bot a part belongs to, if any. ]]
local function botFromPart(part: BasePart): Bot?
	local model = part:FindFirstAncestorOfClass("Model")
	if not model then
		return nil
	end
	for _, bot in bots do
		if bot.model == model then
			return bot
		end
	end
	return nil
end

--[[
	A shot hit a bot.

	Routed the same way the zombies and the fairground props are, because a
	bot is not a Player and so every normal damage path misses it.
]]
function BotService.RegisterHit(part: BasePart, damage: number, attacker: Player?): boolean
	local bot = botFromPart(part)
	if not bot or bot.dead then
		return false
	end

	-- Headshots count on bots too, or sniping them would feel wrong.
	local hit = if part.Name == "Head" then damage * Config.Movement.HeadshotMultiplier else damage
	bot.health -= hit
	bot.humanoid.Health = math.max(0, bot.health)
	Sound.At("Hitmarker", part.Position, 0.6)

	if bot.health > 0 then
		return true
	end

	bot.dead = true
	bot.humanoid.Health = 0

	if attacker then
		PlayerState.AwardPoints(attacker, Config.Bots.Points)
	end
	BotService.Killed.Fire(bot, attacker)

	-- Gone after a moment, then back where it started, so a venue stays
	-- populated for whoever is still playing.
	local model = bot.model
	task.delay(Config.Bots.RespawnDelay, function()
		if model.Parent then
			model:Destroy()
		end
		-- Only bring it back if its venue is still running.
		local stillWanted = false
		for _, other in bots do
			if other == bot then
				stillWanted = true
				break
			end
		end
		if not stillWanted then
			return
		end

		local fresh, humanoid, root = buildBody(bot.name, bot.team, bot.homeAt)
		fresh:SetAttribute("Bot", true)
		fresh:SetAttribute("BotTeam", bot.team)
		bot.model = fresh
		bot.humanoid = humanoid
		bot.root = root
		bot.health = bot.maxHealth
		bot.dead = false
	end)

	return true
end

--[[ Is this part a bot? Used by the aim assist, which must not lock onto one
     of your own side. ]]
function BotService.TeamOf(part: BasePart): number?
	local bot = botFromPart(part)
	return if bot then bot.team else nil
end

-- =================================================================== BRAINS ==

--[[
	Walk somewhere, using the Humanoid's own pathing.

	MoveTo rather than setting a velocity: it steps up kerbs, round walls and
	up the stairs for free, and it looks like walking because it is.
]]
function BotService.WalkTo(bot: Bot, goal: Vector3)
	bot.goal = goal
	if not bot.dead and bot.humanoid.Parent then
		bot.humanoid:MoveTo(goal)
	end
end

--[[ The nearest living player not on this bot's team. ]]
function BotService.NearestEnemy(bot: Bot, within: number): (Player?, Vector3?)
	local best: Player? = nil
	local bestPosition: Vector3? = nil
	local bestDistance = within

	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
			continue
		end
		-- A bot's team is a number; a player's is a Team object. Compare
		-- through TeamService's index rather than the objects.
		local distance = (root.Position - bot.root.Position).Magnitude
		if distance < bestDistance then
			best, bestPosition, bestDistance = player, root.Position, distance
		end
	end

	return best, bestPosition
end

local lastStep = 0

--[[
	One tick of bot upkeep.

	Deliberately slow -- a few times a second, not sixty. A bot deciding
	where to walk four times a second is indistinguishable from one deciding
	sixty times a second, and twenty bots doing it sixty times a second is
	the sort of thing that quietly eats a server.
]]
local function step()
	local now = os.clock()
	if now - lastStep < Config.Bots.ThinkInterval then
		return
	end
	lastStep = now

	for index = #bots, 1, -1 do
		local bot = bots[index]
		if not bot.model.Parent then
			table.remove(bots, index)
			continue
		end
		if bot.dead then
			continue
		end

		-- Keep walking toward whatever the venue last asked for. The venue
		-- brains set the goal; this just makes sure a bot that has stopped
		-- short of it starts again.
		local goal = bot.goal
		if goal then
			local flat = Vector3.new(goal.X - bot.root.Position.X, 0, goal.Z - bot.root.Position.Z)
			if flat.Magnitude > 6 then
				bot.humanoid:MoveTo(goal)
			end
		end
	end
end

function BotService.Start()
	RunService.Heartbeat:Connect(step)
end

--[[ One tick, for tests. ]]
function BotService.StepForTests()
	lastStep = 0
	step()
end

return BotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">CarnivalService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CarnivalService — the fairground.

	A corner of every map is given over to things that are not trying to kill
	you: a dunk tank, a shooting gallery with ducks that slide back and forth,
	and a high striker with a bell on top.

	All of it scores points, so messing about is not entirely wasted time.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Sound = require(Shared:WaitForChild("Sound"))
local Util = require(Shared:WaitForChild("Util"))
local ArcadeService = require(script.Parent:WaitForChild("ArcadeService"))

local PlayerState = require(script.Parent:WaitForChild("PlayerState"))

local CarnivalService = {}

local container: Folder? = nil
local origin = Vector3.zero

type Duck = {
	part: BasePart,
	centre: Vector3,
	span: number,
	speed: number,
	phase: number,
	downUntil: number,
}

local ducks: { Duck } = {}
local dunkSeat: Seat? = nil
local dunkHome: CFrame = CFrame.identity
local dunkWetUntil = 0
local strikerPuck: BasePart? = nil
local strikerUntil = 0

local rng = Random.new()

local DUNK_POINTS = 60
local DUCK_POINTS = 20
local STRIKER_POINTS = 35

-- ================================================================= HELPERS ==

-- Who last fired the cannon, so a flattened stack has somebody to pay, and
-- when it may be fired again.
local lastCannonFirer: Player? = nil
local nextCannonAt = 0

local function award(player: Player?, points: number, message: string)
	if not player then
		return
	end
	local earned = PlayerState.AwardPoints(player, points)
	Remotes.Event("Notify"):FireClient(player, `{message} +{earned}`)
end

local function sign(parent: Instance, position: Vector3, text: string, colour: Color3)
	local post = Util.Part({
		Name = "SignPost",
		Size = Vector3.new(1, 14, 1),
		CFrame = CFrame.new(position + Vector3.new(0, 7, 0)),
		Color = Color3.fromRGB(120, 90, 60),
		Material = Enum.Material.Wood,
		Parent = parent,
	})

	local board = Util.Part({
		Name = "SignBoard",
		Size = Vector3.new(18, 5, 0.6),
		CFrame = CFrame.new(position + Vector3.new(0, 16, 0)),
		Color = colour,
		Material = Enum.Material.SmoothPlastic,
		Parent = parent,
	})
	Util.Weld(post, board)

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(18, 5)
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = 600
	billboard.Parent = board

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(30, 26, 24)
	label.TextScaled = true
	label.Font = Enum.Font.LuckiestGuy
	label.Parent = billboard
end

-- =============================================================== DUNK TANK ==

--[[
	The dunk tank: a seat on a plank over a tank of water, and a target on a
	post beside it. Hit the target and the seat gives way.
]]
local function buildDunkTank(at: Vector3, parent: Instance)
	-- The tank.
	Util.Part({
		Name = "TankWall",
		Size = Vector3.new(26, 14, 1.5),
		CFrame = CFrame.new(at + Vector3.new(0, 7, 13)),
		Color = Color3.fromRGB(150, 160, 170),
		Material = Enum.Material.Glass,
		Transparency = 0.55,
		Parent = parent,
	})
	for _, side in { -1, 1 } do
		Util.Part({
			Name = "TankWall",
			Size = Vector3.new(1.5, 14, 26),
			CFrame = CFrame.new(at + Vector3.new(side * 13, 7, 0)),
			Color = Color3.fromRGB(150, 160, 170),
			Material = Enum.Material.Glass,
			Transparency = 0.55,
			Parent = parent,
		})
	end
	Util.Part({
		Name = "TankWall",
		Size = Vector3.new(26, 14, 1.5),
		CFrame = CFrame.new(at + Vector3.new(0, 7, -13)),
		Color = Color3.fromRGB(150, 160, 170),
		Material = Enum.Material.Glass,
		Transparency = 0.55,
		Parent = parent,
	})

	-- Interior exit ladder so dunked players can climb right back out.
	local ladder = Instance.new("TrussPart")
	ladder.Name = "TankLadder"
	ladder.Size = Vector3.new(2, 15, 2)
	ladder.CFrame = CFrame.new(at + Vector3.new(0, 7.5, -11.2))
	ladder.Anchored = true
	ladder.Color = Color3.fromRGB(220, 185, 60)
	ladder.Material = Enum.Material.Metal
	ladder.Parent = parent

	-- The water. Non-solid, so you fall in rather than onto.
	Util.Part({
		Name = "DunkWater",
		Size = Vector3.new(25, 11, 25),
		CFrame = CFrame.new(at + Vector3.new(0, 5.5, 0)),
		Color = Color3.fromRGB(70, 140, 190),
		Material = Enum.Material.Water,
		Transparency = 0.35,
		CanCollide = false,
		Parent = parent,
	})

	-- The plank and the seat above it.
	local plank = Util.Part({
		Name = "DunkPlank",
		Size = Vector3.new(10, 1, 4),
		CFrame = CFrame.new(at + Vector3.new(0, 18, 0)),
		Color = Color3.fromRGB(150, 110, 70),
		Material = Enum.Material.WoodPlanks,
		Parent = parent,
	})

	local seat = Instance.new("Seat")
	seat.Name = "DunkSeat"
	seat.Size = Vector3.new(5, 1, 5)
	seat.CFrame = CFrame.new(at + Vector3.new(0, 19.5, 0))
	seat.Anchored = true
	seat.Color = Color3.fromRGB(220, 90, 90)
	seat.Material = Enum.Material.SmoothPlastic
	seat.Parent = parent

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Take the hot seat"
	prompt.ObjectText = "Dunk Tank"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 22
	prompt.RequiresLineOfSight = false
	prompt.Parent = seat

	prompt.Triggered:Connect(function(player)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 and not humanoid.SeatPart and not seat.Occupant then
			seat:Sit(humanoid)
		end
	end)

	dunkSeat = seat
	dunkHome = seat.CFrame
	local _ = plank

	-- The target, on a post to one side.
	local post = Util.Part({
		Name = "DunkPost",
		Size = Vector3.new(1.2, 20, 1.2),
		CFrame = CFrame.new(at + Vector3.new(18, 10, 0)),
		Color = Color3.fromRGB(110, 82, 54),
		Material = Enum.Material.Wood,
		Parent = parent,
	})

	local target = Util.Part({
		Name = "DunkTarget",
		Size = Vector3.new(7, 7, 0.8),
		CFrame = CFrame.new(at + Vector3.new(18, 20, 0)),
		Color = Color3.fromRGB(240, 240, 235),
		Material = Enum.Material.SmoothPlastic,
		Parent = parent,
	})
	target:SetAttribute("Carnival", "Dunk")
	Util.Weld(post, target)

	local ring = Util.Part({
		Name = "DunkRing",
		Size = Vector3.new(0.3, 4.6, 4.6),
		CFrame = target.CFrame * CFrame.new(0, 0, -0.6) * CFrame.Angles(0, math.rad(90), 0),
		Shape = Enum.PartType.Cylinder,
		Color = Color3.fromRGB(220, 40, 40),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = parent,
	})
	ring:SetAttribute("Carnival", "Dunk")
	Util.Weld(target, ring)

	sign(parent, at + Vector3.new(0, 0, -20), "DUNK TANK — HIT THE TARGET", Color3.fromRGB(240, 200, 90))
end

--[[ Drop whoever is on the seat into the water. ]]
local function dunk(shooter: Player?)
	local seat = dunkSeat
	if not seat or not seat.Parent then
		return
	end
	if os.clock() < dunkWetUntil then
		return
	end
	dunkWetUntil = os.clock() + 3

	local occupant = seat.Occupant
	if occupant then
		local character = occupant.Parent
		local dunked = if character then Players:GetPlayerFromCharacter(character) else nil
		local weld = seat:FindFirstChild("SeatWeld")
		if weld then
			weld:Destroy()
		end
		occupant.Sit = false

		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local targetPos = seat.Position - Vector3.new(0, 14, 0)
			task.defer(function()
				if root.Parent then
					root.CFrame = CFrame.new(targetPos)
					root.AssemblyLinearVelocity = Vector3.zero
				end
			end)
		end

		if dunked then
			Remotes.Event("Notify"):FireClient(dunked, "SPLASH. You have been dunked.")
		end
		award(shooter, DUNK_POINTS, "DUNKED THEM!")
	else
		award(shooter, math.floor(DUNK_POINTS / 4), "Bullseye — nobody was sitting.")
	end

	-- The splash.
	local splash = Util.Part({
		Name = "Splash",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(seat.Position - Vector3.new(0, 12, 0)),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = workspace,
	})
	local spray = Instance.new("ParticleEmitter")
	spray.Color = ColorSequence.new(Color3.fromRGB(150, 210, 240))
	spray.Size = NumberSequence.new(3, 0)
	spray.Lifetime = NumberRange.new(0.5, 1.2)
	spray.Speed = NumberRange.new(20, 44)
	spray.SpreadAngle = Vector2.new(70, 70)
	spray.Rate = 0
	spray.Parent = splash
	spray:Emit(90)
	Sound.At("Splash", splash.Position)
	Debris:AddItem(splash, 3)
end

-- ========================================================= SHOOTING GALLERY ==

local function buildGallery(at: Vector3, parent: Instance)
	Util.Part({
		Name = "GalleryBack",
		Size = Vector3.new(60, 20, 1.5),
		CFrame = CFrame.new(at + Vector3.new(0, 10, 8)),
		Color = Color3.fromRGB(180, 90, 70),
		Material = Enum.Material.WoodPlanks,
		Parent = parent,
	})
	Util.Part({
		Name = "GalleryCounter",
		Size = Vector3.new(60, 6, 6),
		CFrame = CFrame.new(at + Vector3.new(0, 3, 0)),
		Color = Color3.fromRGB(150, 120, 80),
		Material = Enum.Material.WoodPlanks,
		Parent = parent,
	})

	for lane = 1, 3 do
		local height = 8 + lane * 3.5
		local duck = Util.Part({
			Name = "Duck",
			Size = Vector3.new(4.5, 4, 2),
			CFrame = CFrame.new(at + Vector3.new(0, height, 5)),
			Color = if lane == 1 then Color3.fromRGB(250, 210, 60)
				elseif lane == 2 then Color3.fromRGB(240, 130, 60)
				else Color3.fromRGB(120, 200, 240),
			Material = Enum.Material.SmoothPlastic,
			Parent = parent,
		})
		duck:SetAttribute("Carnival", "Duck")

		local head = Util.Part({
			Name = "DuckHead",
			Size = Vector3.new(2, 2.2, 2),
			CFrame = duck.CFrame * CFrame.new(1.4, 2.6, 0),
			Color = duck.Color,
			Material = Enum.Material.SmoothPlastic,
			Anchored = false,
			CanCollide = false,
			Massless = true,
			Parent = parent,
		})
		head:SetAttribute("Carnival", "Duck")
		Util.Weld(duck, head)

		table.insert(ducks, {
			part = duck :: BasePart,
			centre = at + Vector3.new(0, height, 5),
			span = 22,
			speed = 0.6 + lane * 0.25,
			phase = rng:NextNumber(0, math.pi * 2),
			downUntil = 0,
		})
	end

	sign(parent, at + Vector3.new(0, 0, -10), "SHOOTING GALLERY", Color3.fromRGB(250, 210, 60))
end

--[[
	Which duck was hit.

	A duck's head is a separate part welded on, so a head shot has to be
	matched back to the body it belongs to — nearest one wins.
]]
local function hitDuck(part: BasePart, shooter: Player?): boolean
	local best: Duck? = nil
	local bestDistance = 12

	for _, duck in ducks do
		if not duck.part.Parent then
			continue
		end
		local distance = (duck.part.Position - part.Position).Magnitude
		if distance < bestDistance then
			best, bestDistance = duck, distance
		end
	end

	if not best or os.clock() < best.downUntil then
		return false
	end

	best.downUntil = os.clock() + 3
	award(shooter, DUCK_POINTS, "Duck down!")
	return true
end

-- ============================================================= HIGH STRIKER ==

local function buildStriker(at: Vector3, parent: Instance)
	Util.Part({
		Name = "StrikerTower",
		Size = Vector3.new(4, 60, 4),
		CFrame = CFrame.new(at + Vector3.new(0, 30, 0)),
		Color = Color3.fromRGB(90, 70, 110),
		Material = Enum.Material.Metal,
		Parent = parent,
	})

	local bell = Util.Part({
		Name = "StrikerBell",
		Size = Vector3.new(7, 6, 7),
		CFrame = CFrame.new(at + Vector3.new(0, 63, 0)),
		Color = Color3.fromRGB(240, 200, 70),
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	local _ = bell

	local pad = Util.Part({
		Name = "StrikerPad",
		Size = Vector3.new(9, 3, 9),
		CFrame = CFrame.new(at + Vector3.new(0, 1.5, 0)),
		Color = Color3.fromRGB(220, 60, 60),
		Material = Enum.Material.SmoothPlastic,
		Parent = parent,
	})
	pad:SetAttribute("Carnival", "Striker")

	strikerPuck = Util.Part({
		Name = "StrikerPuck",
		Size = Vector3.new(6, 2.5, 6),
		CFrame = CFrame.new(at + Vector3.new(0, 4, 0)),
		Color = Color3.fromRGB(250, 250, 250),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})

	sign(parent, at + Vector3.new(0, 0, -12), "HIGH STRIKER — SHOOT THE PAD", Color3.fromRGB(220, 120, 200))
end

local function ringBell(shooter: Player?)
	if os.clock() < strikerUntil then
		return
	end
	strikerUntil = os.clock() + 2.5
	local puck = strikerPuck
	if puck then
		Sound.At("Bell", puck.Position + Vector3.new(0, 60, 0))
	end
	award(shooter, STRIKER_POINTS, "DING! Bell rung.")
end

-- ================================================================== PUBLIC ==

--[[ Something was shot. Returns true if it was a carnival prop. ]]
--[[
	Balloon pop.

	A wall of balloons on a board. Pop one and it is gone, with the whole
	board refilling once it is cleared -- so there is always something to
	shoot and never a wall of nothing.
]]
local balloonBoard: { BasePart } = {}
local balloonHome: Vector3 = Vector3.new()

local BALLOON_COLOURS = {
	Color3.fromRGB(230, 60, 60),
	Color3.fromRGB(60, 140, 230),
	Color3.fromRGB(240, 200, 60),
	Color3.fromRGB(110, 210, 110),
	Color3.fromRGB(200, 110, 220),
}

local function fillBalloons(parent: Instance)
	for column = 0, 7 do
		for row = 0, 3 do
			local balloon = Util.Part({
				Name = "Balloon",
				Size = Vector3.new(4, 5, 4),
				CFrame = CFrame.new(balloonHome + Vector3.new(
					-21 + column * 6,
					6 + row * 6,
					0
				)),
				Shape = Enum.PartType.Ball,
				Color = BALLOON_COLOURS[((column + row) % #BALLOON_COLOURS) + 1],
				Material = Enum.Material.SmoothPlastic,
				Parent = parent,
			})
			balloon:SetAttribute("Carnival", "Balloon")
			table.insert(balloonBoard, balloon)
		end
	end
end

local function buildBalloonPop(at: Vector3, parent: Instance)
	balloonHome = at
	table.clear(balloonBoard)

	Util.Part({
		Name = "BalloonBoard",
		Size = Vector3.new(50, 32, 2),
		CFrame = CFrame.new(at + Vector3.new(0, 16, 2)),
		Color = Color3.fromRGB(96, 70, 46),
		Material = Enum.Material.Wood,
		Parent = parent,
	})
	fillBalloons(parent)
	sign(parent, at + Vector3.new(0, 1, 10), "BALLOON POP", Color3.fromRGB(230, 90, 90))
end

local function popBalloon(part: BasePart, shooter: Player?): boolean
	if not part.Parent then
		return false
	end
	Sound.At("Hitmarker", part.Position, 0.9)
	part:Destroy()

	local index = table.find(balloonBoard, part)
	if index then
		table.remove(balloonBoard, index)
	end
	award(shooter, Config.Carnival.BalloonPoints, "POP!")

	-- Board cleared: a bonus, and a fresh wall.
	if #balloonBoard == 0 and container then
		award(shooter, Config.Carnival.BalloonClearBonus, "FULL BOARD CLEARED!")
		local parent = container
		task.delay(1.6, function()
			if parent.Parent then
				fillBalloons(parent)
			end
		end)
	end
	return true
end

--[[
	Milk bottles.

	Three stacks of bottles. Knock every bottle in a stack off its shelf and
	the stack pays out -- which means a shot that scatters two at once is
	worth more than two careful shots, and that is the whole game.
]]
local bottleStacks: { { bottles: { BasePart }, shelf: Vector3, cleared: boolean } } = {}

local function stackBottles(stack: { bottles: { BasePart }, shelf: Vector3, cleared: boolean }, parent: Instance)
	table.clear(stack.bottles)
	stack.cleared = false
	-- Three on the bottom, two, then one: a pyramid, like a real stall.
	local rows = { 3, 2, 1 }
	for row, count in rows do
		for index = 1, count do
			local bottle = Util.Part({
				Name = "MilkBottle",
				Size = Vector3.new(2.4, 5, 2.4),
				CFrame = CFrame.new(stack.shelf + Vector3.new(
					-(count - 1) * 1.8 + (index - 1) * 3.6,
					2.5 + (row - 1) * 5,
					0
				)),
				Shape = Enum.PartType.Cylinder,
				Color = Color3.fromRGB(240, 245, 250),
				Material = Enum.Material.Glass,
				Anchored = false,
				Parent = parent,
			})
			-- A cylinder lies on its own X, so stand it upright.
			bottle.CFrame = CFrame.new(bottle.Position) * CFrame.Angles(0, 0, math.rad(90))
			bottle:SetAttribute("Carnival", "Bottle")
			table.insert(stack.bottles, bottle)
		end
	end
end

local function buildMilkBottles(at: Vector3, parent: Instance)
	table.clear(bottleStacks)
	for index = -1, 1 do
		local shelfAt = at + Vector3.new(index * 22, 8, 0)
		Util.Part({
			Name = "BottleShelf",
			Size = Vector3.new(18, 1.6, 8),
			CFrame = CFrame.new(shelfAt - Vector3.new(0, 0.8, 0)),
			Color = Color3.fromRGB(104, 76, 50),
			Material = Enum.Material.Wood,
			Parent = parent,
		})
		-- The legs, so the shelf is not floating.
		for _, side in { -1, 1 } do
			Util.Part({
				Name = "ShelfLeg",
				Size = Vector3.new(1.4, 7.4, 1.4),
				CFrame = CFrame.new(shelfAt + Vector3.new(side * 7.5, -5.2, 0)),
				Color = Color3.fromRGB(88, 64, 42),
				Material = Enum.Material.Wood,
				Parent = parent,
			})
		end

		local stack = { bottles = {}, shelf = shelfAt, cleared = false }
		stackBottles(stack, parent)
		table.insert(bottleStacks, stack)
	end
	sign(parent, at + Vector3.new(0, 1, 12), "MILK BOTTLES", Color3.fromRGB(240, 240, 250))
end

--[[ A bottle took a hit: shove it, and pay out if its stack is swept. ]]
local function knockBottle(part: BasePart, shooter: Player?, direction: Vector3?): boolean
	local push = direction or Vector3.new(0, 0, -1)
	local flat = Vector3.new(push.X, 0, push.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, -1)
	end
	part.AssemblyLinearVelocity = flat.Unit * 70 + Vector3.new(0, 26, 0)
	Sound.At("Hitmarker", part.Position, 0.8)
	award(shooter, Config.Carnival.BottlePoints, "BOTTLE")

	for _, stack in bottleStacks do
		if stack.cleared then
			continue
		end
		local standing = 0
		for _, bottle in stack.bottles do
			-- Still on the shelf if it has not dropped below it.
			if bottle.Parent and bottle.Position.Y > stack.shelf.Y - 1 then
				standing += 1
			end
		end
		if standing == 0 then
			stack.cleared = true
			award(shooter, Config.Carnival.BottleStackBonus, "STACK CLEARED!")
			Sound.At("RoundEnd", stack.shelf, 0.9)

			local parent = container
			task.delay(Config.Carnival.ResetSeconds, function()
				if parent and parent.Parent then
					for _, old in stack.bottles do
						if old.Parent then
							old:Destroy()
						end
					end
					stackBottles(stack, parent)
				end
			end)
		end
	end
	return true
end

--[[
	Whack-a-mole, played with a gun.

	Heads pop up out of holes for a moment and drop back. Shoot one while it
	is up and it counts; the holes are on their own timers so the pattern is
	never the same twice.
]]
type Mole = { head: Part, home: Vector3, upUntil: number, nextUpAt: number, up: boolean }
local moles: { Mole } = {}

local function buildMoles(at: Vector3, parent: Instance)
	table.clear(moles)

	Util.Part({
		Name = "MoleTable",
		Size = Vector3.new(36, 3, 24),
		CFrame = CFrame.new(at + Vector3.new(0, 8, 0)),
		Color = Color3.fromRGB(70, 110, 72),
		Material = Enum.Material.Grass,
		Parent = parent,
	})

	for column = -1, 1 do
		for row = -1, 1 do
			local holeAt = at + Vector3.new(column * 11, 9.5, row * 7)
			Util.Part({
				Name = "MoleHole",
				Size = Vector3.new(5.6, 0.6, 5.6),
				CFrame = CFrame.new(holeAt),
				Shape = Enum.PartType.Cylinder,
				Color = Color3.fromRGB(44, 34, 26),
				Material = Enum.Material.Ground,
				CanCollide = false,
				Parent = parent,
			})

			local head = Util.Part({
				Name = "Mole",
				Size = Vector3.new(4.4, 4.4, 4.4),
				-- Starts sunk into the table, so it has somewhere to rise from.
				CFrame = CFrame.new(holeAt - Vector3.new(0, 4.5, 0)),
				Shape = Enum.PartType.Ball,
				Color = Color3.fromRGB(128, 94, 62),
				Material = Enum.Material.Fabric,
				Parent = parent,
			})
			head:SetAttribute("Carnival", "Mole")

			table.insert(moles, {
				head = head,
				home = holeAt,
				upUntil = 0,
				nextUpAt = os.clock() + math.random() * 3,
				up = false,
			})
		end
	end
	sign(parent, at + Vector3.new(0, 1, 16), "WHACK-A-MOLE", Color3.fromRGB(150, 220, 150))
end

local function whackMole(part: BasePart, shooter: Player?): boolean
	for _, mole in moles do
		if mole.head == part then
			if not mole.up then
				-- Shooting a sunk mole is shooting the table.
				return true
			end
			mole.up = false
			mole.upUntil = 0
			mole.nextUpAt = os.clock() + Config.Carnival.MoleDownSeconds
			mole.head.CFrame = CFrame.new(mole.home - Vector3.new(0, 4.5, 0))
			Sound.At("Hitmarker", part.Position, 1)
			award(shooter, Config.Carnival.MolePoints, "WHACK!")
			return true
		end
	end
	return false
end

--[[
	The cannon range.

	A cannon you aim and fire at stacks of crates, and the whole stack is
	real physics -- so a shot into the base brings the lot down and a shot
	at the top knocks one crate off. Clearing a stack pays out.

	This is the knock-them-over game, and the reason it works is that none
	of it is scripted: the cannonball is a heavy ball, the crates are
	unanchored boxes, and Roblox does the rest.
]]
type CrateStack = { crates: { BasePart }, base: Vector3, cleared: boolean }
local crateStacks: { CrateStack } = {}
local cannonBarrel: BasePart? = nil

local function stackCrates(stack: CrateStack, parent: Instance)
	table.clear(stack.crates)
	stack.cleared = false
	-- A tower four high, two wide at the bottom, one at the top.
	local layout = { 3, 3, 2, 1 }
	for level, count in layout do
		for index = 1, count do
			local crate = Util.Part({
				Name = "Crate",
				Size = Vector3.new(6, 6, 6),
				CFrame = CFrame.new(stack.base + Vector3.new(
					-(count - 1) * 3.2 + (index - 1) * 6.4,
					3 + (level - 1) * 6.2,
					0
				)),
				Color = Color3.fromRGB(150, 110, 66),
				Material = Enum.Material.WoodPlanks,
				Anchored = false,
				Parent = parent,
			})
			crate:SetAttribute("Carnival", "Crate")
			crate:SetAttribute("Destructible", true)
			table.insert(stack.crates, crate)
		end
	end
end

local function buildCannonRange(at: Vector3, parent: Instance)
	table.clear(crateStacks)

	-- The cannon itself: a carriage, a barrel, and a prompt to fire it.
	Util.Part({
		Name = "CannonCarriage",
		Size = Vector3.new(10, 5, 14),
		CFrame = CFrame.new(at + Vector3.new(0, 3, 0)),
		Color = Color3.fromRGB(70, 54, 40),
		Material = Enum.Material.Wood,
		Parent = parent,
	})

	local barrel = Util.Part({
		Name = "CannonBarrel",
		Size = Vector3.new(5, 5, 18),
		CFrame = CFrame.new(at + Vector3.new(0, 8, -6)) * CFrame.Angles(math.rad(-16), 0, 0),
		Shape = Enum.PartType.Cylinder,
		Color = Color3.fromRGB(44, 46, 52),
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	-- A cylinder points along its own X, so turn it to face down the range.
	barrel.CFrame = CFrame.new(at + Vector3.new(0, 8, -6))
		* CFrame.Angles(0, math.rad(90), 0)
		* CFrame.Angles(0, 0, math.rad(16))
	barrel:SetAttribute("Carnival", "Cannon")
	cannonBarrel = barrel

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "CannonPrompt"
	prompt.ActionText = "Fire the cannon"
	prompt.ObjectText = "Cannon"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 18
	prompt.RequiresLineOfSight = false
	prompt.Parent = barrel
	prompt.Triggered:Connect(function(player)
		CarnivalService.FireCannon(player)
	end)

	-- Three stacks down the range, further away for more points.
	for index = 1, 3 do
		local stack: CrateStack = {
			crates = {},
			base = at + Vector3.new((index - 2) * 30, 1, -70 - index * 24),
			cleared = false,
		}
		stackCrates(stack, parent)
		table.insert(crateStacks, stack)
	end

	sign(parent, at + Vector3.new(0, 1, 12), "CANNON RANGE", Color3.fromRGB(255, 180, 90))
end

--[[ Fire a cannonball down the range. Heavy, slow, and entirely physics. ]]
function CarnivalService.FireCannon(player: Player?)
	local barrel = cannonBarrel
	if not barrel or not barrel.Parent or not container then
		return
	end

	local now = os.clock()
	if now < nextCannonAt then
		return
	end
	nextCannonAt = now + Config.Carnival.CannonCooldown

	-- Down the range, which is the barrel's own forward.
	local muzzle = barrel.Position + Vector3.new(0, 2, -12)
	local ball = Util.Part({
		Name = "Cannonball",
		Size = Vector3.new(5, 5, 5),
		CFrame = CFrame.new(muzzle),
		Shape = Enum.PartType.Ball,
		Color = Color3.fromRGB(30, 30, 34),
		Material = Enum.Material.Metal,
		Anchored = false,
		-- Heavy, so it goes through a stack rather than bouncing off it.
		CustomPhysicalProperties = PhysicalProperties.new(6, 0.4, 0.2, 1, 1),
		Parent = container,
	})
	ball.AssemblyLinearVelocity = Vector3.new(0, 42, -1) * 2 + Vector3.new(0, 0, -150)
	Sound.At("ExplosionBig", muzzle, 0.7)
	Util.DestroyAfter(ball, 12)

	if player then
		lastCannonFirer = player
	end
end

--[[ Did a stack get swept? Checked after anything disturbs the crates. ]]
local function checkCrateStacks()
	for _, stack in crateStacks do
		if stack.cleared then
			continue
		end
		local standing = 0
		for _, crate in stack.crates do
			if crate.Parent and crate.Position.Y > stack.base.Y + 1 then
				standing += 1
			end
		end
		if standing == 0 then
			stack.cleared = true
			award(lastCannonFirer, Config.Carnival.CrateStackBonus, "STACK FLATTENED!")
			Sound.At("RoundEnd", stack.base, 1)

			local parent = container
			task.delay(Config.Carnival.ResetSeconds, function()
				if parent and parent.Parent then
					for _, old in stack.crates do
						if old.Parent then
							old:Destroy()
						end
					end
					stackCrates(stack, parent)
				end
			end)
		end
	end
end

function CarnivalService.RegisterHit(part: BasePart, attacker: Player?, direction: Vector3?): boolean
	local game_ = part:GetAttribute("Carnival")
	if game_ == "Dunk" then
		dunk(attacker)
		return true
	elseif game_ == "Duck" then
		hitDuck(part, attacker)
		return true
	elseif game_ == "Striker" then
		ringBell(attacker)
		return true
	elseif game_ == "Balloon" then
		return popBalloon(part, attacker)
	elseif game_ == "Bottle" then
		return knockBottle(part, attacker, direction)
	elseif game_ == "Mole" then
		return whackMole(part, attacker)
	elseif game_ == "Crate" then
		-- A bullet nudges a crate; the cannon is what flattens a stack.
		local push = direction or Vector3.new(0, 0, -1)
		part.AssemblyLinearVelocity = push * 40 + Vector3.new(0, 18, 0)
		if attacker then
			lastCannonFirer = attacker
		end
		award(attacker, Config.Carnival.CratePoints, "CRATE")
		return true
	elseif game_ == "Cannon" then
		CarnivalService.FireCannon(attacker)
		return true
	end
	return false
end

--[[ Put the fairground up, off to one side of the arena. ]]
function CarnivalService.Build(mapSize: number)
	CarnivalService.Clear()

	local folder = Instance.new("Folder")
	folder.Name = "Carnival"
	folder.Parent = workspace
	container = folder

	-- Off to one side, clear of the bases at either end.
	origin = Vector3.new(mapSize * 0.3, 0, 0)

	Util.Part({
		Name = "CarnivalGround",
		Size = Vector3.new(160, 1, 130),
		CFrame = CFrame.new(origin + Vector3.new(0, 0.6, 0)),
		Color = Color3.fromRGB(140, 120, 96),
		Material = Enum.Material.Sand,
		Parent = folder,
	})

	buildDunkTank(origin + Vector3.new(-45, 1, 0), folder)
	buildGallery(origin + Vector3.new(30, 1, -30), folder)
	buildStriker(origin + Vector3.new(35, 1, 35), folder)
	buildBalloonPop(origin + Vector3.new(-10, 1, -48), folder)
	buildMilkBottles(origin + Vector3.new(62, 1, -6), folder)
	buildMoles(origin + Vector3.new(-62, 1, 42), folder)
	buildCannonRange(origin + Vector3.new(0, 1, 56), folder)

	-- Overhead warm fairground festoon string lights for Future-lighting ambience.
	for idx, lightPos in {
		origin + Vector3.new(-20, 26, -15),
		origin + Vector3.new(10, 26, 0),
		origin + Vector3.new(32, 26, 15),
	} do
		local bulb = Util.Part({
			Name = "FairgroundBulb",
			Size = Vector3.new(1.8, 1.8, 1.8),
			CFrame = CFrame.new(lightPos),
			Shape = Enum.PartType.Ball,
			Color = if idx % 2 == 1 then Color3.fromRGB(255, 220, 130) else Color3.fromRGB(255, 160, 110),
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
			Parent = folder,
		})
		local glow = Instance.new("PointLight")
		glow.Color = bulb.Color
		glow.Brightness = 3.2
		glow.Range = 55
		glow.Shadows = true
		glow.Parent = bulb
	end

	-- Offered as a sub-game, so "fair games" is something you can pick from
	-- a menu rather than something you have to stumble across.
	ArcadeService.Register({
		id = "carnival",
		name = "Fair Games",
		objective = "Dunk tank, duck shoot and the high striker. All of it scores.",
		centre = Vector3.new(mapSize * 0.3, 0, 0),
		spawns = {
			Vector3.new(mapSize * 0.3 - 40, 6, 0),
			Vector3.new(mapSize * 0.3 + 40, 6, 0),
			Vector3.new(mapSize * 0.3, 6, 40),
		},
		perTeam = 2,
		teamed = false,
	})
end

function CarnivalService.Clear()
	if container then
		container:Destroy()
		container = nil
	end
	table.clear(ducks)
	dunkSeat = nil
	strikerPuck = nil
	dunkWetUntil = 0
	strikerUntil = 0
end

--[[ Ducks slide back and forth; a shot one lies down for a moment. ]]
local function step()
	if not container then
		return
	end
	local now = os.clock()

	--[[
		The moles, rising and dropping on their own timers.

		Each hole runs independently, so the pattern is never the same twice
		-- which is the only thing that makes a grid of nine holes a game
		rather than a shooting drill.
	]]
	for _, mole in moles do
		if not mole.head.Parent then
			continue
		end
		if mole.up then
			if now >= mole.upUntil then
				mole.up = false
				mole.nextUpAt = now + Config.Carnival.MoleDownSeconds * (0.6 + math.random())
				mole.head.CFrame = CFrame.new(mole.home - Vector3.new(0, 4.5, 0))
			end
		elseif now >= mole.nextUpAt then
			mole.up = true
			mole.upUntil = now + Config.Carnival.MoleUpSeconds
			mole.head.CFrame = CFrame.new(mole.home + Vector3.new(0, 1.6, 0))
		end
	end

	-- Has a crate stack been flattened? Checked here rather than on every
	-- bullet, because a stack comes down over a second or two of physics
	-- and the shot that started it has long since been resolved.
	checkCrateStacks()

	--[[
		The moles, rising and dropping on their own timers.

		Each hole runs independently, so the pattern is never the same twice
		-- which is the only thing that makes a grid of nine holes a game
		rather than a shooting drill.
	]]
	for _, mole in moles do
		if not mole.head.Parent then
			continue
		end
		if mole.up then
			if now >= mole.upUntil then
				mole.up = false
				mole.nextUpAt = now + Config.Carnival.MoleDownSeconds * (0.6 + math.random())
				mole.head.CFrame = CFrame.new(mole.home - Vector3.new(0, 4.5, 0))
			end
		elseif now >= mole.nextUpAt then
			mole.up = true
			mole.upUntil = now + Config.Carnival.MoleUpSeconds
			mole.head.CFrame = CFrame.new(mole.home + Vector3.new(0, 1.6, 0))
		end
	end

	-- Has a crate stack been flattened? Checked here rather than on every
	-- bullet, because a stack comes down over a second or two of physics
	-- and the shot that started it has long since been resolved.
	checkCrateStacks()

	for _, duck in ducks do
		if not duck.part.Parent then
			continue
		end
		if now < duck.downUntil then
			-- Tipped over backwards.
			duck.part.CFrame = CFrame.new(duck.centre) * CFrame.Angles(math.rad(-80), 0, 0)
		else
			local slide = math.sin(now * duck.speed + duck.phase) * duck.span
			duck.part.CFrame = CFrame.new(duck.centre + Vector3.new(slide, 0, 0))
		end
	end

	-- The puck sits at the bottom, then rides up the tower when the bell is
	-- rung and slides back down afterwards.
	local puck = strikerPuck
	if puck and puck.Parent then
		local remaining = strikerUntil - now
		local climbed = 0
		if remaining > 0 then
			local elapsed = 2.5 - remaining
			if elapsed < 0.45 then
				local t = elapsed / 0.45
				climbed = (1 - (1 - t) * (1 - t)) * 56
			else
				local t = (elapsed - 0.45) / 2.05
				climbed = (1 - t * t) * 56
			end
		end
		puck.CFrame = CFrame.new(puck.Position.X, origin.Y + 5 + climbed, puck.Position.Z)
	end
end

RunService.Heartbeat:Connect(step)

return CarnivalService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">DamageService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DamageService — the single place where anybody loses health.

	Every gun, every explosion and every crash goes through ApplyDamage, which
	means the rules about shields, spawn protection and invincibility burgers
	only have to be written once and cannot drift apart.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Signal = require(Shared:WaitForChild("Signal"))
local Sound = require(Shared:WaitForChild("Sound"))
local Util = require(Shared:WaitForChild("Util"))

local PlayerState = require(script.Parent:WaitForChild("PlayerState"))
local VehicleService = require(script.Parent:WaitForChild("VehicleService"))

local DamageService = {}

--[[ Fired as (victim, killer|nil, cause) whenever somebody dies. ]]
DamageService.Killed = Signal.new()

--[[
	Fired as (position, radius, attacker) for a mega-detonation only.

	Announced rather than acted on, so that the things which care about huge
	explosions — the giant animals, which shrug off everything smaller — can
	listen without this module having to know they exist.
]]
DamageService.MegaBlast = Signal.new()

--[[
	Hurt a player.

	Shields soak damage first and health takes the remainder, so a full shield
	is worth exactly its number in extra health. Returns true if this hit
	actually landed, which callers use to decide whether to show a hitmarker.
]]
function DamageService.ApplyDamage(
	victim: Player,
	amount: number,
	attacker: Player?,
	cause: string?
): boolean
	if not (amount > 0) or amount == math.huge then
		return false
	end

	local character = victim.Character
	if not character then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end

	-- Freshly spawned, ForceField protected, or chewing an invincibility burger.
	if PlayerState.IsInvincible(victim) or character:FindFirstChildOfClass("ForceField") then
		return false
	end

	-- Friendly fire is off. Shooting your own team does nothing.
	if attacker and attacker ~= victim and attacker.Team and victim.Team and attacker.Team == victim.Team then
		return false
	end

	local state = PlayerState.Get(victim)
	state.lastDamagedAt = os.clock()

	-- Shields first.
	local remaining = amount
	if state.shield > 0 then
		local absorbed = math.min(state.shield, remaining)
		state.shield -= absorbed
		remaining -= absorbed

		-- The moment the shield gives out is the moment that matters, so it
		-- gets its own noise.
		if state.shield <= 0 then
			local root = character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				Sound.At("ShieldBreak", root.Position)
			end
		end
	end

	if remaining > 0 then
		humanoid:TakeDamage(remaining)
	end

	PlayerState.Changed.Fire(victim)

	if humanoid.Health <= 0 then
		local root = character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			Sound.At("Death", root.Position)
		end
		DamageService.HandleDeath(victim, attacker, cause or "Unknown")
	end

	return true
end

--[[ Book-keeping for a death: keys to the killer, a tally for both. ]]
function DamageService.HandleDeath(victim: Player, killer: Player?, cause: string)
	if victim.Parent then
		local victimState = PlayerState.Get(victim)
		victimState.deaths += 1
	end

	if killer and killer ~= victim and killer.Parent then
		local killerState = PlayerState.Get(killer)
		killerState.kills += 1
		-- Keys are the progression: every kill moves you toward a faster car.
		PlayerState.AwardKeys(killer, 1)
	end

	DamageService.Killed.Fire(victim, killer, cause)
end

--[[
	An explosion. Everything within the radius takes damage on a slide from
	full at the centre to nothing at the edge, and vehicles take their own
	multiplier on top.
]]
function DamageService.Explode(
	position: Vector3,
	radius: number,
	maxDamage: number,
	attacker: Player?,
	vehicleMultiplier: number?,
	isMega: boolean?,
	cause: string?
)
	if not (radius > 0) or radius == math.huge then
		return
	end
	local damageCause = cause or "Explosion"
	if isMega then
		DamageService.MegaBlast.Fire(position, radius, attacker)
	end

	-- Big blasts get the deeper boom.
	Sound.At(if radius > 60 then "ExplosionBig" else "Explosion", position)

	-- The visible bang. BlastPressure does the ragdoll-throwing; the numbers
	-- below do the actual damage, so nobody dies to physics alone.
	local explosion = Instance.new("Explosion")
	explosion.Position = position
	explosion.BlastRadius = radius
	explosion.BlastPressure = 180000
	explosion.DestroyJointRadiusPercent = 0
	explosion.ExplosionType = Enum.ExplosionType.NoCraters
	explosion.Parent = workspace

	-- Players in range.
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local distance = (root.Position - position).Magnitude
			if distance <= radius then
				local falloff = 1 - (distance / radius)
				DamageService.ApplyDamage(player, maxDamage * falloff, attacker, damageCause)
			end
		end
	end

	-- Vehicles in range.
	local seen: { [Model]: boolean } = {}
	local parts = workspace:GetPartBoundsInRadius(position, radius)
	for _, part in parts do
		local vehicle = VehicleService.FromPart(part)
		if vehicle and not seen[vehicle] then
			seen[vehicle] = true
			local primary = vehicle.PrimaryPart
			if primary then
				local distance = (primary.Position - position).Magnitude
				local falloff = math.max(0, 1 - (distance / radius))
				VehicleService.Damage(vehicle, maxDamage * falloff * (vehicleMultiplier or 1), attacker)
			end
		end
	end

	-- Blow apart any cover the map marked as breakable.
	for _, part in parts do
		if part:GetAttribute("Destructible") then
			part:Destroy()
		end
	end
end

--[[
	Carve a crater into the mud. Purely cosmetic, but it is the thing that
	makes a mega-detonation feel like it mattered.
]]
--[[
	A wrecked vehicle's blast.

	VehicleService announces these rather than applying them, because it
	already requires this module and the reverse would be a cycle.

	Before this listener existed, every exploding vehicle dealt exactly zero
	damage. Roblox's Explosion only hurts a Humanoid by breaking its joints,
	and the vehicle blast set DestroyJointRadiusPercent to 0 to stop
	characters coming apart -- which switched off the only damage it did. So
	riding a torpedo straight into somebody, the entire purpose of the
	torpedo, did nothing to them whatsoever.
]]
VehicleService.Wrecked.Connect(function(
	position: Vector3,
	radius: number,
	damage: number,
	lastDriver: Player?
)
	DamageService.Explode(position, radius, damage, lastDriver, 1.4, false)
end)

function DamageService.Crater(position: Vector3, radius: number)
	-- Cylinder height is Size.X; diameter is Size.Y/Size.Z.
	local crater = Util.Part({
		Name = "Crater",
		Size = Vector3.new(Config.Mega.CraterDepth, radius * 2, radius * 2),
		CFrame = CFrame.new(position - Vector3.new(0, Config.Mega.CraterDepth * 0.4, 0))
			* CFrame.Angles(0, 0, math.rad(90)),
		Shape = Enum.PartType.Cylinder,
		Color = Color3.fromRGB(48, 34, 22),
		Material = Enum.Material.Mud,
		CanCollide = false,
		Parent = workspace:FindFirstChild("Arena") or workspace,
	})
	Util.DestroyAfter(crater, 45)
end

-- Shields tick back up for everybody, once per frame.
RunService.Heartbeat:Connect(function(deltaTime)
	PlayerState.RegenerateShields(deltaTime)
end)

return DamageService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">EffectService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EffectService — the silly half of the game.

	Lava death screens, a donkey, a sparkle-farting unicorn, a cat telling you
	to hang in there, and the WIENER celebration when a team wins.

	Everything here is deliberately visual only. Roblox audio IDs cannot be
	guessed — a wrong one throws a real error at runtime — so the guide shows
	you where to drop sounds in from the Toolbox instead of me inventing IDs
	that would break your game.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local EffectService = {}

local rng = Random.new()

--[[ A burst of coloured particles at a spot in the world. ]]
local function burst(position: Vector3, colour: Color3, count: number, spread: number)
	local anchor = Util.Part({
		Name = "EffectAnchor",
		Size = Vector3.new(0.2, 0.2, 0.2),
		CFrame = CFrame.new(position),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = workspace,
	})

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(colour)
	emitter.Size = NumberSequence.new(2.5, 0)
	emitter.Lifetime = NumberRange.new(0.6, 1.4)
	emitter.Speed = NumberRange.new(spread * 0.5, spread)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = 0
	emitter.Parent = anchor
	emitter:Emit(count)

	Debris:AddItem(anchor, 3)
end

--[[
	The donkey. A stubby grey thing that appears where you died, brays
	silently, and wanders off.
]]
local function spawnDonkey(position: Vector3)
	local model = Instance.new("Model")
	model.Name = "Donkey"

	local body = Util.Part({
		Name = "Body",
		Size = Vector3.new(3, 3, 6),
		CFrame = CFrame.new(position + Vector3.new(0, 4, 0)),
		Color = Color3.fromRGB(120, 116, 110),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = model,
	})
	model.PrimaryPart = body

	local head = Util.Part({
		Name = "Head",
		Size = Vector3.new(2, 2.5, 2.5),
		CFrame = body.CFrame * CFrame.new(0, 2, -3.5),
		Color = Color3.fromRGB(130, 126, 120),
		CanCollide = false,
		Parent = model,
	})
	Util.Weld(body, head)

	for _, ear in { -0.7, 0.7 } do
		local earPart = Util.Part({
			Name = "Ear",
			Size = Vector3.new(0.5, 2, 0.5),
			CFrame = head.CFrame * CFrame.new(ear, 2, 0),
			Color = Color3.fromRGB(110, 106, 100),
			CanCollide = false,
			Parent = model,
		})
		Util.Weld(head, earPart)
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(10, 3)
	billboard.StudsOffset = Vector3.new(0, 5, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = head

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "HEE-HAW"
	label.TextColor3 = Color3.fromRGB(255, 240, 200)
	label.TextStrokeTransparency = 0.2
	label.TextScaled = true
	label.Font = Enum.Font.LuckiestGuy
	label.Parent = billboard

	model.Parent = workspace
	Debris:AddItem(model, 6)
end

--[[ The unicorn. It sparkles, and it farts sparkles. ]]
local function spawnUnicorn(position: Vector3)
	local model = Instance.new("Model")
	model.Name = "SparkleUnicorn"

	local body = Util.Part({
		Name = "Body",
		Size = Vector3.new(3, 3, 6),
		CFrame = CFrame.new(position + Vector3.new(0, 4, 0)),
		Color = Color3.fromRGB(255, 235, 250),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})
	model.PrimaryPart = body

	local horn = Util.Part({
		Name = "Horn",
		Size = Vector3.new(0.6, 3, 0.6),
		CFrame = body.CFrame * CFrame.new(0, 3, -3),
		Color = Color3.fromRGB(255, 200, 90),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})
	Util.Weld(body, horn)

	-- The important part.
	local rear = Util.Attachment(body, Vector3.new(0, 0, 3.2), "Rear")
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 220)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(140, 220, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 240, 140)),
	})
	sparkles.Size = NumberSequence.new(1.6, 0)
	sparkles.Lifetime = NumberRange.new(0.8, 1.6)
	sparkles.Speed = NumberRange.new(12, 22)
	sparkles.SpreadAngle = Vector2.new(35, 35)
	sparkles.Rate = 90
	sparkles.Parent = rear

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(12, 3)
	billboard.StudsOffset = Vector3.new(0, 6, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = body

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "PBBBT!"
	label.TextColor3 = Color3.fromRGB(255, 170, 240)
	label.TextStrokeTransparency = 0.2
	label.TextScaled = true
	label.Font = Enum.Font.LuckiestGuy
	label.Parent = billboard

	model.Parent = workspace
	Debris:AddItem(model, 6)
end

--[[ Hang in there. ]]
local function spawnCat(position: Vector3)
	local sign = Util.Part({
		Name = "HangInThereCat",
		Size = Vector3.new(10, 10, 0.4),
		CFrame = CFrame.new(position + Vector3.new(0, 9, 0)),
		Color = Color3.fromRGB(250, 240, 220),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = workspace,
	})

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(14, 6)
	billboard.AlwaysOnTop = true
	billboard.Parent = sign

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "HANG IN THERE\nMEOW"
	label.TextColor3 = Color3.fromRGB(60, 50, 40)
	label.TextScaled = true
	label.Font = Enum.Font.LuckiestGuy
	label.Parent = billboard

	Debris:AddItem(sign, 6)
end

--[[ Roll the dice on a gag when somebody dies. ]]
function EffectService.PlayDeathGag(position: Vector3)
	if rng:NextNumber() > Config.Effects.GagChance then
		return
	end

	if #Config.Effects.Gags == 0 then
		return
	end
	local gag = Config.Effects.Gags[rng:NextInteger(1, #Config.Effects.Gags)]
	if gag == "Donkey" then
		spawnDonkey(position)
	elseif gag == "Unicorn" then
		spawnUnicorn(position)
	else
		spawnCat(position)
	end

	burst(position, Color3.fromRGB(255, 200, 120), 40, 20)
end

--[[ Tell one player's screen to go lava-red because they just died. ]]
function EffectService.ShowDeathScreen(player: Player, killerName: string?)
	Remotes.Event("DeathScreen"):FireClient(player, {
		duration = Config.Effects.DeathScreenDuration,
		killer = killerName,
	})
end

--[[
	WIENER. The winning team gets hot dogs raining out of the sky and a very
	large word across everybody's screen.
]]
local celebrationGen = 0

function EffectService.Clear()
	celebrationGen += 1
	local folder = workspace:FindFirstChild("ArenaEffects")
	if folder then
		folder:Destroy()
	end
end

local function effectsContainer(): Folder
	local existing = workspace:FindFirstChild("ArenaEffects")
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = "ArenaEffects"
	folder.Parent = workspace
	return folder
end

function EffectService.CelebrateWinner(teamName: string)
	celebrationGen += 1
	local myGen = celebrationGen
	for _, player in Players:GetPlayers() do
		Remotes.Event("PlayEffect"):FireClient(player, {
			effect = "Wiener",
			team = teamName,
			duration = Config.Effects.WienerDuration,
		})
	end

	task.spawn(function()
		local deadline = os.clock() + Config.Effects.WienerDuration
		local parent = effectsContainer()
		while os.clock() < deadline and myGen == celebrationGen and parent.Parent do
			local drop = Util.Part({
				Name = "HotDog",
				Size = Vector3.new(7, 2, 2),
				CFrame = CFrame.new(rng:NextNumber(-260, 260), 220, rng:NextNumber(-260, 260))
					* CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), rng:NextNumber(0, 6)),
				Shape = Enum.PartType.Cylinder,
				Color = Color3.fromRGB(196, 98, 62),
				Material = Enum.Material.SmoothPlastic,
				Anchored = false,
				CanCollide = false,
				CanQuery = false,
				Parent = parent,
			})

			local bun = Util.Part({
				Name = "Bun",
				Size = Vector3.new(7.4, 1.3, 2.6),
				CFrame = drop.CFrame * CFrame.new(0, -0.8, 0),
				Color = Color3.fromRGB(238, 198, 132),
				Anchored = false,
				CanCollide = false,
				CanQuery = false,
				Massless = true,
				Parent = parent,
			})
			Util.Weld(drop, bun)

			Debris:AddItem(drop, 8)
			Debris:AddItem(bun, 8)
			task.wait(0.08)
		end
	end)
end

return EffectService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">FlagService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	FlagService — Capture the Flag.

	One flag per team, on a stand at their end of the map. Touch the enemy's
	to pick it up, carry it back to your own stand, and score.

	Halo's rules, which are what make it a game rather than a footrace:
	  * you cannot score unless your own flag is sitting on its stand
	  * dying drops the flag where you fell
	  * a dropped flag goes home on its own after a while
	  * your own dropped flag goes straight home if you touch it
	  * carrying slows you down, so a runner can be caught
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Signal = require(Shared:WaitForChild("Signal"))
local Sound = require(Shared:WaitForChild("Sound"))
local Util = require(Shared:WaitForChild("Util"))

local DamageService = require(script.Parent:WaitForChild("DamageService"))
local PlayerState = require(script.Parent:WaitForChild("PlayerState"))
local TeamService = require(script.Parent:WaitForChild("TeamService"))

local FlagService = {}

type Flag = {
	teamIndex: number,
	model: Model,
	pole: BasePart,
	home: Vector3,
	state: string, -- "Home" | "Carried" | "Dropped"
	carrier: Player?,
	droppedAt: number,
	colour: BrickColor,
}

local flags: { [number]: Flag } = {}
local stands: { [number]: BasePart } = {}
local container: Folder? = nil
local active = false

--[[ Fired as (player, teamIndex, points) when somebody scores. ]]
FlagService.Captured = Signal.new()

-- ================================================================ BUILDING ==

local function buildStand(position: Vector3, colour: BrickColor, parent: Instance): BasePart
	local base = Util.Part({
		Name = "FlagStand",
		Size = Vector3.new(16, 1.5, 16),
		CFrame = CFrame.new(position),
		Color = colour.Color,
		Material = Enum.Material.Neon,
		Parent = parent,
	})

	-- A ring of posts, so the stand reads from a distance.
	for index = 1, 8 do
		local angle = (index / 8) * math.pi * 2
		Util.Part({
			Name = "StandPost",
			Size = Vector3.new(0.8, 6, 0.8),
			CFrame = CFrame.new(position + Vector3.new(math.cos(angle) * 7, 3, math.sin(angle) * 7)),
			Color = colour.Color,
			Material = Enum.Material.Metal,
			Parent = parent,
		})
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(16, 4)
	billboard.StudsOffset = Vector3.new(0, 14, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 2000
	billboard.Parent = base

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "BASE"
	label.TextColor3 = colour.Color
	label.TextStrokeTransparency = 0.2
	label.TextScaled = true
	label.Font = Enum.Font.LuckiestGuy
	label.Parent = billboard

	return base
end

local function buildFlag(teamIndex: number, home: Vector3, colour: BrickColor, parent: Instance): Flag
	local model = Instance.new("Model")
	model.Name = `Flag_{teamIndex}`

	local pole = Util.Part({
		Name = "Pole",
		Size = Vector3.new(0.7, 14, 0.7),
		CFrame = CFrame.new(home + Vector3.new(0, 8, 0)),
		Color = Color3.fromRGB(210, 210, 215),
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = model,
	})
	model.PrimaryPart = pole

	local cloth = Util.Part({
		Name = "Cloth",
		Size = Vector3.new(0.3, 5, 8),
		CFrame = pole.CFrame * CFrame.new(0, 4, -4),
		Color = colour.Color,
		Material = Enum.Material.Fabric,
		CanCollide = false,
		Parent = model,
	})
	Util.Weld(pole, cloth)

	local glow = Instance.new("PointLight")
	glow.Color = colour.Color
	glow.Brightness = 3
	glow.Range = 30
	glow.Parent = pole

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(12, 3)
	billboard.StudsOffset = Vector3.new(0, 9, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 3000
	billboard.Parent = pole

	local label = Instance.new("TextLabel")
	label.Name = "FlagLabel"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "FLAG"
	label.TextColor3 = colour.Color
	label.TextStrokeTransparency = 0.2
	label.TextScaled = true
	label.Font = Enum.Font.LuckiestGuy
	label.Parent = billboard

	model.Parent = parent

	return {
		teamIndex = teamIndex,
		model = model,
		pole = pole,
		home = home,
		state = "Home",
		carrier = nil,
		droppedAt = 0,
		colour = colour,
	}
end

-- ================================================================== HELPERS ==

local function announce(message: string)
	for _, player in Players:GetPlayers() do
		Remotes.Event("Notify"):FireClient(player, message)
	end
end

local function setLabel(flag: Flag, text: string)
	local label = flag.pole:FindFirstChild("BillboardGui")
	if not label then
		for _, child in flag.pole:GetChildren() do
			if child:IsA("BillboardGui") then
				label = child
				break
			end
		end
	end
	if label then
		local text_ = label:FindFirstChild("FlagLabel")
		if text_ and text_:IsA("TextLabel") then
			text_.Text = text
		end
	end
end

--[[ Put a flag back on its stand. ]]
local function sendHome(flag: Flag, quiet: boolean?)
	flag.state = "Home"
	flag.carrier = nil
	flag.model:PivotTo(CFrame.new(flag.home + Vector3.new(0, 8, 0)))
	setLabel(flag, "FLAG")
	if not quiet then
		local team = TeamService.Get(flag.teamIndex)
		announce(`{if team then team.Name else "A"} flag returned.`)
	end
end

--[[ Drop it where the carrier fell. ]]
local function drop(flag: Flag, position: Vector3)
	flag.state = "Dropped"
	flag.carrier = nil
	flag.droppedAt = os.clock()
	flag.model:PivotTo(CFrame.new(position + Vector3.new(0, 6, 0)))
	setLabel(flag, "DROPPED")

	local team = TeamService.Get(flag.teamIndex)
	announce(`{if team then team.Name else "A"} flag dropped!`)
end

--[[ Slow the carrier down, or put them back to normal. ]]
local function setCarrierSpeed(player: Player, carrying: boolean)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	humanoid.WalkSpeed = if carrying
		then Config.Turbo.WalkSpeed * Config.CTF.CarrierSpeedFactor
		else Config.Turbo.WalkSpeed
end

local function pickUp(flag: Flag, player: Player)
	flag.state = "Carried"
	flag.carrier = player
	setLabel(flag, "TAKEN")
	setCarrierSpeed(player, true)

	PlayerState.AwardPoints(player, Config.CTF.FlagTakenPoints)
	Sound.At("FlagTaken", flag.pole.Position)
	local team = TeamService.Get(flag.teamIndex)
	announce(`{player.DisplayName} has the {if team then team.Name else ""} flag!`)
end

--[[ Somebody made it home with the other team's flag. ]]
local function capture(flag: Flag, player: Player, scorerIndex: number)
	local earned = PlayerState.AwardPoints(player, Config.CTF.CapturePoints)
	FlagService.Captured.Fire(player, scorerIndex, earned)

	announce(`{player.DisplayName} CAPTURED THE FLAG! +{earned}`)
	Sound.At("FlagCapture", flag.home)
	setCarrierSpeed(player, false)
	sendHome(flag, true)
end

-- ================================================================== TOUCHING ==

--[[
	Work out what touching a flag means for this player.

	Their own flag: if it is lying on the ground, they send it home. If it is
	on its stand and they are carrying the enemy's, that is a capture.
	The enemy's flag: they pick it up.
]]
local function onFlagTouched(flag: Flag, player: Player)
	if not active then
		return
	end

	local playerTeam = TeamService.IndexOf(player)

	if flag.teamIndex == playerTeam then
		if flag.state == "Dropped" then
			PlayerState.AwardPoints(player, Config.CTF.FlagReturnPoints)
			sendHome(flag)
		end
		return
	end

	-- The enemy's flag.
	if flag.state == "Home" or flag.state == "Dropped" then
		pickUp(flag, player)
	end
end

--[[ Reaching your own stand while carrying theirs. ]]
local function onStandTouched(teamIndex: number, player: Player)
	if not active then
		return
	end
	if TeamService.IndexOf(player) ~= teamIndex then
		return
	end

	-- Are they carrying anything?
	local carried: Flag? = nil
	for _, flag in flags do
		if flag.carrier == player then
			carried = flag
		end
	end
	if not carried then
		return
	end

	-- Halo's rule: your own flag has to be home for a capture to count.
	local ownFlag = flags[teamIndex]
	if Config.CTF.RequireOwnFlagHome and ownFlag and ownFlag.state ~= "Home" then
		local now = os.clock()
		local lastNotified = (player:GetAttribute("LastFlagNotify") :: number?) or 0
		if now - lastNotified >= 2 then
			player:SetAttribute("LastFlagNotify", now)
			Remotes.Event("Notify"):FireClient(player, "Your own flag is not home — you cannot score yet!")
		end
		return
	end

	capture(carried, player, teamIndex)
end

local function bindTouch(part: BasePart, handler: (Player) -> ())
	part.Touched:Connect(function(hit)
		local character = hit:FindFirstAncestorOfClass("Model")
		if not character then
			return
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			return
		end
		local player = Players:GetPlayerFromCharacter(character)
		if player then
			handler(player)
		end
	end)
end

-- =================================================================== PUBLIC ==

--[[ Build the flags and stands for a Capture the Flag round. ]]
function FlagService.Setup(build: any, teamColours: { BrickColor })
	FlagService.Clear()

	local folder = Instance.new("Folder")
	folder.Name = "CaptureTheFlag"
	folder.Parent = workspace
	container = folder

	for teamIndex = 1, 2 do
		local spawns = build.teamSpawns[teamIndex]
		if not spawns or #spawns == 0 then
			continue
		end

		-- Just in front of that team's spawn line, safely inside the boundary walls.
		local middle = spawns[math.max(1, math.floor(#spawns / 2))]
		local inward = if middle.Z ~= 0 then -math.sign(middle.Z) * 20 else 0
		local home = Vector3.new(middle.X, 1, middle.Z + inward)
		local colour = teamColours[teamIndex] or BrickColor.new("Medium stone grey")

		local stand = buildStand(home, colour, folder)
		stands[teamIndex] = stand
		bindTouch(stand, function(player)
			onStandTouched(teamIndex, player)
		end)

		local flag = buildFlag(teamIndex, home, colour, folder)
		flags[teamIndex] = flag
		bindTouch(flag.pole, function(player)
			onFlagTouched(flag, player)
		end)
	end

	active = true
end

function FlagService.IsCarrier(player: Player): boolean
	for _, flag in flags do
		if flag.carrier == player then
			return true
		end
	end
	return false
end

function FlagService.Clear()
	active = false
	for _, flag in flags do
		if flag.carrier then
			setCarrierSpeed(flag.carrier, false)
		end
	end
	if container then
		container:Destroy()
		container = nil
	end
	table.clear(flags)
	table.clear(stands)
end

--[[ Is a Capture the Flag round running? ]]
function FlagService.IsActive(): boolean
	return active
end

--[[ Flag state for the scoreboard: "Home", "Carried" or "Dropped". ]]
function FlagService.StateOf(teamIndex: number): string
	local flag = flags[teamIndex]
	return if flag then flag.state else "None"
end

--[[ Carried flags follow their carrier; dropped ones eventually go home. ]]
local function step()
	if not active then
		return
	end
	local now = os.clock()

	for _, flag in flags do
		if flag.state == "Carried" then
			local carrier = flag.carrier
			local character = carrier and carrier.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				-- Held up and slightly behind, so it is obvious who has it.
				flag.model:PivotTo(root.CFrame * CFrame.new(0, 6, 1.6))
			else
				-- Carrier vanished without dying properly.
				sendHome(flag)
			end
		elseif flag.state == "Dropped" then
			if now - flag.droppedAt >= Config.CTF.DroppedReturnDelay then
				sendHome(flag)
			end
		end
	end
end

local started = false

function FlagService.Start()
	if started then
		return
	end
	started = true
	-- Dying drops whatever you were carrying, right where you fell.
	DamageService.Killed.Connect(function(victim: Player, _killer: Player?, _cause: string)
		for _, flag in flags do
			if flag.carrier == victim then
				local character = victim.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				local where = if root and root:IsA("BasePart") then root.Position else flag.home
				setCarrierSpeed(victim, false)
				drop(flag, where)
			end
		end
	end)

	RunService.Heartbeat:Connect(step)
end

return FlagService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">GraphicsService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	GraphicsService — makes it stop looking like a bin of bricks.

	Configures Future PBR lighting, 2022 surface materials, volumetric clouds,
	realistic river water, atmospheric depth, and balanced filmic post-processing.
	No external asset IDs are used anywhere, so everything works offline or in
	an unpublished Studio place without throwing.
]]

local Lighting = game:GetService("Lighting")
local MaterialService = game:GetService("MaterialService")

local GraphicsService = {}

--[[ Remove previous arena graphics and any default lighting clutter that would stack. ]]
local function clearPrevious()
	for _, child in Lighting:GetChildren() do
		if
			child:GetAttribute("ArenaGraphics")
			or child:IsA("Sky")
			or child:IsA("Atmosphere")
			or child:IsA("PostEffect")
		then
			child:Destroy()
		end
	end

	local terrain = workspace.Terrain
	if terrain then
		for _, child in terrain:GetChildren() do
			if child:GetAttribute("ArenaGraphics") or child:IsA("Clouds") then
				child:Destroy()
			end
		end
	end
end

local function tag(instance: Instance, parent: Instance?): Instance
	instance:SetAttribute("ArenaGraphics", true)
	instance.Parent = parent or Lighting
	return instance
end

function GraphicsService.Start()
	clearPrevious()

	-- Future lighting gives real per-pixel shadows, specular highlights, and
	-- local light pools. Technology is [NotScriptable] in live servers, so both
	-- assignments stay protected in pcall (and Future is also baked in the place).
	local ok = pcall(function()
		Lighting.Technology = Enum.Technology.Future
	end)
	if not ok then
		pcall(function()
			Lighting.Technology = Enum.Technology.ShadowMap
		end)
	end

	-- Enable 2022 PBR material textures (normal, roughness, metalness maps) so
	-- Concrete, Asphalt, Metal, Mud, Snow, Ice, and WoodPlanks catch real light.
	pcall(function()
		(MaterialService :: any).Use2022Materials = true
	end)

	-- Late-afternoon golden hour: lower sun angle casts long architectural
	-- shadows across streets and gives buildings clear lit vs. shaded faces.
	Lighting.Brightness = 2.85
	Lighting.ClockTime = 16.2
	Lighting.GeographicLatitude = 26
	Lighting.ExposureCompensation = 0.0
	Lighting.EnvironmentDiffuseScale = 0.85
	Lighting.EnvironmentSpecularScale = 1.0
	Lighting.GlobalShadows = true
	pcall(function()
		Lighting.ShadowSoftness = 0.22
	end)

	-- Cool shadowed ambient against warm sunlight gives natural sky-fill contrast.
	Lighting.Ambient = Color3.fromRGB(38, 44, 58)
	Lighting.OutdoorAmbient = Color3.fromRGB(76, 86, 108)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 224, 176)
	Lighting.ColorShift_Bottom = Color3.fromRGB(58, 68, 88)

	-- Atmospheric scattering and distance perspective.
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.24
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(210, 206, 198)
	atmosphere.Decay = Color3.fromRGB(96, 108, 130)
	atmosphere.Glare = 0.34
	atmosphere.Haze = 0.95
	tag(atmosphere)

	-- Clear physical sky dome with crisp celestial bodies.
	local sky = Instance.new("Sky")
	sky.CelestialBodiesShown = true
	sky.SunAngularSize = 14
	sky.MoonAngularSize = 9
	sky.StarCount = 3000
	tag(sky)

	-- Volumetric overhead clouds break up the skyline and cast subtle sky variation.
	local terrain = workspace.Terrain
	if terrain then
		local clouds = Instance.new("Clouds")
		clouds.Cover = 0.56
		clouds.Density = 0.68
		clouds.Color = Color3.fromRGB(236, 230, 220)
		tag(clouds, terrain)

		-- Realistic water appearance for Terrain water.
		terrain.WaterWaveSize = 0.18
		terrain.WaterWaveSpeed = 12
		terrain.WaterReflectance = 0.85
		terrain.WaterTransparency = 0.32
		terrain.WaterColor = Color3.fromRGB(36, 108, 128)
	end

	-- Selective bloom: high threshold prevents sunlit concrete from clipping to
	-- flat white while Neon tracers, headlights, and explosions glow vividly.
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.38
	bloom.Size = 24
	bloom.Threshold = 1.45
	tag(bloom)

	local sunRays = Instance.new("SunRaysEffect")
	sunRays.Intensity = 0.16
	sunRays.Spread = 0.85
	tag(sunRays)

	-- Balanced filmic color grade that keeps material grain and texture detail.
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Brightness = 0.01
	grade.Contrast = 0.12
	grade.Saturation = 0.1
	grade.TintColor = Color3.fromRGB(255, 250, 244)
	tag(grade)

	-- Kept disabled by default to avoid wasting a full-screen GPU pass during
	-- hipfire; can be toggled dynamically if a zoomed scope wants shallow DoF.
	local depth = Instance.new("DepthOfFieldEffect")
	depth.Enabled = false
	depth.FarIntensity = 0.14
	depth.NearIntensity = 0
	depth.FocusDistance = 120
	depth.InFocusRadius = 600
	tag(depth)
end

return GraphicsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">HockeyService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Nuclear Mud Arena — the ice rink.

	A full rink with boards, two goals and a puck, dropped into the map
	alongside the city and the resort. You can play actual hockey on it:
	shoot the puck, score goals, and the goals are worth team points like
	anything else.

	You are also still armed. That is the rule for every sport here and it is
	not suspended on the ice -- a hockey game where the other team can shoot
	you is simply a better hockey game. Fights work the way Blades of Steel
	did: hit an opposing player with your stick and it turns into a scrap,
	both of you mashing a key, and the winner can break their stick over the
	loser and keep the splintered half as a weapon.

	The ice itself is a low-friction surface, so skating is a matter of
	momentum rather than walking, and a car driven onto it is a disaster in
	the best way.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Signal = require(Shared:WaitForChild("Signal"))
local Sound = require(Shared:WaitForChild("Sound"))
local Util = require(Shared:WaitForChild("Util"))

local PlayerState = require(script.Parent:WaitForChild("PlayerState"))
-- Required, and it was not. TeamService.IndexOf is called when a goal goes
-- in, so without this every single goal threw "attempt to index nil" inside
-- the Heartbeat connection and took the whole hockey step down with it.
local TeamService = require(script.Parent:WaitForChild("TeamService"))
local ArcadeService = require(script.Parent:WaitForChild("ArcadeService"))

local HockeyService = {}

--[[ Fired as (scorer, teamIndex, points) when the puck goes in. ]]
HockeyService.Goal = Signal.new()

--[[ Fired as (winner, loser, brokeStick) when a fight is settled. ]]
HockeyService.FightOver = Signal.new()

--[[
	Who has the puck, and where they may not pick it up again yet.

	Possession is the whole difference between a rink and a rink with a
	puck lying on it: you carry it, you can be checked off it, and you shoot
	it where you are looking. Before this the puck was only ever something to
	shoot at from a distance.
]]
local puckOwner: Player? = nil
local pickupBlockedUntil: { [Player]: number } = {}
local goalLights: { [number]: BasePart } = {}
local penaltyBox = Vector3.new()

local RINK_LENGTH = 300
local RINK_WIDTH = 150
local BOARD_HEIGHT = 11
local CORNER_SEGMENTS = 4

local rink: Model? = nil
local puck: BasePart? = nil
local puckHome = Vector3.new()
local goalZones: { { part: Part, defendingTeam: number } } = {}
local lastGoalAt = 0

type Fight = {
	a: Player,
	b: Player,
	endsAt: number,
	swings: { [Player]: number },
}
local fights: { Fight } = {}
local fightOf: { [Player]: Fight } = {}

-- ================================================================= GEOMETRY ==

--[[
	The boards.

	Straight runs down the sides and ends, with the corners cut across in
	short segments. A rink with square corners reads as a swimming pool.
]]
local function boards(centre: Vector3, parent: Instance)
	local halfLength = RINK_LENGTH * 0.5
	local halfWidth = RINK_WIDTH * 0.5
	local cornerCut = 46

	local function board(from: Vector3, to: Vector3)
		local delta = to - from
		local length = delta.Magnitude
		if length < 1 then
			return
		end
		local middle = from + delta * 0.5
		local facing = CFrame.lookAt(middle, to)

		Util.Part({
			Name = "Boards",
			Size = Vector3.new(3, BOARD_HEIGHT, length),
			CFrame = facing * CFrame.new(0, BOARD_HEIGHT * 0.5, 0),
			Color = Color3.fromRGB(236, 240, 246),
			Material = Enum.Material.SmoothPlastic,
			Parent = parent,
		})

		-- The kick plate along the bottom, in team-neutral yellow, which is
		-- what every rink has and what makes it read as a rink.
		Util.Part({
			Name = "KickPlate",
			Size = Vector3.new(3.4, 2, length),
			CFrame = facing * CFrame.new(0, 1, 0),
			Color = Color3.fromRGB(240, 196, 40),
			Material = Enum.Material.SmoothPlastic,
			Parent = parent,
		})

		-- Glass above it, low enough to shoot over from outside but high
		-- enough to keep the puck in.
		Util.Part({
			Name = "RinkGlass",
			Size = Vector3.new(1.2, 9, length),
			CFrame = facing * CFrame.new(0, BOARD_HEIGHT + 4.5, 0),
			Color = Color3.fromRGB(200, 226, 240),
			Material = Enum.Material.Glass,
			Transparency = 0.72,
			Reflectance = 0.2,
			Parent = parent,
		})
	end

	-- The eight points of a rounded rectangle, walked in order.
	local outline = {
		Vector3.new(-halfWidth, 0, -halfLength + cornerCut),
		Vector3.new(-halfWidth + cornerCut, 0, -halfLength),
		Vector3.new(halfWidth - cornerCut, 0, -halfLength),
		Vector3.new(halfWidth, 0, -halfLength + cornerCut),
		Vector3.new(halfWidth, 0, halfLength - cornerCut),
		Vector3.new(halfWidth - cornerCut, 0, halfLength),
		Vector3.new(-halfWidth + cornerCut, 0, halfLength),
		Vector3.new(-halfWidth, 0, halfLength - cornerCut),
	}

	local cornerArcs = {
		[1] = { pivot = Vector3.new(-halfWidth + cornerCut, 0, -halfLength + cornerCut), a0 = math.pi, a1 = math.pi * 1.5 },
		[3] = { pivot = Vector3.new(halfWidth - cornerCut, 0, -halfLength + cornerCut), a0 = math.pi * 1.5, a1 = math.pi * 2 },
		[5] = { pivot = Vector3.new(halfWidth - cornerCut, 0, halfLength - cornerCut), a0 = 0, a1 = math.pi * 0.5 },
		[7] = { pivot = Vector3.new(-halfWidth + cornerCut, 0, halfLength - cornerCut), a0 = math.pi * 0.5, a1 = math.pi },
	}

	for index = 1, #outline do
		local arc = cornerArcs[index]
		if arc then
			for step = 0, CORNER_SEGMENTS - 1 do
				local angA = arc.a0 + (arc.a1 - arc.a0) * (step / CORNER_SEGMENTS)
				local angB = arc.a0 + (arc.a1 - arc.a0) * ((step + 1) / CORNER_SEGMENTS)
				local a = centre + arc.pivot + Vector3.new(math.cos(angA) * cornerCut, 0, math.sin(angA) * cornerCut)
				local b = centre + arc.pivot + Vector3.new(math.cos(angB) * cornerCut, 0, math.sin(angB) * cornerCut)
				board(a, b)
			end
		else
			local from = centre + outline[index]
			local to = centre + outline[(index % #outline) + 1]
			board(from, to)
		end
	end
end

--[[ A goal: frame, crossbar, netting, and the zone that counts it. ]]
local function goal(centre: Vector3, facingZ: number, defendingTeam: number, parent: Instance)
	local width = 26
	local height = 15
	local depth = 14
	local rawColour = Config.Teams[defendingTeam] and Config.Teams[defendingTeam].Color
	local colour = if typeof(rawColour) == "BrickColor"
		then rawColour.Color
		elseif typeof(rawColour) == "Color3" then rawColour
		else Color3.fromRGB(200, 60, 60)

	-- Posts and crossbar.
	for _, side in { -1, 1 } do
		Util.Part({
			Name = "GoalPost",
			Size = Vector3.new(1.6, height, 1.6),
			CFrame = CFrame.new(centre + Vector3.new(side * width * 0.5, height * 0.5, 0)),
			Color = colour,
			Material = Enum.Material.Metal,
			Parent = parent,
		})
	end
	Util.Part({
		Name = "GoalBar",
		Size = Vector3.new(width + 1.6, 1.6, 1.6),
		CFrame = CFrame.new(centre + Vector3.new(0, height, 0)),
		Color = colour,
		Material = Enum.Material.Metal,
		Parent = parent,
	})

	-- Netting: a back and two sides, thin and see-through.
	Util.Part({
		Name = "GoalNet",
		Size = Vector3.new(width, height, 0.5),
		CFrame = CFrame.new(centre + Vector3.new(0, height * 0.5, facingZ * depth)),
		Color = Color3.fromRGB(230, 235, 240),
		Material = Enum.Material.Fabric,
		Transparency = 0.45,
		Parent = parent,
	})
	for _, side in { -1, 1 } do
		Util.Part({
			Name = "GoalNet",
			Size = Vector3.new(0.5, height, depth),
			CFrame = CFrame.new(centre + Vector3.new(side * width * 0.5, height * 0.5, facingZ * depth * 0.5)),
			Color = Color3.fromRGB(230, 235, 240),
			Material = Enum.Material.Fabric,
			Transparency = 0.45,
			Parent = parent,
		})
	end

	-- The lamp behind the net, which is the whole drama of a goal.
	local lamp = Util.Part({
		Name = "GoalLight",
		Size = Vector3.new(4, 4, 4),
		CFrame = CFrame.new(centre + Vector3.new(0, height + 6, facingZ * (depth + 4))),
		Shape = Enum.PartType.Ball,
		Color = Color3.fromRGB(70, 14, 14),
		Material = Enum.Material.Neon,
		Parent = parent,
	})
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 40, 40)
	glow.Brightness = 0
	glow.Range = 60
	glow.Parent = lamp
	goalLights[defendingTeam] = lamp

	-- The goal line, painted.
	Util.Part({
		Name = "GoalLine",
		Size = Vector3.new(width + 10, 0.2, 1.4),
		CFrame = CFrame.new(centre + Vector3.new(0, 1.1, 0)),
		Color = Color3.fromRGB(210, 50, 50),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = parent,
	})

	-- And the zone that actually counts it. Not solid, or the puck would
	-- bounce off the thing meant to detect it.
	local zone = Util.Part({
		Name = "GoalZone",
		Size = Vector3.new(width - 2, height - 2, depth),
		CFrame = CFrame.new(centre + Vector3.new(0, height * 0.5, facingZ * depth * 0.5)),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = parent,
	})
	zone:SetAttribute("DefendingTeam", defendingTeam)
	table.insert(goalZones, { part = zone, defendingTeam = defendingTeam })
end

--[[ The ice, the lines and the face-off circles. ]]
local function surface(centre: Vector3, parent: Instance)
	local ice = Util.Part({
		Name = "Ice",
		Size = Vector3.new(RINK_WIDTH, 2, RINK_LENGTH),
		CFrame = CFrame.new(centre + Vector3.new(0, 0, 0)),
		Color = Color3.fromRGB(240, 248, 255),
		Material = Enum.Material.Ice,
		Reflectance = 0.14,
		-- Properly slippery. Skating here is momentum, not walking, and a
		-- car driven onto it is a disaster in the best way.
		CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.02, 0.2, 1, 1),
		Parent = parent,
	})
	ice:SetAttribute("Ice", true)

	-- Centre red line, two blue lines.
	for _, line in {
		{ at = 0, colour = Color3.fromRGB(210, 50, 50), width = 2.4 },
		{ at = -RINK_LENGTH * 0.2, colour = Color3.fromRGB(50, 90, 210), width = 3 },
		{ at = RINK_LENGTH * 0.2, colour = Color3.fromRGB(50, 90, 210), width = 3 },
	} do
		Util.Part({
			Name = "RinkLine",
			Size = Vector3.new(RINK_WIDTH, 0.2, line.width),
			CFrame = CFrame.new(centre + Vector3.new(0, 1.1, line.at)),
			Color = line.colour,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Parent = parent,
		})
	end

	-- Face-off circles, drawn as rings of short arcs.
	for _, spot in {
		Vector3.new(0, 0, 0),
		Vector3.new(-RINK_WIDTH * 0.26, 0, -RINK_LENGTH * 0.3),
		Vector3.new(RINK_WIDTH * 0.26, 0, -RINK_LENGTH * 0.3),
		Vector3.new(-RINK_WIDTH * 0.26, 0, RINK_LENGTH * 0.3),
		Vector3.new(RINK_WIDTH * 0.26, 0, RINK_LENGTH * 0.3),
	} do
		local radius = 15
		for step = 0, 23 do
			local angle = (step / 24) * math.pi * 2
			Util.Part({
				Name = "FaceoffCircle",
				Size = Vector3.new(1.2, 0.2, 4.2),
				CFrame = CFrame.new(
					centre + spot + Vector3.new(math.cos(angle) * radius, 1.1, math.sin(angle) * radius)
				) * CFrame.Angles(0, -angle, 0),
				Color = Color3.fromRGB(210, 50, 50),
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Parent = parent,
			})
		end
	end
end

--[[ A rack of sticks, so the rink comes with something to play it with. ]]
local function stickRack(at: Vector3, parent: Instance)
	Util.Part({
		Name = "StickRack",
		Size = Vector3.new(16, 8, 4),
		CFrame = CFrame.new(at + Vector3.new(0, 4, 0)),
		Color = Color3.fromRGB(96, 70, 46),
		Material = Enum.Material.Wood,
		Parent = parent,
	})
	for index = 0, 5 do
		Util.Part({
			Name = "RackStick",
			Size = Vector3.new(0.7, 11, 0.7),
			CFrame = CFrame.new(at + Vector3.new(-6 + index * 2.4, 7, 0))
				* CFrame.Angles(math.rad(12), 0, 0),
			Color = Color3.fromRGB(190, 170, 140),
			Material = Enum.Material.Wood,
			CanCollide = false,
			Parent = parent,
		})
	end
end

-- ===================================================================== PUCK ==

--[[
	Drop a fresh puck at centre ice.

	Deliberately light and very slippery, so a bullet moves it a long way.
	Shooting the puck IS playing hockey here -- there is no stick-handling
	simulation and there does not need to be one.
]]
local function dropPuck()
	if puck then
		puck:Destroy()
	end

	local fresh = Util.Part({
		Name = "Puck",
		Size = Vector3.new(1.2, 3.4, 3.4),
		CFrame = CFrame.new(puckHome),
		Shape = Enum.PartType.Cylinder,
		Color = Color3.fromRGB(22, 22, 26),
		Material = Enum.Material.Rubber,
		Anchored = false,
		CustomPhysicalProperties = PhysicalProperties.new(0.4, 0.03, 0.35, 1, 1),
		Parent = rink,
	})
	-- A cylinder lies on its own X, so turn it flat.
	fresh.CFrame = CFrame.new(puckHome) * CFrame.Angles(0, 0, math.rad(90))
	fresh:SetAttribute("Puck", true)
	puck = fresh
end

--[[
	A bullet hit the puck.

	This is the shot. The puck takes off along the shot's own direction, hard
	enough to cross the rink, which makes a rifle a perfectly good stick.
]]
function HockeyService.RegisterHit(part: BasePart, attacker: Player?, direction: Vector3?): boolean
	if part:GetAttribute("Puck") ~= true then
		return false
	end

	local push = direction or Vector3.new(0, 0, -1)
	local flat = Vector3.new(push.X, 0, push.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, -1)
	end

	part.AssemblyLinearVelocity = flat.Unit * 190 + Vector3.new(0, 14, 0)
	Sound.At("MeleeHit", part.Position, 1.1)

	if attacker then
		-- Credit for touching it last, so a goal has somebody to name.
		part:SetAttribute("LastTouchUserId", attacker.UserId)
	end
	return true
end

--[[
	Carry the puck, and shoot it.

	The puck is pulled toward a point in front of whoever has it rather than
	welded to them, so it can be checked off, shot away, or lost when they
	are knocked down. Welding would make possession absolute, and a puck
	nobody can take off you is not hockey.
]]
local function stepPossession()
	local live = puck
	if not live or not live.Parent then
		return
	end

	local owner = puckOwner
	if owner then
		local character = owner.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
			puckOwner = nil
		else
			local ahead = root.Position
				+ root.CFrame.LookVector * Config.Hockey.CarryDistance
				- Vector3.new(0, 2.2, 0)
			-- Pulled, not placed: it lags a little and can be knocked loose.
			live.AssemblyLinearVelocity = (ahead - live.Position) * 18
			return
		end
	end

	-- Loose: whoever is closest and on the ice picks it up.
	local now = os.clock()
	for _, player in Players:GetPlayers() do
		if now < (pickupBlockedUntil[player] or 0) then
			continue
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
			continue
		end
		-- Not while in a fight: you have dropped your gloves, not picked up
		-- a stick.
		if fightOf[player] then
			continue
		end
		if (root.Position - live.Position).Magnitude <= Config.Hockey.PickupRange then
			puckOwner = player
			live:SetAttribute("LastTouchUserId", player.UserId)
			Sound.At("Pickup", live.Position, 0.7)
			Remotes.Event("HockeyScore"):FireClient(player, { carrying = true })
			return
		end
	end
end

--[[ Shoot the puck where the shooter is looking. ]]
function HockeyService.ShootPuck(player: Player, direction: any)
	if puckOwner ~= player then
		return
	end
	local live = puck
	if not live or not live.Parent then
		return
	end
	local aim = Util.SaneDirection(direction)
	if not aim then
		return
	end

	puckOwner = nil
	-- A moment before you can scoop it straight back up.
	pickupBlockedUntil[player] = os.clock() + 0.6

	local flat = Vector3.new(aim.X, 0, aim.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, -1)
	end
	live.AssemblyLinearVelocity = flat.Unit * Config.Hockey.ShotSpeed + Vector3.new(0, 9, 0)
	live:SetAttribute("LastTouchUserId", player.UserId)
	Sound.At("MeleeHit", live.Position, 1.1)
end

--[[ Who has it, for tests. ]]
function HockeyService.PuckOwner(): Player?
	return puckOwner
end

--[[ Who last touched the puck, if they are still here. ]]
local function lastToucher(): Player?
	if not puck then
		return nil
	end
	local userId = puck:GetAttribute("LastTouchUserId")
	if typeof(userId) ~= "number" then
		return nil
	end
	for _, player in Players:GetPlayers() do
		if player.UserId == userId then
			return player
		end
	end
	return nil
end

--[[ Did the puck cross a goal line? ]]
local function checkGoals()
	local live = puck
	if not live or not live.Parent then
		return
	end

	-- Reset puck if blasted over the boards or out of bounds.
	local distFromHome = live.Position - puckHome
	if live.Position.Y < -20 or math.abs(distFromHome.X) > RINK_WIDTH * 0.65 or math.abs(distFromHome.Z) > RINK_LENGTH * 0.65 then
		dropPuck()
		return
	end

	local now = os.clock()
	if now - lastGoalAt < 3 then
		return
	end

	for _, zone in goalZones do
		local offset = live.Position - zone.part.Position
		local half = zone.part.Size * 0.5
		if math.abs(offset.X) <= half.X
			and math.abs(offset.Y) <= half.Y
			and math.abs(offset.Z) <= half.Z
		then
			lastGoalAt = now

			-- Light the lamp at the end that was scored on.
			local lamp = goalLights[zone.defendingTeam]
			if lamp then
				lamp.Color = Color3.fromRGB(255, 40, 40)
				local glow = lamp:FindFirstChildOfClass("PointLight")
				if glow then
					glow.Brightness = 6
				end
				task.delay(2.5, function()
					if lamp.Parent then
						lamp.Color = Color3.fromRGB(70, 14, 14)
						local dim = lamp:FindFirstChildOfClass("PointLight")
						if dim then
							dim.Brightness = 0
						end
					end
				end)
			end

			local scorer = lastToucher()
			-- The goal belongs to whoever is NOT defending it.
			local scoringTeam = if zone.defendingTeam == 1 then 2 else 1
			local points = Config.Hockey.GoalPoints

			if scorer and TeamService.IndexOf(scorer) == scoringTeam then
				PlayerState.AwardPoints(scorer, points)
			end
			HockeyService.Goal.Fire(scorer, scoringTeam, points)

			Sound.At("RoundEnd", live.Position, 1.2)
			dropPuck()
			puckOwner = nil
			return
		end
	end
end

-- ==================================================================== FIGHTS ==

--[[
	A hockey fight, Blades of Steel style.

	Two opposing players, both mashing, for a few seconds. The one who
	swings most wins: the loser goes down, the winner takes the points, and
	the winner's stick has a good chance of breaking over them -- at which
	point the splintered half becomes a genuinely nasty melee weapon.

	Note what does NOT happen: nobody's guns are taken away. You can shoot
	your way out of a fight, or shoot two other people having one. That is
	the rule for every sport on this map and a fight is no exception; it just
	means the scrap is a gamble rather than a cutscene.
]]
function HockeyService.StartFight(a: Player, b: Player): boolean
	if fightOf[a] or fightOf[b] then
		return false
	end
	if a == b or (a.Team and b.Team and a.Team == b.Team) then
		return false
	end

	local fight: Fight = {
		a = a,
		b = b,
		endsAt = os.clock() + Config.Hockey.FightSeconds,
		swings = { [a] = 0, [b] = 0 },
	}
	table.insert(fights, fight)
	fightOf[a] = fight
	fightOf[b] = fight

	for _, who in { a, b } do
		local foe = if who == a then b else a
		Remotes.Event("FightStarted"):FireClient(who, {
			opponent = foe.DisplayName,
			duration = Config.Hockey.FightSeconds,
		})
	end

	Remotes.Event("KillFeed"):FireAllClients(
		`{a.DisplayName} and {b.DisplayName} are going at it`,
		false
	)
	return true
end

local lastSwingAt: { [Player]: number } = {}

--[[ A swing thrown during a fight. The client sends one per mash (rate-limited). ]]
function HockeyService.Swing(player: Player)
	local fight = fightOf[player]
	if not fight then
		return
	end
	local now = os.clock()
	if now - (lastSwingAt[player] or 0) < 0.08 then
		return
	end
	lastSwingAt[player] = now
	fight.swings[player] = (fight.swings[player] or 0) + 1
end

local function settle(fight: Fight)
	fightOf[fight.a] = nil
	fightOf[fight.b] = nil

	local aSwings = fight.swings[fight.a] or 0
	local bSwings = fight.swings[fight.b] or 0

	local winner, loser
	if aSwings == bSwings then
		-- A dead heat is a draw: both of them look silly and neither falls.
		for _, who in { fight.a, fight.b } do
			Remotes.Event("FightResult"):FireClient(who, { won = false, draw = true })
		end
		return
	elseif aSwings > bSwings then
		winner, loser = fight.a, fight.b
	else
		winner, loser = fight.b, fight.a
	end

	PlayerState.AwardPoints(winner, Config.Hockey.FightWinPoints)

	-- The loser goes down. Not killed -- knocked over, which is both funnier
	-- and leaves them in the game.
	local loserCharacter = loser.Character
	local loserHumanoid = loserCharacter and loserCharacter:FindFirstChildOfClass("Humanoid")
	if loserHumanoid then
		loserHumanoid.PlatformStand = true
		task.delay(Config.Hockey.KnockdownSeconds, function()
			if loserHumanoid and loserHumanoid.Parent then
				loserHumanoid.PlatformStand = false
			end
		end)
	end

	-- And the stick may well break. The splintered half is the prize.
	local brokeStick = math.random() < Config.Hockey.StickBreakChance
	if brokeStick then
		local state = PlayerState.Get(winner)
		local spec = Config.Weapons[Config.Hockey.BrokenStickWeapon]
		if spec then
			state.weapons[Config.Hockey.BrokenStickWeapon] = {
				ammo = spec.MagSize,
				reloadingUntil = 0,
				nextFireAt = 0,
			}
			state.equipped = Config.Hockey.BrokenStickWeapon
			PlayerState.Changed.Fire(winner)
		end
	end

	Remotes.Event("FightResult"):FireClient(winner, { won = true, brokeStick = brokeStick })
	Remotes.Event("FightResult"):FireClient(loser, { won = false, brokeStick = false })
	Remotes.Event("KillFeed"):FireAllClients(
		`{winner.DisplayName} won the fight with {loser.DisplayName}`
			.. (if brokeStick then " and broke their stick over them" else ""),
		false
	)

	HockeyService.FightOver.Fire(winner, loser, brokeStick)
end

--[[ Is this player on the ice? Fights only start on the rink. ]]
function HockeyService.OnIce(player: Player): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") or not rink then
		return false
	end
	local ice = rink:FindFirstChild("Ice")
	if not ice or not ice:IsA("BasePart") then
		return false
	end
	local offset = root.Position - ice.Position
	return math.abs(offset.X) <= RINK_WIDTH * 0.5
		and math.abs(offset.Z) <= RINK_LENGTH * 0.5
		and offset.Y > -6
		and offset.Y < 30
end

-- ===================================================================== BUILD ==

function HockeyService.Clear()
	for _, fight in fights do
		for _, fighter in { fight.a, fight.b } do
			if fighter.Parent then
				Remotes.Event("FightResult"):FireClient(fighter, { won = false, draw = true, brokeStick = false })
			end
		end
	end
	if rink then
		rink:Destroy()
		rink = nil
	end
	puck = nil
	table.clear(goalZones)
	table.clear(fights)
	table.clear(fightOf)
	table.clear(lastSwingAt)
end

--[[ Put the rink down, off to one side of the city. ]]
function HockeyService.Build(mapSize: number)
	HockeyService.Clear()

	local model = Instance.new("Model")
	model.Name = "HockeyRink"
	rink = model

	-- Opposite the carnival, so the two distractions are not on top of each
	-- other and both are a drive from the middle.
	local centre = Vector3.new(-mapSize * 0.3, 0, mapSize * 0.06)

	surface(centre, model)
	boards(centre, model)

	goal(centre + Vector3.new(0, 0, -RINK_LENGTH * 0.42), -1, 1, model)
	goal(centre + Vector3.new(0, 0, RINK_LENGTH * 0.42), 1, 2, model)

	stickRack(centre + Vector3.new(RINK_WIDTH * 0.5 + 14, 0, 0), model)
	stickRack(centre + Vector3.new(-RINK_WIDTH * 0.5 - 14, 0, 0), model)

	model.Parent = workspace

	puckHome = centre + Vector3.new(0, 4, 0)
	dropPuck()

	-- Offer it as a sub-game: walk in and it asks, or pick it from the menu
	-- and you are brought here.
	ArcadeService.Register({
		id = "hockey",
		name = "Ice Hockey",
		objective = "Shoot the puck into their net. Stick to an opponent starts a fight.",
		centre = centre,
		spawns = {
			centre + Vector3.new(-30, 4, -40),
			centre + Vector3.new(30, 4, -40),
			centre + Vector3.new(-30, 4, 40),
			centre + Vector3.new(30, 4, 40),
		},
		perTeam = 4,
		teamed = true,
	})

	return { centre = centre, puckHome = puckHome }
end

--[[ Where the rink sits, so the city is not built on top of it. ]]
function HockeyService.ReservedArea(mapSize: number): { centre: Vector3, radius: number }
	return {
		centre = Vector3.new(-mapSize * 0.3, 0, mapSize * 0.06),
		radius = RINK_LENGTH * 0.5 + 30,
	}
end

local hockeyStarted = false

local function isAlive(p: Player): boolean
	if p.Parent == nil then
		return false
	end
	local char = p.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end

function HockeyService.Start()
	if hockeyStarted then
		return
	end
	hockeyStarted = true

	Remotes.Event("FightSwing").OnServerEvent:Connect(function(player: Player)
		HockeyService.Swing(player)
	end)

	Remotes.Event("HockeyShoot").OnServerEvent:Connect(function(player: Player, direction)
		HockeyService.ShootPuck(player, direction)
	end)

	RunService.Heartbeat:Connect(function()
		checkGoals()
		stepPossession()

		local now = os.clock()
		for index = #fights, 1, -1 do
			local fight = fights[index]
			local aGone = not isAlive(fight.a)
			local bGone = not isAlive(fight.b)
			if now >= fight.endsAt or aGone or bGone then
				table.remove(fights, index)
				if aGone or bGone then
					fightOf[fight.a] = nil
					fightOf[fight.b] = nil
					for _, fighter in { fight.a, fight.b } do
						if fighter.Parent then
							Remotes.Event("FightResult"):FireClient(fighter, { won = false, draw = true, brokeStick = false })
						end
					end
				else
					settle(fight)
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		fightOf[player] = nil
		lastSwingAt[player] = nil
	end)
end

--[[ How many fights are running, for tests. ]]
function HockeyService.FightCount(): number
	return #fights
end

--[[ The puck itself, for tests. ]]
function HockeyService.Puck(): BasePart?
	return puck
end

return HockeyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MapService — builds the whole arena out of code.

	Nothing here is hand-modelled, so changing a map means changing numbers in
	Config.Maps rather than opening the 3D editor.

	Two rules every piece obeys:

	  1. YOU CAN DRIVE IT. Doorways are wide and tall enough to take a truck,
	     every roof has a ramp, and no vehicle route has a step in it.
	  2. YOU CAN WALK IT. Buildings are hollow, with hallways and real
	     staircases inside, so a player on foot has somewhere to fight that
	     is not just open mud.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local ResortService = require(script.Parent:WaitForChild("ResortService"))
local HockeyService = require(script.Parent:WaitForChild("HockeyService"))

local MapService = {}

export type MapBuild = {
	model: Model,
	teamSpawns: { [number]: { Vector3 } },
	vehiclePads: { { position: Vector3, kind: string } },
	pickupPads: { { position: Vector3, kind: string, weapon: string? } },
	resort: ResortService.ResortBuild,
}

local SLAB = 3 -- thickness of floors and ramps
local FLOOR_HEIGHT = 18 -- tall enough to drive a truck through a storey
local DOOR_WIDTH = 22 -- wide enough for a truck
local DOOR_HEIGHT = 14
local WALL_THICKNESS = 2
local STAIR_STEPS = 14

-- ============================================================ BASIC PIECES ==

--[[
	A sloped slab connecting two points. This one function builds every ramp,
	every jump and every bridge in the game.
]]
local function ramp(from: Vector3, to: Vector3, width: number, color: Color3, parent: Instance): Part
	local delta = to - from
	local length = math.max(delta.Magnitude, 0.1)
	local mid = from + delta * 0.5

	-- CFrame.lookAt points the part's -Z at the target and Size.Z runs along
	-- that axis, so a part sized (width, thickness, length) becomes the ramp.
	return Util.Part({
		Name = "Ramp",
		Size = Vector3.new(width, SLAB, length),
		CFrame = CFrame.lookAt(mid, to),
		Color = color,
		Material = Enum.Material.Concrete,
		Parent = parent,
	})
end

--[[
	A staircase. Built from real steps rather than a slope, because indoors
	you want somewhere to fight, not a ski jump — and stairs read as stairs.
	Vehicles use the outside ramp instead.
]]
local function staircase(bottom: Vector3, direction: Vector3, rise: number, width: number, color: Color3, parent: Instance)
	local flat = Vector3.new(direction.X, 0, direction.Z)
	flat = if flat.Magnitude < 0.01 then Vector3.new(0, 0, 1) else flat.Unit

	local stepRise = rise / STAIR_STEPS
	local stepRun = 1.55

	for index = 1, STAIR_STEPS do
		local centre = bottom
			+ flat * (index * stepRun)
			+ Vector3.new(0, index * stepRise - stepRise * 0.5, 0)

		local step = Util.Part({
			Name = "Step",
			Size = Vector3.new(width, stepRise, stepRun),
			CFrame = CFrame.lookAt(centre, centre + flat),
			Color = color,
			Material = Enum.Material.Concrete,
			Parent = parent,
		})
		local _ = step
	end
end

--[[
	A wall with a doorway punched through the middle of it: a panel either
	side and a lintel across the top.
]]
local function wallWithDoor(
	centre: Vector3,
	facing: Vector3,
	length: number,
	height: number,
	color: Color3,
	parent: Instance
)
	local flat = Vector3.new(facing.X, 0, facing.Z)
	flat = if flat.Magnitude < 0.01 then Vector3.new(0, 0, 1) else flat.Unit
	-- The wall runs at right angles to the way it faces.
	local along = Vector3.new(-flat.Z, 0, flat.X)

	local sideLength = math.max((length - DOOR_WIDTH) * 0.5, 0.5)
	local orientation = CFrame.lookAt(centre, centre + flat)

	for _, side in { -1, 1 } do
		local offset = side * (DOOR_WIDTH * 0.5 + sideLength * 0.5)
		local panelCentre = centre + along * offset + Vector3.new(0, height * 0.5, 0)
		Util.Part({
			Name = "Wall",
			Size = Vector3.new(sideLength, height, WALL_THICKNESS),
			CFrame = CFrame.lookAt(panelCentre, panelCentre + flat),
			Color = color,
			Material = Enum.Material.Brick,
			Parent = parent,
		})
	end

	-- Lintel over the door.
	if height > DOOR_HEIGHT then
		local lintelHeight = height - DOOR_HEIGHT
		local lintelCentre = centre + Vector3.new(0, DOOR_HEIGHT + lintelHeight * 0.5, 0)
		Util.Part({
			Name = "Lintel",
			Size = Vector3.new(DOOR_WIDTH, lintelHeight, WALL_THICKNESS),
			CFrame = CFrame.lookAt(lintelCentre, lintelCentre + flat),
			Color = color,
			Material = Enum.Material.Brick,
			Parent = parent,
		})
	end

	local _ = orientation
end

--[[
	One floor slab with a square hole cut in one corner for the stairwell.
	Built from two rectangles, because that is how you make a hole without
	needing modelling tools.
]]
local function floorWithStairwell(centre: Vector3, footprint: number, holeSize: number, color: Color3, parent: Instance)
	local half = footprint * 0.5

	-- The big piece: full width, stopping short of the stairwell strip.
	Util.Part({
		Name = "Floor",
		Size = Vector3.new(footprint, SLAB, footprint - holeSize),
		CFrame = CFrame.new(centre + Vector3.new(0, 0, -holeSize * 0.5)),
		Color = color,
		Material = Enum.Material.Concrete,
		Parent = parent,
	})

	-- The remaining strip, minus the corner that stays open.
	Util.Part({
		Name = "Floor",
		Size = Vector3.new(footprint - holeSize, SLAB, holeSize),
		CFrame = CFrame.new(centre + Vector3.new(-holeSize * 0.5, 0, half - holeSize * 0.5)),
		Color = color,
		Material = Enum.Material.Concrete,
		Parent = parent,
	})
end

-- ================================================================ BUILDINGS ==

--[[
	A building you can drive into, walk through, climb, and fight on top of.

	Ground floor and every floor above it are hollow, with doorways on all
	four sides and a partition down the middle making two hallways. A
	staircase in one corner connects the floors on foot; a switchback ramp
	around the outside gets vehicles to the roof.
]]
--[[
	A hollow building you can fight through.

	`vehicleRamp` decides whether it gets the switchback ramp around the
	outside. A tower with one needs a whole city block to itself; without it
	the footprint is all the room it takes, which is what makes it possible
	to put two low buildings in a block and get a dense street rather than
	a handful of islands.
]]
local function building(
	origin: Vector3,
	footprint: number,
	floors: number,
	color: Color3,
	parent: Instance,
	vehicleRamp: boolean?
)
	local half = footprint * 0.5
	local height = floors * FLOOR_HEIGHT
	local holeSize = 24

	-- Ground slab, so the inside is a floor and not open mud.
	Util.Part({
		Name = "Floor",
		Size = Vector3.new(footprint, SLAB, footprint),
		CFrame = CFrame.new(origin + Vector3.new(0, SLAB * 0.5, 0)),
		Color = color:Lerp(Color3.fromRGB(60, 60, 60), 0.3),
		Material = Enum.Material.Concrete,
		Parent = parent,
	})

	for floor = 0, floors - 1 do
		local baseY = floor * FLOOR_HEIGHT + SLAB

		-- Four walls, each with a doorway wide enough to drive through.
		for _, facing in { Vector3.new(0, 0, 1), Vector3.new(0, 0, -1), Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0) } do
			wallWithDoor(
				origin + facing * half + Vector3.new(0, baseY, 0),
				facing,
				footprint,
				FLOOR_HEIGHT,
				color,
				parent
			)
		end

		-- An interior partition, offset from centre, making a long hallway on
		-- one side and rooms on the other. Left open at both ends.
		local partitionLength = footprint * 0.45
		Util.Part({
			Name = "Partition",
			Size = Vector3.new(WALL_THICKNESS, FLOOR_HEIGHT, partitionLength),
			CFrame = CFrame.new(origin + Vector3.new(-footprint * 0.12, baseY + FLOOR_HEIGHT * 0.5, 0)),
			Color = color:Lerp(Color3.fromRGB(230, 230, 230), 0.25),
			Material = Enum.Material.Brick,
			Parent = parent,
		})

		-- The ceiling of this floor is the floor of the next, with a hole in
		-- the corner for the stairs to come up through.
		local ceilingY = baseY + FLOOR_HEIGHT
		floorWithStairwell(
			origin + Vector3.new(0, ceilingY, 0),
			footprint,
			holeSize,
			color:Lerp(Color3.fromRGB(60, 60, 60), 0.3),
			parent
		)

		-- Stairs up through that hole, tucked into the corner it leaves open.
		staircase(
			origin + Vector3.new(half - holeSize * 0.5, baseY, half - holeSize),
			Vector3.new(0, 0, 1),
			FLOOR_HEIGHT,
			holeSize * 0.7,
			color:Lerp(Color3.fromRGB(200, 200, 200), 0.3),
			parent
		)
	end

	-- Architectural glazing bands on upper floors so buildings catch sky reflections under Future lighting.
	for floor = 2, floors do
		local wy = (floor - 1) * FLOOR_HEIGHT + FLOOR_HEIGHT * 0.56
		local bandW = math.max(12, footprint - 14)
		for _, side in { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) } do
			Util.Part({
				Name = "WindowBand",
				Size = Vector3.new(
					if side.X ~= 0 then 0.6 else bandW,
					5.5,
					if side.Z ~= 0 then 0.6 else bandW
				),
				CFrame = CFrame.new(origin + side * (half + 0.15) + Vector3.new(0, wy, 0)),
				Color = Color3.fromRGB(48, 68, 86),
				Material = Enum.Material.Glass,
				Reflectance = 0.42,
				Transparency = 0.18,
				CanCollide = false,
				Parent = parent,
			})
		end
	end

	-- Roof lip with a gap on the vehicle ramp entry side so cars drive cleanly onto the roof.
	local roofY = floors * FLOOR_HEIGHT + SLAB
	for _, side in { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) } do
		if vehicleRamp ~= false and side.Z == -1 then
			continue
		end
		Util.Part({
			Name = "RoofLip",
			Size = Vector3.new(
				if side.X ~= 0 then 2 else footprint,
				4,
				if side.Z ~= 0 then 2 else footprint
			),
			CFrame = CFrame.new(origin + side * half + Vector3.new(0, roofY + 2, 0)),
			Color = color:Lerp(Color3.new(0, 0, 0), 0.25),
			Material = Enum.Material.Concrete,
			Parent = parent,
		})
	end

	-- Rooftop HVAC unit for realistic skyline silhouette.
	Util.Part({
		Name = "RoofHVAC",
		Size = Vector3.new(8, 4.5, 6),
		CFrame = CFrame.new(origin + Vector3.new(-half * 0.45, roofY + 2.25, -half * 0.45)),
		Color = Color3.fromRGB(132, 138, 144),
		Material = Enum.Material.Metal,
		Parent = parent,
	})

	if vehicleRamp == false then
		return roofY
	end

	-- The vehicle route: a ramp that switchbacks around the outside, with a
	-- flat landing at every corner so you do not clip the turn.
	local rampWidth = 16
	local outset = half + rampWidth * 0.5
	local corners = {
		Vector3.new(outset, 0, outset),
		Vector3.new(-outset, 0, outset),
		Vector3.new(-outset, 0, -outset),
		Vector3.new(outset, 0, -outset),
	}

	local runs = floors * 2
	local rise = roofY / runs
	local rampColor = color:Lerp(Color3.fromRGB(90, 90, 90), 0.4)

	for index = 0, runs - 1 do
		local fromCorner = corners[(index % 4) + 1]
		local toCorner = corners[((index + 1) % 4) + 1]

		ramp(
			origin + fromCorner + Vector3.new(0, index * rise, 0),
			origin + toCorner + Vector3.new(0, (index + 1) * rise, 0),
			rampWidth,
			rampColor,
			parent
		)

		Util.Part({
			Name = "RampLanding",
			Size = Vector3.new(rampWidth, SLAB, rampWidth),
			CFrame = CFrame.new(origin + toCorner + Vector3.new(0, (index + 1) * rise, 0)),
			Color = rampColor,
			Material = Enum.Material.Concrete,
			Parent = parent,
		})
	end

	-- Bridge the top of the ramp onto the roof.
	local topCorner = corners[(runs % 4) + 1]
	ramp(
		origin + topCorner + Vector3.new(0, roofY, 0),
		origin + topCorner * 0.4 + Vector3.new(0, roofY + SLAB * 0.5, 0),
		rampWidth,
		rampColor,
		parent
	)

	return roofY
end

-- =================================================================== PIECES ==

--[[
	A barricade: a long, low wall you can crouch behind and shoot over, with
	a sandbag look. Scattered thickly, because open ground is no fun on foot.
]]
local function barricade(origin: Vector3, heading: number, rng: Random, parent: Instance)
	local length = rng:NextNumber(18, 34)
	local height = rng:NextNumber(6, 9)
	local facing = CFrame.Angles(0, heading, 0)

	local wall = Util.Part({
		Name = "Barricade",
		Size = Vector3.new(length, height, 3.5),
		CFrame = CFrame.new(origin + Vector3.new(0, height * 0.5, 0)) * facing,
		Color = Color3.fromRGB(118, 106, 84),
		Material = Enum.Material.Sandstone,
		Parent = parent,
	})
	wall:SetAttribute("Destructible", true)

	-- A stack of sandbags along the top, so it reads as cover rather than
	-- a random slab.
	for bag = 0, 2 do
		local offset = -length * 0.3 + bag * (length * 0.3)
		Util.Part({
			Name = "Sandbag",
			Size = Vector3.new(length * 0.28, 2.4, 4.4),
			CFrame = CFrame.new(origin + Vector3.new(0, height + 1.2, 0)) * facing * CFrame.new(offset, 0, 0),
			Color = Color3.fromRGB(132, 118, 92),
			Material = Enum.Material.Sand,
			Parent = parent,
		})
	end
end

--[[
	Boost arrows: chevrons painted on the run-up to a jump. Drive over them
	and the vehicle is flung forward, which is what turns a ramp into real
	air rather than a gentle hop.
]]
local function boostArrows(origin: Vector3, direction: Vector3, parent: Instance)
	local flat = Vector3.new(direction.X, 0, direction.Z)
	flat = if flat.Magnitude < 0.01 then Vector3.new(0, 0, 1) else flat.Unit

	-- Two chevrons, close in. Four spread over sixty studs was a long enough
	-- run-up to arrive at the ramp far too fast.
	for step = 1, 2 do
		local centre = origin - flat * (step * 11)
		-- Each chevron is two angled bars meeting at a point.
		for _, side in { -1, 1 } do
			local bar = Util.Part({
				Name = "BoostPad",
				Size = Vector3.new(3, 0.6, 9),
				CFrame = CFrame.lookAt(centre + Vector3.new(0, 1.1, 0), centre + Vector3.new(0, 1.1, 0) + flat)
					* CFrame.new(side * 4, 0, 0)
					* CFrame.Angles(0, side * math.rad(28), 0),
				Color = Color3.fromRGB(255, 190, 40),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = parent,
			})
			bar:SetAttribute("Boost", true)
		end
	end
end

--[[ A stunt jump: launch ramp, a real gap, and a landing ramp to catch you. ]]
local function stuntJump(origin: Vector3, direction: Vector3, scale: number, color: Color3, parent: Instance)
	local flat = Vector3.new(direction.X, 0, direction.Z)
	flat = if flat.Magnitude < 0.01 then Vector3.new(0, 0, 1) else flat.Unit

	local launchLength = 40 * scale
	local launchHeight = 16 * scale
	local gap = 70 * scale
	local width = 26

	-- Chevrons on the run-up.
	boostArrows(origin, flat, parent)

	ramp(origin, origin + flat * launchLength + Vector3.new(0, launchHeight, 0), width, color, parent)

	-- A kicker at the top so the car leaves the ground cleanly.
	local lipCentre = origin + flat * (launchLength + 4) + Vector3.new(0, launchHeight + 1, 0)
	Util.Part({
		Name = "JumpLip",
		Size = Vector3.new(width, SLAB, 8),
		CFrame = CFrame.lookAt(lipCentre, lipCentre + flat) * CFrame.Angles(math.rad(-18), 0, 0),
		Color = color,
		Material = Enum.Material.DiamondPlate,
		Parent = parent,
	})

	local landingStart = origin + flat * (launchLength + gap)
	ramp(
		landingStart + Vector3.new(0, launchHeight * 0.75, 0),
		landingStart + flat * (launchLength * 1.4),
		width + 10,
		color,
		parent
	)
end

--[[
	The street grid.

	Roads are laid first and everything else is fitted into the blocks they
	leave, which is the whole difference between a city and a field with
	buildings dropped on it. Returns the grid offsets so the rest of the
	build can line up with them.
]]
local ROAD_WIDTH = 40

local function streets(size: number, pitch: number, offsets: { number }, parent: Instance)
	local roadColor = Color3.fromRGB(52, 54, 58)
	local kerbColor = Color3.fromRGB(148, 146, 140)
	local span = if #offsets >= 2 then (offsets[#offsets] - offsets[1]) + ROAD_WIDTH else size

	for _, offset in offsets do
		-- The carriageway, both ways; slight 0.02 Y offset eliminates Z-fighting at junctions.
		for _, alongZ in { true, false } do
			local yRoad = if alongZ then 0.6 else 0.62
			local yLine = if alongZ then 1.13 else 1.15
			Util.Part({
				Name = "Street",
				Size = if alongZ
					then Vector3.new(ROAD_WIDTH, 1, span)
					else Vector3.new(span, 1, ROAD_WIDTH),
				CFrame = if alongZ then CFrame.new(offset, yRoad, 0) else CFrame.new(0, yRoad, offset),
				Color = roadColor,
				Material = Enum.Material.Asphalt,
				Parent = parent,
			})

			-- Centre line, so the road reads as a road at speed.
			Util.Part({
				Name = "Line",
				Size = if alongZ then Vector3.new(1.4, 0.1, span) else Vector3.new(span, 0.1, 1.4),
				CFrame = if alongZ then CFrame.new(offset, yLine, 0) else CFrame.new(0, yLine, offset),
				Color = Color3.fromRGB(220, 196, 86),
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Parent = parent,
			})

			-- Segmented kerbs between intersections so kerbs never block cross-streets.
			for _, side in { -1, 1 } do
				local edge = offset + side * (ROAD_WIDTH * 0.5 + 2)
				for seg = 1, #offsets - 1 do
					local segStart = offsets[seg] + ROAD_WIDTH * 0.5 + 4
					local segEnd = offsets[seg + 1] - ROAD_WIDTH * 0.5 - 4
					local segLen = segEnd - segStart
					if segLen > 4 then
						local mid = (segStart + segEnd) * 0.5
						Util.Part({
							Name = "Kerb",
							Size = if alongZ then Vector3.new(4, 1.4, segLen) else Vector3.new(segLen, 1.4, 4),
							CFrame = if alongZ then CFrame.new(edge, 0.9, mid) else CFrame.new(mid, 0.9, edge),
							Color = kerbColor,
							Material = Enum.Material.Concrete,
							Parent = parent,
						})
					end
				end
			end
		end
	end

	-- Zebra crossings, at the interior intersections only and three stripes
	-- wide. It is the detail that stops a grid of grey strips reading as a
	-- car park, but five stripes on every junction of a large map is well
	-- over a thousand parts of paint for no extra legibility.
	for xi = 2, #offsets - 1 do
		for zi = 2, #offsets - 1 do
			local x, z = offsets[xi], offsets[zi]
			for _, axis in { true, false } do
				for stripe = -1, 1 do
					local slide = stripe * 7
					local reach = ROAD_WIDTH * 0.5 + 4
					Util.Part({
						Name = "Crossing",
						Size = if axis
							then Vector3.new(4, 1, reach)
							else Vector3.new(reach, 1, 4),
						CFrame = if axis
							then CFrame.new(x + slide, 1.15, z + (ROAD_WIDTH * 0.5 + reach * 0.5))
							else CFrame.new(x + (ROAD_WIDTH * 0.5 + reach * 0.5), 1.15, z + slide),
						Color = Color3.fromRGB(225, 225, 220),
						Material = Enum.Material.SmoothPlastic,
						CanCollide = false,
						Parent = parent,
					})
				end
			end
		end
	end

	-- Street lights, at every other junction and two to a junction. These
	-- carry a real PointLight, which is most of what makes a street look
	-- built rather than drawn -- and also the most expensive thing here, so
	-- there are tens of them rather than hundreds.
	for xi = 1, #offsets, 2 do
		for zi = 1, #offsets, 2 do
			local x, z = offsets[xi], offsets[zi]
			for _, corner in { Vector2.new(-1, -1), Vector2.new(1, 1) } do
				local base = Vector3.new(
					x + corner.X * (ROAD_WIDTH * 0.5 + 6),
					0,
					z + corner.Y * (ROAD_WIDTH * 0.5 + 6)
				)

				local post = Util.Part({
					Name = "LampPost",
					Size = Vector3.new(1, 26, 1),
					CFrame = CFrame.new(base + Vector3.new(0, 13, 0)),
					Color = Color3.fromRGB(70, 72, 76),
					Material = Enum.Material.Metal,
					Parent = parent,
				})

				local head = Util.Part({
					Name = "Lamp",
					Size = Vector3.new(3.5, 1.2, 3.5),
					CFrame = CFrame.new(base + Vector3.new(0, 26, 0)),
					Color = Color3.fromRGB(255, 240, 200),
					Material = Enum.Material.Neon,
					CanCollide = false,
					Parent = parent,
				})
				Util.Weld(post, head)

				local glow = Instance.new("PointLight")
				glow.Color = Color3.fromRGB(255, 236, 190)
				glow.Brightness = 1.8
				glow.Range = 52
				glow.Parent = head
			end
		end
	end
end

local function mudPatch(origin: Vector3, size: number, parent: Instance)
	Util.Part({
		Name = "Mud",
		Size = Vector3.new(size, 2, size),
		CFrame = CFrame.new(origin + Vector3.new(0, 0.5, 0)),
		Color = Color3.fromRGB(86, 64, 42),
		Material = Enum.Material.Mud,
		Parent = parent,
	})
end

local function cover(origin: Vector3, rng: Random, color: Color3, parent: Instance)
	local block = Util.Part({
		Name = "Cover",
		Size = Vector3.new(rng:NextNumber(8, 20), rng:NextNumber(6, 12), rng:NextNumber(8, 20)),
		CFrame = CFrame.new(origin) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0),
		Color = color:Lerp(Color3.fromRGB(60, 60, 60), rng:NextNumber(0, 0.5)),
		Material = Enum.Material.Concrete,
		Parent = parent,
	})
	block.CFrame = block.CFrame + Vector3.new(0, block.Size.Y * 0.5, 0)
	block:SetAttribute("Destructible", true)
end

--[[
	A real SpawnLocation for a team.

	Using Roblox's own spawn system rather than teleporting people around is
	what stops anybody ever appearing in mid-air: the engine will not place a
	character until it has one of these to place them on.
]]
local function teamSpawn(position: Vector3, teamColor: BrickColor, parent: Instance)
	local pad = Instance.new("SpawnLocation")
	pad.Name = "TeamSpawn"
	pad.Size = Vector3.new(14, 1, 14)
	pad.CFrame = CFrame.new(position)
	pad.Anchored = true
	pad.CanCollide = true
	pad.TeamColor = teamColor
	pad.Neutral = false
	pad.BrickColor = teamColor
	pad.Material = Enum.Material.Neon
	pad.Duration = 0
	pad.Parent = parent
	return pad
end

-- ==================================================================== BUILD ==

function MapService.Build(mapConfig: any, teamColors: { BrickColor }): MapBuild
	MapService.Clear()

	local model = Instance.new("Model")
	model.Name = "Arena"

	local size = mapConfig.Size
	local half = size * 0.5
	-- Deterministic polynomial hash of mapConfig.Id so every map gets a unique layout.
	local seed = 5381
	for i = 1, #mapConfig.Id do
		seed = (seed * 33 + string.byte(mapConfig.Id, i)) % 2147483647
	end
	local rng = Random.new(seed)

	-- The floor. One flat slab, so nothing snags a wheel.
	Util.Part({
		Name = "Ground",
		Size = Vector3.new(size, 4, size),
		CFrame = CFrame.new(0, -2, 0),
		Color = mapConfig.Theme,
		Material = Enum.Material.Ground,
		Parent = model,
	})

	-- ---------------------------------------------------------- the city grid
	--
	-- Roads first, then everything else fitted into the blocks they leave.
	-- Doing it the other way round is what produced the old maps, where
	-- buildings sat in the middle of the road and the streets led nowhere.
	-- The ring outside the city is where the resort lives now -- the lazy
	-- river runs right round it and the mountain sits in one corner -- so it
	-- has to be wide enough for a river channel and a mountain base, not
	-- just a flanking lane.
	local gridHalf = half - 250
	local blocksPerSide = math.max(3, math.floor((gridHalf * 2) / 172 + 0.5))
	local pitch = (gridHalf * 2) / blocksPerSide

	local offsets: { number } = {}
	for index = 0, blocksPerSide do
		table.insert(offsets, -gridHalf + pitch * index)
	end

	streets(size, pitch, offsets, model)

	-- The resort: the lazy river right round the city, the mountain in one
	-- corner, the ski run between them, the chairlift up the side. Built
	-- before the blocks are handed out so its footprint is known when the
	-- city is laid down.
	local resort = ResortService.Build(size, model)
	local resortReserved = ResortService.ReservedAreas(size)
	-- The rink builds its own model, but the city has to know where it is.
	table.insert(resortReserved, HockeyService.ReservedArea(size))

	-- Walls, so nobody drives off the edge of the world.
	local wallHeight = 160
	for _, side in { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) } do
		Util.Part({
			Name = "Boundary",
			Size = Vector3.new(
				if side.X ~= 0 then 8 else size + 16,
				wallHeight,
				if side.Z ~= 0 then 8 else size + 16
			),
			CFrame = CFrame.new(side * (half + 4) + Vector3.new(0, wallHeight * 0.5, 0)),
			Color = Color3.fromRGB(52, 52, 58),
			Material = Enum.Material.Metal,
			Transparency = 0.55,
			Parent = model,
		})
	end

	-- One block per square of the grid. The usable half-extent is what is
	-- left after the two half-roads either side and a strip of pavement, so
	-- by construction nothing placed inside a block can reach the asphalt.
	type Block = { center: Vector3, extent: number, role: string, roof: number }
	local blockExtent = pitch * 0.5 - ROAD_WIDTH * 0.5 - 7
	local blocks: { Block } = {}
	for xi = 1, blocksPerSide do
		for zi = 1, blocksPerSide do
			table.insert(blocks, {
				center = Vector3.new(
					(offsets[xi] + offsets[xi + 1]) * 0.5,
					0,
					(offsets[zi] + offsets[zi + 1]) * 0.5
				),
				extent = blockExtent,
				role = "yard",
				roof = 0,
			})
		end
	end

	-- Reservations, decided before anything is built.
	--
	--   the carnival      CarnivalService builds its own ground at 0.3 * size
	--   the spawn rows    both teams need to get out of their base without
	--                     being funnelled through a doorway
	local carnival = Vector3.new(size * 0.3, 0, 0)

	--[[ Is this block inside something the resort already owns? ]]
	local function insideResort(flat: Vector3): boolean
		for _, area in resortReserved do
			if (flat - Vector3.new(area.centre.X, 0, area.centre.Z)).Magnitude < area.radius then
				return true
			end
		end
		return false
	end
	local spawnReach = gridHalf - pitch * 0.9
	local available: { Block } = {}
	for _, block in blocks do
		local flat = Vector3.new(block.center.X, 0, block.center.Z)
		if (flat - carnival).Magnitude < 145 or insideResort(flat) then
			block.role = "reserved"
		elseif math.abs(block.center.Z) > spawnReach and math.abs(block.center.X) < half * 0.45 then
			block.role = "plaza" -- kept open: this is a team's way out of its base
		else
			table.insert(available, block)
		end
	end

	-- Shuffled with the map's own seed, so a given map always looks the same
	-- but no two maps share a skyline.
	for index = #available, 2, -1 do
		local swap = rng:NextInteger(1, index)
		available[index], available[swap] = available[swap], available[index]
	end

	-- How the blocks get used.
	--
	-- A tower needs a whole block, because its vehicle ramp wraps the
	-- outside. A row block holds two low buildings you enter on foot, which
	-- is how the map reaches the configured building count without either
	-- shrinking the blocks until trucks cannot turn or thinning the city out
	-- into islands. Whatever is left over is open ground, and the map needs
	-- that just as much: a city of nothing but buildings has no firefights
	-- in it, only corridors.
	local towerTarget = math.min(
		math.ceil(mapConfig.Buildings * 0.55),
		math.max(1, #available - 4)
	)
	local rowTarget = math.min(
		math.ceil((mapConfig.Buildings - towerTarget) / 2),
		math.max(0, #available - towerTarget - 3)
	)

	for index, block in available do
		if index <= towerTarget then
			block.role = "tower"
		elseif index <= towerTarget + rowTarget then
			block.role = "row"
		elseif index <= towerTarget + rowTarget + 3 then
			block.role = "plaza"
		else
			block.role = "yard"
		end
	end

	-- --------------------------------------------------------- fill the blocks
	local towers: { Block } = {}
	for _, block in blocks do
		if block.role == "tower" then
			-- A building plus its outside vehicle ramp has to fit the block.
			local footprint = math.clamp(
				rng:NextNumber(50, 88),
				34, -- below this the 22-stud doorway stops fitting
				(block.extent - 26) * 2
			)
			local floors = rng:NextInteger(2, 5)
			local spot = block.center + Vector3.new(
				rng:NextNumber(-6, 6),
				0,
				rng:NextNumber(-6, 6)
			)
			block.roof = building(spot, footprint, floors, mapConfig.Theme, model)
			block.center = spot
			table.insert(towers, block)
		elseif block.role == "row" then
			-- Two low buildings sharing a block, with a gap between them you
			-- can run down but not drive through. No outside ramp, so the
			-- roof is a foot-only sniper spot reached by the inside stairs.
			local footprint = math.min(48, block.extent - 10)
			local shift = block.extent - footprint * 0.5 - 2
			local alongX = rng:NextNumber() < 0.5
			for _, side in { -1, 1 } do
				local spot = block.center + if alongX
					then Vector3.new(side * shift, 0, 0)
					else Vector3.new(0, 0, side * shift)
				local roof = building(spot, footprint, rng:NextInteger(2, 3), mapConfig.Theme, model, false)
				table.insert(towers, {
					center = spot,
					extent = footprint * 0.5,
					role = "row",
					roof = roof,
				})
			end
		elseif block.role == "plaza" then
			-- Paved, open, and worth crossing: cover to fight around and a
			-- pickup in the middle.
			Util.Part({
				Name = "Plaza",
				Size = Vector3.new(block.extent * 2, 1, block.extent * 2),
				CFrame = CFrame.new(block.center + Vector3.new(0, 0.6, 0)),
				Color = Color3.fromRGB(128, 126, 120),
				Material = Enum.Material.Pavement,
				Parent = model,
			})
			local room = math.max(4, block.extent - 14)
			for _ = 1, 4 do
				cover(block.center + Vector3.new(
					rng:NextNumber(-room, room),
					0,
					rng:NextNumber(-room, room)
				), rng, mapConfig.Theme, model)
			end
		elseif block.role == "yard" then
			-- Mud and barricades. Open ground to fight across, which a city
			-- made only of buildings never gives you.
			if rng:NextNumber() < mapConfig.MudFraction then
				mudPatch(block.center, block.extent * rng:NextNumber(1.1, 1.7), model)
			end
			-- Pulled well inside the block: a barricade is up to 30 studs
			-- across, and one hanging over the kerb is an obstacle in the
			-- road rather than cover beside it.
			local room = math.max(4, block.extent - 30)
			for _ = 1, rng:NextInteger(3, 6) do
				barricade(
					block.center + Vector3.new(
						rng:NextNumber(-room, room),
						0,
						rng:NextNumber(-room, room)
					),
					rng:NextNumber(0, math.pi * 2),
					rng,
					model
				)
			end
		end
	end

	-- Sky bridges between neighbouring rooftops, so the roofs are a second
	-- level you can cross rather than a set of islands. Only between blocks
	-- that are actually adjacent, and drawn at the lower of the two roofs.
	local bridgeSpan = pitch * 1.35
	local bridged = 0
	for i = 1, #towers do
		for j = i + 1, #towers do
			local a, b = towers[i], towers[j]
			local gap = (a.center - b.center).Magnitude
			if gap < bridgeSpan and bridged < #towers then
				local deck = math.min(a.roof, b.roof)
				ramp(
					Vector3.new(a.center.X, deck, a.center.Z),
					Vector3.new(b.center.X, deck, b.center.Z),
					14,
					Color3.fromRGB(120, 116, 108),
					model
				)
				bridged += 1
				break
			end
		end
	end

	-- -------------------------------------------------------- street furniture
	--
	-- Jumps and ramps go ON the roads, pointed along them, because a jump you
	-- cannot reach at speed is just scenery.
	--[[
		Keep an along-the-street coordinate clear of the CROSSING streets.

		A point on the x = 200 road is still in the middle of a junction if
		its z happens to land on the z = 200 road, and that is how street
		furniture ends up blocking a road it was never placed on.
	]]
	local function clearOfJunctions(along: number): number
		local nearest = offsets[1]
		for _, lane in offsets do
			if math.abs(along - lane) < math.abs(along - nearest) then
				nearest = lane
			end
		end
		local gap = ROAD_WIDTH * 0.5 + 26
		local delta = along - nearest
		if math.abs(delta) < gap then
			return nearest + (if delta < 0 then -gap else gap)
		end
		return along
	end

	local function randomStreet(): (Vector3, Vector3)
		local lane = offsets[rng:NextInteger(1, #offsets)]
		local along = clearOfJunctions(rng:NextNumber(-gridHalf * 0.85, gridHalf * 0.85))
		if rng:NextNumber() < 0.5 then
			return Vector3.new(lane, 0, along), Vector3.new(0, 0, if along < 0 then 1 else -1)
		end
		return Vector3.new(along, 0, lane), Vector3.new(if along < 0 then 1 else -1, 0, 0)
	end

	for _ = 1, mapConfig.Jumps do
		local spot, heading = randomStreet()
		stuntJump(spot, heading, rng:NextNumber(0.8, 2.2), Color3.fromRGB(150, 120, 60), model)
	end

	for _ = 1, mapConfig.Ramps do
		local spot, heading = randomStreet()
		ramp(
			spot,
			spot + heading * rng:NextNumber(30, 60) + Vector3.new(0, rng:NextNumber(8, 22), 0),
			18,
			Color3.fromRGB(130, 110, 70),
			model
		)
	end

	-- Cover on the pavements, where you actually need it: crossing a street
	-- is the most exposed thing you do.
	for _ = 1, 26 do
		local spot, heading = randomStreet()
		-- Across the street, not along it: heading runs with the road, so
		-- swapping its components gives the pavement direction.
		local side = (if rng:NextNumber() < 0.5 then -1 else 1) * (ROAD_WIDTH * 0.5 + 18)
		cover(spot + Vector3.new(heading.Z, 0, heading.X) * side, rng, mapConfig.Theme, model)
	end

	-- The open ring outside the grid, so the map edge is not a dead zone.
	--
	-- A SQUARE ring, hugging the four edges. A circle of this radius looks
	-- right on paper and then cuts straight back through the city at the
	-- diagonals, dropping barricades in the middle of interior roads.
	local ringInset = ROAD_WIDTH * 0.5 + 24
	for _ = 1, 20 do
		local along = clearOfJunctions(rng:NextNumber(-gridHalf, gridHalf))
		local out = (if rng:NextNumber() < 0.5 then -1 else 1) * (gridHalf + ringInset)
		local spot = if rng:NextNumber() < 0.5
			then Vector3.new(along, 0, out)
			else Vector3.new(out, 0, along)
		barricade(spot, rng:NextNumber(0, math.pi * 2), rng, model)
	end

	-- Team spawns at opposite ends, out in the open ring, with real
	-- SpawnLocations on them.
	local teamSpawns: { [number]: { Vector3 } } = { {}, {} }
	for teamIndex = 1, 2 do
		local zSign = if teamIndex == 1 then -1 else 1
		local colour = teamColors[teamIndex] or BrickColor.new("Medium stone grey")
		for slot = 1, 6 do
			local x = -half * 0.35 + (slot - 1) * (half * 0.7 / 5)
			local position = Vector3.new(x, 4, zSign * (half - 24))
			table.insert(teamSpawns[teamIndex], position)
			teamSpawn(position, colour, model)
		end
	end

	-- --------------------------------------------------------------- the pads
	--
	-- Intersections, which is where you look for a vehicle in a city.
	local intersections: { Vector3 } = {}
	for _, x in offsets do
		for _, z in offsets do
			table.insert(intersections, Vector3.new(x, 4, z))
		end
	end
	for index = #intersections, 2, -1 do
		local swap = rng:NextInteger(1, index)
		intersections[index], intersections[swap] = intersections[swap], intersections[index]
	end

	local nextIntersection = 0
	local function takeIntersection(): Vector3
		nextIntersection += 1
		local spot = intersections[((nextIntersection - 1) % #intersections) + 1]
		-- Nudge repeats apart once the list wraps.
		local lap = math.floor((nextIntersection - 1) / #intersections)
		if lap == 0 then
			return spot
		end
		return spot + Vector3.new(
			rng:NextNumber(-ROAD_WIDTH * 0.4, ROAD_WIDTH * 0.4),
			0,
			rng:NextNumber(-ROAD_WIDTH * 0.4, ROAD_WIDTH * 0.4)
		)
	end

	-- One tank, one plane, one torpedo and two turret trucks, always. They
	-- respawn on these same pads a while after they are wrecked.
	local vehiclePads = {}
	local bigVehicles = {
		"Tank", "Plane", "TurretTruck", "TurretTruck",
		-- Rideable rockets, several of them, because they are the best thing
		-- on the map and one was never enough.
		"Torpedo", "Torpedo", "Torpedo", "Torpedo",
	}
	for _, kind in bigVehicles do
		local position = takeIntersection()
		table.insert(vehiclePads, { position = position, kind = kind })

		Util.Part({
			Name = "VehiclePad",
			Size = Vector3.new(34, 1, 34),
			CFrame = CFrame.new(position - Vector3.new(0, 3, 0)),
			Color = Color3.fromRGB(70, 90, 110),
			Material = Enum.Material.DiamondPlate,
			Parent = model,
		})
	end

	local pickupPads: { { position: Vector3, kind: string, weapon: string? } } = {}
	for _, kind in { "Burger", "Fries", "Shield", "Ammo", "Burger", "Fries", "Shield", "Ammo" } do
		table.insert(pickupPads, { position = takeIntersection(), kind = kind })
	end

	-- Guns, everywhere. Walk over one and it is in your hands.
	local scattered = {
		"RPG", "LandMine", "ClusterBomb", "Grenade", "StickyGrenade",
		"Drone", "Minigun", "AntiMaterial", "AutoShotgun", "Revolver",
		"MachineGun", "Sniper", "DiamondGun", "Deagle", "SMG", "Shotgun",
	}
	for index = 1, 34 do
		local spot = randomStreet()
		table.insert(pickupPads, {
			position = spot + Vector3.new(0, 4, 0),
			kind = "Weapon",
			weapon = scattered[((index - 1) % #scattered) + 1],
		})
	end

	-- Ammo, and the point multiplier, scattered just as freely.
	for _ = 1, 16 do
		table.insert(pickupPads, { position = randomStreet() + Vector3.new(0, 4, 0), kind = "Ammo" })
	end
	for _ = 1, 5 do
		table.insert(pickupPads, { position = takeIntersection(), kind = "Multiplier" })
	end

	-- The hidden ones. These go INSIDE buildings rather than out on the pads,
	-- so they are a reward for going in and looking rather than something you
	-- trip over crossing the map.
	local hiddenKinds = { "Health", "Invincibility", "DroneAmmo", "Health", "Invincibility", "DroneAmmo" }
	for index, tower in towers do
		table.insert(pickupPads, {
			-- Ground floor, tucked into a corner of the interior.
			position = tower.center + Vector3.new(rng:NextNumber(-14, 14), 6, rng:NextNumber(-14, 14)),
			kind = hiddenKinds[((index - 1) % #hiddenKinds) + 1],
		})
	end

	-- Resort gear, on the pads the resort picked out: tubes at the summit, at
	-- the foot of the ski run and round the river, and gliders at the top.
	for _, at in resort.tubePads do
		table.insert(vehiclePads, { position = at, kind = "Tube" })
	end
	for index, at in resort.skiPads do
		table.insert(vehiclePads, {
			position = at + Vector3.new(0, 2, 0),
			kind = if index == 2 then "Glider" else "Skis",
		})
	end
	if resort.liftStations[1] then
		table.insert(vehiclePads, {
			position = resort.liftStations[1] + Vector3.new(0, 2, -24),
			kind = "Glider",
		})
	end

	-- Off-roaders at the lift stations, which is where you go to get up the
	-- mountain. A Lamborghini at the bottom of a mountain trail is a joke.
	local offRoaders = { "G-Wagon", "Hummer", "Jeep" }
	for index, station in resort.liftStations do
		table.insert(vehiclePads, {
			position = station + Vector3.new(22, 2, 0),
			kind = offRoaders[((index - 1) % #offRoaders) + 1],
		})
	end
	table.insert(vehiclePads, {
		position = resort.liftStations[1] + Vector3.new(-22, 2, 0),
		kind = "Hummer",
	})

	-- Gear on the sniper towers, because climbing one should be worth it.
	for index, top in resort.towerTops do
		table.insert(pickupPads, {
			position = top + Vector3.new(0, 2, 0),
			kind = "Weapon",
			weapon = if index % 2 == 0 then "AntiMaterial" else "Sniper",
		})
	end

	-- And something at the summit, which is the longest climb on the map.
	table.insert(pickupPads, { position = resort.summit + Vector3.new(0, 3, -14), kind = "Multiplier" })

	model.Parent = workspace
	return {
		model = model,
		teamSpawns = teamSpawns,
		vehiclePads = vehiclePads,
		pickupPads = pickupPads,
		resort = resort,
	}
end

function MapService.Clear()
	local existing = workspace:FindFirstChild("Arena")
	if existing then
		existing:Destroy()
	end
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">MatchService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MatchService — the clock the whole game runs on.

	Vote on a map, fight on it, celebrate, repeat. Everything else in the game
	is a system this loop turns on and off at the right moment.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local MapService = require(script.Parent:WaitForChild("MapService"))
local PickupService = require(script.Parent:WaitForChild("PickupService"))
local PlayerState = require(script.Parent:WaitForChild("PlayerState"))
local TeamService = require(script.Parent:WaitForChild("TeamService"))
local VehicleService = require(script.Parent:WaitForChild("VehicleService"))
local HockeyService = require(script.Parent:WaitForChild("HockeyService"))
local WildlifeService = require(script.Parent:WaitForChild("WildlifeService"))
local FlagService = require(script.Parent:WaitForChild("FlagService"))
local CarnivalService = require(script.Parent:WaitForChild("CarnivalService"))
local ProjectileService = require(script.Parent:WaitForChild("ProjectileService"))
local DamageService = require(script.Parent:WaitForChild("DamageService"))
local EffectService = require(script.Parent:WaitForChild("EffectService"))
local ScoreboardService = require(script.Parent:WaitForChild("ScoreboardService"))
local HockeyService = require(script.Parent:WaitForChild("HockeyService"))
local ResortService = require(script.Parent:WaitForChild("ResortService"))

local MatchService = {}

local rng = Random.new()

local phase = "Warmup"
local phaseEndsAt = 0
local scores = { 0, 0 }
local currentMap: MapService.MapBuild? = nil
local currentMapSpec: Config.MapSpec? = nil
local currentMode = Config.Modes[1]

-- Map voting. Each option is a map paired with a mode, so one vote picks
-- both what you play and where.
local ballot: { { map: Config.MapSpec, mode: typeof(Config.Modes[1]) } } = {}
local votes: { [Player]: number } = {}

-- The one car each player currently owns.
local playerCars: { [Player]: Model } = {}

--[[
	Medals.

	Halo's two kinds, and they are different things: a MULTIKILL is several
	kills close together in time, and a SPREE is many kills without dying.
	Tracked per player and reset by death.
]]
local recentKills: { [Player]: { number } } = {}
local sprees: { [Player]: number } = {}

local MULTIKILL_WINDOW = 4.5

local MULTIKILL_NAMES = {
	[2] = "DOUBLE KILL",
	[3] = "TRIPLE KILL",
	[4] = "OVERKILL",
	[5] = "KILLTACULAR",
	[6] = "KILLTROCITY",
}

local SPREE_NAMES = {
	[5] = "KILLING SPREE",
	[10] = "RUNNING RIOT",
	[15] = "RAMPAGE",
	[20] = "UNTOUCHABLE",
}

--[[ Everybody sees who killed whom. ]]
local function killFeed(killer: Player?, victim: Player, cause: string)
	local line = if killer
		then `{killer.DisplayName}  ▸  {cause}  ▸  {victim.DisplayName}`
		else `{victim.DisplayName} died — {cause}`

	for _, player in Players:GetPlayers() do
		Remotes.Event("KillFeed"):FireClient(player, line, player == killer)
	end
end

--[[ Work out whether this kill earned a medal, and announce it if so. ]]
local function awardMedals(killer: Player)
	local now = os.clock()

	-- Multikill: how many in the last few seconds.
	local window = recentKills[killer] or {}
	table.insert(window, now)
	for index = #window, 1, -1 do
		if now - window[index] > MULTIKILL_WINDOW then
			table.remove(window, index)
		end
	end
	recentKills[killer] = window

	local multi = MULTIKILL_NAMES[#window]
	if multi then
		Remotes.Event("Medal"):FireClient(killer, multi)
		Remotes.Event("PlaySound"):FireClient(killer, "Medal")
	end

	-- Spree: how many since last dying.
	sprees[killer] = (sprees[killer] or 0) + 1
	local spree = SPREE_NAMES[sprees[killer]]
	if spree then
		for _, player in Players:GetPlayers() do
			Remotes.Event("Medal"):FireClient(player, `{killer.DisplayName}: {spree}`)
		end
		Remotes.Event("PlaySound"):FireClient(killer, "Medal")
	end
end

--[[ The two team colours, for painting the spawn pads. ]]
local function teamColours(): { BrickColor }
	local colours = {}
	for index, spec in Config.Teams do
		colours[index] = spec.Color
	end
	return colours
end

--[[
	Tear down whatever arena is standing and put a new one up.

	This is deliberately separate from starting a round, because the world
	must never be empty: an arena exists from the moment the server boots,
	long before the first round begins.
]]
local function buildArena(entry: { map: Config.MapSpec, mode: typeof(Config.Modes[1]) })
	local spec = entry.map
	currentMapSpec = spec
	currentMode = entry.mode

	ProjectileService.ClearAll()
	VehicleService.ClearAll()
	PickupService.Clear()

	currentMap = MapService.Build(spec, teamColours())
	local build = currentMap
	if build then
		PickupService.Build(build.pickupPads)
	end
	MatchService.SpawnMapVehicles()

	WildlifeService.Populate(spec.Size)
	CarnivalService.Build(spec.Size)
	-- And the rink, which builds its own model beside the arena.
	HockeyService.Build(spec.Size)

	-- Flags only exist in Capture the Flag.
	FlagService.Clear()
	if currentMode.Id == "CTF" and build then
		FlagService.Setup(build, teamColours())
	end
end

--[[ Push the scoreboard and the clock to everybody's screen. ]]
local function broadcast()
	local payload = {
		phase = phase,
		timeLeft = math.max(0, phaseEndsAt - os.clock()),
		scores = scores,
		mapName = if currentMapSpec then currentMapSpec.Name else "—",
		modeName = currentMode.Name,
		-- Only meaningful in Capture the Flag, ignored otherwise.
		flags = if FlagService.IsActive()
			then { FlagService.StateOf(1), FlagService.StateOf(2) }
			else nil,
	}
	Remotes.Event("MatchState"):FireAllClients(payload)
end

--[[ The same noise in everybody's ears at once, for match-wide moments. ]]
local function fanfare(soundName: string)
	for _, player in Players:GetPlayers() do
		Remotes.Event("PlaySound"):FireClient(player, soundName)
	end
end

--[[ Put a player on the ground at their team's end of the map, in a car. ]]
local function deployPlayer(player: Player, keepProgress: boolean)
	local build = currentMap
	if not build then
		return
	end

	local character = player.Character
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end

	if not player.Parent then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and not keepProgress then
		humanoid.Sit = false
		humanoid.Health = humanoid.MaxHealth
	end

	--[[
		How fast you move on foot, and how high you jump.

		Nothing set these. Config.Turbo.WalkSpeed existed and was read when
		turbo switched OFF and when a flag carrier was slowed down -- but
		never to establish the baseline -- so everybody walked at Roblox's
		default 16 studs a second regardless of what the config said, which
		is a plod across a 2000-stud map.
	]]
	if humanoid then
		humanoid.WalkSpeed = Config.Turbo.WalkSpeed
		humanoid.JumpPower = Config.Movement.JumpPower
		humanoid.UseJumpPower = true
	end

	PlayerState.Reset(player, keepProgress)

	local teamIndex = TeamService.IndexOf(player)
	local spawns = build.teamSpawns[teamIndex]
	if not spawns or #spawns == 0 then
		spawns = { Vector3.new(0, 8, 0) }
	end
	local spot = spawns[rng:NextInteger(1, #spawns)]

	root.CFrame = CFrame.new(spot + Vector3.new(0, 5, 0))

	-- A car of your own, parked next to you, at whatever tier your keys earned.
	-- The last one goes first, so dying twenty times does not leave twenty
	-- abandoned cars sitting on the map.
	local previous = playerCars[player]
	if previous and previous.Parent then
		previous:Destroy()
	end

	local state = PlayerState.Get(player)
	playerCars[player] = VehicleService.SpawnCar(state.carTier, spot + Vector3.new(14, 0, 0), player)
end

--[[ Everybody gets put back on the field. ]]
local function deployAll()
	for _, player in Players:GetPlayers() do
		if player.Character then
			deployPlayer(player, false)
		else
			PlayerState.Reset(player, false)
			task.spawn(function()
				if player.Parent then
					player:LoadCharacterAsync()
				end
			end)
		end
	end
end

--[[ Park one of each big toy on its pad, and put it back when it is wrecked. ]]
function MatchService.SpawnMapVehicles()
	local build = currentMap
	if not build then
		return
	end

	for _, pad in build.vehiclePads do
		local spec = Config.Vehicles[pad.kind]
		local respawnDelay = if spec then spec.RespawnDelay else 30

		local function place()
			-- Stop respawning once the round that owns this pad is over.
			if currentMap ~= build then
				return
			end
			local vehicle = VehicleService.SpawnKind(pad.kind, pad.position)
			if not vehicle then
				return
			end
			vehicle.Destroying:Connect(function()
				task.delay(respawnDelay, place)
			end)
		end

		place()
	end
end

-- ================================================================== PHASES ==

local function runVoting()
	phase = "Voting"
	phaseEndsAt = os.clock() + Config.Match.VoteDuration
	table.clear(votes)

	-- Offer a few maps at random out of the ten.
	local pool = table.clone(Config.Maps)
	ballot = {}
	for index = 1, math.min(Config.Match.MapChoices, #pool) do
		local pick = rng:NextInteger(1, #pool)
		-- Alternate the modes down the ballot so both are always on offer.
		local mode = Config.Modes[((index - 1) % #Config.Modes) + 1]
		table.insert(ballot, { map = pool[pick], mode = mode })
		table.remove(pool, pick)
	end

	local options = {}
	for index, entry in ballot do
		options[index] = {
			id = entry.map.Id,
			name = `{entry.mode.Name} · {entry.map.Name}`,
			blurb = entry.mode.Blurb,
		}
	end
	Remotes.Event("VoteOptions"):FireAllClients(options, Config.Match.VoteDuration)

	while os.clock() < phaseEndsAt do
		broadcast()
		task.wait(0.5)
	end
end

--[[ Count the votes. A tie, or nobody voting at all, is broken at random. ]]
local function tallyVotes(): { map: Config.MapSpec, mode: typeof(Config.Modes[1]) }
	local counts = table.create(#ballot, 0)
	for _, choice in votes do
		if ballot[choice] then
			counts[choice] += 1
		end
	end

	local bestCount = -1
	local tied: { number } = {}
	for index = 1, #ballot do
		if counts[index] > bestCount then
			bestCount = counts[index]
			table.clear(tied)
			table.insert(tied, index)
		elseif counts[index] == bestCount then
			table.insert(tied, index)
		end
	end

	if bestCount <= 0 or #tied == 0 then
		return ballot[rng:NextInteger(1, #ballot)]
	end
	return ballot[tied[rng:NextInteger(1, #tied)]]
end

local function runRound()
	-- The arena is already standing; a round is just the clock and the score.
	scores = { 0, 0 }
	table.clear(recentKills)
	table.clear(sprees)
	phase = "Playing"
	phaseEndsAt = os.clock() + Config.Match.RoundDuration

	deployAll()
	fanfare("RoundStart")

	while os.clock() < phaseEndsAt do
		broadcast()
		-- Each mode has its own target.
		local limit = currentMode.ScoreLimit or Config.Match.ScoreLimit
		if scores[1] >= limit or scores[2] >= limit then
			break
		end
		task.wait(0.5)
	end
end

local function runIntermission()
	phase = "Intermission"
	phaseEndsAt = os.clock() + Config.Match.IntermissionDuration

	-- Who won, and the WIENER treatment for them.
	-- Whichever team has the most points at the whistle, in either mode.
	local winnerIndex = if scores[1] == scores[2] then 0 elseif scores[1] > scores[2] then 1 else 2
	local winnerName = if winnerIndex == 0 then "NOBODY" else Config.Teams[winnerIndex].Name
	EffectService.CelebrateWinner(winnerName)
	fanfare("RoundEnd")

	-- Put the final standings up without anybody having to reach for Tab.
	-- It is the one moment everyone wants to see them.
	pcall(ScoreboardService.PushAll)

	while os.clock() < phaseEndsAt do
		broadcast()
		task.wait(0.5)
	end

	-- Wreckage and bullets go; the arena itself stays standing until the
	-- next one is built, so there is never a moment with no world.
	ProjectileService.ClearAll()
end

--[[
	The loop itself. It never stops for as long as the server is up.

	Order matters: we fight on the arena that is already standing, and only
	vote for the next map afterwards. Voting first would mean twenty seconds
	of everybody staring at an empty sky.
]]
local function loop()
	while true do
		if #Players:GetPlayers() < Config.Match.MinPlayers then
			-- Nobody here yet. The arena still exists, so anyone who does
			-- turn up can drive around it while they wait.
			phase = "Warmup"
			phaseEndsAt = os.clock() + 1
			broadcast()
			task.wait(1)
			continue
		end

		runRound()
		runIntermission()
		runVoting()
		buildArena(tallyVotes())
	end
end

-- =================================================================== SETUP ==

function MatchService.Start()
	-- A kill is worth points to the killer's team.
	-- What each weapon's display name is worth, so a kill can be scored by
	-- the thing that made it.
	local pointsByWeapon: { [string]: number } = {}
	for _, spec in Config.Weapons do
		pointsByWeapon[spec.DisplayName] = spec.Points or Config.Match.PointsPerKill
	end
	pointsByWeapon.Melee = 20
	pointsByWeapon.Trampled = 15
	pointsByWeapon.Explosion = 15

	DamageService.Killed.Connect(function(victim: Player, killer: Player?, cause: string)
		local character = victim.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			EffectService.PlayDeathGag(root.Position)
		end

		EffectService.ShowDeathScreen(victim, if killer then killer.DisplayName else nil)
		killFeed(killer, victim, cause)

		-- Dying ends your spree and your multikill window.
		sprees[victim] = 0
		recentKills[victim] = {}

		if killer and killer ~= victim and killer.Parent and phase == "Playing" then
			local base = pointsByWeapon[cause] or Config.Match.PointsPerKill
			local earned = PlayerState.AwardPoints(killer, base)

			local teamIndex = TeamService.IndexOf(killer)
			scores[teamIndex] += earned

			Remotes.Event("Notify"):FireClient(killer, `+{earned} — {cause}`)
			Remotes.Event("PlaySound"):FireClient(killer, "KillConfirm")
			awardMedals(killer)
			broadcast()
		end
	end)

	FlagService.Captured.Connect(function(_player: Player, teamIndex: number, points: number)
		if phase == "Playing" then
			scores[teamIndex] += points
			broadcast()
		end
	end)

	HockeyService.Goal.Connect(function(scorer: Player?, teamIndex: number, points: number)
		if phase == "Playing" then
			scores[teamIndex] += points
			broadcast()
		end
		if scorer and scorer.Parent then
			Remotes.Event("KillFeed"):FireAllClients(`{scorer.DisplayName} SCORED A GOAL! (+{points})`, false)
		end
	end)

	FlagService.Start()
	ResortService.Start()

	Remotes.Event("CastVote").OnServerEvent:Connect(function(player, choice)
		if phase ~= "Voting" then
			return
		end
		if typeof(choice) ~= "number" then
			return
		end
		local index = math.floor(choice)
		if ballot[index] then
			votes[player] = index
		end
	end)

	--[[
		Set a player up. Pulled out of the PlayerAdded handler because in
		Studio the local player can already be in the game by the time this
		script runs — in which case PlayerAdded never fires for them, and
		without this they would never be assigned a team or given a car.
	]]
	local function setUpPlayer(player: Player)
		TeamService.Assign(player)

		player.CharacterAdded:Connect(function()
			task.wait(0.35)
			if player.Parent then
				deployPlayer(player, true)
			end
		end)

		if player.Character then
			task.spawn(function()
				task.wait(0.35)
				if player.Parent then
					deployPlayer(player, true)
				end
			end)
		end
	end

	Players.PlayerAdded:Connect(setUpPlayer)

	-- Anybody already here before this script got going. Called directly
	-- rather than deferred: there is nothing to wait for, and running it now
	-- means a player who is already present is set up before the first round.
	for _, player in Players:GetPlayers() do
		setUpPlayer(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		votes[player] = nil
		recentKills[player] = nil
		sprees[player] = nil
		local car = playerCars[player]
		if car and car.Parent then
			car:Destroy()
		end
		playerCars[player] = nil
	end)

	-- A safety net. Fly a plane over the boundary wall and you would otherwise
	-- fall forever; this notices and respawns you instead.
	RunService.Heartbeat:Connect(function()
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and root.Position.Y < -120 then
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health > 0 then
					DamageService.ApplyDamage(player, humanoid.MaxHealth + 1000, nil, "Void")
					if humanoid.Health > 0 then
						humanoid.Health = 0
					end
				end
			end
		end
	end)

	-- The world exists before anybody can possibly join it.
	buildArena({
		map = Config.Maps[rng:NextInteger(1, #Config.Maps)],
		mode = Config.Modes[rng:NextInteger(1, #Config.Modes)],
	})

	task.spawn(loop)
end

--[[
	Put the match straight into a running round.

	Only the tests use this: kills are deliberately ignored outside a round,
	so without it a test would have to wait out the real loop to score one.
]]
--[[
	Shout about a landed trick.

	Tricks come out of VehicleService, which has no idea the HUD exists, so
	the announcement is wired up here where the kill feed and the medals
	already live.
]]
VehicleService.TrickLanded.Connect(function(player: Player, name: string, points: number, airtime: number)
	if not player.Parent then
		return
	end
	if phase == "Playing" then
		local teamIndex = TeamService.IndexOf(player)
		scores[teamIndex] += points
		broadcast()
	end
	Remotes.Event("Medal"):FireClient(player, `{name}  +{points}`)
	Remotes.Event("PlaySound"):FireClient(player, "Medal")

	local team = player.Team
	if team then
		Remotes.Event("KillFeed"):FireAllClients(
			`{player.DisplayName} landed a {name} ({string.format("%.1f", airtime)}s air)`,
			false
		)
	end
end)

function MatchService.ForceRoundForTests()
	phase = "Playing"
	phaseEndsAt = os.clock() + Config.Match.RoundDuration
	scores = { 0, 0 }
	table.clear(recentKills)
	table.clear(sprees)
end

--[[ Which phase the game is in, for anything that needs to care. ]]
function MatchService.Phase(): string
	return phase
end

return MatchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MonetizationService — the till. It is switched off.

	While Config.FreeMode is true this module hands everything out for free and
	never talks to Roblox's purchase system at all. That is the right state for
	now: get the game good, then charge for it.

	WHEN YOU TURN IT ON
	-------------------
	Set Config.FreeMode = false and paste your real IDs into Config.GamePasses
	and Config.Products. Everything below is already written to Roblox's rules:

	  * ProcessReceipt is registered exactly once, which Roblox requires.
	  * A receipt is only marked PurchaseGranted after the player's data has
	    actually saved. If the save fails we return NotProcessedYet, so Roblox
	    retries later instead of the player paying for nothing.
	  * Receipt IDs are remembered, so a retried receipt does not pay out twice.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local PlayerState = require(script.Parent:WaitForChild("PlayerState"))

local MonetizationService = {}

--[[
	Receipts already paid out, so a Roblox retry cannot double-grant.

	This is fetched lazily rather than at the top of the file, and that detail
	matters enormously: Roblox Studio refuses DataStore access in a place that
	has never been published, and a refusal at the top of a module kills the
	whole server script before anything else gets to run. Asking for it only
	when a real purchase arrives means an unpublished test place still works.
]]
local receiptStore: GlobalDataStore? = nil

local function getReceiptStore(): GlobalDataStore?
	if receiptStore then
		return receiptStore
	end
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore("NuclearMudArena_Receipts_v1")
	end)
	if ok and store then
		receiptStore = store
		return store
	end
	warn("[Monetization] DataStore unavailable — is the place published?")
	return nil
end

--[[ Does this player own a pass? In free mode, everybody owns everything. ]]
local passCache: { [number]: { [string]: boolean } } = {}

Players.PlayerRemoving:Connect(function(player)
	passCache[player.UserId] = nil
end)

function MonetizationService.OwnsPass(player: Player, passKey: string): boolean
	if Config.FreeMode then
		return true
	end

	local passId = Config.GamePasses[passKey]
	if not passId or passId == 0 then
		return false
	end

	local userCache = passCache[player.UserId]
	if userCache and userCache[passKey] ~= nil then
		return userCache[passKey]
	end

	local success, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
	end)
	local result = success and owns == true
	if success then
		-- `or {}` rather than an if: reassigning an existing cache to itself
		-- is harmless, and this is the only shape strict mode can see as
		-- definitely-a-table.
		local cache: { [string]: boolean } = userCache or {}
		passCache[player.UserId] = cache
		cache[passKey] = result
	end
	return result
end

--[[ Give out whatever a product was bought for. Returns false if it could not. ]]
local function grantProduct(player: Player, productKey: string): boolean
	local state = PlayerState.Get(player)

	if productKey == "MegaDetonations" then
		state.megaCharges += Config.ProductGrants.MegaDetonations
	elseif productKey == "Revive" then
		-- The point of paying: you come back with your keys and your good car.
		-- Respawning yields, so it runs on its own thread and does not hold
		-- up the receipt we still have to confirm.
		task.spawn(function()
			player:LoadCharacterAsync()
		end)
	elseif productKey == "InstantTopCar" then
		state.carTier = Config.ProductGrants.InstantTopCarTier
	else
		return false
	end

	PlayerState.Changed.Fire(player)
	return true
end

--[[ Turn a Roblox product ID back into the name we know it by. ]]
local function productKeyFromId(productId: number): string?
	for key, id in Config.Products do
		if id == productId then
			return key
		end
	end
	return nil
end

function MonetizationService.Start()
	if Config.FreeMode then
		-- Nothing to wire up. Everything is already free.
		return
	end

	MarketplaceService.ProcessReceipt = function(receiptInfo)
		local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
		if not player then
			-- They left before we could pay out. Roblox will try again when
			-- they next join, so do not consume the receipt.
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		local receiptKey = `receipt_{receiptInfo.PurchaseId}`

		local store = getReceiptStore()
		if not store then
			-- No way to record the receipt means no safe way to grant it.
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		local productKey = productKeyFromId(receiptInfo.ProductId)
		if not productKey then
			warn(`MonetizationService: unknown product {receiptInfo.ProductId}`)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		-- Atomically claim the receipt before granting so retries can never double-grant.
		local alreadyClaimed = false
		local claimOk = pcall(function()
			store:UpdateAsync(receiptKey, function(old)
				if old then
					alreadyClaimed = true
					return old
				end
				return true
			end)
		end)
		if not claimOk then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		if alreadyClaimed then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		if not player.Parent then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end

		grantProduct(player, productKey)
		Remotes.Event("Notify"):FireClient(player, "Purchase complete. Thank you!")
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">PickupService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PickupService — the burgers, the fries, the shields and the ammo crates.

	Each one sits on a pad, spins, and comes back a little while after somebody
	takes it, so there is always a reason to drive across the map.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Sound = require(Shared:WaitForChild("Sound"))
local Util = require(Shared:WaitForChild("Util"))

local PlayerState = require(script.Parent:WaitForChild("PlayerState"))
local VehicleService = require(script.Parent:WaitForChild("VehicleService"))

local PickupService = {}

type Pickup = {
	kind: string,
	-- Only set on weapon crates: which gun this one hands over.
	weapon: string?,
	part: BasePart,
	position: Vector3,
	availableAt: number,
	available: boolean,
}

local pickups: { Pickup } = {}
local container: Folder?

local function colourFor(kind: string, weapon: string?): Color3
	if kind == "Weapon" and weapon then
		local spec = Config.Weapons[weapon]
		if spec then
			return spec.Color
		end
	end
	if kind == "Multiplier" then
		return Config.Pickups.Multiplier.Color
	end
	if kind == "Burger" then
		return Config.Pickups.Burger.Color
	elseif kind == "Fries" then
		return Config.Pickups.Fries.Color
	elseif kind == "Shield" then
		return Config.Pickups.Shield.Color
	elseif kind == "Health" then
		return Config.Pickups.Health.Color
	elseif kind == "Invincibility" then
		return Config.Pickups.Invincibility.Color
	elseif kind == "PoopAmmo" then
		return Config.Pickups.PoopAmmo.Color
	elseif kind == "DroneAmmo" then
		return Config.Pickups.DroneAmmo.Color
	end
	return Config.Pickups.Ammo.Color
end

local function labelFor(kind: string, weapon: string?): string
	if kind == "Weapon" and weapon then
		local spec = Config.Weapons[weapon]
		if spec then
			return spec.DisplayName
		end
	end
	if kind == "Multiplier" then
		return Config.Pickups.Multiplier.DisplayName
	end
	if kind == "Burger" then
		return Config.Pickups.Burger.DisplayName
	elseif kind == "Fries" then
		return Config.Pickups.Fries.DisplayName
	elseif kind == "Shield" then
		return Config.Pickups.Shield.DisplayName
	elseif kind == "Health" then
		return Config.Pickups.Health.DisplayName
	elseif kind == "Invincibility" then
		return Config.Pickups.Invincibility.DisplayName
	elseif kind == "PoopAmmo" then
		return Config.Pickups.PoopAmmo.DisplayName
	elseif kind == "DroneAmmo" then
		return Config.Pickups.DroneAmmo.DisplayName
	end
	return Config.Pickups.Ammo.DisplayName
end

--[[ Hand the pickup's effect to whoever drove into it. ]]
local function grant(player: Player, kind: string, weapon: string?)
	local state = PlayerState.Get(player)
	local now = os.clock()

	if kind == "Burger" then
		state.burgerUntil = math.max(state.burgerUntil, now + Config.Pickups.Burger.Duration)
	elseif kind == "Fries" then
		state.friesUntil = now + Config.Pickups.Fries.Duration
	elseif kind == "Shield" then
		state.maxShield = math.max(state.maxShield, Config.Pickups.Shield.Amount)
		state.shield = state.maxShield
	elseif kind == "Ammo" then
		for name, slot in state.weapons do
			local spec = Config.Weapons[name]
			-- Poop and drones are scavenged, not resupplied by a crate.
			if spec and not spec.AmmoFromPickupsOnly then
				slot.ammo = spec.MagSize
				slot.reloadingUntil = 0
			end
		end
	elseif kind == "Health" then
		-- Straight back to full.
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Health = humanoid.MaxHealth
		end
	elseif kind == "Invincibility" then
		-- Twenty seconds of nothing being able to touch you.
		state.burgerUntil = math.max(state.burgerUntil, now + Config.Pickups.Invincibility.Duration)
	elseif kind == "PoopAmmo" then
		local slot = state.weapons.Poop
		local spec = Config.Weapons.Poop
		if slot and spec then
			slot.ammo = math.min(spec.MagSize, slot.ammo + 2)
		end
	elseif kind == "DroneAmmo" then
		local slot = state.weapons.Drone
		local spec = Config.Weapons.Drone
		if slot and spec then
			slot.ammo = math.min(spec.MagSize, slot.ammo + 1)
		end
	elseif kind == "Multiplier" then
		-- Everything you score is worth more for the next minute and a half.
		state.multiplierUntil = now + Config.Pickups.Multiplier.Duration
		state.multiplierAmount = Config.Pickups.Multiplier.Amount
	elseif kind == "Weapon" and weapon then
		-- Picking a gun up puts it straight in your hands.
		local spec = Config.Weapons[weapon]
		if spec and not spec.MountedOnly then
			state.equipped = weapon
			local slot = state.weapons[weapon]
			if not slot then
				slot = { ammo = spec.MagSize, reloadingUntil = 0, nextFireAt = 0 }
				state.weapons[weapon] = slot
			else
				slot.ammo = spec.MagSize
				slot.reloadingUntil = 0
			end
		end
	end

	PlayerState.Changed.Fire(player)

	-- The good ones sound like it.
	local big = kind == "Invincibility" or kind == "Multiplier" or kind == "Weapon"
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		Sound.At(if big then "PickupBig" else "Pickup", root.Position)
	end

	Remotes.Event("Notify"):FireClient(player, `Picked up: {labelFor(kind, weapon)}`)
end

--[[ Build the floating, spinning thing you actually drive into. ]]
local function createPickup(kind: string, position: Vector3, parent: Folder, weapon: string?): Pickup
	local part = Util.Part({
		Name = `Pickup_{kind}`,
		Size = Vector3.new(6, 6, 6),
		CFrame = CFrame.new(position + Vector3.new(0, 4, 0)),
		Color = colourFor(kind, weapon),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(8, 2)
	billboard.StudsOffset = Vector3.new(0, 4, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = labelFor(kind, weapon)
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = billboard

	local pickup: Pickup = {
		kind = kind,
		weapon = weapon,
		part = part,
		position = position + Vector3.new(0, 4, 0),
		availableAt = 0,
		available = true,
	}

	part.Touched:Connect(function(hit)
		if not pickup.available then
			return
		end
		local player: Player? = nil
		local character = hit:FindFirstAncestorOfClass("Model")
		if character then
			player = Players:GetPlayerFromCharacter(character)
		end
		if not player then
			local vehicle = VehicleService.FromPart(hit)
			if vehicle then
				local seat = vehicle:FindFirstChild("DriverSeat")
				if seat and seat:IsA("Seat") and seat.Occupant and seat.Occupant.Parent then
					player = Players:GetPlayerFromCharacter(seat.Occupant.Parent :: Model)
				end
			end
		end
		if not player then
			return
		end
		local pChar = player.Character
		local pHum = pChar and pChar:FindFirstChildOfClass("Humanoid")
		if not pHum or pHum.Health <= 0 then
			return
		end

		pickup.available = false
		pickup.availableAt = os.clock() + Config.Pickups.RespawnDelay
		part.Transparency = 1
		billboard.Enabled = false

		grant(player, kind, weapon)
	end)

	return pickup
end

--[[ Lay out every pickup the current map asked for. ]]
function PickupService.Build(pads: { { position: Vector3, kind: string, weapon: string? } })
	PickupService.Clear()

	local folder = Instance.new("Folder")
	folder.Name = "Pickups"
	folder.Parent = workspace
	container = folder

	for _, pad in pads do
		table.insert(pickups, createPickup(pad.kind, pad.position, folder, pad.weapon))
	end
end

function PickupService.Clear()
	if container then
		container:Destroy()
		container = nil
	end
	table.clear(pickups)
end

--[[ Spin them, bob them, and bring back the ones whose timer is up. ]]
local function step()
	local now = os.clock()
	local spin = CFrame.Angles(0, now * 1.5, 0)
	local bob = math.sin(now * 2) * 0.8

	for _, pickup in pickups do
		if not pickup.part.Parent then
			continue
		end

		pickup.part.CFrame = CFrame.new(pickup.position + Vector3.new(0, bob, 0)) * spin

		if not pickup.available and now >= pickup.availableAt then
			pickup.available = true
			pickup.part.Transparency = 0
			local billboard = pickup.part:FindFirstChildOfClass("BillboardGui")
			if billboard then
				billboard.Enabled = true
			end
		end
	end
end

RunService.Heartbeat:Connect(step)

return PickupService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">PlayerState</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PlayerState — everything the server remembers about a player for the
	length of a round: shields, keys, ammo, which perks are ticking down.

	Kept in one place so no two systems can disagree about how much shield
	somebody has.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Signal = require(Shared:WaitForChild("Signal"))

local PlayerState = {}

export type WeaponSlotState = {
	ammo: number,
	reloadingUntil: number,
	nextFireAt: number,
}

export type State = {
	shield: number,
	maxShield: number,
	lastDamagedAt: number,
	keys: number,
	carTier: number,
	megaCharges: number,
	equipped: string,
	weapons: { [string]: WeaponSlotState },
	burgerUntil: number,
	friesUntil: number,
	spawnProtectedUntil: number,
	nextMeleeAt: number,
	-- Points scored this round, and the multiplier ticking down on them.
	points: number,
	multiplierUntil: number,
	multiplierAmount: number,
	kills: number,
	deaths: number,
	-- The vehicle this player is sitting in, if any.
	vehicle: Model?,
	seatRole: string?,
}

local states: { [Player]: State } = {}

--[[ Fired whenever anything changes that the player's screen should show. ]]
PlayerState.Changed = Signal.new()

local function freshWeapons(): { [string]: WeaponSlotState }
	local weapons = {}
	for name, spec in Config.Weapons do
		weapons[name] = {
			ammo = if spec.AmmoFromPickupsOnly then 0 else spec.MagSize,
			reloadingUntil = 0,
			nextFireAt = 0,
		}
	end
	return weapons
end

--[[ Start a player from scratch. Called on join and at every respawn. ]]
function PlayerState.Reset(player: Player, keepProgress: boolean)
	local previous = states[player]

	local shieldBonus = 0
	-- The shield game pass adds permanent plating. In free mode everybody has it.
	if Config.FreeMode then
		shieldBonus = 50
	end

	states[player] = {
		shield = shieldBonus,
		maxShield = shieldBonus,
		lastDamagedAt = 0,
		keys = if keepProgress and previous then previous.keys else 0,
		carTier = if keepProgress and previous then previous.carTier else 1,
		megaCharges = if keepProgress and previous
			then math.max(Config.Mega.FreeChargesPerLife, previous.megaCharges)
			else Config.Mega.FreeChargesPerLife,
		equipped = Config.StartingLoadout[1],
		weapons = freshWeapons(),
		burgerUntil = 0,
		friesUntil = 0,
		spawnProtectedUntil = os.clock() + Config.Combat.SpawnProtection,
		nextMeleeAt = 0,
		-- Points, kills and deaths are per ROUND, so they survive a respawn
		-- but are wiped when a new round deploys everybody fresh.
		points = if keepProgress and previous then previous.points else 0,
		multiplierUntil = if keepProgress and previous then previous.multiplierUntil else 0,
		multiplierAmount = if keepProgress and previous then previous.multiplierAmount else 1,
		kills = if keepProgress and previous then previous.kills else 0,
		deaths = if keepProgress and previous then previous.deaths else 0,
		vehicle = nil,
		seatRole = nil,
	}

	PlayerState.Changed.Fire(player)
end

--[[ The live state for a player, creating it if this is the first ask. ]]
function PlayerState.Get(player: Player): State
	local existing = states[player]
	if existing then
		return existing
	end
	if not player.Parent then
		-- Return an untracked dummy state so departed players never leak into `states`.
		return {
			shield = 0,
			maxShield = 0,
			lastDamagedAt = 0,
			keys = 0,
			carTier = 1,
			megaCharges = 0,
			equipped = Config.StartingLoadout[1],
			weapons = freshWeapons(),
			burgerUntil = 0,
			friesUntil = 0,
			spawnProtectedUntil = 0,
			nextMeleeAt = 0,
			points = 0,
			multiplierUntil = 0,
			multiplierAmount = 1,
			kills = 0,
			deaths = 0,
			vehicle = nil,
			seatRole = nil,
		}
	end
	PlayerState.Reset(player, false)
	return states[player]
end

function PlayerState.Clear(player: Player)
	states[player] = nil
end

--[[ Is this player untouchable right now — just spawned, or holding a burger? ]]
function PlayerState.IsInvincible(player: Player): boolean
	local state = PlayerState.Get(player)
	local now = os.clock()
	return now < state.spawnProtectedUntil or now < state.burgerUntil
end

--[[ How many barrels this player's gun fires at once. Fries make it three. ]]
function PlayerState.BarrelCount(player: Player): number
	local state = PlayerState.Get(player)
	if os.clock() < state.friesUntil then
		return Config.Pickups.Fries.Barrels
	end
	return 1
end

--[[ The multiplier on this player's points right now, or 1. ]]
function PlayerState.PointMultiplier(player: Player): number
	local state = PlayerState.Get(player)
	if os.clock() < state.multiplierUntil then
		return state.multiplierAmount
	end
	return 1
end

--[[ Score, with whatever multiplier is running applied. ]]
function PlayerState.AwardPoints(player: Player, base: number): number
	local state = PlayerState.Get(player)
	local earned = math.floor(base * PlayerState.PointMultiplier(player))
	state.points += earned
	PlayerState.Changed.Fire(player)
	return earned
end

--[[ Shields grow back once nobody has shot you for a few seconds. ]]
function PlayerState.RegenerateShields(deltaTime: number)
	local now = os.clock()
	for player, state in states do
		if not player.Parent then
			states[player] = nil
			continue
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			continue
		end
		if state.maxShield > 0
			and state.shield < state.maxShield
			and now - state.lastDamagedAt > Config.Combat.ShieldRegenDelay
		then
			local prevFloor = math.floor(state.shield)
			state.shield = math.min(
				state.maxShield,
				state.shield + Config.Combat.ShieldRegenPerSecond * deltaTime
			)
			if math.floor(state.shield) ~= prevFloor or state.shield >= state.maxShield then
				PlayerState.Changed.Fire(player)
			end
		end
	end
end

--[[ Hand out a key, and upgrade the car if that key was enough. ]]
function PlayerState.AwardKeys(player: Player, count: number)
	local state = PlayerState.Get(player)
	state.keys += count

	for tierIndex = #Config.CarTiers, 1, -1 do
		if state.keys >= Config.CarTiers[tierIndex].KeysRequired then
			if tierIndex > state.carTier then
				state.carTier = tierIndex
			end
			break
		end
	end

	PlayerState.Changed.Fire(player)
end

Players.PlayerRemoving:Connect(function(player)
	PlayerState.Clear(player)
end)

return PlayerState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">ProjectileService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ProjectileService — everything that leaves a barrel and travels.

	Projectiles are simulated by the server, one raycast per frame along the
	path they just covered. That is deliberate: it means the server decides
	every hit, so nobody can fake a kill by editing their own game.

	The star of the show is the nuclear diamond bullet. It does not stop when
	it hits something — it detonates, keeps going, and detonates again at the
	next thing, up to Pierces times. Press F while it is still in the air and
	the next blast is ten times the size.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local DamageService = require(script.Parent:WaitForChild("DamageService"))
local VehicleService = require(script.Parent:WaitForChild("VehicleService"))
local WildlifeService = require(script.Parent:WaitForChild("WildlifeService"))
local CarnivalService = require(script.Parent:WaitForChild("CarnivalService"))

local ProjectileService = {}

local GRAVITY = Vector3.new(0, -75, 0)
local MAX_LIFETIME = 12

type Projectile = {
	owner: Player,
	weaponName: string,
	spec: Config.WeaponSpec,
	part: BasePart,
	position: Vector3,
	velocity: Vector3,
	piercesLeft: number,
	bornAt: number,
	-- Grenades only.
	fuseAt: number?,
	-- Drones only: who it is chasing.
	target: BasePart?,
	stuck: boolean,
	stuckTo: BasePart?,
	stuckOffset: CFrame?,
	hitEntities: { [Instance]: boolean },
	dead: boolean,
	-- Everything this projectile is not allowed to hit (the shooter, their car).
	ignore: { Instance },
}

local live: { Projectile } = {}

--[[ A small glowing part so players can actually see what is flying at them. ]]
local function makeVisual(spec: Config.WeaponSpec, position: Vector3, isDiamond: boolean): BasePart
	local isBall = spec.Kind == "Arcing"
	local isRocket = spec.Kind == "Rocket" or spec.Kind == "Homing"
	local size = if isDiamond
		then Vector3.new(1.5, 1.5, 2.8)
		elseif isBall then Vector3.new(1.3, 1.3, 1.3)
		elseif isRocket then Vector3.new(0.9, 0.9, 2.8)
		else Vector3.new(0.45, 0.45, 1.8)
	local material = if spec.Splat
		then Enum.Material.Mud
		elseif isBall and not spec.Sticky then Enum.Material.Metal
		else Enum.Material.Neon

	local part = Util.Part({
		Name = "Projectile",
		Size = size,
		CFrame = CFrame.new(position),
		Shape = if isBall then Enum.PartType.Ball else Enum.PartType.Block,
		Color = spec.Color,
		Material = material,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Anchored = true,
		Parent = workspace,
	})

	if isDiamond or isRocket or spec.Sticky then
		local light = Instance.new("PointLight")
		light.Color = spec.Color
		light.Range = if isDiamond then 22 else 14
		light.Brightness = if isDiamond then 4 else 2.5
		light.Shadows = false
		light.Parent = part
	end

	-- Attachments perpendicular to forward (-Z) travel so the Trail ribbon has real width.
	local trailHalf = if isDiamond then 0.55 elseif isRocket then 0.35 else 0.22
	local trail = Instance.new("Trail")
	local a0 = Util.Attachment(part, Vector3.new(0, trailHalf, 0), "TrailA")
	local a1 = Util.Attachment(part, Vector3.new(0, -trailHalf, 0), "TrailB")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = if isRocket then 0.5 else 0.35
	trail.Color = ColorSequence.new(spec.Color)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.LightEmission = if spec.Splat then 0 else 0.85
	trail.Parent = part

	return part
end

--[[ Stop simulating a projectile and clean its part up. ]]
local function retire(projectile: Projectile)
	if projectile.dead then
		return
	end
	projectile.dead = true
	if projectile.part and projectile.part.Parent then
		-- A moment of grace so the trail can finish drawing.
		projectile.part.Transparency = 1
		Debris:AddItem(projectile.part, 0.4)
	end
end

--[[
	Set one off. `scale` is 1 for a normal blast and 10 for a mega-detonation.
]]
local function detonate(projectile: Projectile, position: Vector3, scale: number)
	local spec = projectile.spec
	local radius = (spec.BlastRadius or 0) * scale
	local damage = (spec.BlastDamage or 0) * scale

	if radius > 0 then
		DamageService.Explode(
			position, radius, damage,
			projectile.owner, spec.VehicleDamageMultiplier,
			scale > 1,
			spec.DisplayName
		)
		if scale > 1 then
			DamageService.Crater(position, radius * 0.5)
		end
	end

	-- Cluster bombs burst into short-fuse bomblets fanning outward.
	local clusterCount = (spec :: any).Cluster
	if typeof(clusterCount) == "number" and clusterCount > 0 then
		local subRadius = (spec :: any).ClusterRadius or 30
		local subDamage = (spec :: any).ClusterDamage or 65
		local subSpec = table.clone(spec :: any)
		subSpec.Cluster = nil
		subSpec.BlastRadius = subRadius
		subSpec.BlastDamage = subDamage
		subSpec.FuseTime = 0.75
		subSpec.Sticky = false

		for i = 1, clusterCount do
			local angle = (i / clusterCount) * math.pi * 2
			local vel = Vector3.new(math.cos(angle) * 48, 34, math.sin(angle) * 48)
			local sub: Projectile = {
				owner = projectile.owner,
				weaponName = projectile.weaponName,
				spec = subSpec,
				part = makeVisual(subSpec, position + Vector3.new(0, 1.5, 0), false),
				position = position + Vector3.new(0, 1.5, 0),
				velocity = vel,
				piercesLeft = 0,
				bornAt = os.clock(),
				fuseAt = os.clock() + 0.75 + (i % 3) * 0.12,
				target = nil,
				stuck = false,
				stuckTo = nil,
				stuckOffset = nil,
				hitEntities = {},
				dead = false,
				ignore = projectile.ignore,
			}
			table.insert(live, sub)
		end
	end
end

--[[ Direct damage to whatever the projectile physically ran into. ]]
local function applyDirectHit(projectile: Projectile, hitPart: BasePart)
	local spec = projectile.spec

	-- Giant animals shrug off anything that is not a mega-detonation.
	-- Fairground props first: they are neither people nor vehicles.
	if CarnivalService.RegisterHit(hitPart, projectile.owner) then
		return
	end

	if WildlifeService.RegisterHit(hitPart, spec.Damage, projectile.owner) then
		return
	end

	local humanoid, character = Util.HumanoidFromHit(hitPart)
	if humanoid and character then
		if projectile.hitEntities[character] then
			return
		end
		projectile.hitEntities[character] = true
		local victim = Players:GetPlayerFromCharacter(character)
		if victim and victim ~= projectile.owner then
			local headshot = hitPart.Name == "Head" and not spec.Splat
			local dmg = if headshot then spec.Damage * 1.8 else spec.Damage
			local applied = DamageService.ApplyDamage(victim, dmg, projectile.owner, spec.DisplayName)
			if applied and projectile.owner.Parent then
				Remotes.Event("Hitmarker"):FireClient(projectile.owner, {
					damage = math.floor(dmg + 0.5),
					headshot = headshot,
				})
			end

			if spec.Splat then
				Remotes.Event("PlayEffect"):FireClient(victim, {
					effect = "Splat",
					duration = Config.Wildlife.SplatDuration,
				})
				if projectile.owner.Parent then
					Remotes.Event("Notify"):FireClient(projectile.owner, "Direct hit. Disgusting.")
				end
			end
			return
		end
	end

	local vehicle = VehicleService.FromPart(hitPart)
	if vehicle then
		if projectile.hitEntities[vehicle] then
			return
		end
		projectile.hitEntities[vehicle] = true
		VehicleService.Damage(
			vehicle,
			spec.Damage * (spec.VehicleDamageMultiplier or 1),
			projectile.owner
		)
	end
end

--[[
	Advance one projectile by one frame.

	The loop inside handles piercing: after a diamond bullet punches through
	something it still has travel left this frame, so we keep casting from the
	far side of what it just went through until it either runs out of pierces
	or runs out of frame.
]]
local function stepProjectile(projectile: Projectile, deltaTime: number)
	local spec = projectile.spec
	local kind = spec.Kind

	if projectile.stuck then
		return
	end

	-- Grenades and anything else lobbed feel gravity.
	if kind == "Arcing" then
		projectile.velocity += GRAVITY * deltaTime
	end

	-- A drone steers itself. It does not fall, and it does not give up.
	if kind == "Homing" then
		local target = projectile.target
		if target and target.Parent then
			local toTarget = target.Position - projectile.position
			if toTarget.Magnitude > 0.1 then
				local wanted = toTarget.Unit * projectile.velocity.Magnitude
				-- Turn toward the target at a limited rate, so it arcs round
				-- rather than snapping onto them instantly.
				local turnRate = (spec.HomingTurnRate or 3) * deltaTime
				local blended = projectile.velocity + (wanted - projectile.velocity) * math.min(1, turnRate)
				if blended.Magnitude > 0.001 then
					projectile.velocity = blended.Unit * projectile.velocity.Magnitude
				end
			end
		end
	end

	local remainingTravel = projectile.velocity * deltaTime
	local params = Util.RayParams(projectile.ignore)

	-- Up to a handful of casts per frame, one per thing pierced.
	for _ = 1, 10 do
		local distance = remainingTravel.Magnitude
		if distance < 0.001 then
			break
		end

		local result = workspace:Raycast(projectile.position, remainingTravel, params)
		if not result then
			projectile.position += remainingTravel
			break
		end

		local hitPoint = result.Position
		applyDirectHit(projectile, result.Instance)

		if kind == "Rocket" or kind == "Homing" then
			detonate(projectile, hitPoint, 1)
			retire(projectile)
			return
		end

		if kind == "Arcing" then
			if spec.Splat or not projectile.fuseAt then
				retire(projectile)
				return
			end
			if spec.Sticky then
				projectile.stuck = true
				projectile.position = hitPoint + result.Normal * 0.5
				local hitCFrame = CFrame.new(projectile.position)
				projectile.part.CFrame = hitCFrame
				if result.Instance and result.Instance:IsA("BasePart") and not result.Instance.Anchored then
					projectile.stuckTo = result.Instance
					projectile.stuckOffset = result.Instance.CFrame:ToObjectSpace(hitCFrame)
				end
				return
			end
			-- Ordinary grenades bounce, losing most of their energy.
			projectile.position = hitPoint + result.Normal * 0.4
			projectile.velocity = (projectile.velocity - 2 * projectile.velocity:Dot(result.Normal) * result.Normal) * 0.4
			return
		end

		-- Bullets. Diamond rounds detonate at every surface they punch through.
		if (spec.BlastRadius or 0) > 0 then
			detonate(projectile, hitPoint, 1)
		end

		if projectile.piercesLeft <= 0 then
			retire(projectile)
			return
		end

		projectile.piercesLeft -= 1

		-- Step out the far side of what we just pierced and carry on with
		-- whatever distance was left over this frame.
		local travelled = (hitPoint - projectile.position).Magnitude
		local direction = remainingTravel.Unit
		projectile.position = hitPoint + direction * 0.6
		remainingTravel = direction * math.max(0, distance - travelled - 0.6)
	end

	-- Point the visible part along the direction of travel.
	if projectile.velocity.Magnitude > 0.01 then
		projectile.part.CFrame = Util.LookAt(projectile.position, projectile.position + projectile.velocity)
	else
		projectile.part.CFrame = CFrame.new(projectile.position)
	end
end

--[[ Check if an enemy player walked or drove over a planted LandMine. ]]
local function checkMineProximity(projectile: Projectile): boolean
	local owner = projectile.owner
	for _, player in Players:GetPlayers() do
		if player == owner then
			continue
		end
		if owner.Team and player.Team and owner.Team == player.Team then
			continue
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
			if (root.Position - projectile.position).Magnitude <= 10 then
				return true
			end
		end
	end
	return false
end

--[[ Every live projectile gets a frame. ]]
local function step(deltaTime: number)
	local now = os.clock()

	for index = #live, 1, -1 do
		local projectile = live[index]

		if projectile.dead then
			table.remove(live, index)
			continue
		end

		-- Keep sticky bombs attached to moving vehicles or characters.
		if projectile.stuck and projectile.stuckTo then
			if projectile.stuckTo.Parent and projectile.stuckOffset then
				local worldCf = projectile.stuckTo.CFrame * projectile.stuckOffset
				projectile.position = worldCf.Position
				projectile.part.CFrame = worldCf
			else
				projectile.stuckTo = nil
				projectile.stuckOffset = nil
				projectile.stuck = false
			end
		end

		-- Armed land mines detonate when an enemy approaches.
		if projectile.stuck and projectile.weaponName == "LandMine" and now - projectile.bornAt > 0.8 then
			if checkMineProximity(projectile) then
				detonate(projectile, projectile.position, 1)
				retire(projectile)
				table.remove(live, index)
				continue
			end
		end

		-- Grenade fuses run whether the grenade is moving or wedged in a wall.
		if projectile.fuseAt and now >= projectile.fuseAt then
			detonate(projectile, projectile.position, 1)
			retire(projectile)
			table.remove(live, index)
			continue
		end

		-- Respect fuseAt so long-fuse LandMines (40s) and Drones (14s) are not deleted early.
		if not projectile.fuseAt and now - projectile.bornAt > MAX_LIFETIME then
			retire(projectile)
			table.remove(live, index)
			continue
		end

		stepProjectile(projectile, deltaTime)
	end
end

--[[
	Fire one projectile. Returns it so the caller can hold on to a diamond
	round for a possible mega-detonation.
]]
function ProjectileService.Spawn(
	owner: Player,
	weaponName: string,
	origin: Vector3,
	direction: Vector3,
	ignore: { Instance }
)
	local spec = Config.Weapons[weaponName]
	if not spec then
		return
	end

	local speed = spec.Speed or 300
	local isDiamond = spec.CanMegaDetonate == true

	--[[
		A drone locks on at launch: the enemy nearest to where you aimed.
		After that it is on its own — it will follow them round corners until
		it catches them or its battery dies.
	]]
	local lockedTarget: BasePart? = nil
	if spec.Kind == "Homing" then
		local bestAngle = 50
		for _, other in Players:GetPlayers() do
			if other == owner then
				continue
			end
			if other.Team and owner.Team and other.Team == owner.Team then
				continue
			end
			local character = other.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
				local toTarget = root.Position - origin
				if toTarget.Magnitude <= spec.Range then
					local angle = Util.AngleBetween(direction, toTarget)
					if angle < bestAngle then
						bestAngle = angle
						lockedTarget = root
					end
				end
			end
		end

		if lockedTarget then
			Remotes.Event("Notify"):FireClient(owner, "Drone locked on.")
		else
			Remotes.Event("Notify"):FireClient(owner, "Drone launched — no lock.")
		end
	end

	local projectile: Projectile = {
		owner = owner,
		weaponName = weaponName,
		spec = spec,
		part = makeVisual(spec, origin, isDiamond),
		position = origin,
		velocity = direction.Unit * speed,
		piercesLeft = spec.Pierces or 0,
		bornAt = os.clock(),
		fuseAt = if spec.Kind == "Homing"
			then os.clock() + (spec.HomingLifetime or 12)
			elseif spec.FuseTime and spec.FuseTime > 0 then os.clock() + spec.FuseTime
			else nil,
		target = lockedTarget,
		stuck = false,
		stuckTo = nil,
		stuckOffset = nil,
		hitEntities = {},
		dead = false,
		ignore = ignore,
	}

	table.insert(live, projectile)
end

--[[
	The F key. Finds this player's newest diamond round still in the air and
	sets it off ten times harder wherever it happens to be.

	Returns true if something actually went bang, so the caller knows whether
	to spend one of the player's charges.
]]
function ProjectileService.MegaDetonate(player: Player): boolean
	for index = #live, 1, -1 do
		local projectile = live[index]
		if projectile.owner == player
			and not projectile.dead
			and projectile.spec.CanMegaDetonate
		then
			detonate(projectile, projectile.position, Config.Mega.Multiplier)
			retire(projectile)
			table.remove(live, index)
			return true
		end
	end
	return false
end

--[[ Does this player have anything in the air worth detonating? ]]
function ProjectileService.HasLiveDiamond(player: Player): boolean
	for _, projectile in live do
		if projectile.owner == player and not projectile.dead and projectile.spec.CanMegaDetonate then
			return true
		end
	end
	return false
end

--[[ Wipe everything in flight, between rounds. ]]
function ProjectileService.ClearAll()
	for _, projectile in live do
		retire(projectile)
	end
	table.clear(live)
end

RunService.Heartbeat:Connect(step)

return ProjectileService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">ResortService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Nuclear Mud Arena — the resort.

	A lazy river, a mountain, a ski run and a chairlift, built into every map
	alongside the city.

	The river is the point of it: it runs right round the outside of the city
	and it MOVES you, so it is a way to get from one fight to another without
	walking, and a place to be ambushed from a sniper tower while you do.
	Sniper towers with ladders sit along it, and one stretch runs through a
	cave where nobody can see you from above.

	The mountain sits in one corner. An off-road trail switchbacks up it for
	the Jeep, the Hummer and the G-Wagon; the far face is a ski run with
	table-top jumps down to the river, so you can come off the mountain on a
	tube and keep going round the river on the same tube. A chairlift runs up
	the side with carriers big enough to drive a car onto.

	It is built from ordinary parts rather than Roblox Terrain. Terrain water
	would give real swimming for free, but it is a separate API with its own
	failure modes, and the whole flow of the river has to be deterministic
	anyway -- the current is explicit FlowZone parts carrying a direction,
	which push tubes and swimmers alike. That is testable from a terminal;
	terrain buoyancy is not.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local ArcadeService = require(script.Parent:WaitForChild("ArcadeService"))

local ResortService = {}

type LiftCarrier = {
	model: Model,
	deck: BasePart,
	hanger: BasePart,
	phase: number,
	lastPos: Vector3,
	lockedVehicle: Model?,
	lockWeld: WeldConstraint?,
	wasAtStation: boolean,
}

type LiftSystem = {
	bottomDeck: Vector3,
	topDeck: Vector3,
	cableBottom: Vector3,
	cableTop: Vector3,
	dir: Vector3,
	right: Vector3,
	laneOffset: number,
	carriers: { LiftCarrier },
	bullwheels: { BasePart },
}

local activeLift: LiftSystem? = nil
local liftStarted = false
local CARRIER_COUNT = 6
local CARRIER_SPEED = 0.028 -- full loop fraction per second (~18s one-way)
local STATION_DWELL = 0.045 -- slow boarding zone at each end

export type ResortBuild = {
	-- Where a tube can be found, on the river and at the mountain top.
	tubePads: { Vector3 },
	-- Where the skis live: the summit.
	skiPads: { Vector3 },
	-- Chairlift boarding points, bottom first.
	liftStations: { Vector3 },
	-- The summit platform, for sniper spawns and the view.
	summit: Vector3,
	-- Sniper tower platforms, so pickups can be put on them.
	towerTops: { Vector3 },
}

local WATER_WIDTH = 46
local BANK = 10
local WALL_HEIGHT = 9
local WATER_LEVEL = 3

--[[
	One straight run of river.

	Floor, two banks, the water itself, and a flow zone. The flow zone is an
	invisible part tagged with the direction of travel; RiverService reads
	those and pushes whatever is inside them, which is what makes the river
	a river rather than a long puddle.
]]
local function riverRun(from: Vector3, to: Vector3, parent: Instance)
	local delta = to - from
	local length = delta.Magnitude
	if length < 1 then
		return
	end

	local middle = from + delta * 0.5
	local facing = CFrame.lookAt(middle, to)
	local direction = delta.Unit

	-- The bed. Slightly sunken, so the water sits in something.
	Util.Part({
		Name = "RiverBed",
		Size = Vector3.new(WATER_WIDTH + BANK * 2, 2, length),
		CFrame = facing,
		Color = Color3.fromRGB(96, 92, 76),
		Material = Enum.Material.Sand,
		Parent = parent,
	})

	-- Walls either side, low enough to shoot over from the water and high
	-- enough that you cannot simply walk out mid-river.
	for _, side in { -1, 1 } do
		Util.Part({
			Name = "RiverWall",
			Size = Vector3.new(BANK, WALL_HEIGHT, length),
			CFrame = facing * CFrame.new(side * (WATER_WIDTH + BANK) * 0.5, WALL_HEIGHT * 0.5, 0),
			Color = Color3.fromRGB(150, 146, 134),
			Material = Enum.Material.Concrete,
			Parent = parent,
		})
	end

	-- The water. Not solid: you ride a tube on it, or swim it on foot.
	Util.Part({
		Name = "RiverWater",
		Size = Vector3.new(WATER_WIDTH, WATER_LEVEL, length),
		CFrame = facing * CFrame.new(0, WATER_LEVEL * 0.5 + 1, 0),
		Color = Color3.fromRGB(70, 160, 200),
		Material = Enum.Material.Water,
		Transparency = 0.35,
		CanCollide = false,
		CanQuery = false,
		Parent = parent,
	})

	-- The current (CanQuery = true so tubes and swimmers detect FlowZone).
	local flow = Util.Part({
		Name = "FlowZone",
		Size = Vector3.new(WATER_WIDTH, 10, length),
		CFrame = facing * CFrame.new(0, 5, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = true,
		CanTouch = true,
		Parent = parent,
	})
	flow:SetAttribute("FlowX", direction.X)
	flow:SetAttribute("FlowY", direction.Y)
	flow:SetAttribute("FlowZ", direction.Z)
end

--[[
	A roof over a stretch of river, and rock down both sides.

	Somewhere on the loop you cannot be seen from above or shot from the
	towers, which is the only thing that makes floating the long way round a
	real choice rather than a slow death.
]]
local function cave(from: Vector3, to: Vector3, parent: Instance)
	local delta = to - from
	local length = delta.Magnitude
	local middle = from + delta * 0.5
	local facing = CFrame.lookAt(middle, to)
	local span = WATER_WIDTH + BANK * 2

	Util.Part({
		Name = "CaveRoof",
		Size = Vector3.new(span + 14, 6, length),
		CFrame = facing * CFrame.new(0, 22, 0),
		Color = Color3.fromRGB(78, 72, 66),
		Material = Enum.Material.Rock,
		Parent = parent,
	})

	for _, side in { -1, 1 } do
		Util.Part({
			Name = "CaveWall",
			Size = Vector3.new(8, 20, length),
			CFrame = facing * CFrame.new(side * (span * 0.5 + 3), 12, 0),
			Color = Color3.fromRGB(70, 65, 60),
			Material = Enum.Material.Rock,
			Parent = parent,
		})
	end

	-- A few stalactites, so it reads as a cave and not a concrete underpass.
	for step = 1, 6 do
		local along = -length * 0.5 + (step / 7) * length
		Util.Part({
			Name = "Stalactite",
			Size = Vector3.new(3, 7, 3),
			CFrame = facing
				* CFrame.new(((step % 2) * 2 - 1) * 12, 15, along)
				* CFrame.Angles(0, 0, math.rad(8)),
			Shape = Enum.PartType.Block,
			Color = Color3.fromRGB(88, 82, 74),
			Material = Enum.Material.Rock,
			CanCollide = false,
			Parent = parent,
		})
	end
end

--[[
	A sniper tower: legs, a platform with a lip, and a climbable ladder.

	TrussPart is the ladder, because Roblox lets a Humanoid climb one with no
	code at all. A ladder built out of ordinary parts is just a wall.
]]
local function sniperTower(base: Vector3, height: number, parent: Instance): Vector3
	local platform = base + Vector3.new(0, height, 0)

	for _, corner in {
		Vector2.new(-1, -1), Vector2.new(1, -1),
		Vector2.new(-1, 1), Vector2.new(1, 1),
	} do
		Util.Part({
			Name = "TowerLeg",
			Size = Vector3.new(2.5, height, 2.5),
			CFrame = CFrame.new(base + Vector3.new(corner.X * 9, height * 0.5, corner.Y * 9)),
			Color = Color3.fromRGB(104, 98, 88),
			Material = Enum.Material.Metal,
			Parent = parent,
		})
	end

	Util.Part({
		Name = "TowerPlatform",
		Size = Vector3.new(26, 2, 26),
		CFrame = CFrame.new(platform),
		Color = Color3.fromRGB(128, 122, 110),
		Material = Enum.Material.DiamondPlate,
		Parent = parent,
	})

	-- A lip to crouch behind, open on one side so you can get on from the
	-- ladder without jumping over anything.
	for index, side in { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, -1) } do
		Util.Part({
			Name = "TowerLip",
			Size = Vector3.new(
				if side.X ~= 0 then 2 else 26,
				5,
				if side.Z ~= 0 then 2 else 26
			),
			CFrame = CFrame.new(platform + side * 12 + Vector3.new(0, 3.5, 0)),
			Color = Color3.fromRGB(112, 106, 96),
			Material = Enum.Material.Metal,
			Parent = parent,
		})
		local _ = index
	end

	local ladder = Instance.new("TrussPart")
	ladder.Name = "TowerLadder"
	ladder.Size = Vector3.new(2, height, 2)
	ladder.CFrame = CFrame.new(base + Vector3.new(0, height * 0.5, 13))
	ladder.Anchored = true
	ladder.Color = Color3.fromRGB(150, 140, 60)
	ladder.Parent = parent

	return platform + Vector3.new(0, 2, 0)
end

--[[
	The mountain.

	Stepped rings rather than a smooth cone, because a stack of wide flat
	terraces is something you can drive on, park on and fight over, and a
	smooth slope is something you slide off. The steps are shallow enough
	that a Jeep takes them at speed.
]]
local function mountain(centre: Vector3, radius: number, height: number, parent: Instance)
	local steps = 9
	for ring = 0, steps - 1 do
		local fraction = ring / steps
		local ringRadius = radius * (1 - fraction * 0.82)
		local ringY = height * fraction
		local thickness = height / steps + 2

		Util.Part({
			Name = "MountainStep",
			Size = Vector3.new(ringRadius * 2, thickness, ringRadius * 2),
			CFrame = CFrame.new(centre + Vector3.new(0, ringY + thickness * 0.5, 0))
				-- Each terrace turned a little, so the silhouette is not a
				-- stack of identical squares.
				* CFrame.Angles(0, math.rad(ring * 11), 0),
			Color = Color3.fromRGB(96, 104, 92):Lerp(Color3.fromRGB(235, 240, 248), fraction * 0.8),
			Material = if fraction > 0.55 then Enum.Material.Snow else Enum.Material.Slate,
			Parent = parent,
		})
	end

	-- The summit platform: flat, snowy, and the best view on the map.
	local summitY = height + 2
	Util.Part({
		Name = "Summit",
		Size = Vector3.new(radius * 0.5, 4, radius * 0.5),
		CFrame = CFrame.new(centre + Vector3.new(0, summitY, 0)),
		Color = Color3.fromRGB(240, 246, 252),
		Material = Enum.Material.Snow,
		Parent = parent,
	})

	return centre + Vector3.new(0, summitY + 2, 0)
end

--[[
	The off-road trail: a switchback road cut round the mountain.

	Wide and banked, because the point is to drive a G-Wagon up it under fire
	rather than to thread a needle.
]]
local function offRoadTrail(centre: Vector3, radius: number, height: number, parent: Instance)
	local legs = 10
	local trailWidth = 26

	for leg = 0, legs - 1 do
		local fromAngle = (leg / legs) * math.pi * 2.4
		local toAngle = ((leg + 1) / legs) * math.pi * 2.4
		local fromRadius = radius * (0.95 - (leg / legs) * 0.55)
		local toRadius = radius * (0.95 - ((leg + 1) / legs) * 0.55)

		local from = centre + Vector3.new(
			math.cos(fromAngle) * fromRadius,
			(leg / legs) * height,
			math.sin(fromAngle) * fromRadius
		)
		local to = centre + Vector3.new(
			math.cos(toAngle) * toRadius,
			((leg + 1) / legs) * height,
			math.sin(toAngle) * toRadius
		)

		local delta = to - from
		local length = delta.Magnitude
		Util.Part({
			Name = "TrailSegment",
			Size = Vector3.new(trailWidth, 2.5, length),
			CFrame = CFrame.lookAt(from + delta * 0.5, to),
			Color = Color3.fromRGB(104, 88, 66),
			Material = Enum.Material.Ground,
			Parent = parent,
		})

		-- A landing pad at every corner, or you clip the turn and go over.
		Util.Part({
			Name = "TrailCorner",
			Size = Vector3.new(trailWidth, 2.5, trailWidth),
			CFrame = CFrame.new(to),
			Color = Color3.fromRGB(110, 94, 70),
			Material = Enum.Material.Ground,
			Parent = parent,
		})
	end
end

--[[
	A table-top jump: up a kicker, across a flat deck, off the far lip.

	The flat top is what makes it a table top rather than a ramp, and it is
	what gives you time in the air to actually do something -- which is the
	whole point of putting them down a ski run.
]]
local function tableTop(centre: Vector3, heading: Vector3, scale: number, parent: Instance)
	local flat = Vector3.new(heading.X, 0, heading.Z)
	flat = if flat.Magnitude < 0.01 then Vector3.new(0, 0, 1) else flat.Unit
	local lift = 9 * scale
	local deck = 20 * scale
	local width = 34

	local facing = CFrame.lookAt(centre, centre + flat)

	-- The run-up kicker (uphill side, +Z in facing space).
	Util.Part({
		Name = "JumpKicker",
		Size = Vector3.new(width, 2.5, 22 * scale),
		CFrame = facing
			* CFrame.new(0, lift * 0.5, deck * 0.5 + 11 * scale)
			* CFrame.Angles(math.rad(16), 0, 0),
		Color = Color3.fromRGB(236, 242, 250),
		Material = Enum.Material.Snow,
		Parent = parent,
	})

	-- The deck.
	Util.Part({
		Name = "JumpDeck",
		Size = Vector3.new(width, 2.5, deck),
		CFrame = facing * CFrame.new(0, lift, 0),
		Color = Color3.fromRGB(240, 246, 252),
		Material = Enum.Material.Snow,
		Parent = parent,
	})

	-- The lip you leave from (downhill side, -Z in facing space).
	local lip = Util.Part({
		Name = "JumpLip",
		Size = Vector3.new(width, 2.5, 12 * scale),
		CFrame = facing
			* CFrame.new(0, lift + 1.6, -(deck * 0.5 + 6 * scale))
			* CFrame.Angles(math.rad(-14), 0, 0),
		Color = Color3.fromRGB(246, 250, 255),
		Material = Enum.Material.Snow,
		Parent = parent,
	})
	-- Tagged so the trick scorer knows you left a jump rather than tripped
	-- off a kerb.
	lip:SetAttribute("TrickLaunch", true)
end

--[[
	The ski run.

	One long piste from the summit down to the river, with table tops spaced
	along it. Long on purpose: the brief was that you should be able to find
	a fight while you are on the way down, and a short run is a cutscene.

	It finishes level with the water, so a tube coming off the bottom carries
	straight into the river and keeps going.
]]
local function skiRun(
	summit: Vector3,
	finish: Vector3,
	parent: Instance
): { Vector3 }
	local segments = 9
	local jumps: { Vector3 } = {}
	local width = 70

	local previous = summit
	for step = 1, segments do
		local fraction = step / segments
		-- Eased, so it is steep at the top and runs out flat at the bottom.
		local eased = 1 - (1 - fraction) * (1 - fraction)
		local here = Vector3.new(
			summit.X + (finish.X - summit.X) * fraction,
			summit.Y + (finish.Y - summit.Y) * eased,
			summit.Z + (finish.Z - summit.Z) * fraction
		)

		local delta = here - previous
		local length = delta.Magnitude
		if length > 1 then
			Util.Part({
				Name = "Piste",
				Size = Vector3.new(width, 3, length),
				CFrame = CFrame.lookAt(previous + delta * 0.5, here),
				Color = Color3.fromRGB(242, 248, 254),
				Material = Enum.Material.Snow,
				Parent = parent,
			})

			-- Edges, so you can lean on them instead of falling off the side
			-- of the mountain every time somebody shoots at you.
			for _, side in { -1, 1 } do
				local across = Vector3.new(-delta.Unit.Z, 0, delta.Unit.X)
				Util.Part({
					Name = "PisteEdge",
					Size = Vector3.new(5, 7, length),
					CFrame = CFrame.lookAt(previous + delta * 0.5, here)
						* CFrame.new(side * (width * 0.5 + 2), 2, 0),
					Color = Color3.fromRGB(224, 232, 242),
					Material = Enum.Material.Snow,
					Parent = parent,
				})
				local _ = across
			end

			-- A table top on most segments, bigger lower down where you have
			-- the speed to clear them.
			if step >= 2 and step <= segments - 1 then
				local jumpAt = previous + delta * 0.55
				tableTop(jumpAt, delta.Unit, 0.8 + fraction * 0.9, parent)
				table.insert(jumps, jumpAt)
			end
		end

		previous = here
	end

	return jumps
end

--[[
	The chairlift.

	Towers, a cable, and carriers wide enough to drive a car onto -- the
	brief asked for that specifically, and it is the thing that makes the
	mountain worth having: you can take a G-Wagon up and bring it down the
	ski run.

	The carriers themselves are built and moved by LiftService; this lays
	down the structure and hands back the two stations.
]]
--[[ Compute world position and facing of a chairlift carrier at loop phase t in [0, 1). ]]
local function carrierPose(lift: LiftSystem, t: number): (Vector3, CFrame, boolean)
	local phase = t % 1
	local bottomD = lift.bottomDeck
	local topD = lift.topDeck
	local right = lift.right
	local lane = lift.laneOffset
	local dir = lift.dir

	-- 0.00..0.46: ascending on +right lane
	-- 0.46..0.50: top bullwheel turnaround (boarding dwell)
	-- 0.50..0.96: descending on -right lane
	-- 0.96..1.00: bottom bullwheel turnaround (boarding dwell)
	if phase < 0.46 then
		local u = phase / 0.46
		local pos = bottomD:Lerp(topD, u) + right * lane
		local atStation = u < STATION_DWELL or u > (1 - STATION_DWELL)
		return pos, CFrame.lookAt(pos, pos + dir), atStation
	elseif phase < 0.50 then
		local u = (phase - 0.46) / 0.04
		local ang = u * math.pi
		local offset = right * (math.cos(ang) * lane) + dir * (math.sin(ang) * lane)
		local pos = topD + offset
		local tangent = -right * math.sin(ang) + dir * math.cos(ang)
		return pos, CFrame.lookAt(pos, pos + tangent), true
	elseif phase < 0.96 then
		local u = (phase - 0.50) / 0.46
		local pos = topD:Lerp(bottomD, u) - right * lane
		local atStation = u < STATION_DWELL or u > (1 - STATION_DWELL)
		return pos, CFrame.lookAt(pos, pos - dir), atStation
	else
		local u = (phase - 0.96) / 0.04
		local ang = math.pi + u * math.pi
		local offset = right * (math.cos(ang) * lane) + dir * (math.sin(ang) * lane)
		local pos = bottomD + offset
		local tangent = -right * math.sin(ang) + dir * math.cos(ang)
		return pos, CFrame.lookAt(pos, pos + tangent), true
	end
end

local function unlockCarrierVehicle(carrier: LiftCarrier)
	if carrier.lockWeld then
		carrier.lockWeld:Destroy()
		carrier.lockWeld = nil
	end
	if carrier.lockedVehicle then
		if carrier.lockedVehicle.Parent then
			carrier.lockedVehicle:SetAttribute("LiftLocked", false)
		end
		carrier.lockedVehicle = nil
	end
end

--[[ Lock any vehicle parked directly on top of a carrier deck. ]]
local function tryLockVehicleOnDeck(carrier: LiftCarrier)
	if carrier.lockedVehicle and carrier.lockedVehicle.Parent then
		return
	end
	unlockCarrierVehicle(carrier)

	local regionCf = carrier.deck.CFrame * CFrame.new(0, 4.5, 0)
	local regionSize = Vector3.new(17, 7, 24)
	local parts = workspace:GetPartBoundsInBox(regionCf, regionSize)
	for _, part in parts do
		local model = part:FindFirstAncestorOfClass("Model")
		if model and model:GetAttribute("VehicleKind") and model.PrimaryPart and not model:GetAttribute("LiftLocked") then
			local chassis = model.PrimaryPart
			if not chassis.Anchored then
				local weld = Instance.new("WeldConstraint")
				weld.Name = "LiftLock"
				weld.Part0 = carrier.deck
				weld.Part1 = chassis
				weld.Parent = carrier.deck
				model:SetAttribute("LiftLocked", true)
				carrier.lockedVehicle = model
				carrier.lockWeld = weld
				return
			end
		end
	end
end

local function buildCarrier(lift: LiftSystem, index: number, parent: Instance): LiftCarrier
	local model = Instance.new("Model")
	model.Name = `LiftCarrier_{index}`

	local initialPhase = (index - 1) / CARRIER_COUNT
	local pos, cf = carrierPose(lift, initialPhase)

	-- Wide steel vehicle-capable platform deck (fits G-Wagon, Hummer, Jeep, and players).
	local deck = Util.Part({
		Name = "CarrierDeck",
		Size = Vector3.new(18, 1.8, 26),
		CFrame = cf,
		Color = Color3.fromRGB(86, 92, 102),
		Material = Enum.Material.DiamondPlate,
		Anchored = true,
		Parent = model,
	})
	model.PrimaryPart = deck

	-- Low hazard side curbs so cars stay centered during the climb.
	for _, side in { -1, 1 } do
		local curb = Util.Part({
			Name = "CarrierCurb",
			Size = Vector3.new(1.2, 2.2, 26),
			CFrame = cf * CFrame.new(side * 8.6, 1.8, 0),
			Color = Color3.fromRGB(224, 178, 36),
			Material = Enum.Material.Metal,
			Anchored = false,
			Massless = true,
			Parent = model,
		})
		Util.Weld(deck, curb)
	end

	-- Overhead steel gantry arch + cable hanger pylon.
	local hanger = Util.Part({
		Name = "CarrierHanger",
		Size = Vector3.new(1.4, 24, 1.4),
		CFrame = cf * CFrame.new(0, 13, 0),
		Color = Color3.fromRGB(58, 62, 70),
		Material = Enum.Material.Metal,
		Anchored = false,
		CanCollide = false,
		Massless = true,
		Parent = model,
	})
	Util.Weld(deck, hanger)

	-- Warm safety beacon at the top of the hanger so moving carriers are visible from afar.
	local beacon = Util.Part({
		Name = "CarrierBeacon",
		Size = Vector3.new(1.6, 1.6, 1.6),
		CFrame = cf * CFrame.new(0, 24.5, 0),
		Shape = Enum.PartType.Ball,
		Color = Color3.fromRGB(255, 200, 90),
		Material = Enum.Material.Neon,
		Anchored = false,
		CanCollide = false,
		CanQuery = false,
		Massless = true,
		Parent = model,
	})
	Util.Weld(deck, beacon)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Toggle Vehicle Lock"
	prompt.ObjectText = "Chairlift Carrier"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 18
	prompt.Parent = deck

	local carrier: LiftCarrier = {
		model = model,
		deck = deck,
		hanger = hanger,
		phase = initialPhase,
		lastPos = pos,
		lockedVehicle = nil,
		lockWeld = nil,
		wasAtStation = true,
	}

	prompt.Triggered:Connect(function()
		if carrier.lockedVehicle then
			unlockCarrierVehicle(carrier)
		else
			tryLockVehicleOnDeck(carrier)
		end
	end)

	model.Parent = parent
	return carrier
end

local function chairlift(bottom: Vector3, top: Vector3, parent: Instance): { Vector3 }
	local delta = top - bottom
	local flatDelta = Vector3.new(delta.X, 0, delta.Z)
	local dir = if flatDelta.Magnitude > 0.01 then flatDelta.Unit else Vector3.new(0, 0, 1)
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local laneOffset = 12
	local cableOffset = 25
	local towers = 6

	-- Grounded steel towers + properly rotated cross-arms perpendicular to the cable.
	for index = 0, towers do
		local fraction = index / towers
		local cablePoint = bottom + delta * fraction + Vector3.new(0, cableOffset + 3, 0)
		local columnHeight = math.max(28, cablePoint.Y)
		local footY = cablePoint.Y - columnHeight

		Util.Part({
			Name = "LiftTower",
			Size = Vector3.new(4.2, columnHeight, 4.2),
			CFrame = CFrame.new(cablePoint.X, footY + columnHeight * 0.5, cablePoint.Z),
			Color = Color3.fromRGB(82, 88, 98),
			Material = Enum.Material.Metal,
			Parent = parent,
		})

		-- Cross-arm oriented perpendicular to the lift direction.
		local armCf = CFrame.lookAt(cablePoint, cablePoint + dir)
		Util.Part({
			Name = "LiftArm",
			Size = Vector3.new(laneOffset * 2 + 4, 2.2, 2.4),
			CFrame = armCf,
			Color = Color3.fromRGB(108, 114, 124),
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = parent,
		})
	end

	-- Dual parallel haul cables (ascending +right lane, descending -right lane).
	for _, side in { -1, 1 } do
		for index = 0, towers - 1 do
			local a = bottom + delta * (index / towers) + Vector3.new(0, cableOffset + 3, 0) + right * (side * laneOffset)
			local b = bottom + delta * ((index + 1) / towers) + Vector3.new(0, cableOffset + 3, 0) + right * (side * laneOffset)
			local span = b - a
			Util.Part({
				Name = "LiftCable",
				Size = Vector3.new(0.7, 0.7, span.Magnitude),
				CFrame = CFrame.lookAt(a + span * 0.5, b),
				Color = Color3.fromRGB(36, 38, 44),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = parent,
			})
		end
	end

	-- Boarding decks + rotating overhead bullwheels at both ends.
	local stations: { Vector3 } = {}
	local bullwheels: { BasePart } = {}
	for idx, at in { bottom, top } do
		local deckCf = CFrame.lookAt(at + Vector3.new(0, 1.5, 0), at + Vector3.new(0, 1.5, 0) + dir)
		Util.Part({
			Name = "LiftStation",
			Size = Vector3.new(54, 3, 52),
			CFrame = deckCf,
			Color = Color3.fromRGB(118, 114, 106),
			Material = Enum.Material.DiamondPlate,
			Parent = parent,
		})

		local wheel = Util.Part({
			Name = "LiftBullwheel",
			Size = Vector3.new(2, laneOffset * 2, laneOffset * 2),
			CFrame = CFrame.new(at + Vector3.new(0, cableOffset + 3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Shape = Enum.PartType.Cylinder,
			Color = Color3.fromRGB(186, 62, 46),
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = parent,
		})
		table.insert(bullwheels, wheel)

		-- Warm station floodlight for Future lighting contrast.
		local lamp = Util.Part({
			Name = "StationLamp",
			Size = Vector3.new(2.2, 2.2, 2.2),
			CFrame = CFrame.new(at + Vector3.new(0, cableOffset + 7, 0)),
			Shape = Enum.PartType.Ball,
			Color = Color3.fromRGB(255, 224, 150),
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
			Parent = parent,
		})
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 220, 155)
		light.Brightness = 4
		light.Range = 60
		light.Shadows = true
		light.Parent = lamp

		-- Summit timber A-frame lodge shelter.
		if idx == 2 then
			local lodgePos = at + right * 34
			Util.Part({
				Name = "SummitLodge",
				Size = Vector3.new(24, 14, 28),
				CFrame = CFrame.lookAt(lodgePos + Vector3.new(0, 7, 0), lodgePos + Vector3.new(0, 7, 0) + dir),
				Color = Color3.fromRGB(112, 74, 46),
				Material = Enum.Material.WoodPlanks,
				Parent = parent,
			})
			Util.Part({
				Name = "LodgeWindow",
				Size = Vector3.new(18, 6, 0.8),
				CFrame = CFrame.lookAt(lodgePos + Vector3.new(0, 8, 0) - dir * 14.1, lodgePos + Vector3.new(0, 8, 0) - dir * 20),
				Color = Color3.fromRGB(255, 206, 128),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = parent,
			})
		end

		table.insert(stations, at + Vector3.new(0, 4, 0))
	end

	local liftSystem: LiftSystem = {
		bottomDeck = bottom + Vector3.new(0, 3.9, 0),
		topDeck = top + Vector3.new(0, 3.9, 0),
		cableBottom = bottom + Vector3.new(0, cableOffset + 3, 0),
		cableTop = top + Vector3.new(0, cableOffset + 3, 0),
		dir = dir,
		right = right,
		laneOffset = laneOffset,
		carriers = {},
		bullwheels = bullwheels,
	}

	for i = 1, CARRIER_COUNT do
		table.insert(liftSystem.carriers, buildCarrier(liftSystem, i, parent))
	end
	activeLift = liftSystem

	return stations
end

function ResortService.Clear()
	if activeLift then
		for _, carrier in activeLift.carriers do
			unlockCarrierVehicle(carrier)
		end
		activeLift = nil
	end
end

function ResortService.Start()
	if liftStarted then
		return
	end
	liftStarted = true

	RunService.Heartbeat:Connect(function(deltaTime: number)
		local lift = activeLift
		if not lift then
			return
		end
		local dt = math.min(deltaTime, 0.1)
		if dt <= 0 then
			return
		end

		-- Spin the steel bullwheels at both stations.
		for _, wheel in lift.bullwheels do
			if wheel.Parent then
				wheel.CFrame = wheel.CFrame * CFrame.Angles(dt * 0.9, 0, 0)
			end
		end

		-- Advance every chairlift carrier smoothly along the closed loop.
		for _, carrier in lift.carriers do
			if not carrier.deck.Parent then
				unlockCarrierVehicle(carrier)
				continue
			end

			local _, _, currentlyAtStation = carrierPose(lift, carrier.phase)
			local stepRate = if currentlyAtStation then CARRIER_SPEED * 0.42 else CARRIER_SPEED
			carrier.phase = (carrier.phase + stepRate * dt) % 1

			local newPos, newCf, nowAtStation = carrierPose(lift, carrier.phase)
			local vel = (newPos - carrier.lastPos) / dt
			carrier.lastPos = newPos

			-- Auto-lock parked cars when leaving a station; auto-release when arriving.
			if carrier.wasAtStation and not nowAtStation then
				tryLockVehicleOnDeck(carrier)
			elseif (not carrier.wasAtStation) and nowAtStation then
				unlockCarrierVehicle(carrier)
			end
			carrier.wasAtStation = nowAtStation

			-- Move the carrier and set AssemblyLinearVelocity so standing players ride smoothly.
			carrier.deck.CFrame = newCf
			carrier.deck.AssemblyLinearVelocity = vel
		end
	end)
end

-- ==================================================================== BUILD ==

--[[
	Build the whole resort for a map of this size.

	Laid out in the open ring around the city: the river runs right round it,
	the mountain sits in one corner, and the ski run comes down the mountain
	straight into the river so a tube carries on without stopping.

	MapService reserves the corner the mountain lands on, the same way it
	reserves the carnival, so no building is ever put inside it.
]]
function ResortService.Build(mapSize: number, parent: Instance): ResortBuild
	ResortService.Clear()
	local half = mapSize * 0.5
	-- The river sits in the middle of the ring, clear of both the city and
	-- the boundary wall.
	local ringRadius = half - 118

	-- Four corners of the loop, rounded off by cutting the corners.
	local cut = ringRadius * 0.42
	local loop: { Vector3 } = {
		Vector3.new(-ringRadius + cut, 0, -ringRadius),
		Vector3.new(ringRadius - cut, 0, -ringRadius),
		Vector3.new(ringRadius, 0, -ringRadius + cut),
		Vector3.new(ringRadius, 0, ringRadius - cut),
		Vector3.new(ringRadius - cut, 0, ringRadius),
		Vector3.new(-ringRadius + cut, 0, ringRadius),
		Vector3.new(-ringRadius, 0, ringRadius - cut),
		Vector3.new(-ringRadius, 0, -ringRadius + cut),
	}

	for index = 1, #loop do
		local from = loop[index]
		local to = loop[(index % #loop) + 1]
		riverRun(from, to, parent)
	end

	-- One stretch runs through a cave: the only part of the loop that cannot
	-- be seen into from above or shot at from the towers.
	cave(loop[6], loop[7], parent)
	-- Warm cave lanterns along the rock wall for Future lighting depth inside the tunnel.
	for i = 1, 4 do
		local lanternPos = loop[6]:Lerp(loop[7], i / 5) + Vector3.new(0, 18, 0)
		local lantern = Util.Part({
			Name = "CaveLantern",
			Size = Vector3.new(1.5, 1.5, 1.5),
			CFrame = CFrame.new(lanternPos),
			Shape = Enum.PartType.Ball,
			Color = Color3.fromRGB(255, 188, 98),
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
			Parent = parent,
		})
		local glow = Instance.new("PointLight")
		glow.Color = Color3.fromRGB(255, 182, 92)
		glow.Brightness = 3.5
		glow.Range = 46
		glow.Shadows = true
		glow.Parent = lantern
	end

	-- Sniper towers overlooking the water, pulled in off the bank so they
	-- cover the river rather than stand in it.
	local towerTops: { Vector3 } = {}
	for _, at in {
		Vector3.new(-ringRadius + 60, 0, -ringRadius + 62),
		Vector3.new(ringRadius - 62, 0, -ringRadius + 60),
		Vector3.new(ringRadius - 60, 0, ringRadius - 62),
	} do
		table.insert(towerTops, sniperTower(at, 46 + (#towerTops * 8), parent))
	end

	-- The mountain, in the corner the towers leave free.
	local mountainCentre = Vector3.new(-ringRadius * 0.74, 0, ringRadius * 0.74)
	local mountainRadius = math.min(220, ringRadius * 0.62)
	local mountainHeight = 170
	local summit = mountain(mountainCentre, mountainRadius, mountainHeight, parent)
	offRoadTrail(mountainCentre, mountainRadius, mountainHeight, parent)

	-- Alpine pine trees around the lower timberline for realistic scale and silhouettes.
	for treeIdx = 1, 14 do
		local ang = (treeIdx / 14) * math.pi * 2 + 0.25
		local dist = mountainRadius * (0.98 + (treeIdx % 3) * 0.08)
		local base = mountainCentre + Vector3.new(math.cos(ang) * dist, 0, math.sin(ang) * dist)
		Util.Part({
			Name = "PineTrunk",
			Size = Vector3.new(2.6, 14, 2.6),
			CFrame = CFrame.new(base + Vector3.new(0, 7, 0)),
			Color = Color3.fromRGB(82, 56, 38),
			Material = Enum.Material.Wood,
			Parent = parent,
		})
		for tier = 1, 3 do
			local w = 13 - tier * 3
			Util.Part({
				Name = "PineFoliage",
				Size = Vector3.new(w, 6, w),
				CFrame = CFrame.new(base + Vector3.new(0, 11 + tier * 4.5, 0))
					* CFrame.Angles(0, math.rad(tier * 30), 0),
				Color = Color3.fromRGB(36 + tier * 6, 74 + tier * 8, 44 + tier * 4),
				Material = Enum.Material.Grass,
				CanCollide = false,
				Parent = parent,
			})
		end
	end

	-- The ski run comes off the summit and finishes in the water, so you can
	-- ride a tube off the mountain and straight into the river.
	local riverEntry = Vector3.new(-ringRadius, WATER_LEVEL, 0)
	local jumps = skiRun(summit, riverEntry, parent)

	-- The chairlift runs up the other side, with decks you can drive onto.
	local liftBottom = mountainCentre + Vector3.new(mountainRadius * 1.05, 0, -mountainRadius * 0.5)
	local liftStations = chairlift(liftBottom, summit + Vector3.new(0, -2, 0), parent)

	-- Tubes: at the summit, at the bottom of the ski run, and a couple round
	-- the loop so the river is usable without climbing anything.
	local tubePads: { Vector3 } = {
		summit + Vector3.new(14, 4, 0),
		riverEntry + Vector3.new(0, 8, 40),
		Vector3.new(0, 8, -ringRadius),
		Vector3.new(ringRadius, 8, 0),
		Vector3.new(0, 8, ringRadius),
	}

	-- Skis live at the top, next to the tubes.
	local skiPads: { Vector3 } = {
		summit + Vector3.new(-14, 4, 0),
		summit + Vector3.new(-14, 4, 16),
		liftStations[2] + Vector3.new(0, 0, 14),
	}

	local _ = jumps

	-- Two sub-games up here: the downhill, and the river. Both are offered
	-- from the menu so nobody has to find the mountain first.
	ArcadeService.Register({
		id = "downhill",
		name = "Downhill",
		objective = "Ski, board or bike to the bottom. Tricks off the jumps score.",
		centre = summit,
		spawns = {
			summit + Vector3.new(-14, 4, 0),
			summit + Vector3.new(14, 4, 0),
			summit + Vector3.new(0, 4, 16),
		},
		perTeam = 3,
		teamed = false,
	})

	ArcadeService.Register({
		id = "river",
		name = "Lazy River",
		objective = "Ride a tube round the loop. Watch the sniper towers.",
		centre = Vector3.new(0, 0, -ringRadius),
		spawns = {
			Vector3.new(0, 8, -ringRadius),
			Vector3.new(ringRadius * 0.4, 8, -ringRadius),
			Vector3.new(-ringRadius * 0.4, 8, -ringRadius),
		},
		perTeam = 2,
		teamed = false,
	})

	return {
		tubePads = tubePads,
		skiPads = skiPads,
		liftStations = liftStations,
		summit = summit,
		towerTops = towerTops,
	}
end

--[[
	Where the mountain lands, so MapService can keep buildings out of it.

	Returned rather than hardcoded in both places, because the two drifting
	apart is how you end up with a tower block inside a mountain.
]]
function ResortService.ReservedAreas(mapSize: number): { { centre: Vector3, radius: number } }
	local half = mapSize * 0.5
	local ringRadius = half - 118
	local mountainRadius = math.min(220, ringRadius * 0.62)

	return {
		{
			centre = Vector3.new(-ringRadius * 0.74, 0, ringRadius * 0.74),
			radius = mountainRadius + 40,
		},
		-- The ski run's landing, which crosses from the mountain to the water.
		{
			centre = Vector3.new(-ringRadius * 0.86, 0, ringRadius * 0.34),
			radius = 110,
		},
	}
end

return ResortService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">ScoreboardService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Nuclear Mud Arena — the scoreboard.

	In a game scored by points rather than kills there is no way to tell
	whether you are winning without one of these. It answers a request rather
	than broadcasting: the panel is on screen a few seconds at a time, and
	streaming every player's score to every player for a whole match is
	bandwidth spent on a window nobody is looking at.
]]

local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))

local PlayerState = require(script.Parent:WaitForChild("PlayerState"))
local TeamService = require(script.Parent:WaitForChild("TeamService"))

local ScoreboardService = {}

type Row = {
	name: string,
	team: string?,
	teamColor: Color3?,
	teamIndex: number,
	points: number,
	kills: number,
	deaths: number,
	isYou: boolean?,
}

--[[
	Everybody's standing, sorted for display.

	Teams first so the two sides read as two sides, then points within a team,
	because points are what decides the round.
]]
function ScoreboardService.Build(viewer: Player?): { Row }
	local rows: { Row } = {}

	for _, player in Players:GetPlayers() do
		local state = PlayerState.Get(player)
		local team = player.Team
		table.insert(rows, {
			name = player.DisplayName,
			team = if team then team.Name else nil,
			teamColor = if team then team.TeamColor.Color else nil,
			teamIndex = TeamService.IndexOf(player),
			points = state.points,
			kills = state.kills,
			deaths = state.deaths,
			isYou = player == viewer,
		})
	end

	table.sort(rows, function(a, b)
		if a.teamIndex ~= b.teamIndex then
			return a.teamIndex < b.teamIndex
		end
		if a.points ~= b.points then
			return a.points > b.points
		end
		-- A stable tie-break, so rows do not jump around between openings.
		return a.name < b.name
	end)

	return rows
end

--[[ A one-line summary for the panel's heading. ]]
function ScoreboardService.Heading(rows: { Row }): string
	local totals = {}
	for _, row in rows do
		local key = row.team or "Unteamed"
		totals[key] = (totals[key] or 0) + row.points
	end

	local parts = {}
	for name, points in totals do
		table.insert(parts, `{string.upper(name)} {points}`)
	end
	table.sort(parts)

	if #parts == 0 then
		return "SCOREBOARD"
	end
	return table.concat(parts, "   ·   ")
end

function ScoreboardService.Send(player: Player)
	local rows = ScoreboardService.Build(player)
	Remotes.Event("Scoreboard"):FireClient(player, {
		rows = rows,
		heading = ScoreboardService.Heading(rows),
	})
end

--[[
	When each player may next ask for a scoreboard.

	The first version of this had a comment claiming a player spamming the
	request "only slows themselves". That was wrong: the work happens on the
	SERVER, and it is a full walk of the player list, a sort and a table
	serialised per event. A loop firing the remote every frame is twenty
	players' worth of lag caused by one of them.

	Twice a second is far more often than a human opens a panel, and the
	client only asks when the key goes down anyway.
]]
local nextAllowedAt: { [Player]: number } = {}
local MIN_INTERVAL = 0.5

function ScoreboardService.Start()
	Remotes.Event("RequestScoreboard").OnServerEvent:Connect(function(player: Player)
		local now = os.clock()
		if now < (nextAllowedAt[player] or 0) then
			return
		end
		nextAllowedAt[player] = now + MIN_INTERVAL

		local ok, err = pcall(function()
			ScoreboardService.Send(player)
		end)
		if not ok then
			warn(`[Nuclear Mud Arena] Scoreboard failed for {player.Name}: {err}`)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		nextAllowedAt[player] = nil
	end)
end

--[[ Send it to everyone, unasked. Used at the end of a round. ]]
function ScoreboardService.PushAll()
	for _, player in Players:GetPlayers() do
		pcall(function()
			ScoreboardService.Send(player)
		end)
	end
end

return ScoreboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">TeamService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	TeamService — Red Mud versus Blue Mud.

	New players join whichever side is smaller, so the game stays roughly even
	without anybody having to think about it.
]]

local Teams = game:GetService("Teams")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local TeamService = {}

local teams: { Team } = {}
local nextTieIndex = 1

function TeamService.Start()
	table.clear(teams)
	for _, spec in Config.Teams do
		local existing = Teams:FindFirstChild(spec.Name)
		local team: Team
		if existing and existing:IsA("Team") then
			team = existing
		else
			team = Instance.new("Team")
			team.Name = spec.Name
			team.Parent = Teams
		end
		team.TeamColor = spec.Color
		team.AutoAssignable = false
		table.insert(teams, team)
	end
end

--[[ Put a player on the emptier side, alternating on ties. ]]
function TeamService.Assign(player: Player)
	if #teams == 0 then
		return
	end

	local counts = {}
	local minCount = math.huge
	for index, team in teams do
		local count = #team:GetPlayers()
		counts[index] = count
		if count < minCount then
			minCount = count
		end
	end

	local tied: { number } = {}
	for index, count in counts do
		if count == minCount then
			table.insert(tied, index)
		end
	end

	local chosen = tied[((nextTieIndex - 1) % #tied) + 1]
	nextTieIndex += 1

	player.Team = teams[chosen]
	player.Neutral = false
end

--[[ Which of the two teams a player is on, as a 1 or a 2. ]]
function TeamService.IndexOf(player: Player): number
	for index, team in teams do
		if player.Team == team then
			return index
		end
	end
	return 1
end

function TeamService.Get(index: number): Team?
	return teams[index]
end

function TeamService.All(): { Team }
	return teams
end

return TeamService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">VehicleService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	VehicleService — builds and drives everything with an engine in it.

	Every vehicle is assembled from plain parts and constraints at runtime, so
	there are no models to import and nothing to break when you edit a number.

	HOW THE CARS STEER
	------------------
	Roblox's VehicleSeat hands us two numbers for free when a player holds WASD:
	  Throttle  -1 (S) to 1 (W)
	  Steer     -1 (A) to 1 (D)

	We turn those into motor speeds. Each front wheel hangs off a "knuckle" —
	a small part on a servo hinge that swings left and right — and each wheel
	spins on its own motor hinge. Back wheels have no knuckle; they just drive.
	This is the standard Roblox car layout, which matters because if you ever
	need help with it, every tutorial online will match what is here.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

-- Shared between every vehicle, every frame: see driveWheeled.
--
-- The probe is paced by DISTANCE, not by time. A fixed 20 Hz looks like a
-- safe saving until you work out how far a car travels between samples: at
-- two hundred studs a second that is ten studs, and a boost chevron is nine
-- studs long, so the pads on the run-up to a ramp get stepped straight over
-- and the jump beyond never works.
--
-- The threshold is not the gap: a sample fires once the car has moved this
-- far, so the real gap is this plus one frame of travel, which at top speed
-- under turbo is another two studs. Four studs keeps the actual spacing
-- around six, with genuine margin against a nine-stud pad rather than the
-- eight-point-something that six studs produced.
local GROUND_SAMPLE_STUDS = 4
-- And a floor on the rate, so a crawling vehicle still notices mud.
local GROUND_SAMPLE_INTERVAL = 1 / 20
local GROUND_PROBE = Vector3.new(0, -14, 0)

-- How far a wheel may travel up or down on its spring.
local SUSPENSION_TRAVEL = 2.2
-- Its own params object, reused, for the same reason the ground probe has
-- one: four wheels per car per frame is a lot of garbage otherwise.
local suspensionParams = RaycastParams.new()
suspensionParams.FilterType = Enum.RaycastFilterType.Exclude
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
local Remotes = require(Shared:WaitForChild("Remotes"))
local Sound = require(Shared:WaitForChild("Sound"))
local Util = require(Shared:WaitForChild("Util"))

local PlayerState = require(script.Parent:WaitForChild("PlayerState"))

local Signal = require(Shared:WaitForChild("Signal"))

local VehicleService = {}

--[[
	A vehicle just went up: (position, radius, damage, lastDriver).

	DamageService listens and applies the blast. It cannot be called from
	here, because it requires this module.
]]
VehicleService.Wrecked = Signal.new()

--[[
	A trick was landed: (player, name, points, airtime).

	Announced so the HUD and the match feed can shout about it without this
	module needing to know either of them exists.
]]
VehicleService.TrickLanded = Signal.new()

local WHEEL_DIAMETER = 7
local WHEEL_WIDTH = 4
local CHASSIS_HEIGHT = 4

-- Wheels want grip; the chassis wants weight so it does not tip over.
local WHEEL_PHYSICS = PhysicalProperties.new(1.2, 2.0, 0.1, 100, 1)
-- Low friction: the chassis is what touches the ground now that the wheels
-- are decoration, and a high-grip box would drag against the drive
-- constraint instead of sliding along under it.
local CHASSIS_PHYSICS = PhysicalProperties.new(4.5, 0.08, 0.1, 1, 1)

--[[ Every vehicle currently alive in the world, so we can drive them each frame. ]]
local active: { [Model]: any } = {}

-- Its own random stream, so picking a car body cannot shift map generation.
local bodyPicker = Random.new()

-- ============================================================ PART HELPERS ==

local function noCollide(a: BasePart, b: BasePart)
	local constraint = Instance.new("NoCollisionConstraint")
	constraint.Part0 = a
	constraint.Part1 = b
	constraint.Parent = a
end

--[[
	A hinge between two parts.

	`axisTurn` decides which way the hinge axis points. An Attachment's axis is
	its own X direction, so:
	  nil  -> X stays X, the hinge spins like a wheel (sideways axle)
	  "up" -> X is rotated onto Y, the hinge swings like a door (vertical axle)
]]
local function hinge(
	partA: BasePart,
	partB: BasePart,
	worldPosition: Vector3,
	axisTurn: string?,
	actuator: Enum.ActuatorType
): HingeConstraint
	local localTwist = if axisTurn == "up" then CFrame.Angles(0, 0, math.rad(90)) else CFrame.identity

	local attachA = Instance.new("Attachment")
	attachA.CFrame = partA.CFrame:ToObjectSpace(CFrame.new(worldPosition) * partA.CFrame.Rotation) * localTwist
	attachA.Parent = partA

	local attachB = Instance.new("Attachment")
	attachB.CFrame = partB.CFrame:ToObjectSpace(CFrame.new(worldPosition) * partB.CFrame.Rotation) * localTwist
	attachB.Parent = partB

	local constraint = Instance.new("HingeConstraint")
	constraint.Attachment0 = attachA
	constraint.Attachment1 = attachB
	constraint.ActuatorType = actuator
	constraint.Parent = partA

	noCollide(partA, partB)
	return constraint
end

--[[
	One wheel.

	Wheels are anchored, non-colliding decoration that we rotate by hand. That
	sounds backwards, but welded colliding wheels cannot roll — they scrape,
	and their friction fights the drive constraint that is trying to move the
	car. Anchoring them takes them out of the physics entirely and lets us
	spin them at exactly road speed, so they look right and cost nothing.

	The chassis is what actually rests on the ground.
]]
--[[
	A driven wheel, on a real suspension.

	This is the rig that matters, and it replaces two earlier attempts.

	  1. Anchored wheels whose CFrame was rewritten from the chassis each
	     frame. They visibly trailed the car, which is what "the wheels were
	     falling off" was.
	  2. Unanchored wheels on a plain hinge, spun to match a velocity
	     constraint that shoved the chassis along. Attached, but the car was
	     still being pushed rather than driven: it slid round corners, it
	     could not climb without a fudge, and jumps needed the drive
	     switching off mid-air to stop it flying flat.

	Now the wheels drive the car. Each corner gets:

	  - a KNUCKLE, an invisible part the wheel hangs off
	  - a CylindricalConstraint from chassis to knuckle, which gives vertical
	    suspension travel and, on the front, doubles as the steering servo
	  - a SpringConstraint across the same two attachments, which is what
	    actually holds the car up and soaks up bumps
	  - a HingeConstraint motor from knuckle to wheel, which is the engine

	Everything else follows from that. Traction is tire friction, so it
	climbs because it grips, it drifts if you ask it to, and in mid-air the
	wheels spin freely and the car arcs because nothing is pushing it. All
	the special cases go away.

	Rigged from code pasted in by the project owner, adapted to this
	module's own part names and tuning.
]]
local function addWheel(model: Model, chassis: BasePart, offset: Vector3, isFront: boolean)
	local driving = Config.Driving
	local radius = WHEEL_DIAMETER * 0.5

	local wheel = Util.Part({
		Name = "Wheel",
		Size = Vector3.new(WHEEL_WIDTH, WHEEL_DIAMETER, WHEEL_DIAMETER),
		-- A cylinder's flat faces point along its own X, which is already
		-- the car's left-right axis, so it is already oriented to roll.
		CFrame = chassis.CFrame * CFrame.new(offset),
		Shape = Enum.PartType.Cylinder,
		Color = Color3.fromRGB(26, 26, 30),
		Material = Enum.Material.Rubber,
		Anchored = false,
		-- Grippy, and weighted so tire friction wins over whatever the road
		-- material says. This is where traction comes from now.
		CustomPhysicalProperties = PhysicalProperties.new(
			1,
			driving.WheelFriction,
			0.1,
			driving.WheelFrictionWeight,
			1
		),
		Parent = model,
	})

	local hub = Util.Part({
		Name = "Hub",
		Size = Vector3.new(WHEEL_WIDTH + 0.5, WHEEL_DIAMETER * 0.5, WHEEL_DIAMETER * 0.5),
		CFrame = wheel.CFrame,
		Shape = Enum.PartType.Cylinder,
		Color = Color3.fromRGB(198, 198, 208),
		Material = Enum.Material.Metal,
		Anchored = false,
		CanCollide = false,
		CanQuery = false,
		Massless = true,
		Parent = model,
	})
	Util.Weld(wheel, hub)

	-- The knuckle: what the suspension pushes on and the wheel spins in.
	local knuckle = Util.Part({
		Name = "Knuckle",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(wheel.Position) * chassis.CFrame.Rotation,
		Transparency = 1,
		Anchored = false,
		CanCollide = false,
		CanQuery = false,
		CustomPhysicalProperties = PhysicalProperties.new(0.5, 0.3, 0.2, 1, 1),
		Parent = model,
	})

	-- Suspension attachments. The primary axis points DOWN, because that is
	-- the direction a CylindricalConstraint slides along.
	local chassisMount = Instance.new("Attachment")
	chassisMount.Name = "SuspensionTop"
	chassisMount.Position = offset + Vector3.new(0, driving.SuspensionHeight, 0)
	chassisMount.Axis = Vector3.new(0, -1, 0)
	chassisMount.SecondaryAxis = Vector3.new(0, 0, -1)
	chassisMount.Parent = chassis

	local knuckleMount = Instance.new("Attachment")
	knuckleMount.Name = "SuspensionBottom"
	knuckleMount.Axis = Vector3.new(0, -1, 0)
	knuckleMount.SecondaryAxis = Vector3.new(0, 0, -1)
	knuckleMount.Parent = knuckle

	local slider = Instance.new("CylindricalConstraint")
	slider.Name = if isFront then "SteerSlider" else "Slider"
	slider.Attachment0 = chassisMount
	slider.Attachment1 = knuckleMount
	slider.LimitsEnabled = true
	slider.LowerLimit = driving.SuspensionHeight - driving.SuspensionTravel
	slider.UpperLimit = driving.SuspensionHeight + driving.SuspensionTravel * 0.5

	if isFront then
		-- The front slider is also the steering servo.
		slider.AngularActuatorType = Enum.ActuatorType.Servo
		slider.ServoMaxTorque = driving.SteerTorque
		slider.AngularSpeed = driving.SteerSpeed
	else
		-- The rears must not steer themselves.
		slider.AngularLimitsEnabled = true
		slider.LowerAngle = 0
		slider.UpperAngle = 0
	end
	slider.Parent = chassis

	local spring = Instance.new("SpringConstraint")
	spring.Name = "Spring"
	spring.Attachment0 = chassisMount
	spring.Attachment1 = knuckleMount
	spring.Stiffness = driving.SpringStiffness
	spring.Damping = driving.SpringDamping
	-- Slightly longer than the rest height, so the car sits on a preload
	-- rather than hanging from the limit.
	spring.FreeLength = driving.SuspensionHeight + 0.4
	spring.Parent = chassis

	-- And the motor, which is the engine.
	local knuckleAxle = Instance.new("Attachment")
	knuckleAxle.Name = "AxleKnuckle"
	knuckleAxle.Axis = Vector3.new(1, 0, 0)
	knuckleAxle.Parent = knuckle

	local wheelAxle = Instance.new("Attachment")
	wheelAxle.Name = "AxleWheel"
	wheelAxle.Axis = Vector3.new(1, 0, 0)
	wheelAxle.Parent = wheel

	local axle = Instance.new("HingeConstraint")
	axle.Name = "Axle"
	axle.Attachment0 = knuckleAxle
	axle.Attachment1 = wheelAxle
	-- All four driven: this map is mud, snow and a mountain trail, and
	-- rear-wheel drive on any of those is a recipe for going nowhere.
	axle.ActuatorType = Enum.ActuatorType.Motor
	axle.MotorMaxTorque = driving.MotorTorque
	axle.AngularVelocity = 0
	axle.Parent = knuckle

	return {
		part = wheel,
		hub = hub,
		knuckle = knuckle,
		axle = axle,
		slider = slider,
		spring = spring,
		front = isFront,
		radius = radius,
		home = offset,
	}
end

local function buildChassis(
	name: string,
	position: Vector3,
	bodySize: Vector3,
	color: Color3,
	wheelbase: number,
	track: number
): (Model, BasePart, { any })
	local model = Instance.new("Model")
	model.Name = name

	local chassis = Util.Part({
		Name = "Chassis",
		Size = bodySize,
		CFrame = CFrame.new(position + Vector3.new(0, WHEEL_DIAMETER * 0.5 + CHASSIS_HEIGHT, 0)),
		Color = color,
		Material = Enum.Material.Metal,
		Anchored = false,
		CustomPhysicalProperties = CHASSIS_PHYSICS,
		Parent = model,
	})
	model.PrimaryPart = chassis

	-- The two constraints that actually move the car.
	--
	-- This matters more than it looks: the moment a player sits in a
	-- VehicleSeat, Roblox hands network ownership of the whole vehicle to
	-- that player's computer, and physics is simulated there. Anything the
	-- server writes straight onto the part's velocity gets overwritten by the
	-- owning client on the very next frame — the car twitches and goes
	-- nowhere. Constraint *properties*, on the other hand, replicate, and the
	-- owning client simulates them. So we steer the constraints, not the part.
	local driveRoot = Util.Attachment(chassis, Vector3.zero, "DriveRoot")

	local drive = Instance.new("LinearVelocity")
	drive.Name = "DriveVelocity"
	drive.Attachment0 = driveRoot
	-- Line mode constrains one axis only, leaving gravity to do its job, so
	-- ramps and jumps still behave.
	drive.VelocityConstraintMode = Enum.VelocityConstraintMode.Line
	-- WORLD space, with the direction recomputed every frame from the
	-- chassis, rather than a fixed direction in the attachment's frame.
	--
	-- Attachment-relative was reported driving the truck straight up: forward
	-- launched it into the sky, reverse slammed it into the ground. Whatever
	-- the attachment's orientation was actually doing, this removes the
	-- question — the direction is computed, flattened, and inspectable, so
	-- the drive axis is horizontal by construction and a car cannot be
	-- driven vertically at all.
	drive.RelativeTo = Enum.ActuatorRelativeTo.World
	drive.LineDirection = Vector3.new(0, 0, -1)
	drive.LineVelocity = 0
	-- THE ONE THAT ACTUALLY MATTERS.
	--
	-- LinearVelocity has two separate force limits: MaxForce, used when
	-- ForceLimitMode is Magnitude, and MaxAxesForce, used when it is PerAxis.
	-- Set the wrong one of the pair and the constraint is left with no force
	-- to push with, so the vehicle sits there doing nothing — no error, no
	-- warning, just a car that will not move.
	--
	-- Turning the limits off entirely sidesteps the whole trap: the
	-- constraint gets whatever force it needs to hit the requested speed.
	drive.ForceLimitsEnabled = false
	drive.ForceLimitMode = Enum.ForceLimitMode.Magnitude
	drive.MaxForce = math.huge
	drive.MaxAxesForce = Vector3.new(math.huge, math.huge, math.huge)
	drive.Enabled = false
	drive.Parent = chassis

	local turn = Instance.new("AngularVelocity")
	turn.Name = "TurnVelocity"
	turn.Attachment0 = driveRoot
	turn.RelativeTo = Enum.ActuatorRelativeTo.World
	turn.AngularVelocity = Vector3.zero
	turn.MaxTorque = 900000
	turn.Enabled = false
	turn.Parent = chassis

	local halfBase = wheelbase * 0.5
	local halfTrack = track * 0.5
	local axleDrop = -bodySize.Y * 0.5

	-- An engine note, pitched by road speed. A silent vehicle feels like a
	-- prop being slid along the floor.
	local engine = Sound.Attach("EngineLoop", chassis)
	if engine then
		engine.Name = "Engine"
	end

	local wheels = {}
	for _, corner in {
		Vector3.new(-halfTrack, axleDrop, -halfBase),
		Vector3.new(halfTrack, axleDrop, -halfBase),
		Vector3.new(-halfTrack, axleDrop, halfBase),
		Vector3.new(halfTrack, axleDrop, halfBase),
	} do
		-- Negative Z is the nose, so those two steer.
		table.insert(wheels, addWheel(model, chassis, corner, corner.Z < 0))
	end

	return model, chassis, wheels
end

--[[
	Put a "press E" prompt on a seat.

	Without this you cannot get into anything. The seat sits on top of the
	chassis at about 8.5 studs, and a Roblox character jumps roughly 7.2 —
	so there is no way to climb aboard by walking into it. Walk up, press E.
]]
--[[
	Bodywork: the bits that make a box look like a car.

	The chassis is one rectangular block, which is fine as a collision hull
	and reads as a brick. Everything here is welded, massless and
	non-colliding, so it changes how the thing looks and nothing about how it
	drives: a cabin set back from the nose, a bonnet, a windscreen raked over
	it, side windows, bumpers front and back, arches over each wheel, and
	lights at both ends.

	Massless matters. Bolting a dozen parts with mass onto a tuned chassis
	changes its centre of gravity and its handling, and then the car that
	drove well before the bodywork went on drives differently after.
]]
local function addBodywork(model: Model, chassis: BasePart, color: Color3, lowSlung: boolean)
	local size = chassis.Size
	local halfLength = size.Z * 0.5
	local halfWidth = size.X * 0.5
	local roofHeight = if lowSlung then size.Y * 0.55 else size.Y * 0.85

	local function panel(props: { [string]: any }): BasePart
		props.Anchored = false
		props.Massless = true
		props.CanCollide = false
		props.CanQuery = false
		props.Parent = model
		local part = Util.Part(props)
		Util.Weld(chassis, part)
		return part
	end

	local darker = color:Lerp(Color3.new(0, 0, 0), 0.45)
	local glass = Color3.fromRGB(150, 190, 215)

	-- The cabin, set back from the nose so there is a bonnet in front of it.
	panel({
		Name = "Cabin",
		Size = Vector3.new(size.X * 0.86, roofHeight, size.Z * 0.46),
		CFrame = chassis.CFrame * CFrame.new(0, size.Y * 0.5 + roofHeight * 0.5, halfLength * 0.18),
		Color = color,
		Material = Enum.Material.Metal,
	})

	-- The windscreen, raked back over the bonnet.
	panel({
		Name = "Windscreen",
		Size = Vector3.new(size.X * 0.8, roofHeight * 0.92, 0.4),
		CFrame = chassis.CFrame
			* CFrame.new(0, size.Y * 0.5 + roofHeight * 0.5, halfLength * 0.18 - size.Z * 0.24)
			* CFrame.Angles(math.rad(-22), 0, 0),
		Color = glass,
		Material = Enum.Material.Glass,
		Transparency = 0.35,
		Reflectance = 0.22,
	})

	-- Side glass, and a rear window.
	for _, side in { -1, 1 } do
		panel({
			Name = "SideWindow",
			Size = Vector3.new(0.3, roofHeight * 0.6, size.Z * 0.4),
			CFrame = chassis.CFrame
				* CFrame.new(side * halfWidth * 0.87, size.Y * 0.5 + roofHeight * 0.58, halfLength * 0.18),
			Color = glass,
			Material = Enum.Material.Glass,
			Transparency = 0.42,
			Reflectance = 0.18,
		})
	end
	panel({
		Name = "RearWindow",
		Size = Vector3.new(size.X * 0.78, roofHeight * 0.8, 0.4),
		CFrame = chassis.CFrame
			* CFrame.new(0, size.Y * 0.5 + roofHeight * 0.5, halfLength * 0.18 + size.Z * 0.23)
			* CFrame.Angles(math.rad(16), 0, 0),
		Color = glass,
		Material = Enum.Material.Glass,
		Transparency = 0.38,
	})

	-- Bonnet and boot, slightly proud of the chassis so there are edges.
	panel({
		Name = "Bonnet",
		Size = Vector3.new(size.X * 0.94, 0.6, size.Z * 0.3),
		CFrame = chassis.CFrame * CFrame.new(0, size.Y * 0.5 + 0.2, -halfLength * 0.6),
		Color = color,
		Material = Enum.Material.Metal,
	})

	-- Bumpers.
	for _, endZ in { -1, 1 } do
		panel({
			Name = "Bumper",
			Size = Vector3.new(size.X * 1.02, size.Y * 0.3, 1.6),
			CFrame = chassis.CFrame * CFrame.new(0, -size.Y * 0.28, endZ * (halfLength + 0.6)),
			Color = darker,
			Material = Enum.Material.Metal,
		})
	end

	-- Arches over each wheel, which is most of what stops the sides reading
	-- as a flat slab.
	for _, side in { -1, 1 } do
		for _, endZ in { -1, 1 } do
			panel({
				Name = "Arch",
				Size = Vector3.new(1.1, size.Y * 0.5, WHEEL_DIAMETER * 1.25),
				CFrame = chassis.CFrame
					* CFrame.new(side * (halfWidth + 0.4), -size.Y * 0.1, endZ * halfLength * 0.56),
				Color = darker,
				Material = Enum.Material.Metal,
			})
		end
	end

	-- Headlights and tail lights, with a real beam off the front.
	for _, side in { -1, 1 } do
		local lamp = panel({
			Name = "Headlight",
			Size = Vector3.new(size.X * 0.22, 1.3, 0.5),
			CFrame = chassis.CFrame
				* CFrame.new(side * halfWidth * 0.6, size.Y * 0.1, -(halfLength + 0.3)),
			Color = Color3.fromRGB(255, 248, 220),
			Material = Enum.Material.Neon,
		})
		local beam = Instance.new("SpotLight")
		beam.Color = Color3.fromRGB(255, 246, 214)
		beam.Brightness = 2.2
		beam.Range = 70
		beam.Angle = 62
		beam.Face = Enum.NormalId.Front
		beam.Shadows = false
		beam.Parent = lamp

		panel({
			Name = "TailLight",
			Size = Vector3.new(size.X * 0.2, 1.1, 0.5),
			CFrame = chassis.CFrame
				* CFrame.new(side * halfWidth * 0.62, size.Y * 0.1, halfLength + 0.3),
			Color = Color3.fromRGB(210, 40, 36),
			Material = Enum.Material.Neon,
		})
	end
end

local function addSitPrompt(seat: Seat | VehicleSeat, actionText: string, vehicleName: string)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "SitPrompt"
	prompt.ActionText = actionText
	prompt.ObjectText = vehicleName
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 16
	-- The car body is between you and the seat, so line of sight would stop
	-- the prompt appearing exactly where you need it.
	prompt.RequiresLineOfSight = false
	prompt.Parent = seat

	prompt.Triggered:Connect(function(player)
		local character = player.Character
		if not character then
			return
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			return
		end
		-- Already sitting somewhere? Get out rather than teleporting across.
		if humanoid.SeatPart then
			return
		end
		-- Seat and VehicleSeat both have Sit, but Roblox makes them siblings
		-- rather than parent and child, so the call has to be narrowed first.
		if seat:IsA("VehicleSeat") then
			seat:Sit(humanoid)
		else
			seat:Sit(humanoid)
		end
	end)

	return prompt
end

--[[ The driver's seat. Sitting in it is what gives us Throttle and Steer. ]]
local function addDriverSeat(chassis: BasePart, model: Model, offset: Vector3): VehicleSeat
	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(4, 1, 4)
	seat.CFrame = chassis.CFrame * CFrame.new(offset)
	seat.Color = Color3.fromRGB(40, 40, 44)
	seat.Anchored = false
	seat.Massless = true
	-- We drive the motors ourselves, so the built-in handling is turned off.
	seat.MaxSpeed = 0
	seat.Torque = 0
	seat.TurnSpeed = 0
	seat.Parent = model
	Util.Weld(chassis, seat)
	addSitPrompt(seat, "Drive", model.Name)
	return seat
end

--[[
	A floating name over a vehicle, readable from right across the map.

	The big vehicles sit on pads a couple of hundred studs apart, which is a
	very long walk if you cannot see where they are.
]]
local function addVehicleLabel(chassis: BasePart, text: string, colour: Color3)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "VehicleLabel"
	billboard.Size = UDim2.fromScale(14, 3)
	billboard.StudsOffset = Vector3.new(0, 9, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 1200
	billboard.Parent = chassis

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = colour
	label.TextStrokeTransparency = 0.25
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = billboard
end

--[[ A passenger seat that does not drive — used by gunners. ]]
local function addPassengerSeat(attachTo: BasePart, model: Model, offset: Vector3, name: string): Seat
	local seat = Instance.new("Seat")
	seat.Name = name
	seat.Size = Vector3.new(4, 1, 4)
	seat.CFrame = attachTo.CFrame * CFrame.new(offset)
	seat.Color = Color3.fromRGB(60, 50, 40)
	seat.Anchored = false
	seat.Massless = true
	seat.Parent = model
	Util.Weld(attachTo, seat)
	addSitPrompt(seat, if name == "GunnerSeat" then "Man the gun" else "Sit", model.Name)
	return seat
end

--[[
	A turret: a rotating drum with a barrel, plus a seat for whoever is
	spinning it. Yaw and pitch are servo hinges the server points wherever the
	gunner is looking.
]]
local function addTurret(chassis: BasePart, model: Model, offset: Vector3, barrelLength: number, color: Color3)
	local drumPosition = chassis.CFrame * CFrame.new(offset)

	local drum = Util.Part({
		Name = "TurretDrum",
		Size = Vector3.new(7, 3, 7),
		CFrame = drumPosition,
		Color = color:Lerp(Color3.new(0, 0, 0), 0.2),
		Material = Enum.Material.Metal,
		Anchored = false,
		Parent = model,
	})

	local yaw = hinge(chassis, drum, drumPosition.Position, "up", Enum.ActuatorType.Servo)
	yaw.Name = "TurretYaw"
	yaw.ServoMaxTorque = 250000
	yaw.AngularSpeed = 3
	-- No limits: the turret spins all the way round.
	yaw.LimitsEnabled = false

	-- Raised well clear of the gunner and pushed forward off the drum. The
	-- previous barrel sat at head height and long enough to clip the rider,
	-- which stopped them turning.
	local barrel = Util.Part({
		Name = "Barrel",
		Size = Vector3.new(1.6, 1.6, barrelLength),
		CFrame = drum.CFrame * CFrame.new(0, 3.6, -barrelLength * 0.5 - 3),
		Color = Color3.fromRGB(40, 40, 44),
		Material = Enum.Material.Metal,
		Anchored = false,
		Massless = true,
		Parent = model,
	})
	Util.Weld(drum, barrel)

	-- Where bullets actually come out.
	Util.Attachment(barrel, Vector3.new(0, 0, -barrelLength * 0.5), "Muzzle")

	local gunnerSeat = addPassengerSeat(drum, model, Vector3.new(0, 1.5, 3.5), "GunnerSeat")

	return drum, barrel, gunnerSeat, yaw
end

--[[
	Watch a seat so the rest of the game knows who is sitting where.

	This is what lets the gunner of a turret truck fire the 50 cal while
	somebody else drives: the seat you are in decides which gun is yours.
]]
local function bindSeat(seat: Seat | VehicleSeat, model: Model, role: string)
	local lastOccupant: Player? = nil
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local occupant = seat.Occupant

		if occupant then
			local character = occupant.Parent
			local player = if character then Players:GetPlayerFromCharacter(character) else nil
			if player then
				lastOccupant = player
				local state = PlayerState.Get(player)
				state.vehicle = model
				state.seatRole = role
				PlayerState.Changed.Fire(player)

				local vehicleState = active[model]
				if vehicleState and role == "Driver" then
					vehicleState.lastDriver = player
				end
			end
			return
		end

		if role == "Driver" and model.Parent then
			model:SetAttribute("Turbo", false)
		end

		local departed = lastOccupant
		lastOccupant = nil
		if departed and departed.Parent then
			local state = PlayerState.Get(departed)
			if state.vehicle == model and state.seatRole == role then
				state.vehicle = nil
				state.seatRole = nil
				PlayerState.Changed.Fire(departed)
			end
		end
	end)
end

-- ================================================================ BUILDERS ==

--[[
	A car. Tier decides how fast it is; the body style is a coin flip between
	a truck and a Lamborghini, so what pulls up beside you varies.
]]
function VehicleService.SpawnCar(
	tierIndex: number,
	position: Vector3,
	owner: Player?,
	bodyName: string?
): Model
	local tier = Config.CarTiers[math.clamp(tierIndex, 1, #Config.CarTiers)]

	--[[
		Which body turns up.

		Normally a coin flip, so what pulls up beside you varies. Named
		explicitly for the mountain, where the whole point is that the thing
		waiting at the trailhead can actually climb it -- a Lamborghini at
		the bottom of a mountain trail is a joke, not a vehicle.
	]]
	local body = Config.CarBodies[bodyPicker:NextInteger(1, #Config.CarBodies)]
	if bodyName then
		for _, candidate in Config.CarBodies do
			if candidate.Name == bodyName then
				body = candidate
				break
			end
		end
	end

	local model, chassis, wheels = buildChassis(
		`{body.Name}_{tier.Name}`,
		position,
		body.Size,
		-- The tier colour tints the body so you can still read how fast
		-- somebody's car is at a glance.
		body.Color:Lerp(tier.Color, 0.45),
		14,
		10
	)
	-- Make it look like a car rather than a painted box.
	addBodywork(model, chassis, body.Color:Lerp(tier.Color, 0.45), body.Name == "Lamborghini")

	local seat = addDriverSeat(chassis, model, Vector3.new(0, body.Size.Y * 0.5 + 0.5, 1))
	bindSeat(seat, model, "Driver")
	addVehicleLabel(chassis, `{body.Name} · {tier.Name}`, Color3.fromRGB(230, 240, 250))

	model:SetAttribute("Health", 260)
	model:SetAttribute("MaxHealth", 260)
	model:SetAttribute("VehicleKind", "Car")
	if owner then
		model:SetAttribute("OwnerUserId", owner.UserId)
	end

	model.Parent = workspace
	active[model] = {
		wheels = wheels,
		kind = "Car",
		chassis = chassis,
		seat = seat,
		maxSpeed = tier.MaxSpeed * body.SpeedBias,
		torque = tier.Torque,
		turnSpeed = tier.TurnSpeed,
		offRoad = body.OffRoad == true,
	}
	return model
end

--[[ The turret truck: one player drives, another works the 50 cal on the back. ]]
function VehicleService.SpawnTurretTruck(position: Vector3): Model
	local spec = Config.Vehicles.TurretTruck

	local model, chassis, wheels = buildChassis(
		"TurretTruck",
		position,
		Vector3.new(12, CHASSIS_HEIGHT, 24),
		spec.Color,
		18,
		12
	)
	local seat = addDriverSeat(chassis, model, Vector3.new(0, CHASSIS_HEIGHT * 0.5 + 0.5, -6))
	local drum, barrel, gunnerSeat, yaw =
		addTurret(chassis, model, Vector3.new(0, CHASSIS_HEIGHT * 0.5 + 2, 6), 8, spec.Color)

	bindSeat(seat, model, "Driver")
	bindSeat(gunnerSeat, model, "Gunner")

	addVehicleLabel(chassis, "Turret Truck · 2 seats", Color3.fromRGB(180, 230, 140))

	model:SetAttribute("Health", spec.Health)
	model:SetAttribute("MaxHealth", spec.Health)
	model:SetAttribute("VehicleKind", "TurretTruck")
	model:SetAttribute("MountedWeapon", spec.MountedWeapon)

	model.Parent = workspace
	active[model] = {
		wheels = wheels,
		kind = "TurretTruck",
		chassis = chassis,
		seat = seat,
		gunnerSeat = gunnerSeat,
		turretDrum = drum,
		barrel = barrel,
		turretYaw = yaw,
		maxSpeed = spec.MaxSpeed,
		torque = spec.Torque,
		turnSpeed = spec.TurnSpeed,
	}
	return model
end

--[[ The tank. Slow, enormously heavy, shrugs off rifle fire. ]]
function VehicleService.SpawnTank(position: Vector3): Model
	local spec = Config.Vehicles.Tank

	local model, chassis, wheels = buildChassis(
		"Tank",
		position,
		Vector3.new(16, 5, 26),
		spec.Color,
		18,
		15
	)
	local seat = addDriverSeat(chassis, model, Vector3.new(0, 3, -8))
	local drum, barrel, gunnerSeat, yaw =
		addTurret(chassis, model, Vector3.new(0, 3.5, 2), 14, spec.Color)

	-- Track skirts, purely so it reads as a tank rather than a big car.
	for _, side in { -1, 1 } do
		local skirt = Util.Part({
			Name = "TrackSkirt",
			Size = Vector3.new(2, 5, 26),
			CFrame = chassis.CFrame * CFrame.new(side * 8.5, -1.5, 0),
			Color = Color3.fromRGB(40, 42, 38),
			Material = Enum.Material.Metal,
			Anchored = false,
			Massless = true,
			CanCollide = false,
			Parent = model,
		})
		Util.Weld(chassis, skirt)
	end

	bindSeat(seat, model, "Driver")
	bindSeat(gunnerSeat, model, "Gunner")

	addVehicleLabel(chassis, "Tank", Color3.fromRGB(150, 220, 150))

	model:SetAttribute("Health", spec.Health)
	model:SetAttribute("MaxHealth", spec.Health)
	model:SetAttribute("VehicleKind", "Tank")
	model:SetAttribute("MountedWeapon", spec.MountedWeapon)
	model:SetAttribute("DamageResistance", spec.DamageResistance)

	model.Parent = workspace
	active[model] = {
		wheels = wheels,
		kind = "Tank",
		chassis = chassis,
		seat = seat,
		gunnerSeat = gunnerSeat,
		turretDrum = drum,
		barrel = barrel,
		turretYaw = yaw,
		maxSpeed = spec.MaxSpeed,
		torque = spec.Torque,
		turnSpeed = spec.TurnSpeed,
	}
	return model
end

--[[
	The plane. This one does not use wheels at all — a physics-accurate
	aeroplane is miserable to fly with a keyboard, so it flies on rails:
	constant forward speed, and the stick points the nose.
]]
function VehicleService.SpawnPlane(position: Vector3): Model
	local spec = Config.Vehicles.Plane

	local model = Instance.new("Model")
	model.Name = "Plane"

	local body = Util.Part({
		Name = "Chassis",
		Size = Vector3.new(6, 4, 26),
		CFrame = CFrame.new(position + Vector3.new(0, 12, 0)),
		Color = spec.Color,
		Material = Enum.Material.Metal,
		Anchored = false,
		CustomPhysicalProperties = PhysicalProperties.new(0.6, 0.3, 0.2, 1, 1),
		Parent = model,
	})
	model.PrimaryPart = body

	local wing = Util.Part({
		Name = "Wing",
		Size = Vector3.new(40, 1, 7),
		CFrame = body.CFrame * CFrame.new(0, 1, 1),
		Color = spec.Color,
		Material = Enum.Material.Metal,
		Anchored = false,
		Massless = true,
		Parent = model,
	})
	Util.Weld(body, wing)

	local tail = Util.Part({
		Name = "Tail",
		Size = Vector3.new(1, 7, 6),
		CFrame = body.CFrame * CFrame.new(0, 3, 11),
		Color = spec.Color,
		Material = Enum.Material.Metal,
		Anchored = false,
		Massless = true,
		Parent = model,
	})
	Util.Weld(body, tail)

	local seat = addDriverSeat(body, model, Vector3.new(0, 2.5, -4))
	Util.Attachment(body, Vector3.new(0, 0, -13), "Muzzle")

	-- The two forces that make it fly. Velocity pushes it along its own nose;
	-- orientation holds whatever attitude the pilot last asked for.
	local root = Util.Attachment(body, Vector3.zero, "FlightRoot")

	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = root
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	-- Limits off, for the same reason as the cars.
	velocity.ForceLimitsEnabled = false
	velocity.MaxForce = math.huge
	velocity.MaxAxesForce = Vector3.new(math.huge, math.huge, math.huge)
	velocity.VectorVelocity = Vector3.zero
	velocity.Enabled = false
	velocity.Parent = body

	local orientation = Instance.new("AlignOrientation")
	orientation.Attachment0 = root
	orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	-- Rigid alignment ignores the torque and angular-velocity limits entirely,
	-- which is what we want: MaxAngularVelocity was never being set, and a
	-- zero there means the aircraft cannot turn no matter the torque.
	orientation.RigidityEnabled = true
	orientation.MaxTorque = math.huge
	orientation.MaxAngularVelocity = math.huge
	orientation.Responsiveness = 25
	orientation.Enabled = false
	orientation.Parent = body

	bindSeat(seat, model, "Driver")

	addVehicleLabel(body, "Plane", Color3.fromRGB(160, 210, 255))

	model:SetAttribute("Health", spec.Health)
	model:SetAttribute("MaxHealth", spec.Health)
	model:SetAttribute("VehicleKind", "Plane")
	model:SetAttribute("MountedWeapon", spec.MountedWeapon)

	model.Parent = workspace
	active[model] = {
		kind = "Plane",
		chassis = body,
		seat = seat,
		velocity = velocity,
		orientation = orientation,
		-- Attitude the pilot has steered to so far.
		heading = body.CFrame.Rotation,
		speed = spec.MinFlySpeed,
	}
	return model
end

--[[
	The rideable torpedo. You sit on it like a saddle, steer with WASD, and it
	goes off like a bomb the moment it touches anything.
]]
function VehicleService.SpawnTorpedo(position: Vector3): Model
	local spec = Config.Vehicles.Torpedo

	local model = Instance.new("Model")
	model.Name = "Torpedo"

	local body = Util.Part({
		Name = "Chassis",
		Size = Vector3.new(4, 4, 18),
		CFrame = CFrame.new(position + Vector3.new(0, 8, 0)),
		Transparency = 1,
		Anchored = false,
		CustomPhysicalProperties = PhysicalProperties.new(0.4, 0.3, 0.2, 1, 1),
		Parent = model,
	})
	model.PrimaryPart = body

	-- Visual cylindrical torpedo hull (Size.X = length 18, Y/Z = diameter 4) rotated onto Z.
	local shell = Util.Part({
		Name = "TorpedoShell",
		Size = Vector3.new(18, 4, 4),
		CFrame = body.CFrame * CFrame.Angles(0, math.rad(90), 0),
		Shape = Enum.PartType.Cylinder,
		Color = spec.Color,
		Material = Enum.Material.Metal,
		Anchored = false,
		CanCollide = false,
		Massless = true,
		Parent = model,
	})
	Util.Weld(body, shell)

	-- The saddle. This is the bit you actually sit on.
	-- It is a VehicleSeat rather than a plain Seat specifically so that WASD
	-- arrives as Throttle and Steer without the client having to send them.
	local saddle = Instance.new("VehicleSeat")
	saddle.Name = "DriverSeat"
	saddle.Size = Vector3.new(3, 1, 5)
	saddle.CFrame = body.CFrame * CFrame.new(0, 2.5, 0)
	saddle.Color = Color3.fromRGB(90, 60, 40)
	saddle.Anchored = false
	saddle.Massless = true
	saddle.MaxSpeed = 0
	saddle.Torque = 0
	saddle.TurnSpeed = 0
	saddle.Parent = model
	Util.Weld(body, saddle)
	addSitPrompt(saddle, "Ride it", "Torpedo")

	local fins = Util.Part({
		Name = "Fins",
		Size = Vector3.new(7, 7, 2),
		CFrame = body.CFrame * CFrame.new(0, 0, 8),
		Color = Color3.fromRGB(60, 60, 64),
		Material = Enum.Material.Metal,
		Anchored = false,
		Massless = true,
		CanCollide = false,
		Parent = model,
	})
	Util.Weld(body, fins)

	local root = Util.Attachment(body, Vector3.zero, "FlightRoot")

	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = root
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.ForceLimitsEnabled = false
	velocity.MaxForce = math.huge
	velocity.MaxAxesForce = Vector3.new(math.huge, math.huge, math.huge)
	velocity.VectorVelocity = Vector3.zero
	velocity.Enabled = false
	velocity.Parent = body

	local orientation = Instance.new("AlignOrientation")
	orientation.Attachment0 = root
	orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	orientation.RigidityEnabled = true
	orientation.MaxTorque = math.huge
	orientation.MaxAngularVelocity = math.huge
	orientation.Responsiveness = 20
	orientation.Enabled = false
	orientation.Parent = body

	bindSeat(saddle, model, "Driver")

	addVehicleLabel(body, "Rideable Torpedo", Color3.fromRGB(255, 140, 140))

	model:SetAttribute("Health", spec.Health)
	model:SetAttribute("MaxHealth", spec.Health)
	model:SetAttribute("VehicleKind", "Torpedo")

	model.Parent = workspace
	active[model] = {
		kind = "Torpedo",
		chassis = body,
		seat = saddle,
		velocity = velocity,
		orientation = orientation,
		heading = body.CFrame.Rotation,
		-- Armed and timed from the moment someone actually climbs aboard.
		armedAt = nil,
		expiresAt = nil,
	}
	return model
end

--[[ Spawn whichever big toy a map pad asks for. ]]
--[[
	An inner tube.

	The one piece of kit that works on both halves of the resort: ride it
	down the ski run and it carries straight on into the lazy river at the
	bottom, because it is pushed by whatever it is sitting in or on -- the
	river's current, or gravity down a snow slope -- rather than by an engine
	of its own.

	It is a seat, so your guns keep working. That is the rule for every sport
	here: you are always armed.
]]
function VehicleService.SpawnTube(position: Vector3): Model
	local model = Instance.new("Model")
	model.Name = "Tube"

	local hub = Util.Part({
		Name = "Chassis",
		Size = Vector3.new(3, 11, 11),
		CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
		Shape = Enum.PartType.Cylinder,
		Color = Color3.fromRGB(250, 150, 40),
		Material = Enum.Material.Rubber,
		Anchored = false,
		CustomPhysicalProperties = PhysicalProperties.new(0.25, 0.08, 0.5, 1, 1),
		Parent = model,
	})
	model.PrimaryPart = hub

	-- The hole in the middle, which is what makes it read as a tube.
	Util.Part({
		Name = "TubeHole",
		Size = Vector3.new(3.4, 5.4, 5.4),
		CFrame = hub.CFrame,
		Shape = Enum.PartType.Cylinder,
		Color = Color3.fromRGB(40, 40, 46),
		Transparency = 0.75,
		CanCollide = false,
		Anchored = false,
		Massless = true,
		Parent = model,
	})
	Util.Weld(hub, model:FindFirstChild("TubeHole") :: BasePart)

	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(4, 1, 4)
	seat.CFrame = CFrame.new(position + Vector3.new(0, 1.4, 0))
	seat.Color = Color3.fromRGB(240, 130, 30)
	seat.Transparency = 1
	seat.Anchored = false
	seat.Massless = true
	-- No engine of its own: the current and the slope do the work.
	seat.MaxSpeed = 0
	seat.Torque = 0
	seat.TurnSpeed = 0
	seat.Parent = model
	Util.Weld(hub, seat)

	-- Steering only. A LinearVelocity in plane mode would fight gravity, so
	-- the tube is pushed by an impulse each frame instead and this just
	-- points it.
	local turn = Instance.new("AngularVelocity")
	turn.Name = "TurnVelocity"
	turn.Attachment0 = Util.Attachment(hub, Vector3.new())
	turn.RelativeTo = Enum.ActuatorRelativeTo.World
	turn.MaxTorque = 90000
	turn.AngularVelocity = Vector3.new()
	turn.Enabled = true
	turn.Parent = hub

	addSitPrompt(seat, "Ride the tube", "Tube")
	bindSeat(seat, model, "Rider")
	addVehicleLabel(hub, "Tube", Color3.fromRGB(255, 190, 120))

	model:SetAttribute("Health", 40)
	model:SetAttribute("MaxHealth", 40)
	model:SetAttribute("VehicleKind", "Tube")
	model.Parent = workspace

	active[model] = {
		kind = "Tube",
		chassis = hub,
		seat = seat,
		turn = turn,
	}
	return model
end

--[[
	A hang glider.

	Launched off the summit, it gives you the one thing no other vehicle on
	the map does: a slow, quiet look down at everybody. It trades height for
	speed like a real wing -- pull the nose up and you climb briefly and then
	stall, push it down and you go fast and lose altitude.

	Spacebar bails out, and the existing parachute catches you, which is what
	makes being shot down survivable rather than just fatal.
]]
function VehicleService.SpawnGlider(position: Vector3): Model
	local model = Instance.new("Model")
	model.Name = "Glider"

	local frame = Util.Part({
		Name = "Chassis",
		Size = Vector3.new(4, 2, 12),
		CFrame = CFrame.new(position),
		Color = Color3.fromRGB(70, 74, 82),
		Material = Enum.Material.Metal,
		Anchored = false,
		CustomPhysicalProperties = PhysicalProperties.new(0.2, 0.3, 0.4, 1, 1),
		Parent = model,
	})
	model.PrimaryPart = frame

	-- The wing: a wide shallow delta, in two halves so it reads as swept.
	for _, side in { -1, 1 } do
		local panel = Util.Part({
			Name = "Wing",
			Size = Vector3.new(26, 0.6, 13),
			CFrame = CFrame.new(position + Vector3.new(side * 13, 3.4, 0))
				* CFrame.Angles(0, 0, math.rad(side * -9)),
			Color = if side < 0 then Color3.fromRGB(235, 80, 70) else Color3.fromRGB(70, 130, 235),
			Material = Enum.Material.Fabric,
			Anchored = false,
			Massless = true,
			Parent = model,
		})
		Util.Weld(frame, panel)
	end

	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(3, 1, 4)
	seat.CFrame = CFrame.new(position + Vector3.new(0, 1, 0))
	seat.Color = Color3.fromRGB(60, 62, 70)
	seat.Anchored = false
	seat.Massless = true
	seat.MaxSpeed = 0
	seat.Torque = 0
	seat.TurnSpeed = 0
	seat.Parent = model
	Util.Weld(frame, seat)

	local lift = Instance.new("LinearVelocity")
	lift.Name = "DriveVelocity"
	lift.Attachment0 = Util.Attachment(frame, Vector3.new())
	lift.RelativeTo = Enum.ActuatorRelativeTo.World
	lift.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lift.ForceLimitsEnabled = false
	lift.VectorVelocity = Vector3.new()
	lift.Enabled = false
	lift.Parent = frame

	local attitude = Instance.new("AlignOrientation")
	attitude.Name = "Attitude"
	attitude.Attachment0 = Util.Attachment(frame, Vector3.new(), "AttitudeAnchor")
	attitude.Mode = Enum.OrientationAlignmentMode.OneAttachment
	attitude.RigidityEnabled = true
	attitude.CFrame = frame.CFrame.Rotation
	attitude.Enabled = false
	attitude.Parent = frame

	addSitPrompt(seat, "Take the glider", "Hang Glider")
	bindSeat(seat, model, "Rider")
	addVehicleLabel(frame, "Hang Glider", Color3.fromRGB(190, 220, 255))

	model:SetAttribute("Health", 55)
	model:SetAttribute("MaxHealth", 55)
	model:SetAttribute("VehicleKind", "Glider")
	model.Parent = workspace

	active[model] = {
		kind = "Glider",
		chassis = frame,
		seat = seat,
		velocity = lift,
		orientation = attitude,
		heading = frame.CFrame.Rotation,
		airspeed = 0,
	}
	return model
end

--[[
	Skis.

	These cannot be a seat. A Roblox seat puts the character into a sitting
	pose and there is no way round that, and the whole point of the ski run
	is that you come down it standing up, shooting at people. So the rider is
	welded to the board instead with PlatformStand set, which holds them
	upright and stops the walk controller fighting the slope.

	The upshot is that skiing is a shooting posture. Guns, grenades, the
	mega-detonate key -- all of it works on the way down, which is the rule
	for every sport on this map.
]]
local SKI_SLOPE_SPEED = 185
local SKI_CARVE_RATE = 2.3

function VehicleService.SpawnSkis(position: Vector3): Model
	local model = Instance.new("Model")
	model.Name = "Skis"

	-- The board: invisible, and the thing everything else is welded to. Two
	-- visible skis sit on top of it.
	local board = Util.Part({
		Name = "Chassis",
		Size = Vector3.new(4.5, 0.6, 13),
		CFrame = CFrame.new(position),
		Transparency = 1,
		Anchored = false,
		-- Slippery and light, so it carries speed down snow.
		CustomPhysicalProperties = PhysicalProperties.new(0.2, 0.04, 0.3, 1, 1),
		Parent = model,
	})
	model.PrimaryPart = board

	for _, side in { -1, 1 } do
		local ski = Util.Part({
			Name = "Ski",
			Size = Vector3.new(1.3, 0.4, 13),
			CFrame = CFrame.new(position + Vector3.new(side * 1.5, 0, 0)),
			Color = if side < 0 then Color3.fromRGB(240, 70, 60) else Color3.fromRGB(255, 200, 50),
			Material = Enum.Material.SmoothPlastic,
			Anchored = false,
			Massless = true,
			Parent = model,
		})
		-- The turned-up tip, which is most of what makes it read as a ski.
		local tip = Util.Part({
			Name = "SkiTip",
			Size = Vector3.new(1.3, 0.4, 2.2),
			CFrame = CFrame.new(position + Vector3.new(side * 1.5, 0.45, -7))
				* CFrame.Angles(math.rad(-24), 0, 0),
			Color = ski.Color,
			Material = Enum.Material.SmoothPlastic,
			Anchored = false,
			Massless = true,
			Parent = model,
		})
		Util.Weld(board, ski)
		Util.Weld(board, tip)
	end

	-- Steering, and something to hold the board the right way up so it does
	-- not simply topple over the first time it is nudged.
	local turn = Instance.new("AngularVelocity")
	turn.Name = "TurnVelocity"
	turn.Attachment0 = Util.Attachment(board, Vector3.new())
	turn.RelativeTo = Enum.ActuatorRelativeTo.World
	turn.MaxTorque = 160000
	turn.AngularVelocity = Vector3.new()
	turn.Enabled = true
	turn.Parent = board

	local upright = Instance.new("AlignOrientation")
	upright.Name = "Upright"
	upright.Attachment0 = Util.Attachment(board, Vector3.new(), "UprightAnchor")
	upright.Mode = Enum.OrientationAlignmentMode.OneAttachment
	-- NOT rigid: a rigid board cannot be tipped, and tipping it is how you
	-- do a trick.
	upright.MaxTorque = 42000
	upright.Responsiveness = 22
	upright.CFrame = board.CFrame.Rotation
	upright.Enabled = true
	upright.Parent = board

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "SkiPrompt"
	prompt.ActionText = "Grab the skis"
	prompt.ObjectText = "Skis"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = board

	prompt.Triggered:Connect(function(player)
		VehicleService.MountSkis(player, model)
	end)

	addVehicleLabel(board, "Skis", Color3.fromRGB(255, 230, 140))

	model:SetAttribute("Health", 30)
	model:SetAttribute("MaxHealth", 30)
	model:SetAttribute("VehicleKind", "Skis")
	model.Parent = workspace

	active[model] = {
		kind = "Skis",
		chassis = board,
		turn = turn,
		upright = upright,
		rider = nil,
		-- Trick bookkeeping, filled in by the drive loop.
		airborneSince = nil,
		spin = 0,
		lastFacing = nil,
	}
	return model
end

--[[ Strap a player onto a pair of skis. ]]
function VehicleService.MountSkis(player: Player, model: Model)
	local state = active[model]
	if not state or state.rider then
		return
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return
	end
	-- Not while sitting in something else.
	if humanoid.SeatPart then
		return
	end

	local board = state.chassis :: BasePart
	root.CFrame = board.CFrame * CFrame.new(0, 3.2, 0)

	local weld = Instance.new("WeldConstraint")
	weld.Name = "SkiWeld"
	weld.Part0 = board
	weld.Part1 = root
	weld.Parent = board

	-- Upright, and the walk controller out of the way.
	humanoid.PlatformStand = true

	state.rider = player
	local playerState = PlayerState.Get(player)
	-- Reusing the vehicle slot on purpose: everything that already knows
	-- about "the thing you are riding" -- the eject key, the aim reference,
	-- the mounted-weapon rules -- then works for skis with no special cases.
	playerState.vehicle = model
	playerState.seatRole = "Skier"
	PlayerState.Changed.Fire(player)
end

--[[ Let go of the skis. Harmless if the player is not on any. ]]
function VehicleService.DismountSkis(player: Player)
	for model, state in active do
		if state.kind == "Skis" and state.rider == player then
			local board = state.chassis :: BasePart
			local weld = board:FindFirstChild("SkiWeld")
			if weld then
				weld:Destroy()
			end

			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.PlatformStand = false
			end

			state.rider = nil
			local playerState = PlayerState.Get(player)
			if playerState.vehicle == model then
				playerState.vehicle = nil
				playerState.seatRole = nil
				PlayerState.Changed.Fire(player)
			end
			return true
		end
	end
	return false
end

--[[
	A snowboard, and a downhill bike.

	Both are the ski rig with different numbers and a different shape on top,
	which is the whole reason skis were built as a board you are welded to
	rather than a seat: anything you ride standing up is the same problem.

	  - The BOARD carves harder and holds its speed better than skis, and
	    spins more freely in the air, so it suits grabs and flips.
	  - The BIKE is faster downhill, takes the biggest jumps, and will run
	    the mountain trail as happily as the piste.

	Both leave your weapons alone. Every sport here does.
]]
local function boardLike(
	name: string,
	label: string,
	position: Vector3,
	slopeSpeed: number,
	carveRate: number,
	dress: (Model, BasePart) -> ()
): Model
	local model = Instance.new("Model")
	model.Name = name

	local board = Util.Part({
		Name = "Chassis",
		Size = Vector3.new(4.5, 0.6, 13),
		CFrame = CFrame.new(position),
		Transparency = 1,
		Anchored = false,
		CustomPhysicalProperties = PhysicalProperties.new(0.2, 0.04, 0.3, 1, 1),
		Parent = model,
	})
	model.PrimaryPart = board

	dress(model, board)

	local turn = Instance.new("AngularVelocity")
	turn.Name = "TurnVelocity"
	turn.Attachment0 = Util.Attachment(board, Vector3.new())
	turn.RelativeTo = Enum.ActuatorRelativeTo.World
	turn.MaxTorque = 160000
	turn.AngularVelocity = Vector3.new()
	turn.Enabled = true
	turn.Parent = board

	local upright = Instance.new("AlignOrientation")
	upright.Name = "Upright"
	upright.Attachment0 = Util.Attachment(board, Vector3.new(), "UprightAnchor")
	upright.Mode = Enum.OrientationAlignmentMode.OneAttachment
	-- Not rigid: tipping it is how a trick happens.
	upright.MaxTorque = 42000
	upright.Responsiveness = 22
	upright.CFrame = board.CFrame.Rotation
	upright.Enabled = true
	upright.Parent = board

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RidePrompt"
	prompt.ActionText = `Grab the {string.lower(label)}`
	prompt.ObjectText = label
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = board
	prompt.Triggered:Connect(function(player)
		VehicleService.MountSkis(player, model)
	end)

	addVehicleLabel(board, label, Color3.fromRGB(230, 240, 255))

	model:SetAttribute("Health", 34)
	model:SetAttribute("MaxHealth", 34)
	model:SetAttribute("VehicleKind", name)
	model.Parent = workspace

	active[model] = {
		-- Driven by driveSkis: same physics, different numbers.
		kind = "Skis",
		chassis = board,
		turn = turn,
		upright = upright,
		rider = nil,
		airborneSince = nil,
		spin = 0,
		lastFacing = nil,
		slopeSpeed = slopeSpeed,
		carveRate = carveRate,
	}
	return model
end

function VehicleService.SpawnSnowboard(position: Vector3): Model
	return boardLike("Snowboard", "Snowboard", position, 205, 2.9, function(model, board)
		local deck = Util.Part({
			Name = "Deck",
			Size = Vector3.new(4.2, 0.5, 13),
			CFrame = board.CFrame,
			Color = Color3.fromRGB(60, 150, 230),
			Material = Enum.Material.SmoothPlastic,
			Anchored = false,
			Massless = true,
			Parent = model,
		})
		Util.Weld(board, deck)

		-- Turned-up nose and tail, which is what makes it read as a board.
		for _, endZ in { -1, 1 } do
			local tip = Util.Part({
				Name = "BoardTip",
				Size = Vector3.new(4.2, 0.5, 2.4),
				CFrame = board.CFrame
					* CFrame.new(0, 0.5, endZ * 7)
					* CFrame.Angles(math.rad(endZ * 22), 0, 0),
				Color = Color3.fromRGB(40, 120, 200),
				Material = Enum.Material.SmoothPlastic,
				Anchored = false,
				Massless = true,
				Parent = model,
			})
			Util.Weld(board, tip)
		end

		for _, side in { -1, 1 } do
			local binding = Util.Part({
				Name = "Binding",
				Size = Vector3.new(2.4, 0.9, 2.6),
				CFrame = board.CFrame * CFrame.new(0, 0.7, side * 2.2),
				Color = Color3.fromRGB(30, 32, 38),
				Material = Enum.Material.Rubber,
				Anchored = false,
				Massless = true,
				Parent = model,
			})
			Util.Weld(board, binding)
		end
	end)
end

function VehicleService.SpawnBike(position: Vector3): Model
	return boardLike("Bike", "Downhill Bike", position, 240, 2.5, function(model, board)
		local frame = Util.Part({
			Name = "BikeFrame",
			Size = Vector3.new(1, 3.2, 10),
			CFrame = board.CFrame * CFrame.new(0, 2.6, 0),
			Color = Color3.fromRGB(220, 70, 40),
			Material = Enum.Material.Metal,
			Anchored = false,
			Massless = true,
			Parent = model,
		})
		Util.Weld(board, frame)

		-- Two wheels, fore and aft, welded on: decoration, like the board
		-- itself, because the slope does the moving.
		for _, endZ in { -1, 1 } do
			local wheel = Util.Part({
				Name = "BikeWheel",
				Size = Vector3.new(0.7, 6.4, 6.4),
				CFrame = board.CFrame * CFrame.new(0, 1.4, endZ * 4.6),
				Shape = Enum.PartType.Cylinder,
				Color = Color3.fromRGB(24, 24, 28),
				Material = Enum.Material.Rubber,
				Anchored = false,
				Massless = true,
				Parent = model,
			})
			Util.Weld(board, wheel)
		end

		local bars = Util.Part({
			Name = "Handlebars",
			Size = Vector3.new(5, 0.6, 0.6),
			CFrame = board.CFrame * CFrame.new(0, 4.6, -3.6),
			Color = Color3.fromRGB(40, 42, 48),
			Material = Enum.Material.Metal,
			Anchored = false,
			Massless = true,
			Parent = model,
		})
		Util.Weld(board, bars)

		local saddle = Util.Part({
			Name = "Saddle",
			Size = Vector3.new(1.4, 0.6, 3),
			CFrame = board.CFrame * CFrame.new(0, 4.4, 2.6),
			Color = Color3.fromRGB(28, 28, 32),
			Material = Enum.Material.Fabric,
			Anchored = false,
			Massless = true,
			Parent = model,
		})
		Util.Weld(board, saddle)
	end)
end

function VehicleService.SpawnKind(kind: string, position: Vector3): Model?
	if kind == "TurretTruck" then
		return VehicleService.SpawnTurretTruck(position)
	elseif kind == "Tank" then
		return VehicleService.SpawnTank(position)
	elseif kind == "Plane" then
		return VehicleService.SpawnPlane(position)
	elseif kind == "Torpedo" then
		return VehicleService.SpawnTorpedo(position)
	elseif kind == "Tube" then
		return VehicleService.SpawnTube(position)
	elseif kind == "Glider" then
		return VehicleService.SpawnGlider(position)
	elseif kind == "Skis" then
		return VehicleService.SpawnSkis(position)
	elseif kind == "Snowboard" then
		return VehicleService.SpawnSnowboard(position)
	elseif kind == "Bike" then
		return VehicleService.SpawnBike(position)
	elseif kind == "G-Wagon" or kind == "Hummer" or kind == "Jeep" then
		-- The off-roaders, by name, for the mountain pads.
		return VehicleService.SpawnCar(3, position, nil, kind)
	end
	return nil
end

-- ================================================================= DRIVING ==

--[[
	Drive a wheeled vehicle.

	We set constraint targets, never the part's velocity directly — see the
	note in buildChassis for why that distinction decides whether the car
	moves at all.

	Speed is eased toward the target rather than snapped to it. That is what
	gives the thing mass: it winds up, it carries momentum into a corner, and
	it does not turn on a coin at walking pace.
]]
local function driveWheeled(model: Model, state: any, deltaTime: number)
	local chassis = state.chassis :: BasePart
	local seat = state.seat :: VehicleSeat
	if not chassis.Parent or not seat then
		return
	end

	local driving = Config.Driving

	-- Float inputs rather than the stepped ones: steering that eases in is
	-- most of the difference between driving and twitching.
	local throttle = if seat.Occupant then seat.ThrottleFloat else 0
	local steer = if seat.Occupant then seat.SteerFloat else 0

	-- A pedal from the on-screen mobile controls overrides the keyboard.
	local pedal = model:GetAttribute("Pedal")
	if seat.Occupant and typeof(pedal) == "number" and math.abs(pedal) > 0.01 then
		throttle = math.clamp(pedal, -1, 1)
	end

	-- The chairlift locks a car to its deck.
	if model:GetAttribute("LiftLocked") == true then
		throttle = 0
		steer = 0
	end

	--[[
		How fast it is actually going, along its own nose.

		Measured rather than tracked. The old loop kept its own idea of
		speed and fed it to a velocity constraint, which meant the number and
		the car could disagree -- and when they did, the car won and the
		number went on being wrong.
	]]
	local velocity = chassis.AssemblyLinearVelocity
	local forward = chassis.CFrame.LookVector
	local roadSpeed = velocity:Dot(forward)

	--[[
		What is under the wheels.

		Paced by distance rather than time: a boost chevron is nine studs
		long, and a fixed 20 Hz sample is ten studs apart at full speed, so
		the pads on the run-up to a ramp get stepped straight over. Four
		studs keeps the real spacing under six.

		This block was lost when the drive loop was rewritten around the new
		rig, and losing it silently switched off mud AND every boost pad on
		every map -- which the mud check below caught.
	]]
	local rolling = math.abs(roadSpeed) > 1 or seat.Occupant ~= nil
	if rolling then
		local now = os.clock()
		local here = chassis.Position
		local moved = if state.lastGroundSampleAt
			then (here - state.lastGroundSampleAt).Magnitude
			else math.huge

		if moved >= GROUND_SAMPLE_STUDS or now >= (state.nextGroundSampleAt or 0) then
			state.nextGroundSampleAt = now + GROUND_SAMPLE_INTERVAL
			state.lastGroundSampleAt = here
			groundParams.FilterDescendantsInstances = { model }
			local hit = workspace:Raycast(here, GROUND_PROBE, groundParams)
			state.groundIsMud = hit ~= nil
				and (hit.Instance.Name == "Mud" or hit.Material == Enum.Material.Mud)
			state.groundIsBoost = hit ~= nil and hit.Instance:GetAttribute("Boost") == true
		end
	else
		state.groundIsMud = false
		state.groundIsBoost = false
		state.nextGroundSampleAt = 0
		state.lastGroundSampleAt = nil
	end

	-- Mud, boost pads and turbo, all as multipliers on the speed the motors
	-- are asked for.
	local speedFactor = 1
	if state.groundIsMud then
		speedFactor = Config.MudSpeedFactor
	end
	if model:GetAttribute("Turbo") == true then
		speedFactor *= Config.Turbo.Multiplier
	end
	local boosted = state.groundIsBoost == true
	if boosted then
		speedFactor = math.max(speedFactor, Config.Boost.Speed / math.max(state.maxSpeed, 1))
	end

	local topSpeed = state.maxSpeed * speedFactor
	local speedRatio = math.clamp(math.abs(roadSpeed) / math.max(topSpeed, 1), 0, 1)

	--[[
		Steering: less lock the faster you go, and Ackermann on top.

		Full lock at 100 studs a second rolls the car, so the available
		angle falls away with speed. The inner wheel turning slightly
		sharper than the outer is what stops the front end scrubbing
		through a tight corner.
	]]
	local lock = driving.MaxSteerAngle
		- (driving.MaxSteerAngle - driving.MinSteerAngle) * speedRatio
	local targetAngle = -steer * lock

	for _, wheel in state.wheels do
		if not wheel.front or not wheel.slider then
			continue
		end
		local inner = (steer > 0 and wheel.home.X > 0) or (steer < 0 and wheel.home.X < 0)
		wheel.slider.TargetAngle = targetAngle * (if inner then 1.15 else 1)
	end

	--[[
		Drive, brake, or coast.

		Braking is asking the motors for zero with a lot of torque, which is
		what a brake is. Coasting is asking for zero with very little, which
		is engine braking. Nothing here pushes the chassis: if the wheels are
		off the ground they spin freely and the car arcs, which is why
		jumping needs no special case any more.
	]]
	local braking = (throttle < 0 and roadSpeed > 2) or (throttle > 0 and roadSpeed < -2)

	for _, wheel in state.wheels do
		local axle = wheel.axle
		if not axle then
			continue
		end
		if braking then
			axle.AngularVelocity = 0
			axle.MotorMaxTorque = driving.BrakeTorque
		elseif math.abs(throttle) > 0.05 then
			-- Linear studs/sec to angular radians/sec at the tire.
			axle.AngularVelocity = -(throttle * topSpeed) / wheel.radius
			axle.MotorMaxTorque = driving.MotorTorque * (if boosted then 1.6 else 1)
		else
			axle.AngularVelocity = 0
			axle.MotorMaxTorque = driving.MotorTorque * 0.1
		end
	end

	-- Kept for anything that still asks, and for the engine note below.
	state.currentSpeed = roadSpeed

	local engine = chassis:FindFirstChild("Engine")
	if engine and engine:IsA("Sound") then
		local fraction = math.abs(roadSpeed) / math.max(topSpeed, 1)
		engine.PlaybackSpeed = 0.45 + fraction * 1.5
		engine.Volume = 0.2 + fraction * 0.4
		if not engine.IsPlaying then
			engine:Play()
		end
	end

	local _ = deltaTime
end

--[[
	Fly a plane. Throttle changes speed, steering rolls and turns, and the
	nose pitches with the seat's own up/down input.
]]
--[[
	Drive a tube.

	A tube has no engine. It goes where it is pushed:

	  - In the river, a FlowZone part carries a direction attribute and the
	    tube is pushed along it. That is what makes the lazy river lazy and
	    still a way to travel.
	  - On snow, gravity does it: the steeper the slope under you, the faster
	    you go, which is what lets you ride the ski run on a tube and shoot
	    off the end of it into the water without ever touching a throttle.

	Steering only points you. Nothing here fights gravity, so the tube still
	falls off a cliff like an object rather than hovering like a vehicle.
]]
-- Declared ahead of driveTube, which uses it: the trick scorer itself needs
-- Util.AngleBetween and PlayerState, so it is defined further down.
local stepTricks: (Model, any, Player?, boolean, number) -> ()

local TUBE_FLOW_SPEED = 46
local TUBE_SLOPE_SPEED = 118

local function driveTube(model: Model, state: any, deltaTime: number)
	local hub = state.chassis :: BasePart
	local seat = state.seat :: VehicleSeat
	local turn = state.turn :: AngularVelocity

	-- Steering works whether or not anybody is aboard; an empty tube simply
	-- is not told to turn.
	turn.AngularVelocity = if seat.Occupant
		then Vector3.new(0, -seat.Steer * 1.9, 0)
		else Vector3.new()

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local occupantCharacter = if seat.Occupant then seat.Occupant.Parent else nil
	params.FilterDescendantsInstances = if occupantCharacter
		then { model, occupantCharacter }
		else { model }

	local push = Vector3.new()

	-- The river first: a current beats a slope.
	local flowHit = workspace:Raycast(hub.Position + Vector3.new(0, 2, 0), Vector3.new(0, -8, 0), params)
	local flowPart = if flowHit then flowHit.Instance else nil
	local onFlow = false
	if flowPart then
		local fx = flowPart:GetAttribute("FlowX")
		local fz = flowPart:GetAttribute("FlowZ")
		if typeof(fx) == "number" and typeof(fz) == "number" then
			onFlow = true
			push = Vector3.new(fx, 0, fz) * TUBE_FLOW_SPEED
		end
	end

	if not onFlow then
		-- Snow: slide downhill, hard. The surface normal gives both the
		-- direction and the steepness in one go.
		local ground = workspace:Raycast(hub.Position, Vector3.new(0, -7, 0), params)
		if ground and ground.Material == Enum.Material.Snow then
			local normal = ground.Normal
			local downhill = Vector3.new(normal.X, 0, normal.Z)
			if downhill.Magnitude > 0.02 then
				-- A flat surface has a vertical normal and so no downhill
				-- component at all, which is exactly right: you stop.
				push = downhill.Unit * (downhill.Magnitude * TUBE_SLOPE_SPEED)
			end
		end
	end

	if push.Magnitude > 0.1 then
		-- An impulse rather than a velocity constraint, so the tube keeps
		-- its own vertical motion and still falls, jumps and lands.
		local current = hub.AssemblyLinearVelocity
		local flat = Vector3.new(current.X, 0, current.Z)
		local wanted = push - flat
		-- Eased, so it accelerates into the current instead of snapping.
		hub.AssemblyLinearVelocity = current + Vector3.new(wanted.X, 0, wanted.Z) * math.min(1, deltaTime * 3.2)
	end

	-- Tricks off the table tops count on a tube too.
	local rider = if seat.Occupant and seat.Occupant.Parent
		then Players:GetPlayerFromCharacter(seat.Occupant.Parent)
		else nil
	local grounded = workspace:Raycast(hub.Position, Vector3.new(0, -6, 0), params) ~= nil
	stepTricks(model, state, rider, grounded, deltaTime)
end

--[[
	Fly a hang glider.

	It trades height for speed the way a wing does: nose down and you gain
	speed and lose altitude, nose up and you convert speed back into a brief
	climb and then run out of it. There is no throttle, which is the whole
	character of the thing.
]]
local GLIDE_MIN_SPEED = 42
local GLIDE_MAX_SPEED = 140
local GLIDE_SINK = 13

local function driveGlider(model: Model, state: any, deltaTime: number)
	local frame = state.chassis :: BasePart
	local seat = state.seat :: VehicleSeat
	local lift = state.velocity :: LinearVelocity
	local attitude = state.orientation :: AlignOrientation

	if not seat.Occupant then
		lift.Enabled = false
		attitude.Enabled = false
		state.airspeed = 0
		return
	end

	lift.Enabled = true
	attitude.Enabled = true

	--[[
		W pushes the nose DOWN, S pulls it up.

		Note the minus sign. A positive rotation about X takes the look
		vector upward in Roblox, so without it W climbed and the glider lost
		speed when you asked it to dive -- which the test caught as "diving
		trades height for speed" failing with the dive SLOWER than level.
	]]
	local pitchInput = seat.Throttle
	local rollInput = seat.Steer

	state.heading = state.heading
		* CFrame.Angles(-pitchInput * 0.9 * deltaTime, -rollInput * 1.25 * deltaTime, 0)

	-- Keep the nose from going fully vertical either way, which would leave
	-- the wing with no sensible forward direction at all.
	local look = state.heading.LookVector
	if look.Y > 0.72 or look.Y < -0.86 then
		state.heading = state.heading * CFrame.Angles(pitchInput * 0.9 * deltaTime, 0, 0)
		look = state.heading.LookVector
	end

	attitude.CFrame = state.heading

	-- Diving builds speed, climbing spends it.
	local gain = -look.Y * 95
	state.airspeed = math.clamp(
		(state.airspeed or GLIDE_MIN_SPEED) + (gain - 16) * deltaTime,
		GLIDE_MIN_SPEED,
		GLIDE_MAX_SPEED
	)

	-- Always sinking a little, so a glide is a glide and not a hover.
	local sink = -GLIDE_SINK * (1 - math.clamp(state.airspeed / GLIDE_MAX_SPEED, 0, 1) * 0.55)
	lift.VectorVelocity = look * state.airspeed + Vector3.new(0, sink, 0)
end

--[[
	Tricks, SSX-style.

	What counts as a trick is measured rather than declared: the server
	watches how long you were off the ground and how far the board turned
	while you were up there, and pays out on the landing. Nothing is reported
	by the client, so there is nothing to lie about -- a trick you did not do
	cannot be claimed, and a trick you did cannot be denied.

	Rotation is accumulated per frame from the board's own facing, so a slow
	720 and a fast 720 score the same, which is as it should be.
]]
local TRICK_MIN_AIRTIME = 0.45
local TRICK_SPIN_POINTS = 0.55 -- per degree turned
local TRICK_AIR_POINTS = 26 -- per second airborne

local TRICK_NAMES = {
	{ spin = 1080, name = "TRIPLE CORK" },
	{ spin = 720, name = "SEVEN-TWENTY" },
	{ spin = 480, name = "FIVE-FORTY" },
	{ spin = 270, name = "THREE-SIXTY" },
	{ spin = 160, name = "ONE-EIGHTY" },
	{ spin = 0, name = "BIG AIR" },
}

local function trickName(spin: number): string
	for _, entry in TRICK_NAMES do
		if spin >= entry.spin then
			return entry.name
		end
	end
	return "BIG AIR"
end

--[[
	Watch a ride for airtime and spin, and pay out when it lands.

	Shared by skis and tubes, because the brief was tricks off the table tops
	and you can take either down the run.
]]
function stepTricks(model, state, rider, grounded, deltaTime)
	local board = state.chassis :: BasePart
	local facing = board.CFrame.LookVector
	local flat = Vector3.new(facing.X, 0, facing.Z)

	if state.lastFacing and flat.Magnitude > 0.01 then
		state.spin = (state.spin or 0) + Util.AngleBetween(state.lastFacing, flat.Unit)
	end
	state.lastFacing = if flat.Magnitude > 0.01 then flat.Unit else state.lastFacing

	if not grounded then
		if not state.airborneSince then
			state.airborneSince = os.clock()
			state.spin = 0
		end
		return
	end

	local launched = state.airborneSince
	state.airborneSince = nil
	if not launched or not rider then
		state.spin = 0
		return
	end

	local airtime = os.clock() - launched
	state.spin = state.spin or 0
	if airtime < TRICK_MIN_AIRTIME then
		-- A bump in the piste is not a trick.
		state.spin = 0
		return
	end

	-- Taken into a local BEFORE the reset. Reading state.spin after zeroing
	-- it meant every trick, however far it turned, came out named "BIG AIR"
	-- while being paid for the spin -- the score was right and the shout was
	-- wrong, which is the kind of thing nobody notices for months.
	local spun = state.spin
	state.spin = 0

	local points = math.floor(airtime * TRICK_AIR_POINTS + spun * TRICK_SPIN_POINTS)
	if points <= 0 then
		return
	end

	local awarded = PlayerState.AwardPoints(rider, points)
	VehicleService.TrickLanded.Fire(rider, trickName(spun), awarded, airtime)

	local _ = deltaTime
end

--[[
	Ski down a mountain.

	Same idea as the tube -- gravity does the work, the slope decides how
	much -- but faster, and it carves: steering turns the board, and the
	board's own facing is what you accelerate along, so you can traverse
	across a slope instead of only straight down it.
]]
local function driveSkis(model: Model, state: any, deltaTime: number)
	local board = state.chassis :: BasePart
	local turn = state.turn :: AngularVelocity
	local upright = state.upright :: AlignOrientation
	local rider = state.rider :: Player?

	-- Nobody aboard: let it lie still rather than skidding off on its own.
	if not rider or not rider.Parent then
		if rider then
			VehicleService.DismountSkis(rider)
		end
		turn.AngularVelocity = Vector3.new()
		return
	end

	local character = rider.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		VehicleService.DismountSkis(rider)
		return
	end

	-- Steering comes off the move keys. There is no seat, so the inputs
	-- arrive as the humanoid's own walk direction.
	local steer = 0
	local wish = humanoid.MoveDirection
	if wish.Magnitude > 0.1 then
		local across = Vector3.new(-board.CFrame.LookVector.Z, 0, board.CFrame.LookVector.X)
		steer = math.clamp(wish:Dot(across) * 1.6, -1, 1)
	end
	turn.AngularVelocity = Vector3.new(0, -steer * (state.carveRate or SKI_CARVE_RATE), 0)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = if character then { model, character } else { model }

	local ground = workspace:Raycast(board.Position, Vector3.new(0, -6, 0), params)
	local grounded = ground ~= nil

	if ground and ground.Material == Enum.Material.Snow then
		local normal = ground.Normal
		local downhill = Vector3.new(normal.X, 0, normal.Z)
		if downhill.Magnitude > 0.02 then
			-- Accelerate along the board's own facing, biased downhill, so
			-- carving across the fall line actually works.
			local steepness = downhill.Magnitude
			local heading = board.CFrame.LookVector
			local flatHeading = Vector3.new(heading.X, 0, heading.Z)
			local blend = if flatHeading.Magnitude > 0.01
				then (flatHeading.Unit * 0.55 + downhill.Unit * 0.45).Unit
				else downhill.Unit

			local target = blend * (steepness * (state.slopeSpeed or SKI_SLOPE_SPEED))
			local current = board.AssemblyLinearVelocity
			local wanted = target - Vector3.new(current.X, 0, current.Z)
			board.AssemblyLinearVelocity = current
				+ Vector3.new(wanted.X, 0, wanted.Z) * math.min(1, deltaTime * 2.6)
		end
	end

	-- Hold the board level when it is on the ground, and let it tumble
	-- freely in the air so a trick looks like a trick.
	upright.Enabled = grounded
	if grounded then
		local heading = board.CFrame.LookVector
		local flatHeading = Vector3.new(heading.X, 0, heading.Z)
		if flatHeading.Magnitude > 0.01 then
			upright.CFrame = CFrame.lookAt(Vector3.new(), flatHeading.Unit)
		end
	end

	stepTricks(model, state, rider, grounded, deltaTime)
end

local function drivePlane(model: Model, state: any, deltaTime: number)
	local spec = Config.Vehicles.Plane
	local seat = state.seat :: VehicleSeat
	local body = state.chassis :: BasePart

	if not seat.Occupant then
		state.velocity.Enabled = false
		state.orientation.Enabled = false
		return
	end

	state.velocity.Enabled = true
	state.orientation.Enabled = true

	-- Fallbacks here mean a half-edited Config still flies instead of erroring.
	local topSpeed = spec.FlySpeed or 180
	local stallSpeed = spec.MinFlySpeed or 60
	local rollRate = spec.RollRate or 2.2
	local pitchRate = spec.PitchRate or 1.4
	local yawRate = spec.YawRate or 0.8

	-- Track takeoff grace period so planes sitting on the pad never explode on boarding.
	local now = os.clock()
	if not state.boardedAt then
		state.boardedAt = now
		state.airborne = false
		state.speed = math.max(state.speed or 0, stallSpeed * 1.25)
		-- Gentle climb attitude on takeoff.
		state.heading = CFrame.new() * state.heading.Rotation * CFrame.Angles(math.rad(14), 0, 0)
	end
	if body.Position.Y > 18 then
		state.airborne = true
	end

	-- Maintain smooth cruise speed; W climbs gently and S dives/slows rather than slamming into the ground.
	local cruise = (stallSpeed + topSpeed) * 0.55
	local target = if seat.Throttle ~= 0
		then (state.speed or cruise) + seat.Throttle * 55 * deltaTime
		else (state.speed or cruise) + (cruise - (state.speed or cruise)) * math.min(1, deltaTime * 1.5)
	state.speed = math.clamp(target, stallSpeed, topSpeed)

	local roll = -seat.Steer * rollRate * deltaTime
	local pitch = seat.Throttle * pitchRate * deltaTime * 0.45
	local yaw = -seat.Steer * yawRate * deltaTime

	state.heading = state.heading * CFrame.Angles(pitch, yaw, roll)
	state.orientation.CFrame = state.heading

	local liftBoost = if (not state.airborne) and (now - state.boardedAt < 2.2) then Vector3.new(0, 26, 0) else Vector3.zero
	state.velocity.VectorVelocity = state.heading.LookVector * state.speed + liftBoost

	if state.airborne and body.Position.Y < 6 then
		VehicleService.Damage(model, 9999, nil)
	end
end

--[[ Ride the torpedo. It only goes forward; you choose where forward is. ]]
local function driveTorpedo(model: Model, state: any, deltaTime: number)
	local spec = Config.Vehicles.Torpedo
	local seat = state.seat :: VehicleSeat

	if not seat.Occupant then
		state.velocity.Enabled = false
		state.orientation.Enabled = false
		return
	end

	state.velocity.Enabled = true
	state.orientation.Enabled = true

	-- A on the keyboard turns you left, W points the nose down so you can dive
	-- it into somebody. That is the whole control scheme.
	local steer = seat.Steer
	local pitch = seat.Throttle * 0.6

	local turnRate = spec.TurnRate or 1.6
	local runSpeed = spec.Speed or 150

	state.heading = state.heading
		* CFrame.Angles(pitch * turnRate * deltaTime, -steer * turnRate * deltaTime, 0)
	state.orientation.CFrame = state.heading
	state.velocity.VectorVelocity = state.heading.LookVector * runSpeed

	--[[
		Hitting things, and running out.

		Neither of these existed. `armedAt` was written at spawn and never
		read once, and `Lifetime` was in the config with a comment promising
		"it dies on its own after this long, with you on it". So the torpedo
		-- the thing you steer into somebody -- passed straight through them
		and then flew forever, or until it hit a wall and sat there.

		A raycast ahead rather than a Touched connection: the body is driven
		by a velocity constraint at 150 studs a second, which is two and a
		half studs per frame, and contact events on something moving that
		fast are not something to rely on.
	]]
	local now = os.clock()
	if not state.armedAt then
		state.armedAt = now + 1.0
		state.expiresAt = now + (spec.Lifetime or 20)
	end
	if now < state.armedAt then
		return
	end

	if now >= state.expiresAt then
		VehicleService.Explode(model)
		return
	end

	local chassis = state.chassis :: BasePart
	local nose = state.heading.LookVector
	-- Far enough ahead to cover a frame of travel plus the shell itself.
	local reach = runSpeed * math.max(deltaTime, 1 / 60) + 11

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	-- Not itself, and not the person riding it.
	local rider = seat.Occupant
	local riderCharacter = if rider then rider.Parent else nil
	params.FilterDescendantsInstances = if riderCharacter
		then { model, riderCharacter }
		else { model }

	local hit = workspace:Raycast(chassis.Position, nose * reach, params)
	if hit then
		VehicleService.Explode(model)
	end
end

--[[
	Turn a player's turbo on or off.

	Works on whatever they are currently driving; on foot it just makes them
	run faster, so the same key always means "go faster".
]]
--[[
	Who is currently looking down a scope, and how fast they may move.

	Kept here beside SetTurbo because both of them write WalkSpeed, and two
	places writing the same property without knowing about each other is how
	you get a player permanently stuck at sniper pace.
]]
local scoped: { [Player]: boolean? } = {}

function VehicleService.SetScoped(player: Player, on: boolean)
	-- nil rather than false, so the table does not grow an entry for every
	-- player who ever un-scoped.
	scoped[player] = if on then true else nil

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	-- Only touch it on foot: in a seat WalkSpeed is irrelevant anyway.
	if humanoid.SeatPart then
		return
	end
	humanoid.WalkSpeed = if on
		then Config.Turbo.WalkSpeed * Config.Movement.ScopedSpeedFactor
		else Config.Turbo.WalkSpeed
end

function VehicleService.SetTurbo(player: Player, on: boolean)
	local state = PlayerState.Get(player)

	if state.vehicle and state.vehicle.Parent and state.seatRole == "Driver" then
		state.vehicle:SetAttribute("Turbo", on)
		return
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		-- Sprinting beats being scoped: letting go of the scope should not
		-- leave you stuck at sniper pace, and holding shift should always
		-- make you faster.
		humanoid.WalkSpeed = if on
			then Config.Turbo.SprintWalkSpeed
			elseif scoped[player] then Config.Turbo.WalkSpeed * Config.Movement.ScopedSpeedFactor
			else Config.Turbo.WalkSpeed
	end
end

--[[ The on-screen gas and brake pedals, for players without a keyboard. ]]
function VehicleService.SetPedal(player: Player, value: number)
	local state = PlayerState.Get(player)
	if state.vehicle and state.vehicle.Parent and state.seatRole == "Driver" then
		state.vehicle:SetAttribute("Pedal", math.clamp(value, -1, 1))
	end
end

--[[
	Bail out.

	Press space on a rideable rocket and you are thrown clear, a parachute
	opens, and you drift down instead of making a crater. The descent is a
	LinearVelocity in Line mode along world Y: it pins how fast you fall
	without touching your horizontal movement, so you can still steer where
	you land.
]]
--[[
	Who is already mid-ejection.

	The Parachute guard below is checked BEFORE a task.wait, and the
	parachute is only created after it. Ten Eject calls in a single frame
	therefore all passed the guard, each stacking another 70 studs/sec of
	upward velocity and another LinearVelocity constraint -- a free launch to
	the top of the skybox. The claim has to be staked synchronously, before
	anything yields.
]]
local ejecting: { [Player]: true } = {}

function VehicleService.Eject(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then
		return
	end
	--[[
		Skis are not a seat, so the bail key has to know about them
		separately -- and PlatformStand means you cannot simply jump off.
	]]
	if not humanoid.SeatPart then
		if VehicleService.DismountSkis(player) then
			return
		end
		return
	end
	-- Already under a canopy, or already on the way to one.
	if character:FindFirstChild("Parachute") or ejecting[player] then
		return
	end
	ejecting[player] = true

	humanoid.Sit = false

	-- Thrown clear of whatever you were riding.
	task.wait(0.1)
	if not root.Parent or player.Parent == nil then
		ejecting[player] = nil
		return
	end
	root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + Vector3.new(0, 70, 0)

	local canopy = Instance.new("Model")
	canopy.Name = "Parachute"

	local dome = Util.Part({
		Name = "Canopy",
		Size = Vector3.new(22, 9, 22),
		CFrame = root.CFrame * CFrame.new(0, 13, 0),
		Color = Color3.fromRGB(240, 130, 60),
		Material = Enum.Material.Fabric,
		Anchored = false,
		CanCollide = false,
		Massless = true,
		Parent = canopy,
	})
	local domeMesh = Instance.new("SpecialMesh")
	domeMesh.MeshType = Enum.MeshType.Sphere
	domeMesh.Parent = dome

	-- Lines from the canopy down to the jumper.
	for index = 1, 4 do
		local angle = (index / 4) * math.pi * 2
		local cord = Util.Part({
			Name = "Cord",
			Size = Vector3.new(0.2, 9, 0.2),
			CFrame = root.CFrame * CFrame.new(math.cos(angle) * 5, 7, math.sin(angle) * 5),
			Color = Color3.fromRGB(230, 230, 230),
			Anchored = false,
			CanCollide = false,
			Massless = true,
			Parent = canopy,
		})
		Util.Weld(dome, cord)
	end

	Util.Weld(root, dome)
	canopy.Parent = character

	local anchorPoint = Util.Attachment(root, Vector3.zero, "ChuteRoot")

	local descent = Instance.new("LinearVelocity")
	descent.Name = "ChuteDescent"
	descent.Attachment0 = anchorPoint
	descent.VelocityConstraintMode = Enum.VelocityConstraintMode.Line
	descent.RelativeTo = Enum.ActuatorRelativeTo.World
	-- Straight down, gently. Horizontal movement is left alone.
	descent.LineDirection = Vector3.new(0, 1, 0)
	descent.LineVelocity = -24
	descent.ForceLimitsEnabled = false
	descent.MaxForce = math.huge
	descent.MaxAxesForce = Vector3.new(math.huge, math.huge, math.huge)
	descent.Enabled = false
	descent.Parent = root

	Sound.At("ParachuteOpen", root.Position)
	Remotes.Event("Notify"):FireClient(player, "Parachute open — steer with WASD.")

	-- Let the launch carry you upward first, then open.
	task.delay(0.7, function()
		if descent.Parent then
			descent.Enabled = true
		end
	end)

	-- Cut away once you are down, or after long enough that something is wrong.
	task.spawn(function()
		local opened = os.clock()
		while os.clock() - opened < 30 do
			task.wait(0.2)
			if not root.Parent or not canopy.Parent then
				break
			end
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { character }
			local ground = workspace:Raycast(root.Position, Vector3.new(0, -8, 0), params)
			if ground and os.clock() - opened > 1.2 then
				break
			end
		end
		ejecting[player] = nil
		if canopy.Parent then
			canopy:Destroy()
		end
		if descent.Parent then
			descent:Destroy()
		end
		if anchorPoint.Parent then
			anchorPoint:Destroy()
		end
	end)
end

--[[ Hurt a vehicle. At zero health it explodes and takes its riders with it. ]]
function VehicleService.Damage(model: Model, amount: number, attacker: Player?)
	if not model or not model.Parent then
		return
	end
	if not (amount > 0) or amount == math.huge then
		return
	end
	local health = model:GetAttribute("Health")
	if typeof(health) ~= "number" then
		return
	end

	local state = active[model]
	if state and attacker then
		state.lastAttacker = attacker
	end

	local resistance = model:GetAttribute("DamageResistance")
	if typeof(resistance) == "number" then
		amount *= (1 - resistance)
	end

	health -= amount
	model:SetAttribute("Health", health)

	if health <= 0 then
		VehicleService.Explode(model)
	end
end

--[[ Blow a vehicle up, throwing anybody nearby around. ]]
function VehicleService.Explode(model: Model)
	local state = active[model]
	if not state then
		if model and model.Parent then
			model:Destroy()
		end
		return
	end

	local chassis = state.chassis :: BasePart
	local position = chassis.Position
	local kind = model:GetAttribute("VehicleKind")

	local blastRadius = 30
	local blastDamage = 110
	if kind == "Torpedo" then
		local torpedo = Config.Vehicles.Torpedo
		blastRadius = torpedo.BlastRadius or 45
		blastDamage = torpedo.BlastDamage or 200
	end

	--[[
		This used to be a bare Explosion instance and nothing else, which
		meant **every exploding vehicle dealt exactly zero damage**.

		Roblox's Explosion only hurts a Humanoid by breaking its joints, and
		DestroyJointRadiusPercent was set to 0 here to stop characters coming
		apart -- which also switched off the only damage it does. So a torpedo
		ridden straight into somebody, the one thing the torpedo is for, did
		nothing at all to them. Same for a tank going up next to a crowd.

		The visible blast stays; the damage goes through DamageService, which
		is the only thing that knows about teams, shields, point awards and
		the kill feed.
	]]
	local explosion = Instance.new("Explosion")
	explosion.Position = position
	explosion.BlastRadius = blastRadius
	explosion.BlastPressure = 250000
	explosion.DestroyJointRadiusPercent = 0
	explosion.Parent = workspace

	-- Announced rather than applied directly. DamageService already requires
	-- this module, so calling into it from here would be a dependency cycle;
	-- it listens for this instead, and the dependency stays one-way.
	if state.rider then
		VehicleService.DismountSkis(state.rider)
	end

	VehicleService.Wrecked.Fire(position, blastRadius, blastDamage, state.lastAttacker or state.lastDriver)

	active[model] = nil
	model:Destroy()
end

--[[ Every vehicle in the world gets a turn, every frame. ]]
local function step(deltaTime: number)
	for model, state in active do
		if not model.Parent then
			active[model] = nil
			continue
		end

		if state.kind == "Plane" then
			drivePlane(model, state, deltaTime)
		elseif state.kind == "Torpedo" then
			driveTorpedo(model, state, deltaTime)
		elseif state.kind == "Tube" then
			driveTube(model, state, deltaTime)
		elseif state.kind == "Glider" then
			driveGlider(model, state, deltaTime)
		elseif state.kind == "Skis" then
			driveSkis(model, state, deltaTime)
		else
			driveWheeled(model, state, deltaTime)
		end
	end
end

--[[ Look up a vehicle by any part of it — used when a bullet hits one. ]]
function VehicleService.FromPart(part: BasePart): Model?
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		if active[model] then
			return model
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

--[[ The state table for a live vehicle, or nil if it is not one of ours. ]]
function VehicleService.GetState(model: Model): any
	return active[model]
end

--[[ Aim a turret at a point in the world, for whoever is in the gunner seat. ]]
function VehicleService.AimTurret(model: Model, worldTarget: Vector3)
	local state = active[model]
	if not state or not state.turretYaw then
		return
	end

	local chassis = state.chassis :: BasePart
	local drum = state.turretDrum :: BasePart

	-- Work out the target angle in the chassis's own frame, so the turret
	-- stays pointed at the target even while the truck is turning.
	local localTarget = chassis.CFrame:PointToObjectSpace(worldTarget)
	local angle = math.atan2(-localTarget.X, -localTarget.Z)
	state.turretYaw.TargetAngle = math.deg(angle)

	local _ = drum
end

--[[ Everything currently alive, so the round can clean up after itself. ]]
function VehicleService.ClearAll()
	for model, state in active do
		if state.rider then
			VehicleService.DismountSkis(state.rider)
		end
		if model.Parent then
			model:Destroy()
		end
	end
	for _, player in Players:GetPlayers() do
		local pState = PlayerState.Get(player)
		if pState.vehicle then
			pState.vehicle = nil
			pState.seatRole = nil
			PlayerState.Changed.Fire(player)
		end
	end
	table.clear(active)
end

Players.PlayerRemoving:Connect(function(player)
	-- Otherwise a player who leaves mid-ejection holds their claim forever,
	-- and these tables hold on to them.
	ejecting[player] = nil
	scoped[player] = nil
end)

RunService.Heartbeat:Connect(step)

return VehicleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">WeaponService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WeaponService — pulling the trigger.

	The client says "I am firing this gun in this direction". The server checks
	that it is allowed, then decides what got hit. The client never gets to say
	who it hit, which is the whole reason the game cannot be cheated by editing
	your own copy of it.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Sound = require(Shared:WaitForChild("Sound"))
local Util = require(Shared:WaitForChild("Util"))

local PlayerState = require(script.Parent:WaitForChild("PlayerState"))
local DamageService = require(script.Parent:WaitForChild("DamageService"))
local ProjectileService = require(script.Parent:WaitForChild("ProjectileService"))
local VehicleService = require(script.Parent:WaitForChild("VehicleService"))
local WildlifeService = require(script.Parent:WaitForChild("WildlifeService"))
local CarnivalService = require(script.Parent:WaitForChild("CarnivalService"))
local HockeyService = require(script.Parent:WaitForChild("HockeyService"))

local WeaponService = {}

-- How far from a player's own body a shot is allowed to claim to start.
-- Generous enough for lag and long gun barrels, tight enough to stop somebody
-- firing from the other side of the map.
local MAX_ORIGIN_DRIFT = 30

local rng = Random.new()

--[[
	Draw the shot.

	The old version of this was a 0.22-stud line at 35% transparency lasting
	0.08 seconds — technically a tracer, practically invisible. Hitscan guns
	therefore looked like they were doing nothing at all, while the vehicle
	guns, which fire visible projectiles, looked fine. This is deliberately
	loud: a thick bright beam, a muzzle flash and a spark where it lands.
]]
--[[
	Tell everybody except the shooter what a shot looked like.

	The shooter's own client already drew it, the instant they pulled the
	trigger -- which is the whole point. Doing the visuals server-side meant
	the flash, the bang and the tracer all arrived one network round trip
	after the trigger, a constant 50-150ms delay on every shot that no amount
	of damage tuning can make feel good.

	Only players near enough to see it are told. Nobody watches a tracer from
	the other end of a 1500-stud map, and a minigun firing 22 times a second
	does not need to tell all twenty of them.
]]
local SHOT_AUDIBLE_RANGE = 420

local function broadcastShot(
	shooter: Player,
	origin: Vector3,
	endPoint: Vector3,
	spec: Config.WeaponSpec,
	normal: Vector3?
)
	local payload = {
		origin = origin,
		endPoint = endPoint,
		color = spec.Color,
		normal = normal,
		sound = Sound.ForWeapon(spec),
	}

	for _, other in Players:GetPlayers() do
		if other == shooter then
			continue
		end
		local character = other.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			if (root.Position - origin).Magnitude <= SHOT_AUDIBLE_RANGE then
				Remotes.Event("ShotFired"):FireClient(other, payload)
			end
		end
	end
end

local function updateHeldWeapon(player: Player)
	local character = player.Character
	if not character then
		return
	end

	local existing = character:FindFirstChild("HeldWeapon")
	if existing then
		existing:Destroy()
	end

	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if not hand or not hand:IsA("BasePart") then
		return
	end

	local state = PlayerState.Get(player)
	local spec = Config.Weapons[state.equipped]
	if not spec then
		return
	end

	local model = Instance.new("Model")
	model.Name = "HeldWeapon"

	-- Longer barrel for the long guns, stubby for sidearms.
	local length = if spec.Category == "Sniper" then 5.5
		elseif spec.Category == "Automatic" then 4.2
		elseif spec.Category == "Shotgun" then 4.0
		elseif spec.Category == "Explosive" then 3.6
		else 2.2

	local body = Util.Part({
		Name = "Barrel",
		Size = Vector3.new(0.4, 0.5, length),
		CFrame = hand.CFrame * CFrame.new(0, -0.4, -length * 0.4),
		Color = spec.Color,
		Material = Enum.Material.Metal,
		Anchored = false,
		CanCollide = false,
		Massless = true,
		Parent = model,
	})

	local grip = Util.Part({
		Name = "Grip",
		Size = Vector3.new(0.35, 0.9, 0.5),
		CFrame = body.CFrame * CFrame.new(0, -0.5, length * 0.3),
		Color = Color3.fromRGB(48, 42, 38),
		Material = Enum.Material.Wood,
		Anchored = false,
		CanCollide = false,
		Massless = true,
		Parent = model,
	})
	Util.Weld(body, grip)

	if spec.Category == "Sniper" then
		local scope = Util.Part({
			Name = "Scope",
			Size = Vector3.new(0.3, 0.3, 1.4),
			CFrame = body.CFrame * CFrame.new(0, 0.45, 0.4),
			Color = Color3.fromRGB(24, 24, 26),
			Material = Enum.Material.Metal,
			Anchored = false,
			CanCollide = false,
			Massless = true,
			Parent = model,
		})
		Util.Weld(body, scope)
	end

	Util.Weld(hand, body)
	model.Parent = character
end

WeaponService.UpdateHeldWeapon = updateHeldWeapon

--[[ Everything a shot from this player should pass straight through. ]]
local function ignoreListFor(player: Player): { Instance }
	local ignore: { Instance } = {}
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local state = PlayerState.Get(player)
	if state.vehicle and state.vehicle.Parent then
		table.insert(ignore, state.vehicle)
	end
	return ignore
end

--[[ One hitscan pellet: cast, damage whatever it found, draw the line. ]]
local function fireHitscanRay(player: Player, spec: Config.WeaponSpec, origin: Vector3, direction: Vector3)
	local params = Util.RayParams(ignoreListFor(player))
	local result = workspace:Raycast(origin, direction * spec.Range, params)

	local endPoint = if result then result.Position else origin + direction * spec.Range
	broadcastShot(
		player,
		origin + direction * 2,
		endPoint,
		spec,
		if result then result.Normal else nil
	)

	if not result then
		return
	end

	-- Shooting a giant animal does not hurt it, but it does annoy it.
	-- Fairground props first: they are neither people nor vehicles.
	if CarnivalService.RegisterHit(result.Instance, player, direction) then
		return
	end

	-- The puck. Shooting it is how you play hockey here -- a rifle makes a
	-- perfectly good stick and there is no stick-handling simulation to get
	-- in the way of it.
	if HockeyService.RegisterHit(result.Instance, player, direction) then
		return
	end

	if WildlifeService.RegisterHit(result.Instance, spec.Damage, player) then
		return
	end

	local humanoid, character = Util.HumanoidFromHit(result.Instance)
	if humanoid and character then
		local victim = Players:GetPlayerFromCharacter(character)
		if victim and victim ~= player then
			-- Headshots hurt more, because they should.
			local damage = spec.Damage
			local headshot = result.Instance.Name == "Head"
			if headshot then
				damage *= Config.Movement.HeadshotMultiplier
			end
			--[[
				A stick to the body on the ice starts a scrap.

				Blades of Steel: you catch somebody with the stick, it turns
				into a fight, and the winner may break the stick over them.
				It only triggers on the rink -- a stick swung in the street
				is just a stick -- and the damage still lands either way.
			]]
			-- Compared by identity against the config entries, because this
			-- function is handed the spec rather than the weapon's name.
			local isStick = spec == Config.Weapons[Config.Hockey.StickWeapon]
				or spec == Config.Weapons[Config.Hockey.BrokenStickWeapon]
			if isStick
				and HockeyService.OnIce(player)
				and HockeyService.OnIce(victim)
			then
				HockeyService.StartFight(player, victim)
			end

			if DamageService.ApplyDamage(victim, damage, player, spec.DisplayName) then
				-- Tell the shooter they connected. Without this, hitscan guns
				-- give you nothing at all to tell you whether you are aiming
				-- anywhere near the target.
				Remotes.Event("Hitmarker"):FireClient(player, {
					damage = math.floor(damage),
					headshot = headshot,
					position = result.Position,
				})
			end
			return
		end
	end

	local vehicle = VehicleService.FromPart(result.Instance)
	if vehicle then
		VehicleService.Damage(vehicle, spec.Damage * (spec.VehicleDamageMultiplier or 1), player)
	end

	-- Some guns go bang on impact even when they hit a wall.
	if (spec.BlastRadius or 0) > 0 then
		DamageService.Explode(
			result.Position,
			spec.BlastRadius or 0,
			spec.BlastDamage or 0,
			player,
			spec.VehicleDamageMultiplier
		)
	end
end

--[[
	Where a player's shots come from.

	On foot that is their head. In a gunner seat it is the muzzle on the end of
	the vehicle's barrel, so the 50 cal fires from the 50 cal and not from the
	gunner's forehead.
]]
local function muzzleFor(player: Player): Vector3?
	local state = PlayerState.Get(player)

	if state.vehicle and state.vehicle.Parent then
		local isMountedUser = state.seatRole == "Gunner"
			or (state.seatRole == "Driver" and state.vehicle:GetAttribute("VehicleKind") == "Plane")
		if isMountedUser then
			local barrel = state.vehicle:FindFirstChild("Barrel", true)
			if barrel and barrel:IsA("BasePart") then
				local muzzle = barrel:FindFirstChild("Muzzle")
				if muzzle and muzzle:IsA("Attachment") then
					return muzzle.WorldPosition
				end
				return barrel.Position
			end
		end
	end

	local character = player.Character
	if not character then
		return nil
	end
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head.Position
	end
	return nil
end

--[[ Which gun this player is actually holding right now. ]]
local function equippedWeaponName(player: Player): string
	local state = PlayerState.Get(player)

	-- The `.Parent` checks matter: a vehicle destroyed under a seated player
	-- leaves state.vehicle pointing at it. Without them the player keeps the
	-- tank cannon after the tank is gone, and muzzleFor -- which does check
	-- Parent -- falls back to their head, so they walk around firing a tank
	-- cannon out of their face.
	if state.vehicle and state.vehicle.Parent and state.seatRole == "Gunner" then
		local mounted = state.vehicle:GetAttribute("MountedWeapon")
		if typeof(mounted) == "string" and Config.Weapons[mounted] then
			return mounted
		end
	end
	-- A plane's pilot has the wing guns.
	if state.vehicle and state.vehicle.Parent and state.seatRole == "Driver" then
		local kind = state.vehicle:GetAttribute("VehicleKind")
		if kind == "Plane" then
			local mounted = state.vehicle:GetAttribute("MountedWeapon")
			if typeof(mounted) == "string" and Config.Weapons[mounted] then
				return mounted
			end
		end
	end

	return state.equipped
end

--[[ Start a reload if the magazine is empty and one is not already running. ]]
local function beginReload(player: Player, weaponName: string)
	local state = PlayerState.Get(player)
	local slot = state.weapons[weaponName]
	local spec = Config.Weapons[weaponName]
	if not slot or not spec then
		return
	end
	if slot.reloadingUntil > os.clock() or slot.ammo >= spec.MagSize then
		return
	end
	if Config.InfiniteAmmo then
		return
	end
	-- Poop and drones do not reload. What you scavenged is what you have.
	if spec.AmmoFromPickupsOnly then
		return
	end

	local expectedUntil = os.clock() + spec.ReloadTime
	slot.reloadingUntil = expectedUntil
	PlayerState.Changed.Fire(player)

	task.delay(spec.ReloadTime, function()
		if not player.Parent then
			return
		end
		local current = PlayerState.Get(player)
		local currentSlot = current.weapons[weaponName]
		if currentSlot and currentSlot.reloadingUntil == expectedUntil then
			currentSlot.ammo = spec.MagSize
			currentSlot.reloadingUntil = 0
			PlayerState.Changed.Fire(player)
		end
	end)
end

--[[
	The trigger. Everything the client asked for is treated as a request, not
	an instruction — the checks below are what actually decide.
]]
--[[
	Fire one named weapon.

	Split out from the fire handler so the dedicated grenade key can throw a
	grenade without the player having to switch weapons for it -- which is
	how Halo's grenade button worked, and the reason you could throw one
	mid-fight without giving up your rifle.
]]
local function fireWeapon(player: Player, weaponName: string, requestedDirection: any)
	-- NaN slips past a magnitude check, because every comparison involving
	-- NaN is false. Util.SaneDirection is the only guard here that actually
	-- rejects it, and it hands back the normalised vector so nothing
	-- downstream has to remember to do that.
	local direction = Util.SaneDirection(requestedDirection)
	if not direction then
		return
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	local spec = Config.Weapons[weaponName]
	if not spec then
		return
	end

	--[[
		There is no state in this game that takes your guns away.

		This used to check WildlifeService.IsRiding, left over from when you
		could ride a giant animal and the animal was the weapon. The animals
		became zombies and the function has returned false ever since, so it
		was a gate that did nothing -- but it was also a gate pointing the
		wrong way. The game is a shooter with sports scattered through it:
		tubing the lazy river, skiing the mountain, flying a glider, playing
		hockey. You are armed in all of them, always, and nothing new should
		ever be allowed to quietly change that. Config.WeaponsAlwaysAvailable
		says so and a test enforces it.
	]]

	local state = PlayerState.Get(player)
	local slot = state.weapons[weaponName]
	if not slot then
		return
	end

	local now = os.clock()
	if now < slot.nextFireAt then
		return
	end
	if now < slot.reloadingUntil then
		return
	end
	if not Config.InfiniteAmmo and slot.ammo <= 0 then
		beginReload(player, weaponName)
		return
	end

	local origin = muzzleFor(player)
	if not origin then
		return
	end

	-- A mounted gun cannot be carried around on foot, and a wrecked vehicle
	-- is not a vehicle.
	if spec.MountedOnly and not (state.vehicle and state.vehicle.Parent) then
		return
	end

	--[[
		Is the client shooting roughly where it is looking?

		Config.Combat.AutoAimServerToleranceDegrees has claimed since it was
		written that "the server re-checks aim against this wider cone before
		trusting a shot". It did not. Nothing checked the direction against
		the character at all, so a hostile client could send a vector
		pointing straight at somebody behind them and the server would
		happily trace it -- a silent 360-degree aimbot, needing no more than
		one line in a console.

		The cone is deliberately generous. It has to cover the client's own
		auto-aim snap, the gunner seats, and a few frames of latency between
		the client aiming and the server looking. It is not there to make
		aiming hard; it is there to make "behind me" impossible.
	]]
	local aimReference: Vector3? = nil
	if state.vehicle and state.vehicle.Parent and spec.MountedOnly then
		local barrel = state.vehicle:FindFirstChild("Barrel", true)
		if barrel and barrel:IsA("BasePart") then
			aimReference = barrel.CFrame.LookVector
		end
	end
	if not aimReference and humanoid.RootPart then
		local head = character and character:FindFirstChild("Head")
		aimReference = if head and head:IsA("BasePart")
			then head.CFrame.LookVector
			else humanoid.RootPart.CFrame.LookVector
	end

	if aimReference and aimReference.Magnitude > 0.001 then
		local tolerance = Config.Combat.AutoAimServerToleranceDegrees
		if Util.AngleBetween(aimReference, direction) > tolerance * 3.4 then
			return
		end
	end

	if spec.AmmoFromPickupsOnly and slot.ammo <= 0 then
		return
	end

	slot.nextFireAt = now + spec.Cooldown
	if (not Config.InfiniteAmmo) or spec.AmmoFromPickupsOnly then
		slot.ammo = math.max(0, slot.ammo - 1)
	end

	-- Fries give you three barrels for a while; normally this is just one.
	local barrels = PlayerState.BarrelCount(player)
	local barrelSpread = Config.Pickups.Fries.SpreadDegrees

	for barrel = 1, barrels do
		local barrelDirection = direction
		if barrels > 1 then
			local offset = (barrel - (barrels + 1) * 0.5) * barrelSpread
			barrelDirection = (Util.LookAt(Vector3.zero, direction) * CFrame.Angles(0, math.rad(offset), 0)).LookVector
		end

		if spec.Kind == "Hitscan" then
			for _ = 1, (spec.Pellets or 1) do
				fireHitscanRay(player, spec, origin, Util.ApplySpread(barrelDirection, spec.Spread, rng))
			end
		elseif spec.Kind == "Arcing" then
			-- Lobbed, so aim a little above where you pointed.
			local lobbed = (barrelDirection + Vector3.new(0, 0.35, 0)).Unit
			ProjectileService.Spawn(player, weaponName, origin, lobbed, ignoreListFor(player))
		else
			ProjectileService.Spawn(
				player,
				weaponName,
				origin,
				Util.ApplySpread(barrelDirection, spec.Spread, rng),
				ignoreListFor(player)
			)
		end
	end

	if not Config.InfiniteAmmo and slot.ammo <= 0 then
		beginReload(player, weaponName)
	end

	PlayerState.Changed.Fire(player)
end

local function handleFire(player: Player, requestedDirection: any)
	fireWeapon(player, equippedWeaponName(player), requestedDirection)
end

--[[
	The dedicated grenade key.

	Throws without changing what is in your hands, and shares the grenade's
	own cooldown with the slot, so holding the key cannot out-throw equipping
	the grenade and spamming fire.
]]
local function handleThrowGrenade(player: Player, requestedDirection: any)
	local weaponName = Config.GrenadeKeyWeapon

	-- A dedicated key has to work whatever is in your loadout. Picking up a
	-- weapon can take the grenade's slot, and a grenade button that silently
	-- stops working is worse than not having one.
	local state = PlayerState.Get(player)
	if not state.weapons[weaponName] then
		local spec = Config.Weapons[weaponName]
		if not spec then
			return
		end
		state.weapons[weaponName] = {
			ammo = spec.MagSize,
			reloadingUntil = 0,
			nextFireAt = 0,
		}
	end

	fireWeapon(player, weaponName, requestedDirection)
end

--[[ Swap guns. In free mode every gun in the config is yours from the start. ]]
local function handleEquip(player: Player, weaponName: any)
	if typeof(weaponName) ~= "string" then
		return
	end
	local spec = Config.Weapons[weaponName]
	if not spec or spec.MountedOnly then
		return
	end

	local state = PlayerState.Get(player)
	state.equipped = weaponName
	updateHeldWeapon(player)
	PlayerState.Changed.Fire(player)
end

--[[ The F key. Costs a charge, and only if something was actually in the air. ]]
local function handleMegaDetonate(player: Player)
	local state = PlayerState.Get(player)
	if state.megaCharges <= 0 then
		return
	end
	if not ProjectileService.HasLiveDiamond(player) then
		return
	end

	if ProjectileService.MegaDetonate(player) then
		state.megaCharges -= 1
		PlayerState.Changed.Fire(player)
	end
end

--[[
	Melee, on Q.

	Halo's close-range rhythm: shoot the shields off, then finish with a hit.
	Catch somebody facing away and it kills outright, which is what makes
	circling behind people worth the risk.
]]
local function handleMelee(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end

	-- You cannot punch from the driver's seat of a tank.
	if humanoid.SeatPart then
		return
	end

	local state = PlayerState.Get(player)
	local now = os.clock()
	if now < state.nextMeleeAt then
		return
	end
	state.nextMeleeAt = now + Config.Melee.Cooldown

	Sound.At("MeleeSwing", root.Position)

	local facing = root.CFrame.LookVector
	local best: Player? = nil
	local bestDistance = Config.Melee.Range

	for _, other in Players:GetPlayers() do
		if other == player then
			continue
		end
		if other.Team and player.Team and other.Team == player.Team then
			continue
		end
		local otherCharacter = other.Character
		local otherRoot = otherCharacter and otherCharacter:FindFirstChild("HumanoidRootPart")
		if not otherRoot or not otherRoot:IsA("BasePart") then
			continue
		end

		-- Dead men cannot be knifed again.
		local otherHumanoid = otherCharacter and otherCharacter:FindFirstChildOfClass("Humanoid")
		if not otherHumanoid or otherHumanoid.Health <= 0 then
			continue
		end

		local toTarget = otherRoot.Position - root.Position
		local distance = toTarget.Magnitude
		-- Has to be in front of you, not merely nearby.
		if distance <= bestDistance and Util.AngleBetween(facing, toTarget) < 70 then
			-- And you have to be able to reach them. Distance and a cone
			-- alone let you knife somebody through a solid wall, which at
			-- nine studs of range happens constantly in a city map full of
			-- two-stud partitions.
			local blocked = workspace:Raycast(
				root.Position,
				toTarget,
				Util.RayParams({ character, otherCharacter })
			)
			if not blocked then
				best = other
				bestDistance = distance
			end
		end
	end

	if not best then
		return
	end

	local victimCharacter = best.Character
	local victimRoot = victimCharacter and victimCharacter:FindFirstChild("HumanoidRootPart")
	local damage = Config.Melee.Damage

	if victimRoot and victimRoot:IsA("BasePart") then
		-- Both facing the same way means you are behind them.
		local alignment = Util.AngleBetween(facing, victimRoot.CFrame.LookVector)
		if alignment < Config.Melee.BackstabArc then
			damage *= Config.Melee.BackstabMultiplier
		end
	end

	Sound.At("MeleeHit", root.Position)
	if DamageService.ApplyDamage(best, damage, player, "Melee") then
		Remotes.Event("Hitmarker"):FireClient(player, {
			damage = math.floor(damage),
			headshot = damage > Config.Melee.Damage,
			position = root.Position,
		})
	end
end

--[[ Gunners tell the server where they are looking; the turret follows. ]]
local function handleAim(player: Player, worldTarget: any)
	-- A NaN here reached HingeConstraint.TargetAngle, which is a poisoned
	-- turret that no longer responds to anything.
	if not Util.IsSaneVector(worldTarget) then
		return
	end
	local state = PlayerState.Get(player)
	if state.vehicle and state.vehicle.Parent and state.seatRole == "Gunner" then
		VehicleService.AimTurret(state.vehicle, worldTarget)
	end
end

function WeaponService.Start()
	-- Everyone spawns holding something.
	local function armOnSpawn(player: Player)
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			updateHeldWeapon(player)
		end)
		if player.Character then
			task.spawn(function()
				task.wait(0.5)
				updateHeldWeapon(player)
			end)
		end
	end

	Players.PlayerAdded:Connect(armOnSpawn)
	for _, player in Players:GetPlayers() do
		armOnSpawn(player)
	end

	Remotes.Event("FireWeapon").OnServerEvent:Connect(function(player, direction)
		handleFire(player, direction)
	end)

	Remotes.Event("SetScoped").OnServerEvent:Connect(function(player, on)
		VehicleService.SetScoped(player, on == true)
	end)

	Remotes.Event("ThrowGrenade").OnServerEvent:Connect(function(player, direction)
		handleThrowGrenade(player, direction)
	end)

	Remotes.Event("EquipWeapon").OnServerEvent:Connect(function(player, weaponName)
		handleEquip(player, weaponName)
	end)

	Remotes.Event("Reload").OnServerEvent:Connect(function(player)
		beginReload(player, equippedWeaponName(player))
	end)

	Remotes.Event("MegaDetonate").OnServerEvent:Connect(function(player)
		handleMegaDetonate(player)
	end)

	Remotes.Event("SetAimDirection").OnServerEvent:Connect(function(player, worldTarget)
		handleAim(player, worldTarget)
	end)

	Remotes.Event("SetTurbo").OnServerEvent:Connect(function(player, on)
		VehicleService.SetTurbo(player, on == true)
	end)

	Remotes.Event("Melee").OnServerEvent:Connect(function(player)
		handleMelee(player)
	end)

	Remotes.Event("Eject").OnServerEvent:Connect(function(player)
		task.spawn(VehicleService.Eject, player)
	end)

	Remotes.Event("SetPedal").OnServerEvent:Connect(function(player, value)
		if typeof(value) == "number" and value == value and math.abs(value) < math.huge then
			VehicleService.SetPedal(player, value)
		end
	end)

	-- The client asks once at join for the full gun list, so the weapon wheel
	-- can build itself without every gun being hard-coded twice.
	Remotes.Function("GetArsenal").OnServerInvoke = function(_player)
		-- Mounted guns are included but flagged. The client needs to know how
		-- the 50 cal behaves while you are sitting behind it, even though it
		-- must never appear in the weapon wheel.
		local arsenal = {}
		for name, spec in Config.Weapons do
			arsenal[name] = {
				Slot = spec.Slot,
				Category = spec.Category,
				DisplayName = spec.DisplayName,
				MagSize = spec.MagSize,
				Automatic = spec.Automatic == true,
				ZoomFov = spec.ZoomFov,
				AutoAim = spec.AutoAim == true,
				CanMegaDetonate = spec.CanMegaDetonate == true,
				MountedOnly = spec.MountedOnly == true,
			}
		end
		return arsenal
	end
end

--[[ What a player currently has in their hands, for tests. ]]
function WeaponService.EquippedForTests(player: Player): string
	return equippedWeaponName(player)
end

--[[ Unused for now, but kept so the origin check has a home when we tighten it. ]]
function WeaponService.MaxOriginDrift(): number
	return MAX_ORIGIN_DRIFT
end

return WeaponService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">WildlifeService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WildlifeService — everything on the map that is alive and is not a player.

	  Zombies    roam, come for you, and hit you if they reach you.
	  Civilians  wander, and say something regrettable when shot.
	  Targets    stand still with a bullseye on them, for practice.

	All three are worth points, all three come back a few seconds after they
	go down, and all three carry a target ring so you can pick them out.

	Poop is still here too: elephants are gone, but a pile that gets shot
	turns into a tower with a staircase round it.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Sound = require(Shared:WaitForChild("Sound"))
local Util = require(Shared:WaitForChild("Util"))

local DamageService = require(script.Parent:WaitForChild("DamageService"))
local PlayerState = require(script.Parent:WaitForChild("PlayerState"))

local WildlifeService = {}
local populationGeneration = 0

type Dweller = {
	kind: string,
	model: Model,
	root: BasePart,
	position: Vector3,
	facing: Vector3,
	target: Vector3,
	health: number,
	maxHealth: number,
	standHeight: number,
	nextAttackAt: number,
	dead: boolean,
}

local dwellers: { Dweller } = {}
local poopPiles: { BasePart } = {}
local wanderRadius = 300
local rng = Random.new()

-- ================================================================ FURNITURE ==

--[[ The bullseye ring that marks anything worth shooting. ]]
local function addBullseye(attachTo: BasePart, height: number)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Bullseye"
	billboard.Size = UDim2.fromOffset(70, 70)
	billboard.StudsOffset = Vector3.new(0, height, 0)
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = 500
	billboard.Parent = attachTo

	-- Concentric rings, red and white, drawn out of nested frames.
	local shades = {
		Color3.fromRGB(220, 40, 40),
		Color3.fromRGB(245, 245, 245),
		Color3.fromRGB(220, 40, 40),
		Color3.fromRGB(245, 245, 245),
	}
	local parent: Instance = billboard
	for index, shade in shades do
		local ring = Instance.new("Frame")
		ring.Size = if index == 1 then UDim2.fromScale(1, 1) else UDim2.fromScale(0.72, 0.72)
		ring.Position = if index == 1 then UDim2.fromScale(0, 0) else UDim2.fromScale(0.14, 0.14)
		ring.BackgroundColor3 = shade
		ring.BorderSizePixel = 0
		ring.Parent = parent

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = ring

		parent = ring
	end
end

--[[ A floating line of speech above someone's head. ]]
local function say(attachTo: BasePart, text: string, colour: Color3, seconds: number)
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(18, 3)
	billboard.StudsOffset = Vector3.new(0, 6, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 400
	billboard.Parent = attachTo

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = colour
	label.TextStrokeTransparency = 0.25
	label.TextScaled = true
	label.Font = Enum.Font.LuckiestGuy
	label.Parent = billboard

	Debris:AddItem(billboard, seconds)
end

--[[ A green cloud, for the obvious reason. ]]
local function fart(position: Vector3)
	local anchor = Util.Part({
		Name = "Fart",
		Size = Vector3.new(0.5, 0.5, 0.5),
		CFrame = CFrame.new(position),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = workspace,
	})

	local cloud = Instance.new("ParticleEmitter")
	cloud.Color = ColorSequence.new(Color3.fromRGB(150, 200, 90))
	cloud.Size = NumberSequence.new(3, 9)
	cloud.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(1, 1),
	})
	cloud.Lifetime = NumberRange.new(0.9, 1.8)
	cloud.Speed = NumberRange.new(4, 11)
	cloud.SpreadAngle = Vector2.new(60, 60)
	cloud.Rate = 0
	cloud.Parent = anchor
	cloud:Emit(40)
	Sound.At("Fart", position)

	Debris:AddItem(anchor, 3)
end

-- ================================================================= BUILDING ==

--[[ A rough person: torso, head, arms, legs. Colour tells you which kind. ]]
local function buildPerson(position: Vector3, skin: Color3, clothes: Color3, name: string): (Model, BasePart, number)
	local model = Instance.new("Model")
	model.Name = name

	local standHeight = 5.5

	local torso = Util.Part({
		Name = "Torso",
		Size = Vector3.new(2.6, 3.4, 1.5),
		CFrame = CFrame.new(position + Vector3.new(0, standHeight, 0)),
		Color = clothes,
		Material = Enum.Material.Fabric,
		CanCollide = false,
		Parent = model,
	})
	model.PrimaryPart = torso

	local head = Util.Part({
		Name = "Head",
		Size = Vector3.new(1.7, 1.7, 1.7),
		CFrame = torso.CFrame * CFrame.new(0, 2.6, 0),
		Color = skin,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = model,
	})
	Util.Weld(torso, head)

	for _, side in { -1, 1 } do
		local arm = Util.Part({
			Name = "Arm",
			Size = Vector3.new(0.9, 3.2, 0.9),
			CFrame = torso.CFrame * CFrame.new(side * 1.75, 0, 0),
			Color = skin,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Parent = model,
		})
		Util.Weld(torso, arm)

		local leg = Util.Part({
			Name = "Leg",
			Size = Vector3.new(1.1, 3.4, 1.1),
			CFrame = torso.CFrame * CFrame.new(side * 0.7, -3.4, 0),
			Color = clothes:Lerp(Color3.new(0, 0, 0), 0.4),
			Material = Enum.Material.Fabric,
			CanCollide = false,
			Parent = model,
		})
		Util.Weld(torso, leg)
	end

	model.Parent = workspace
	return model, torso, standHeight
end

local function spawnZombie(position: Vector3)
	local model, torso, standHeight = buildPerson(
		position,
		Color3.fromRGB(126, 158, 110),
		Color3.fromRGB(72, 84, 66),
		"Zombie"
	)
	model:SetAttribute("Dweller", "Zombie")
	addBullseye(torso, 5)

	-- Arms out in front, so it reads as a zombie at a glance.
	for _, arm in model:GetChildren() do
		if arm:IsA("BasePart") and arm.Name == "Arm" then
			arm.CFrame = arm.CFrame * CFrame.new(0, 1.1, -1.5) * CFrame.Angles(math.rad(-75), 0, 0)
		end
	end

	table.insert(dwellers, {
		kind = "Zombie",
		model = model,
		root = torso :: BasePart,
		position = position,
		facing = Vector3.new(0, 0, 1),
		target = position,
		health = Config.Population.ZombieHealth,
		maxHealth = Config.Population.ZombieHealth,
		standHeight = standHeight,
		nextAttackAt = 0,
		dead = false,
	})
end

local function spawnCivilian(position: Vector3)
	local shirts = {
		Color3.fromRGB(220, 90, 90), Color3.fromRGB(90, 140, 220),
		Color3.fromRGB(240, 200, 80), Color3.fromRGB(140, 200, 130),
		Color3.fromRGB(200, 120, 210),
	}
	local model, torso, standHeight = buildPerson(
		position,
		Color3.fromRGB(226, 186, 150),
		shirts[rng:NextInteger(1, #shirts)],
		"Civilian"
	)
	model:SetAttribute("Dweller", "Civilian")
	addBullseye(torso, 5)

	table.insert(dwellers, {
		kind = "Civilian",
		model = model,
		root = torso :: BasePart,
		position = position,
		facing = Vector3.new(0, 0, 1),
		target = position,
		health = Config.Population.CivilianHealth,
		maxHealth = Config.Population.CivilianHealth,
		standHeight = standHeight,
		nextAttackAt = 0,
		dead = false,
	})
end

--[[ A practice target on a post: board, bullseye, and a stand. ]]
local function spawnTarget(position: Vector3)
	local model = Instance.new("Model")
	model.Name = "PracticeTarget"
	model:SetAttribute("Dweller", "Target")

	local post = Util.Part({
		Name = "Post",
		Size = Vector3.new(1.2, 12, 1.2),
		CFrame = CFrame.new(position + Vector3.new(0, 6, 0)),
		Color = Color3.fromRGB(110, 82, 54),
		Material = Enum.Material.Wood,
		Parent = model,
	})

	local board = Util.Part({
		Name = "Board",
		Size = Vector3.new(11, 11, 0.8),
		CFrame = CFrame.new(position + Vector3.new(0, 15, 0))
			* CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0),
		Color = Color3.fromRGB(245, 245, 240),
		Material = Enum.Material.WoodPlanks,
		Parent = model,
	})
	model.PrimaryPart = board
	Util.Weld(post, board)

	-- Painted rings, front and back, so it works from either side.
	for _, facing in { 1, -1 } do
		local radius = 5.0
		for ring = 1, 4 do
			Util.Part({
				Name = "Ring",
				Size = Vector3.new(0.2, radius * 2, radius * 2),
				CFrame = board.CFrame * CFrame.new(0, 0, facing * (0.45 + ring * 0.01)),
				Shape = Enum.PartType.Cylinder,
				Color = if ring % 2 == 1 then Color3.fromRGB(220, 40, 40) else Color3.fromRGB(250, 250, 250),
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Parent = model,
			})
			radius *= 0.72
		end
	end

	-- A cylinder lies on its own X, so the rings need standing upright.
	for _, ring in model:GetChildren() do
		if ring:IsA("BasePart") and ring.Name == "Ring" then
			ring.CFrame = ring.CFrame * CFrame.Angles(0, math.rad(90), 0)
			Util.Weld(board, ring)
		end
	end

	model.Parent = workspace

	table.insert(dwellers, {
		kind = "Target",
		model = model,
		root = board :: BasePart,
		position = position,
		facing = Vector3.new(0, 0, 1),
		target = position,
		health = Config.Population.TargetHealth,
		maxHealth = Config.Population.TargetHealth,
		standHeight = 15,
		nextAttackAt = 0,
		dead = false,
	})
end

-- ==================================================================== POOP ==

local function collectPoop(player: Player, pile: BasePart)
	local state = PlayerState.Get(player)
	local slot = state.weapons.Poop
	local spec = Config.Weapons.Poop
	if not slot or not spec then
		return
	end
	slot.ammo = math.min(spec.MagSize, slot.ammo + Config.Wildlife.PoopPerPile)
	PlayerState.Changed.Fire(player)
	Remotes.Event("Notify"):FireClient(player, "Picked up poop — press 7 to throw it")

	local index = table.find(poopPiles, pile)
	if index then
		table.remove(poopPiles, index)
	end
	pile:Destroy()
end

--[[
	Shoot a pile and it grows into a tower with a staircase wrapped round it.

	Which is ridiculous, and also genuinely useful: the top is a good sniping
	platform, and the only way up is the stairs.
]]
local function raisePoopColumn(pile: BasePart)
	local base = pile.Position
	local index = table.find(poopPiles, pile)
	if index then
		table.remove(poopPiles, index)
	end
	pile:Destroy()

	local model = Instance.new("Model")
	model.Name = "PoopColumn"

	local height = 84
	local radius = 7

	local column = Util.Part({
		Name = "Column",
		Size = Vector3.new(height, radius * 2, radius * 2),
		CFrame = CFrame.new(base + Vector3.new(0, height * 0.5, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Shape = Enum.PartType.Cylinder,
		Color = Color3.fromRGB(92, 64, 38),
		Material = Enum.Material.Mud,
		Parent = model,
	})

	-- The platform on top.
	Util.Part({
		Name = "Platform",
		Size = Vector3.new(radius * 4, 1.5, radius * 4),
		CFrame = CFrame.new(base + Vector3.new(0, height, 0)),
		Color = Color3.fromRGB(104, 74, 44),
		Material = Enum.Material.Sand,
		Parent = model,
	})
	-- A lip, so you can lie down up there without rolling off.
	for _, side in { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) } do
		Util.Part({
			Name = "Lip",
			Size = Vector3.new(
				if side.X ~= 0 then 1 else radius * 4,
				3,
				if side.Z ~= 0 then 1 else radius * 4
			),
			CFrame = CFrame.new(base + side * radius * 2 + Vector3.new(0, height + 2, 0)),
			Color = Color3.fromRGB(84, 58, 34),
			Material = Enum.Material.Sand,
			Parent = model,
		})
	end

	-- The spiral: one step at a time, round and round.
	local steps = 64
	local turns = 3.5
	for step = 1, steps do
		local fraction = step / steps
		local angle = fraction * turns * math.pi * 2
		local y = fraction * (height - 2)
		local outward = radius + 3.5

		Util.Part({
			Name = "SpiralStep",
			Size = Vector3.new(7, 1, 4.5),
			CFrame = CFrame.new(base + Vector3.new(math.cos(angle) * outward, y, math.sin(angle) * outward))
				* CFrame.Angles(0, -angle + math.pi * 0.5, 0),
			Color = Color3.fromRGB(120, 88, 52),
			Material = Enum.Material.WoodPlanks,
			Parent = model,
		})
	end

	model.Parent = workspace

	for _, player in Players:GetPlayers() do
		Remotes.Event("Notify"):FireClient(player, "A poop tower has risen. There are stairs.")
	end
end

local function dropPoop(position: Vector3)
	if #poopPiles >= Config.Wildlife.MaxPoopPiles then
		local oldest = table.remove(poopPiles, 1)
		if oldest and oldest.Parent then
			oldest:Destroy()
		end
	end

	local pile = Util.Part({
		Name = "PoopPile",
		Size = Vector3.new(6, 4.5, 6),
		CFrame = CFrame.new(position + Vector3.new(0, 2, 0)),
		Shape = Enum.PartType.Ball,
		Color = Color3.fromRGB(92, 64, 38),
		Material = Enum.Material.Sand,
		CanCollide = false,
		Parent = workspace,
	})
	pile:SetAttribute("Poop", true)

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(6, 1.6)
	billboard.StudsOffset = Vector3.new(0, 5, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 250
	billboard.Parent = pile

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "POOP"
	label.TextColor3 = Color3.fromRGB(210, 180, 140)
	label.TextStrokeTransparency = 0.3
	label.TextScaled = true
	label.Font = Enum.Font.LuckiestGuy
	label.Parent = billboard

	pile.Touched:Connect(function(hit)
		if not pile.Parent then
			return
		end
		local character = hit:FindFirstAncestorOfClass("Model")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local player = if character and humanoid and humanoid.Health > 0 then Players:GetPlayerFromCharacter(character) else nil
		if player then
			collectPoop(player, pile)
		end
	end)

	table.insert(poopPiles, pile)
end

--[[ Scatter some poop about, since there is no elephant leaving it any more. ]]
local function seedPoop()
	for _ = 1, 12 do
		dropPoop(Vector3.new(
			rng:NextNumber(-wanderRadius, wanderRadius),
			2,
			rng:NextNumber(-wanderRadius, wanderRadius)
		))
	end
end

-- ==================================================================== DEATH ==

local function respawnOne(kind: string)
	local where = Vector3.new(
		rng:NextNumber(-wanderRadius, wanderRadius),
		4,
		rng:NextNumber(-wanderRadius, wanderRadius)
	)
	if kind == "Zombie" then
		spawnZombie(where)
	elseif kind == "Civilian" then
		spawnCivilian(where)
	else
		spawnTarget(where)
	end
end

local function kill(dweller: Dweller, attacker: Player?)
	if dweller.dead then
		return
	end
	dweller.dead = true

	local points = if dweller.kind == "Zombie" then Config.Population.ZombiePoints
		elseif dweller.kind == "Civilian" then Config.Population.CivilianPoints
		else Config.Population.TargetPoints

	if attacker then
		local earned = PlayerState.AwardPoints(attacker, points)
		Remotes.Event("Notify"):FireClient(attacker, `+{earned} — {dweller.kind}`)
	end

	-- A burst of whatever colour suits.
	local anchor = Util.Part({
		Name = "Burst",
		Size = Vector3.new(0.5, 0.5, 0.5),
		CFrame = CFrame.new(dweller.root.Position),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = workspace,
	})
	local burst = Instance.new("ParticleEmitter")
	burst.Color = ColorSequence.new(
		if dweller.kind == "Zombie" then Color3.fromRGB(110, 160, 90) else Color3.fromRGB(220, 60, 60)
	)
	burst.Size = NumberSequence.new(2.5, 0)
	burst.Lifetime = NumberRange.new(0.5, 1.1)
	burst.Speed = NumberRange.new(14, 34)
	burst.SpreadAngle = Vector2.new(180, 180)
	burst.Rate = 0
	burst.Parent = anchor
	burst:Emit(60)
	Debris:AddItem(anchor, 2.5)

	local kind = dweller.kind
	local gen = populationGeneration
	dweller.model:Destroy()
	task.delay(Config.Population.RespawnDelay, function()
		if gen == populationGeneration then
			respawnOne(kind)
		end
	end)
end

--[[
	Something was shot. Returns true if this module handled it, so the caller
	knows not to look for a player or a vehicle as well.
]]
function WildlifeService.RegisterHit(part: BasePart, damage: number?, attacker: Player?): boolean
	-- A poop pile that takes a hit grows into a tower.
	if part:GetAttribute("Poop") then
		raisePoopColumn(part)
		return true
	end

	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		if model:GetAttribute("Dweller") then
			for _, dweller in dwellers do
				if dweller.model == model and not dweller.dead then
					dweller.health -= (damage or 20)

					if dweller.kind == "Civilian" then
						local line = Config.CivilianLines[rng:NextInteger(1, #Config.CivilianLines)]
						say(dweller.root, line, Color3.fromRGB(255, 240, 200), 3)
						fart(dweller.root.Position - Vector3.new(0, 1.5, 0))
					elseif dweller.kind == "Zombie" then
						say(dweller.root, "RRRAAAGH", Color3.fromRGB(160, 220, 130), 1.5)
						Sound.At("ZombieGrowl", dweller.root.Position)
					end

					if dweller.health <= 0 then
						kill(dweller, attacker)
					end
					return true
				end
			end
			return true
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return false
end

-- ================================================================= MOVEMENT ==

--[[
	Everybody alive, gathered once.

	Every zombie used to walk the whole player list itself, every frame. Ten
	zombies and twenty players is two hundred character lookups a frame, each
	one a FindFirstChild and a FindFirstChildOfClass -- the expensive part,
	far more than the arithmetic. Gathering the list once a frame and sharing
	it makes that twenty lookups instead of two hundred, and the answer is
	identical.
]]
type LivingPlayer = { player: Player, position: Vector3 }
local living: { LivingPlayer } = {}

local function refreshLiving()
	table.clear(living)
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
			table.insert(living, { player = player, position = root.Position })
		end
	end
end

local function nearestLiving(from: Vector3): (Player?, Vector3?, number)
	local best: Player? = nil
	local bestPosition: Vector3? = nil
	local bestDistance = math.huge

	for _, entry in living do
		local distance = (entry.position - from).Magnitude
		if distance < bestDistance then
			best, bestPosition, bestDistance = entry.player, entry.position, distance
		end
	end

	return best, bestPosition, bestDistance
end

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude

local function groundHeight(position: Vector3, ignore: Instance): number
	groundParams.FilterDescendantsInstances = { ignore }
	local hit = workspace:Raycast(position + Vector3.new(0, 6, 0), Vector3.new(0, -24, 0), groundParams)
	return if hit then hit.Position.Y else position.Y
end

local function stepDweller(dweller: Dweller, deltaTime: number)
	-- Targets do not go anywhere.
	if dweller.kind == "Target" then
		return
	end

	local speed = if dweller.kind == "Zombie"
		then Config.Population.ZombieSpeed
		else Config.Population.CivilianSpeed

	local goal: Vector3
	if dweller.kind == "Zombie" then
		-- Zombies come for whoever is closest.
		local player, position, distance = nearestLiving(dweller.position)
		if position and distance < 320 then
			goal = position

			-- Close enough to swing.
			if distance <= Config.Population.ZombieReach and player then
				local now = os.clock()
				if now >= dweller.nextAttackAt then
					dweller.nextAttackAt = now + 1.2
					DamageService.ApplyDamage(player, Config.Population.ZombieDamage, nil, "Zombie")
					say(dweller.root, "NOM", Color3.fromRGB(200, 90, 90), 1)
				end
				return
			end
		else
			goal = dweller.target
		end
	else
		goal = dweller.target
	end

	local toGoal = Vector3.new(goal.X - dweller.position.X, 0, goal.Z - dweller.position.Z)
	if toGoal.Magnitude < 12 then
		dweller.target = Vector3.new(
			rng:NextNumber(-wanderRadius, wanderRadius),
			0,
			rng:NextNumber(-wanderRadius, wanderRadius)
		)
		return
	end

	local direction = toGoal.Unit
	local blended = dweller.facing + (direction - dweller.facing) * math.min(1, deltaTime * 3)
	if blended.Magnitude > 1e-4 then
		dweller.facing = blended.Unit
	end
	dweller.position += dweller.facing * speed * deltaTime
	dweller.position = Vector3.new(
		dweller.position.X,
		groundHeight(dweller.position, dweller.model),
		dweller.position.Z
	)

	-- A little bob, so they look like they are walking rather than sliding.
	local bob = math.abs(math.sin(os.clock() * 7)) * 0.4
	local stand = dweller.position + Vector3.new(0, dweller.standHeight + bob, 0)
	dweller.model:PivotTo(CFrame.lookAt(stand, stand + dweller.facing))
end

local function step(deltaTime: number)
	-- One player scan for the whole crowd, before anybody moves.
	refreshLiving()

	for index = #dwellers, 1, -1 do
		local dweller = dwellers[index]
		if not dweller.model.Parent then
			table.remove(dwellers, index)
		else
			stepDweller(dweller, deltaTime)
		end
	end
end

-- =================================================================== PUBLIC ==

function WildlifeService.Populate(mapSize: number)
	WildlifeService.Clear()
	wanderRadius = mapSize * 0.4

	local function scatter(): Vector3
		return Vector3.new(
			rng:NextNumber(-wanderRadius, wanderRadius),
			4,
			rng:NextNumber(-wanderRadius, wanderRadius)
		)
	end

	for _ = 1, Config.Population.Zombies do
		spawnZombie(scatter())
	end
	for _ = 1, Config.Population.Civilians do
		spawnCivilian(scatter())
	end
	for _ = 1, Config.Population.Targets do
		spawnTarget(scatter())
	end

	seedPoop()
end

function WildlifeService.Clear()
	populationGeneration += 1
	for _, dweller in dwellers do
		if dweller.model.Parent then
			dweller.model:Destroy()
		end
	end
	table.clear(dwellers)

	for _, pile in poopPiles do
		if pile.Parent then
			pile:Destroy()
		end
	end
	table.clear(poopPiles)

	for _, child in workspace:GetChildren() do
		if child.Name == "PoopColumn" then
			child:Destroy()
		end
	end
end

function WildlifeService.Count(): number
	return #dwellers
end

function WildlifeService.PoopCount(): number
	return #poopPiles
end

--[[ How many of each kind are about, for the tests. ]]
function WildlifeService.CountOf(kind: string): number
	local total = 0
	for _, dweller in dwellers do
		if dweller.kind == kind and not dweller.dead then
			total += 1
		end
	end
	return total
end

--[[
	The zombie closest to a point, for the tests.

	The chase logic is shared between every zombie through one player scan a
	frame, so a test has to be able to watch one of them actually move.
]]
function WildlifeService.NearestZombieForTests(from: Vector3): any
	local best: any = nil
	local bestDistance = math.huge
	for _, dweller in dwellers do
		if dweller.kind == "Zombie" and not dweller.dead then
			local distance = (dweller.position - from).Magnitude
			if distance < bestDistance then
				best, bestDistance = dweller, distance
			end
		end
	end
	return best
end

RunService.Heartbeat:Connect(step)

return WildlifeService
]]></string>
